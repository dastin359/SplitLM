+    const uint32_t npair = n / (2 * VLEN_FP32);
+    uint32_t       rem   = n % (2 * VLEN_FP32);
+
+    uint32_t i = 0;
+    _Pragma("unroll(2)")
+    for (; i < npair; i++) {
+        HVX_Vector y0, y1;
+        hvx_vec_sigmoid2_f32_hf(vg[2 * i], vg[2 * i + 1], &y0, &y1, &c, one_hf, one_f32, m1);
