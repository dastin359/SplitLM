+
+static void hmx_a8_out_convert_threaded(struct htp_context * ctx, __fp16 * out, const uint8_t * meta, const float * row_scale,
+                                        uint32_t n_row_tiles, uint32_t n_col_tiles, uint32_t n_threads) {
+    hmx_a8_out_state_t st = {
+        .out = out, .meta = meta, .row_scale = row_scale, .n_q = (n_row_tiles + 1) / 2, .n_col_tiles = n_col_tiles,
