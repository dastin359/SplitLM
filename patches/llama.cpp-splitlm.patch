+// ---------------------------------------------------------------------------------------------------------
+// Per-thread driver (kparams->pipeline bit 1, GGML_HEXAGON_GDN_MT): every HVX thread runs whole heads on its
+// own (its VTCM head slot, its DMA queue), pushes its HMX jobs to the shared HMX queue under a spin lock and
+// waits on each job's done flag. Same phases, same HMX jobs, same math as gated_delta_net_f32_hmx_chunked;
+// it removes the six work_queue_run barriers and the main-thread HMX round trips per chunk, and the HMX
+// jobs of one thread overlap the HVX work of the others.
+struct htp_gdn_mt_context {
+    struct htp_ops_context *             octx;
+    const struct htp_gdn_kernel_params * kparams;
+    struct htp_gdn_hmx_vtcm_layout       L;
+    struct htp_gdn_head_ptrs             heads[8];
+    float *                              g_raw[2];
+    float *                              b_raw[2];
+    const float *                        g_all;     // HTP_GDN_PIPE_GB_VTCM: g [T][H] in VTCM
+    const float *                        b_all;     //                       beta [T][H] in VTCM
+    uint8_t *                            scales_1;
+    uint8_t *                            scales_o;  // HTP_GDN_PIPE_V2: output scale of the merged o job
+    const float *                        norm_w;
+    uint32_t                             row_start;
+    uint32_t                             nrows;
+    uint32_t                             n_workers;
+    atomic_uint                          hmx_lock;
+};
+
+static inline void gdn_mt_push(struct htp_gdn_mt_context * mc, struct htp_gdn_hmx_gemm_task * task,
+                               const __fp16 * row_tiles, const __fp16 * col_tiles, __fp16 * out_tiles,
+                               uint32_t n_row_tiles, uint32_t n_col_tiles, uint32_t n_dot_tiles) {
+    task->row_tiles   = row_tiles;
+    task->col_tiles   = col_tiles;
+    task->out_tiles   = out_tiles;
+    task->n_row_tiles = n_row_tiles;
+    task->n_col_tiles = n_col_tiles;
+    task->n_dot_tiles = n_dot_tiles;
+    task->dot_stride  = n_dot_tiles * HMX_FP16_TILE_N_ELMS;
+    task->hmx_scales  = mc->scales_1;
+    atomic_store(&task->done, 0);
+
+    hmx_queue_t q = mc->octx->ctx->hmx_queue;
+    while (1) {
+        unsigned int expected = 0;
+        if (atomic_compare_exchange_weak(&mc->hmx_lock, &expected, 1)) {
+            const bool ok = hmx_queue_push(q, hmx_queue_make_desc(htp_gdn_hmx_gemm_worker, task));
+            atomic_store(&mc->hmx_lock, 0);
+            if (ok) {
+                return;
+            }
+        }
+        hex_pause();
+    }
+}
+
+static inline void gdn_mt_wait(struct htp_gdn_hmx_gemm_task * task) {
+    while (!atomic_load(&task->done)) {
+        hex_pause();
+    }
+}
