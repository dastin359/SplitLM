+// Scatter of a paired gate/up HMX output chunk of the streamed expert kernel with the SWIGLU folded in:
+// of the 2 * nt column tiles of each tile row, [0, nt) hold the gate and [nt, 2 nt) the up columns of the same
+// n_cols = nt * 32 output columns; each mapped dst row gets silu(gate) * up (mode 2: fp16 sigmoid as
+// HTP_MM_EPI_SWIGLU_PAIR_HF, mode 1: qf32 sigmoid as HTP_MM_EPI_SWIGLU_PAIR, mode 3: mode 2 with the product in fp16,
+// mode 4: mode 2 rounded once to fp16 and stored as fp16 rows (dst points at fp16 columns, rows at the f32 row strides),
+// mode 5: mode 3 stored as fp16 rows). The second row of an odd last row pair is computed from padding and never stored.
+static void transfer_output_chunk_scattered_swiglu_pair(
+            float *restrict dst,
+            const __fp16 *restrict vtcm_src,
+            uint32_t start_row,
+            uint32_t vtcm_start_row,
+            uint32_t n_rows,
+            uint32_t n_cols,
+            const struct mmid_row_mapping *matrix_rows,
+            uint32_t cur_a,
+            uint32_t mapping_stride,
+            size_t dst_nb1,
+            size_t dst_nb2,
+            uint32_t cne1,
+            bool aligned_ok,
+            uint32_t mode) {
+    assert(n_cols % HTP_MM_HMX_TILE_N_COLS == 0);
+    const size_t nt              = n_cols / HTP_MM_HMX_TILE_N_COLS;
+    const size_t tile_row_stride = 2 * nt * HTP_MM_HMX_TILE_N_ELMS;
+    const size_t tstep           = HTP_MM_HMX_TILE_N_ELMS * sizeof(__fp16) / VLEN;  // vectors per tile
+    const size_t up_v            = nt * tstep;                                      // gate -> up, in vectors
+
+    const HVX_Vector one = hvx_vec_splat_f16(1.0);
+    const struct hvx_silu_hf_consts hc = hvx_silu_hf_consts_init();
+    const struct hvx_sigmoid_qf32_consts sc = hvx_sigmoid_qf32_consts_init();
+
+    const bool aligned = aligned_ok && hex_is_aligned(dst, VLEN) && (dst_nb1 % VLEN) == 0 && (dst_nb2 % VLEN) == 0;
+
+    for (size_t r = 0; r < n_rows; r += 2) {
+        const uint32_t r_idx0 = start_row + r + 0;
+        const uint32_t r_idx1 = start_row + r + 1;
