+namespace ggml::cpu::htptile {
+
+class tensor_traits : public ggml::cpu::tensor_traits {
+    // q8_0 activation rows, then per-block int32 sums
+    bool work_size(int /*n_threads*/, const struct ggml_tensor * op, size_t & size) override {
+        const ggml_tensor * src1 = op->src[1];
+        const int64_t rows = src1->ne[1] * src1->ne[2];
+        size = ggml_row_size(GGML_TYPE_Q8_0, src1->ne[0]) * rows + sizeof(int32_t) * (src1->ne[0] / 32) * rows + 64;
+        return true;
+    }
+
+    // MUL_MAT_ID: dst[N, n_used, n_tok] = experts[K, N, E][ids] x src1[K, ne11, n_tok]
+    // MUL_MAT:    dst[N, n_tok] = W[K, N] x src1[K, n_tok]  (treated as one expert, one slot)
+    bool compute_forward(struct ggml_compute_params * params, struct ggml_tensor * op) override {
+        if (op->op != GGML_OP_MUL_MAT_ID && op->op != GGML_OP_MUL_MAT) {
+            return false;
+        }
+        const bool is_id = op->op == GGML_OP_MUL_MAT_ID;
+        const ggml_tensor * src0 = op->src[0];
+        const ggml_tensor * src1 = op->src[1];
+        const ggml_tensor * ids  = is_id ? op->src[2] : nullptr;
+        const int ith = params->ith, nth = params->nth;
+
+        const int64_t K = src0->ne[0], N = src0->ne[1];
+        const int64_t ne11 = is_id ? src1->ne[1] : 1;
+        const int64_t ne12 = is_id ? src1->ne[2] : src1->ne[1];
+        const int64_t n_used = is_id ? ids->ne[0] : 1;
+        const size_t  rs = ggml_row_size(GGML_TYPE_Q8_0, K);
+        const int     n_kt = (int) (K / 32);
+        uint8_t * wq   = (uint8_t *) params->wdata;
+        int32_t * sums = (int32_t *) (wq + rs * ne11 * ne12);
+        static const htptile_kernel kern0 = htptile_pick_kernel();
+        htptile_kernel kern = kern0;
+#if defined(HTPTILE_I8MM)
+        // batches (speculative verification, prefill over aliased weights) take the i8mm matrix kernel
+        static const bool no_mmla = getenv("GGML_HTPTILE_NO_MMLA") != nullptr;
+        if (kern0 == HTPTILE_DOT && !no_mmla && ne12 > 1) {
+            kern = HTPTILE_MMLA;
+        }
+#endif
+
+        GGML_ASSERT(src1->nb[0] == sizeof(float));
+        // MUL_MAT keeps tokens on dim 1, MUL_MAT_ID on dim 2
+        const size_t nb_slot = is_id ? src1->nb[1] : 0;
+        const size_t nb_tok  = is_id ? src1->nb[2] : src1->nb[1];
+        for (int64_t r = ith; r < ne11 * ne12; r += nth) {
+            const int64_t i11 = r % ne11, i12 = r / ne11;
+            quantize_row_q8_0((const float *) ((const char *) src1->data + i11 * nb_slot + i12 * nb_tok), wq + r * rs, K);
+#if defined(HTPTILE_I8MM)
+            if (kern == HTPTILE_USDOT || kern == HTPTILE_MMLA) {
+                htptile_prep_x((block_q8_0 *) (wq + r * rs), sums + r * n_kt, n_kt);
+            } else
+#endif
+            {
+                htptile_block_sums((const block_q8_0 *) (wq + r * rs), sums + r * n_kt, n_kt);
+            }
+        }
+        ggml_barrier(params->threadpool);
+
+        const int64_t n_bands = N / HT_ROWS;
+        const block_q8_0 * xs[HT_MULTI];
+        const int32_t *    ss[HT_MULTI];
+        float *            ys[HT_MULTI];
+        if (!is_id) {
+            // band-outer, tokens-inner: each 32-row band (~27 KB) stays in L1 while every token uses it,
+            // and tokens go through the band HT_MULTI at a time
+            for (int64_t band = ith; band < n_bands; band += nth) {
+                const uint8_t * w = (const uint8_t *) src0->data + band * HT_ROWS * src0->nb[1];
+                for (int64_t t0 = 0; t0 < ne12; t0 += HT_MULTI) {
+                    const int nt = (int) std::min<int64_t>(HT_MULTI, ne12 - t0);
+                    for (int i = 0; i < nt; i++) {
+                        xs[i] = (const block_q8_0 *) (wq + (t0 + i) * rs);
+                        ss[i] = sums + (t0 + i) * n_kt;
+                        ys[i] = (float *) ((char *) op->data + (t0 + i) * op->nb[1]) + band * HT_ROWS;
+                    }
+                    htptile_band_multi(kern, w, xs, ss, n_kt, ys, nt);
+                }
+            }
+            return true;
+        }
+        if (ne12 > 1) {
+            // batches (prefill, speculative verification): group (token, slot) pairs by expert so each expert band
+            // is unpacked once per HT_MULTI tokens that route to it
+            const int64_t n_exp = src0->ne[2];
+            thread_local std::vector<int32_t> cnt, start, pairs;
+            cnt.assign(n_exp + 1, 0);
+            for (int64_t t = 0; t < ne12; t++) {
+                for (int64_t s = 0; s < n_used; s++) {
+                    const int32_t e = *(const int32_t *) ((const char *) ids->data + s * ids->nb[0] + t * ids->nb[1]);
+                    cnt[e + 1]++;
+                }
+            }
+            start.assign(n_exp + 1, 0);
+            for (int64_t e = 0; e < n_exp; e++) start[e + 1] = start[e] + cnt[e + 1];
+            pairs.assign(ne12 * n_used, 0);
+            std::vector<int32_t> fill(start.begin(), start.end() - 1);
+            for (int64_t t = 0; t < ne12; t++) {
+                for (int64_t s = 0; s < n_used; s++) {
+                    const int32_t e = *(const int32_t *) ((const char *) ids->data + s * ids->nb[0] + t * ids->nb[1]);
+                    pairs[fill[e]++] = (int32_t) (t * n_used + s);
+                }
+            }
+            const int64_t n_items_e = n_exp * n_bands;
+            for (int64_t it = ith; it < n_items_e; it += nth) {
+                const int64_t e = it / n_bands, band = it % n_bands;
+                const int32_t p0 = start[e], p1 = start[e + 1];
+                if (p0 == p1) continue;
+                const uint8_t * w = (const uint8_t *) src0->data + e * src0->nb[2] + band * HT_ROWS * src0->nb[1];
+                for (int32_t p = p0; p < p1; p += HT_MULTI) {
+                    const int nt = std::min<int32_t>(HT_MULTI, p1 - p);
+                    for (int i = 0; i < nt; i++) {
+                        const int64_t t = pairs[p + i] / n_used, s = pairs[p + i] % n_used;
+                        const int64_t row = (s % ne11) + t * ne11;
+                        xs[i] = (const block_q8_0 *) (wq + row * rs);
+                        ss[i] = sums + row * n_kt;
+                        ys[i] = (float *) ((char *) op->data + s * op->nb[1] + t * op->nb[2]) + band * HT_ROWS;
+                    }
+                    htptile_band_multi(kern, w, xs, ss, n_kt, ys, nt);
+                }
+            }
+            return true;
+        }
+        const int64_t n_items = ne12 * n_used * n_bands;
+        for (int64_t it = ith; it < n_items; it += nth) {
+            const int64_t band = it % n_bands;
+            const int64_t s    = (it / n_bands) % n_used;
+            const int64_t t    = it / (n_bands * n_used);
+            const int32_t e    = is_id ? *(const int32_t *) ((const char *) ids->data + s * ids->nb[0] + t * ids->nb[1]) : 0;
+            const uint8_t * w  = (const uint8_t *) src0->data + e * src0->nb[2] + band * HT_ROWS * src0->nb[1];
+            const int64_t row = (s % ne11) + t * ne11;
+            const block_q8_0 * xq = (const block_q8_0 *) (wq + row * rs);
+            float * y = is_id ? (float *) ((char *) op->data + s * op->nb[1] + t * op->nb[2]) + band * HT_ROWS
+                              : (float *) ((char *) op->data + t * op->nb[1]) + band * HT_ROWS;
+            htptile_band(kern, w, xq, sums + row * n_kt, n_kt, y);
+        }
+        return true;
+    }
+};
+
+static tensor_traits g_traits;
+
+class extra_buffer_type : ggml::cpu::extra_buffer_type {
+    bool supports_op(ggml_backend_dev_t, const struct ggml_tensor * op) override {
+        if ((op->op != GGML_OP_MUL_MAT_ID && op->op != GGML_OP_MUL_MAT) || !g_resolver) {
+            return false;
+        }
+        const ggml_tensor * src0 = op->src[0];
+        const ggml_tensor * src1 = op->src[1];
+        if (!src0->buffer || src0->buffer->buft != ggml_backend_cpu_htptile_buffer_type() || !htptile_shape_ok(src0)) {
+            return false;
+        }
+        if (src1->buffer && !ggml_backend_buft_is_host(src1->buffer->buft)) {
+            return false;
+        }
+        if (op->op == GGML_OP_MUL_MAT && (src0->ne[2] != 1 || src1->ne[2] != 1 || src1->ne[3] != 1 || src1->nb[0] != sizeof(float))) {
+            return false; // plain 2-D weight x token rows only
+        }
+        return src1->type == GGML_TYPE_F32 && op->type == GGML_TYPE_F32;
+    }
+
+    ggml::cpu::tensor_traits * get_tensor_traits(const struct ggml_tensor * op) override {
+        if ((op->op == GGML_OP_MUL_MAT_ID || op->op == GGML_OP_MUL_MAT) && op->src[0]->buffer &&
+            op->src[0]->buffer->buft == ggml_backend_cpu_htptile_buffer_type()) {
+            return &g_traits;
+        }
+        return nullptr;
+    }
+};
