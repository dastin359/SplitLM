+    for (uint32_t c0 = 0; c0 < ne00; c0 += 32) {
+        HVX_Vector * t = (HVX_Vector *) (vals + c0);  // t[p * vstride] = row p of the tile
+        const uint32_t vstride = ne00 / 32;
+        // 32x32 word transpose, 5 rounds of new[2i], new[2i + 1] = interleave(old[i], old[i + 16]). Done in place:
+        // before round m (0-based) logical row j is stored at physical row rotr5(j, m), and the two outputs go back to
+        // the two input slots, which is exactly rotr5(., m + 1) of their new logical rows; after 5 rounds the mapping
+        // is the identity again.
+        for (uint32_t m = 0; m < 5; ++m) {
+            for (uint32_t i = 0; i < 16; ++i) {
+                HVX_Vector * pa = t + (size_t) topk_rotr5(i, m) * vstride;
+                HVX_Vector * pb = t + (size_t) topk_rotr5(i + 16, m) * vstride;
+                HVX_VectorPair w = Q6_W_vshuff_VVR(*pb, *pa, -4);
+                *pa = Q6_V_lo_W(w);
+                *pb = Q6_V_hi_W(w);
+            }
+        }
+        for (uint32_t e = 0; e < 32; ++e) {
+            const HVX_Vector v  = t[(size_t) e * vstride];
+            const HVX_Vector vi = Q6_V_vsplat_R((int32_t) (c0 + e));
+            HVX_VectorPred p[TOPK_MAX_K];
+            for (uint32_t j = 0; j < k; ++j) {
+                p[j] = Q6_Q_or_QQ(Q6_Q_vcmp_gt_VsfVsf(v, bv[j]), Q6_Q_vcmp_gt_VwVw(zero, bi[j]));
+            }
+            for (uint32_t j = k - 1; j > 0; --j) {
+                bv[j] = Q6_V_vmux_QVV(p[j - 1], bv[j - 1], Q6_V_vmux_QVV(p[j], v, bv[j]));
+                bi[j] = Q6_V_vmux_QVV(p[j - 1], bi[j - 1], Q6_V_vmux_QVV(p[j], vi, bi[j]));
+            }
+            bv[0] = Q6_V_vmux_QVV(p[0], v, bv[0]);
+            bi[0] = Q6_V_vmux_QVV(p[0], vi, bi[0]);
+        }
+    }
