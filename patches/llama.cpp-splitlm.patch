+    void *vtcm_raw_bufs[2] = { vtcm_weight, dequant_worker_fn ? vtcm_weight : vtcm_scratch0 };
+    void *vtcm_weight_bufs[2] = { dequant_worker_fn ? vtcm_scratch0 : vtcm_weight, vtcm_scratch0 };
+    const int n_chunk_cnt = hmx_ceil_div(n, n_chunk_n_cols);
+
+#define HMX_MMID_DMA_HEIGHT(cols) ((uint32_t) (is_tiled ? hmx_ceil_div((cols), 32) * n_weight_tiles : (cols)))
+
+    // A0: weight chunk 0 of the first item. Reuse the previous call's prefetch when it is this exact chunk,
+    // otherwise issue it now so that it overlaps the activation gather.
+    const uint32_t height0 = HMX_MMID_DMA_HEIGHT(hex_smin((size_t) n, n_chunk_n_cols));
+    bool chunk0_inflight = false;
+    if (pf && pf->pending) {
+        pf->pending = false;
+        if (pf->src == weights[0] && pf->height == height0) {
+            chunk0_inflight = true;
+        } else {
+            dma_queue_pop(weight_dma);
+        }
+    }
+    if (!chunk0_inflight) {
+        dma_queue_push(weight_dma, dma_make_data(vtcm_raw_bufs[0], weights[0]),
+                       dma_dst_stride, dma_src_stride, dma_width_bytes, height0);
+    }
+
+    uint32_t item = 0;  // flat (M-chunk, weight, N-chunk) counter, selects the buffer parity
+    for (size_t mr = (size_t) m_start; mr < (size_t) m_end; mr += m_chunk_n_rows) {
+        const size_t n_rows = hex_smin((size_t) m_end - mr, m_chunk_n_rows);
+        const size_t n_row_tiles = hmx_ceil_div(n_rows, HTP_MM_HMX_TILE_N_ROWS);
+        const bool last_m_chunk = (mr + m_chunk_n_rows >= (size_t) m_end);
+
+        if (tiled_act) {
+            // rows mr .. mr + 32 * n_row_tiles of the expert block (padded to 32 rows by the producer)
+            hmx_mmid_tiled_copy_threaded(ctx, vtcm_f16_act, tiled_act + mr * (size_t) k,
+                                         n_row_tiles * HTP_MM_HMX_TILE_N_ROWS * vec_dot_size, n_threads);
+        } else {
+            transfer_activation_chunk_gathered_threaded(
+                ctx, vtcm_f16_act, activation, (int) mr, (int) n_rows, k,
+                matrix_rows, cur_a, mapping_stride, ne11, act_nb1, act_nb2, cne1, n_threads, k_valid);
+        }
+
+        for (int w = 0; w < n_w; ++w) {
+            for (int i = 0; i < n_chunk_cnt; ++i, ++item) {
+                const size_t nc = (size_t) i * n_chunk_n_cols;
+                const size_t n_cols = hex_smin((size_t) n - nc, n_chunk_n_cols);
+                const size_t n_col_tiles = hmx_ceil_div(n_cols, HTP_MM_HMX_TILE_N_COLS);
+
+                // A: Wait for weight DMA
+                void * curr_raw = (void *) dma_queue_pop(weight_dma).dst;
+
+                // B: Weight Dequantize (Threaded)
+                dequantize_tiled_weight_chunk_to_fp16_tiles(
+                    ctx, vtcm_weight_bufs[item % 2], curr_raw,
+                    n_cols, k, row_stride, weight_type,
+                    n_k_tiles, n_k_tiles_div, dequant_worker_fn, n_threads
+                );
+
+                // Start the weight DMA for the next item early: next N-chunk, else next weight,
+                // else chunk 0 of the next M-chunk, else chunk 0 of the next call
+                int next_w = w, next_i = i + 1;
+                if (next_i == n_chunk_cnt) {
+                    next_i = 0;
+                    if (++next_w == n_w) {
+                        next_w = last_m_chunk ? -1 : 0;
+                    }
+                }
+                if (next_w >= 0) {
+                    const size_t nc_next = (size_t) next_i * n_chunk_n_cols;
+                    const size_t n_cols_next = hex_smin((size_t) n - nc_next, n_chunk_n_cols);
+                    dma_queue_push(weight_dma, dma_make_data(vtcm_raw_bufs[(item + 1) % 2], weights[next_w] + nc_next * weight_stride),
+                                   dma_dst_stride, dma_src_stride, dma_width_bytes, HMX_MMID_DMA_HEIGHT(n_cols_next));
+                } else if (pf && next && next->weight && dequant_worker_fn) {
+                    // the raw buffer stays free until the next call; that call's layout starts with its weight area too
+                    const int next_m_padded = hex_align_up(next->m_core > 0 ? next->m_core : 1, 32);
+                    size_t mc2 = 0, nc2 = 0, used2 = 0;
+                    if (hmx_mm_id_plan(vtcm_budget, weight_type, k, n, aligned_tile_size, next_m_padded,
+                                       &mc2, &nc2, &used2) == 0) {
+                        const uint32_t h2 = HMX_MMID_DMA_HEIGHT(hex_smin((size_t) n, nc2));
+                        if ((size_t) h2 * dma_dst_stride <= weight_area_size) {
+                            dma_queue_push(weight_dma, dma_make_data(vtcm_raw_bufs[0], next->weight),
+                                           dma_dst_stride, dma_src_stride, dma_width_bytes, h2);
+                            pf->src     = next->weight;
+                            pf->height  = h2;
+                            pf->pending = true;
+                        }
+                    }
+                }
+
+                // C: HMX Compute (Queue-based)
+                hmx_matmul_job_init(&job, vtcm_output, vtcm_f16_act, (__fp16 *) vtcm_weight_bufs[item % 2], vtcm_scales, n_row_tiles, n_col_tiles, k / HTP_MM_HMX_TILE_N_ROWS);
+                hmx_queue_push(ctx->hmx_queue, hmx_queue_make_desc(hmx_matmul_worker_fn, &job));
+                hmx_queue_pop(ctx->hmx_queue);
+
+                // D: Output Store
+                transfer_output_chunk_scattered_threaded(
+                    ctx, dsts[w] + nc, vtcm_output, (int) mr, (int) n_rows, (int) n_cols,
+                    matrix_rows, cur_a, mapping_stride, dst_nb1s[w], dst_nb2s[w], cne1, n_threads, aligned_out,
+                    w == combine_w ? HMX_MMID_SCATTER_SWIGLU_COMBINE : 0);
+            }
+        }
+    }
+
+#undef HMX_MMID_DMA_HEIGHT
+
+    return 0;
+}
+
+// --- Streamed expert kernel (single device) ---
+//
+// One flat item stream over the whole op: (expert, M-chunk, weight, N-chunk). Two raw weight buffers, two
+// fp16 weight buffers, two activation buffers and two output buffers, with async HMX:
+//   item j: wait DMA(j) -> pop HMX(j - 2) -> one HVX step [scatter(j - 2) | gather of a new expert / M-chunk |
+//           dequant(j)] -> DMA(j + 2) into the raw buffer just freed -> push HMX(j)
+// HMX always has the previous item queued while HVX runs the step, across expert boundaries.
+// Arithmetic is unchanged: every output tile is still one HMX job over the full k with the same dequant.
+
+// experts with rows, in order
+struct hmx_mmid_pos {
+    const uint32_t * row_counts;
+    uint32_t         n_as;
+    uint32_t         next_a;  // next expert to examine
+    bool             valid;
+    int              a;       // current expert
+    int              cne1;    // its rows
+    int              m_end;   // its rows padded to 32
+    int              mr;      // current M-chunk start
+    int              w;       // current weight
+    int              i;       // current N-chunk
+};
+
+static inline void hmx_mmid_pos_next_expert(struct hmx_mmid_pos * p) {
+    p->valid = false;
+    while (p->next_a < p->n_as) {
+        const uint32_t a = p->next_a++;
+        const uint32_t c = p->row_counts[a];
+        if (c > 0) {
+            p->valid = true;
+            p->a     = (int) a;
+            p->cne1  = (int) c;
+            p->m_end = hex_align_up((int) c, 32);
+            break;
+        }
+    }
+    p->mr = 0;
+    p->w  = 0;
+    p->i  = 0;
+}
+
+static inline void hmx_mmid_pos_init(struct hmx_mmid_pos * p, const uint32_t * row_counts, uint32_t n_as) {
+    p->row_counts = row_counts;
+    p->n_as       = n_as;
+    p->next_a     = 0;
+    hmx_mmid_pos_next_expert(p);
+}
+
+static inline void hmx_mmid_pos_advance(struct hmx_mmid_pos * p, int n_w, int n_chunk_cnt, int m_chunk) {
+    if (++p->i < n_chunk_cnt) return;
+    p->i = 0;
+    if (++p->w < n_w) return;
+    p->w = 0;
+    p->mr += m_chunk;
+    if (p->mr < p->m_end) return;
+    hmx_mmid_pos_next_expert(p);
+}
+
+// next M-chunk (segment) after the one p points at (p at the start of a segment)
+static inline void hmx_mmid_pos_next_seg(struct hmx_mmid_pos * p, int m_chunk) {
+    p->w = 0;
+    p->i = 0;
+    p->mr += m_chunk;
+    if (p->mr < p->m_end) return;
+    hmx_mmid_pos_next_expert(p);
+}
+
+#define HMX_MMID_TILED_MAX_AS 128
+
+// streamed expert kernel pipeline depth (HTP_OPFLAG_MMID_DEPTH): fp16 weight / output buffers
+#define HMX_MMID_DEPTH_MAX     4
+#define HMX_MMID_DEPTH_DEFAULT 2
+#define HMX_MMID_BAG_MAX_ROWS  224  // rows in flight per thread (DMA ring of 256 descriptors)
+#define HMX_MMID_BAG_MAX_BLK   (HMX_MMID_BAG_MAX_ROWS / 32)
+#define HMX_MMID_BAG_DELAY     2    // steps between a block's push and its conversion
+
+// HTP_MMID_STREAM_ACT_TILED layout: first row of every expert (offs[a], a < n_as). Returns false when the layout plus
+// the flag word does not fit into the tensor (bytes) or the op does not qualify; producer and consumer see the same
+// counts, so they always agree.
+static bool hmx_mmid_tiled_layout(const uint32_t * row_counts, uint32_t n_as, uint32_t k, size_t bytes, uint32_t * offs) {
+    if (n_as > HMX_MMID_TILED_MAX_AS || k % 64 != 0 || bytes < HMX_MMID_TILED_FLAG_BYTES) return false;
+    uint64_t rows = 0;
+    for (uint32_t a = 0; a < n_as; ++a) {
+        offs[a] = (uint32_t) rows;
+        rows += (row_counts[a] + 31) & ~31u;
+    }
+    return rows * k * sizeof(__fp16) <= bytes - HMX_MMID_TILED_FLAG_BYTES;
+}
+
+static inline volatile uint32_t * hmx_mmid_tiled_flag(uint64_t data, size_t bytes) {
+    return (volatile uint32_t *) ((uint8_t *) (uintptr_t) data + bytes - HMX_MMID_TILED_FLAG_BYTES);
+}
+
+// The gather threads write whole 32-row tiles from their first row on, so the last ones can write up to 31 rows
+// past the M-chunk. The synchronous kernel lets that spill into its idle output area; here the next buffer is
+// live (the other activation buffer or a pending output), so each activation buffer gets one spare tile row.
+#define HMX_MMID_ACT_SLACK_ROWS 32
+
+// nd: fp16 weight / output buffers (pipeline depth: HMX jobs queued while HVX runs a step = nd - 1)
+// INVARIANT: non-decreasing in mc (every term is align_up of a non-decreasing function of mc). The fast M-chunk search
+// of hmx_mmid_stream_plan (GGML_HEXAGON_MMID_PLAN_FAST) steps up from an estimate and relies on this to find the same
+// largest fitting mc as the v1 loop; a layout term that shrinks with mc would change plans only with PLAN_FAST=1.
+static inline size_t hmx_mmid_stream_vtcm_size(size_t mc, size_t nc, size_t w_col_bytes, size_t vec_dot_size, size_t fixed,
+                                               size_t nd) {
+    return fixed + 2 * hex_align_up(nc * w_col_bytes, HTP_MM_HMX_TILE_SIZE) +
+           nd * hex_align_up(nc * vec_dot_size, HTP_MM_HMX_TILE_SIZE) +
+           2 * hex_align_up((mc + HMX_MMID_ACT_SLACK_ROWS) * vec_dot_size, HTP_MM_HMX_TILE_SIZE) +
+           nd * hex_align_up(mc * nc * sizeof(__fp16), HTP_MM_HMX_TILE_SIZE) + 256;
+}
+
+// (M-chunk, N-chunk) for the whole op. HVX dequant is the bottleneck, so the estimate counts dequant work
+// (repeated for every M-chunk of an expert) plus a fixed cost per item (thread dispatch, HMX job).
+static uint32_t g_mmid_opt      = 0;  // htp_mm_kernel_params.mmid_opt of the MUL_MAT_ID(_NX) op being processed
+static uint32_t g_mmid_plan_ovr = 0;  // diagnostic plan override: bits 0-7 mc tiles, bits 8-15 nc tiles (0 = planner)
+static uint64_t g_mmid_item_ps  = 10000000;  // planner cost per item (ps)
+
+static int hmx_mmid_stream_plan(size_t budget, const uint32_t * row_counts, uint32_t n_as, int n_w, int k, int n,
+                                int nc_step, size_t w_col_bytes, size_t vec_dot_size, size_t fixed, size_t nd,
+                                size_t * mc_out, size_t * nc_out, size_t * used_out) {
+    int max_m = 0;
+    for (uint32_t a = 0; a < n_as; ++a) {
+        max_m = hex_smax(max_m, (int) row_counts[a]);
+    }
+    if (max_m == 0) return -1;
+    max_m = hex_align_up(max_m, 32);
+
+    const uint64_t dq_ps_per_elem = 22;        // ~2.2e-5 us per weight element (v73, Q4_0)
+    const uint64_t item_ps        = g_mmid_item_ps;  // ~10 us per item
+
+    uint64_t best_cost = UINT64_MAX;
+    size_t   best_mc = 0, best_nc = 0, best_used = 0;
+    uint32_t memo_mt = 0, memo_m_chunks = 0;
+    // HTP_MMID_OPT_PLAN_V1 clear (GGML_HEXAGON_MMID_PLAN_FAST, default): the M-chunk count of an M-chunk size mt (sum over the
+    // experts of ceil(t_a / mt), t_a = row tiles of expert a) from a histogram of the t_a, memoized per mt, and each
+    // candidate's M-chunk size from a linear estimate instead of 32-row steps down from the largest expert. Same plan;
+    // the v1 loops cost 65-110 us per op on v73 (~3000 software divisions and ~1000 layout sizes for LFM2.5 at 4096 tokens).
+    const bool fast = !(g_mmid_opt & HTP_MMID_OPT_PLAN_V1);
+    // scratch in .bss, not on the stack: the planner runs inside hmx_mmid_stream (large locals) on the main op thread,
+    // whose stack is small; ops run one at a time, so one static copy suffices (~1.6 KB)
+    enum { HMX_MMID_PLAN_MAX_T = 160 };
+    static uint16_t t_val[HMX_MMID_PLAN_MAX_T], t_cnt[HMX_MMID_PLAN_MAX_T];
+    static uint32_t mc_memo[HMX_MMID_PLAN_MAX_T + 1];
+    static uint16_t hist[HMX_MMID_PLAN_MAX_T + 1];
+    uint32_t n_tv = 0;
+    const bool use_hist = fast && (uint32_t) max_m / 32 <= HMX_MMID_PLAN_MAX_T;
+    if (use_hist) {
+        memset(hist, 0, sizeof(hist));
+        for (uint32_t a = 0; a < n_as; ++a) {
+            hist[(row_counts[a] + 31) / 32]++;  // <= max_m / 32
+        }
+        for (uint32_t t = 1; t <= HMX_MMID_PLAN_MAX_T; ++t) {
+            if (hist[t]) {
+                t_val[n_tv] = (uint16_t) t;
+                t_cnt[n_tv] = hist[t];
+                ++n_tv;
+            }
+        }
+        memset(mc_memo, 0xff, sizeof(mc_memo));
+    }
+    const int mc_ovr = (int) (g_mmid_plan_ovr & 0xff) * 32;
+    // N-chunk override: rounded up to a multiple of nc_step and capped at the largest candidate, so it always names a
+    // candidate (an override that matched none would make the op fall back to the per-expert kernel)
+    int nc_ovr = (int) ((g_mmid_plan_ovr >> 8) & 0xff) * 32;
+    if (nc_ovr) {
+        nc_ovr = (int) hex_smin((size_t) ((nc_ovr + nc_step - 1) / nc_step * nc_step), (size_t) (n - n % nc_step));
+    }
+    for (int nc = n - n % nc_step; nc >= nc_step; nc -= nc_step) {
+        if (nc_ovr && nc != nc_ovr) continue;
+        size_t mc = hex_align_down((size_t) (mc_ovr && mc_ovr < max_m ? mc_ovr : max_m), 32);
+        if (fast && mc >= 32) {
+            // the largest multiple of 32 <= mc whose layout fits (needs hmx_mmid_stream_vtcm_size non-decreasing in mc, see
+            // its INVARIANT): from the linear estimate, then
+            // the same steps as the v1 loop (up while the next size fits, down below while it does not)
+            const size_t mc_top = mc;
+            const size_t base   = hmx_mmid_stream_vtcm_size(0, nc, w_col_bytes, vec_dot_size, fixed, nd);
+            const size_t per32  = hmx_mmid_stream_vtcm_size(32, nc, w_col_bytes, vec_dot_size, fixed, nd) - base;
+            size_t est = (budget > base && per32 > 0) ? (budget - base) / per32 * 32 : 0;
+            if (est > mc_top) est = mc_top;
+            mc = est;
+            while (mc + 32 <= mc_top && hmx_mmid_stream_vtcm_size(mc + 32, nc, w_col_bytes, vec_dot_size, fixed, nd) <= budget) {
+                mc += 32;
+            }
+        }
+        while (mc >= 32 && hmx_mmid_stream_vtcm_size(mc, nc, w_col_bytes, vec_dot_size, fixed, nd) > budget) {
+            mc -= 32;
+        }
+        if (mc < 32) continue;
+
+        // M-chunks over all experts in 32-row tiles (32-bit divisions only; the per-item factor is the same
+        // for every expert)
+        const uint32_t mt = (uint32_t) (mc / 32);
+        if (use_hist && mt <= HMX_MMID_PLAN_MAX_T) {
+            if (mc_memo[mt] == 0xffffffffu) {
+                uint32_t m_chunks = 0;
+                for (uint32_t v = 0; v < n_tv; ++v) {
+                    m_chunks += (uint32_t) t_cnt[v] * ((t_val[v] + mt - 1) / mt);
+                }
+                mc_memo[mt] = m_chunks;
+            }
+            memo_mt       = mt;
+            memo_m_chunks = mc_memo[mt];
+        }
+        if (mt != memo_mt) {  // most N-chunk candidates share an M-chunk size: count its M-chunks once
+            uint32_t m_chunks = 0;
+#pragma clang loop vectorize(disable) unroll(disable)
+            for (uint32_t a = 0; a < n_as; ++a) {
+                const uint32_t t = (row_counts[a] + 31) / 32;
+                m_chunks += (t + mt - 1) / mt;
+            }
+            memo_mt       = mt;
+            memo_m_chunks = m_chunks;
+        }
+        const uint32_t m_chunks = memo_m_chunks;
+        const uint32_t n_chunks = (uint32_t) (n + nc - 1) / (uint32_t) nc;
+        const uint64_t cost = (uint64_t) m_chunks * (uint64_t) n_w * ((uint64_t) n * k * dq_ps_per_elem + (uint64_t) n_chunks * item_ps);
+        if (cost < best_cost || (cost == best_cost && mc * nc > best_mc * best_nc)) {
+            best_cost = cost;
+            best_mc   = mc;
+            best_nc   = nc;
+            best_used = hmx_mmid_stream_vtcm_size(mc, nc, w_col_bytes, vec_dot_size, fixed, nd);
+        }
+    }
+    if (best_mc == 0) return -1;
+    *mc_out   = best_mc;
+    *nc_out   = best_nc;
+    *used_out = best_used;
+    return 0;
+}
+
+// HVX work of one pipeline step of the streamed expert kernel as one shared task list (one fork-join per item):
+// scatter of an older item, gather of a new expert / M-chunk and dequant of the next item. Tasks are taken
+// dynamically and interleaved by type, so memory-bound (gather, scatter) and VTCM-bound (dequant) tasks run
+// on different HVX threads at the same time.
+enum { HMX_MMID_T_GATHER = 0, HMX_MMID_T_SCATTER = 1, HMX_MMID_T_DEQUANT = 2 };
+
+#define HMX_MMID_MAX_TASKS 96
+#define HMX_MMID_DMA_PAIRS 4   // row pairs in flight per thread in the DMA gather
+#define HMX_MMID_MAX_G     24  // gather tasks: multiples of 32 rows (the tile padding stays inside the task)
+#define HMX_MMID_MAX_S     32  // scatter tasks: multiples of 16 rows
+#define HMX_MMID_MAX_D     32  // dequant tasks
+
+typedef struct {
+    struct htp_thread_trace       * traces;
+    atomic_uint                     next;
+    uint32_t                        n_tasks;
+    uint8_t                         type[HMX_MMID_MAX_TASKS];
+    uint8_t                         idx[HMX_MMID_MAX_TASKS];
+
+    // gather tasks of the DMA threads (1..n-1): own counter; thread 0 keeps its DMA queue for the weights
+    struct htp_context            * ctx;
+    atomic_uint                     g_next;
+    uint32_t                        n_g_dma;
+    float                         * dma_ring;        // per thread (index i - 1): 2 * HMX_MMID_DMA_PAIRS rows of k
+    bool                            act_f16;         // HTP_MMID_STREAM_ACT_F16: fp16 activation rows
+    size_t                          dma_ring_floats;
+
+    const struct mmid_row_mapping * matrix_rows;
+    uint32_t                        mapping_stride;
+
+    // gather: rows [g_mr, g_mr + g_n_rows) of expert g_a into g_dst
+    __fp16                        * g_dst;
+    const float                   * g_src;
+    uint32_t                        g_a, g_cne1, g_mr, g_n_rows, g_task_rows, k, k_valid, ne11;
+    struct fastdiv_values           ne11_div;
+    size_t                          nb11, nb12;
+
+    // scatter: rows [s_mr, s_mr + s_n_rows) of expert s_a from s_src
+    float                         * s_dst;
+    const __fp16                  * s_src;
+    uint32_t                        s_a, s_cne1, s_mr, s_n_rows, s_task_rows, s_n_cols;
+    size_t                          s_nb1, s_nb2;
+    bool                            s_aligned;  // HTP_MMID_STREAM_ALIGNED_OUT
+    uint32_t                        s_swiglu;   // paired gate/up SWIGLU scatter mode (0 = plain)
+    __fp16                        * s_tiled;    // HTP_MMID_STREAM_ACT_TILED producer: tile row 0 of this M-chunk (NULL = scatter)
+    uint32_t                        s_col_tile0, s_k_tiles;
+
+    // HTP_MMID_STREAM_ACT_TILED consumer: one block DMA per M-chunk on thread 1's queue
+    bool                            ab_pop;     // wait for the block DMA pushed in an earlier step
+    bool                            ab_sync;    // push + wait now (ab_sync_*)
+    bool                            ab_push;    // push now, wait in a later step (ab_push_*)
+    void                          * ab_sync_dst;
+    const void                    * ab_sync_src;
+    void                          * ab_push_dst;
+    const void                    * ab_push_src;
+    uint32_t                        ab_sync_bytes, ab_push_bytes;
+
+    // HTP_OPFLAG_MMID_BAG: bulk async gather of segment (bag_a, bag_mr, bag_rows) into bag_dst on threads 1..n-1 (own
+    // DMA queues), in 32-row blocks b = i - 1, i - 1 + bag_nw, ...: bag_np[i] blocks pushed, bag_nc[i] converted
+    uint32_t                        bag_nw;
+    bool                            bag_fin;    // first step of the segment: push, wait for and convert all the rest
+    bool                            bag_inc;    // a step of the segment before (after the tasks): push all blocks in
+                                                // the first one, then convert one block per step, HMX_MMID_BAG_DELAY
+                                                // steps after its push
+    uint32_t                        bag_step;
+    __fp16                        * bag_dst;
+    uint32_t                        bag_a, bag_mr, bag_rows;
+    uint8_t                         bag_np[HTP_MAX_NTHREADS], bag_nc[HTP_MAX_NTHREADS];
+    uint32_t                        bag_ps[HTP_MAX_NTHREADS][HMX_MMID_BAG_MAX_BLK];
+
+    // scatter first: the first scat_first tasks of the list are the scatter tasks; the gather threads wait for s_done == scat_first
+    uint32_t                        scat_first;
+    atomic_uint                     s_done;
+
+    // dequant
+    tiled_dequantize_state_t        dq;
+} hmx_mmid_hvx_step_t;
+
+// Gather of `rows` activation rows (fp32, DDR) into fp16 HMX tiles through this thread's DMA queue: the rows
+// are fetched HMX_MMID_DMA_PAIRS pairs ahead into a VTCM ring, so HVX converts from VTCM instead of waiting on
+// DDR loads. Same conversion and tile layout as transfer_activation_chunk_fp32_to_fp16_gathered(_flat); the
+// padding rows of the last tile are left as they are (their HMX output rows are never stored).
+static void hmx_mmid_gather_dma(dma_queue * q, float * ring, __fp16 * vtcm_dst, const float * src,
+                                uint32_t start_row, uint32_t vtcm_start_row, uint32_t rows, uint32_t k_block,
+                                const struct mmid_row_mapping * matrix_rows, uint32_t cur_a, uint32_t mapping_stride,
+                                uint32_t ne11, const struct fastdiv_values * ne11_div, size_t nb11, size_t nb12,
+                                uint32_t k_valid, bool act_f16) {
+    const struct mmid_row_mapping * map = matrix_rows + (size_t) cur_a * mapping_stride + start_row;
+    const uint32_t n_pairs   = (rows + 1) / 2;
+    const size_t   row_bytes = (size_t) k_valid * (act_f16 ? sizeof(__fp16) : sizeof(float));
+
+#define HMX_MMID_ROW_SRC(r) ((dma_addr_t) ((const uint8_t *) src + \
+        (ne11 > 1 ? fastmodulo(map[(r)].i1, ne11, ne11_div) : 0) * nb11 + (size_t) map[(r)].i2 * nb12))
+#define HMX_MMID_PUSH_PAIR(pp) do {                                                                      \
+        float * d0 = ring + (size_t) (2 * ((pp) % HMX_MMID_DMA_PAIRS)) * k_block;                        \
+        dma_queue_push(q, dma_make_data(d0, HMX_MMID_ROW_SRC(2 * (pp))), row_bytes, row_bytes, row_bytes, 1); \
+        if (2 * (pp) + 1 < rows) {                                                                       \
+            dma_queue_push(q, dma_make_data(d0 + k_block, HMX_MMID_ROW_SRC(2 * (pp) + 1)),               \
+                           row_bytes, row_bytes, row_bytes, 1);                                           \
+        }                                                                                                \
+    } while (0)
+
+    uint32_t pushed = 0;
+    for (; pushed < n_pairs && pushed < HMX_MMID_DMA_PAIRS; ++pushed) {
+        HMX_MMID_PUSH_PAIR(pushed);
+    }
+
+    for (uint32_t p = 0; p < n_pairs; ++p) {
+        const bool has1 = (2 * p + 1 < rows);
+        dma_queue_pop(q);
+        if (has1) dma_queue_pop(q);
+
+        const float * row0 = ring + (size_t) (2 * (p % HMX_MMID_DMA_PAIRS)) * k_block;
+        const float * row1 = row0 + k_block;
+
+        const uint32_t lr = vtcm_start_row + 2 * p;          // vtcm-local row
+        const uint32_t r0 = lr / HTP_MM_HMX_TILE_N_ROWS;     // tile row index
+        const uint32_t r1 = lr % HTP_MM_HMX_TILE_N_ROWS;     // intra-tile row idx
+        HVX_Vector * tile_row = (HVX_Vector *) (vtcm_dst + (size_t) r0 * (k_block / HTP_MM_HMX_TILE_N_COLS) * HTP_MM_HMX_TILE_N_ELMS);
+
+        if (act_f16) {
+            // fp16 rows (k_valid == k_block, a multiple of 64): interleave the row pair into two column tiles
+            const size_t tv = HTP_MM_HMX_TILE_N_ELMS * sizeof(__fp16) / VLEN;  // vectors per tile
+            const HVX_Vector * h0 = (const HVX_Vector *) row0;
+            const HVX_Vector * h1 = (const HVX_Vector *) row1;
+            for (uint32_t c = 0; c < k_block; c += 64) {
+                const HVX_Vector     v0 = h0[c / 64];
+                const HVX_Vector     v1 = has1 ? h1[c / 64] : Q6_V_vzero();
+                const HVX_VectorPair vp = Q6_W_vshuff_VVR(v1, v0, -2);
+                tile_row[(c / HTP_MM_HMX_TILE_N_COLS) * tv + r1 / 2]       = Q6_V_lo_W(vp);
+                tile_row[(c / HTP_MM_HMX_TILE_N_COLS + 1) * tv + r1 / 2]   = Q6_V_hi_W(vp);
+            }
+            if (pushed < n_pairs) {  // into the slot just converted
+                HMX_MMID_PUSH_PAIR(pushed);
+                ++pushed;
+            }
+            continue;
+        }
+
+        uint32_t c = 0;
+        for (; c + 32 <= k_valid; c += 32) {
+            HVX_Vector v0 = *(const HVX_Vector *) (row0 + c);
+            HVX_Vector v1 = has1 ? *(const HVX_Vector *) (row1 + c) : Q6_V_vzero();
+            tile_row[(c / HTP_MM_HMX_TILE_N_COLS) * (HTP_MM_HMX_TILE_N_ELMS * sizeof(__fp16) / VLEN) + r1 / 2] =
+                hvx_vec_f32_to_f16_shuff(v0, v1);
+        }
+        if (c < k_block) {
+            HVX_Vector v0 = *(const HVX_Vector *) (row0 + c);
+            HVX_Vector v1 = has1 ? *(const HVX_Vector *) (row1 + c) : Q6_V_vzero();
+            uint32_t rem = k_valid - c;
+            HVX_VectorPred mask = Q6_Q_vsetq2_R(rem > 0 ? rem * sizeof(float) : 0);
+            v0 = Q6_V_vmux_QVV(mask, v0, Q6_V_vzero());
+            v1 = Q6_V_vmux_QVV(mask, v1, Q6_V_vzero());
+            tile_row[(c / HTP_MM_HMX_TILE_N_COLS) * (HTP_MM_HMX_TILE_N_ELMS * sizeof(__fp16) / VLEN) + r1 / 2] =
+                hvx_vec_f32_to_f16_shuff(v0, v1);
+        }
+
+        if (pushed < n_pairs) {  // into the slot just converted
+            HMX_MMID_PUSH_PAIR(pushed);
+            ++pushed;
+        }
+    }
+#undef HMX_MMID_PUSH_PAIR
+#undef HMX_MMID_ROW_SRC
+}
+
+// HTP_OPFLAG_MMID_BAG (bulk async gather of fp16 activation rows): each row is one 2D DMA that drops its 128-byte
+// column chunks straight into their tile pair (chunk j of row 2v + e -> vector v of tile 2j + e of its 32-row tile
+// row), so the rows of a whole segment can be in flight at once, long before they are needed. hmx_mmid_bag_cvt_blk then
+// interleaves each vector pair in place into the HMX layout (the vectors hmx_mmid_gather_dma writes from the same
+// row pair). Rows [0, rows) of the segment, 32-row blocks b = i - 1, i - 1 + nw, ... on thread i.
+static void hmx_mmid_bag_push_blk(dma_queue * q, __fp16 * vtcm_dst, const __fp16 * src, uint32_t start_row,
+                                  uint32_t b, uint32_t rows, uint32_t k,
+                                  const struct mmid_row_mapping * matrix_rows, uint32_t cur_a, uint32_t mapping_stride,
+                                  uint32_t ne11, const struct fastdiv_values * ne11_div, size_t nb11, size_t nb12) {
+    const struct mmid_row_mapping * map = matrix_rows + (size_t) cur_a * mapping_stride + start_row;
+    const uint32_t tsz   = HTP_MM_HMX_TILE_N_ELMS * sizeof(__fp16);
+    const uint32_t r_end = hex_smin(rows, (b + 1) * HTP_MM_HMX_TILE_N_ROWS);
+    for (uint32_t r = b * HTP_MM_HMX_TILE_N_ROWS; r < r_end; ++r) {
+        const dma_addr_t s = (dma_addr_t) ((const uint8_t *) src +
+            (ne11 > 1 ? fastmodulo(map[r].i1, ne11, ne11_div) : 0) * nb11 + (size_t) map[r].i2 * nb12);
+        // 128-byte chunk j (columns 64j..64j+63) of row 2v + e -> vector v of tile 2j + e
+        const uint32_t rr = r % HTP_MM_HMX_TILE_N_ROWS;
+        __fp16 * d = vtcm_dst + (size_t) b * HTP_MM_HMX_TILE_N_ROWS * k + (size_t) (rr & 1) * HTP_MM_HMX_TILE_N_ELMS +
+                     (size_t) (rr / 2) * (VLEN / sizeof(__fp16));
+        if (__builtin_expect(!dma_queue_push(q, dma_make_data(d, s), 2 * tsz, VLEN, VLEN, k / 64), 0)) {
+            // ring full (the planner keeps a thread's rows in flight below its capacity, so only if something else
+            // shares this queue): wait for the oldest descriptor and retry. Pops are FIFO, so hmx_mmid_bag_cvt_blk's
+            // per-row pops then only wait for later rows (a pop on an empty ring returns at once): never a lost row.
+            FARF(HIGH, "hmx-mmid-bag: DMA ring full (depth %u), row %u", (unsigned) dma_queue_depth(q), (unsigned) r);
+            dma_queue_pop(q);
+            const bool ok = dma_queue_push(q, dma_make_data(d, s), 2 * tsz, VLEN, VLEN, k / 64);
+            assert(ok);
+            (void) ok;
+        }
+    }
+}
+
+// waits for block b's row DMAs (the oldest on this queue) and interleaves its row pairs in place
+static void hmx_mmid_bag_cvt_blk(dma_queue * q, __fp16 * vtcm_dst, uint32_t b, uint32_t rows, uint32_t k) {
+    const size_t   tv    = HTP_MM_HMX_TILE_N_ELMS * sizeof(__fp16) / VLEN;  // vectors per tile
+    const uint32_t nb    = hex_smin(rows - b * HTP_MM_HMX_TILE_N_ROWS, HTP_MM_HMX_TILE_N_ROWS);  // rows in block
+    for (uint32_t r = 0; r < nb; ++r) dma_queue_pop(q);
+    const uint32_t pairs = (nb + 1) / 2;
+    HVX_Vector *   blk   = (HVX_Vector *) (vtcm_dst + (size_t) b * HTP_MM_HMX_TILE_N_ROWS * k);
+    for (uint32_t c = 0; c < k / 32; c += 2) {
+        HVX_Vector * t0 = blk + c * tv;        // row 2v, columns 32c..32c+63
+        HVX_Vector * t1 = t0 + tv;             // row 2v + 1, same columns
+        for (uint32_t v = 0; v < pairs; ++v) {
+            const HVX_Vector     x  = t0[v];
+            const HVX_Vector     y  = (2 * v + 1 < nb) ? t1[v] : Q6_V_vzero();
+            const HVX_VectorPair vp = Q6_W_vshuff_VVR(y, x, -2);
+            t0[v] = Q6_V_lo_W(vp);
+            t1[v] = Q6_V_hi_W(vp);
+        }
+    }
+}
+
+// contiguous DDR -> VTCM block (sizes multiples of 4 KB) as one 2D descriptor
+static inline void hmx_mmid_block_dma_push(dma_queue * q, void * dst, const void * src, uint32_t bytes) {
+    const uint32_t row = 4096;
+    dma_queue_push(q, dma_make_data(dst, src), row, row, row, bytes / row);
+}
+
+// scatter task j of a step (rows [j * s_task_rows, ...) of the older item)
+static void hmx_mmid_step_scatter(hmx_mmid_hvx_step_t * st, struct htp_thread_trace * tr, uint32_t j) {
+    const uint32_t r0 = j * st->s_task_rows;
+    int rows = (int) st->s_n_rows - (int) r0;
+    if (rows > (int) st->s_task_rows) rows = (int) st->s_task_rows;
+    if (rows <= 0 || st->s_mr + r0 >= st->s_cne1) return;
+    htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_O_PROC, j);
+    if (st->s_tiled) {
+        // valid rows only (the pair holding the last one is written whole)
+        const uint32_t valid = st->s_cne1 - (st->s_mr + r0);
+        transfer_output_chunk_tiled_swiglu_pair(
+            st->s_tiled, st->s_src, r0, (uint32_t) rows < valid ? (uint32_t) rows : valid,
+            st->s_n_cols, st->s_col_tile0, st->s_k_tiles, st->s_swiglu, (g_mmid_opt & HTP_MMID_OPT_SCAT_V1) != 0);
+    } else if (st->s_swiglu == HMX_MMID_SCATTER_F16) {
+        transfer_output_chunk_f16_scattered(
+            (__fp16 *) st->s_dst, st->s_src, st->s_mr + r0, r0, (uint32_t) rows, st->s_n_cols,
+            st->matrix_rows, st->s_a, st->mapping_stride, st->s_nb1, st->s_nb2, st->s_cne1,
+            st->s_aligned);
+    } else if (st->s_swiglu) {
+        transfer_output_chunk_scattered_swiglu_pair(
+            st->s_dst, st->s_src, st->s_mr + r0, r0, (uint32_t) rows, st->s_n_cols,
+            st->matrix_rows, st->s_a, st->mapping_stride, st->s_nb1, st->s_nb2, st->s_cne1,
+            st->s_aligned, st->s_swiglu);
+    } else {
+        transfer_output_chunk_fp16_to_fp32_scattered(
+            st->s_dst, st->s_src, st->s_mr + r0, r0, (uint32_t) rows, st->s_n_cols,
+            st->matrix_rows, st->s_a, st->mapping_stride, st->s_nb1, st->s_nb2, st->s_cne1,
+            st->s_aligned);
+    }
+    htp_trace_event_stop(tr, HTP_TRACE_EVT_HVX_O_PROC, j);
+}
