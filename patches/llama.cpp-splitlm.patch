+        free(fa_kpre_buf);
+        fa_kpre_buf  = (uint8_t *) memalign(128, bytes);
+        fa_kpre_size = fa_kpre_buf ? bytes : 0;
+        if (fa_kpre_buf) {
+            // only the DMA touches this buffer from now on: no cache line of it may be written back over the DMA's data
