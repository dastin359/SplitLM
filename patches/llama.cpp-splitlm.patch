+        const int64_t bn = std::min(b1 + FA_DEC_BKV, ic_end); // end of the next block, for prefetch
+
+        // unmasked positions of this block (the mask is shared by all heads)
+        int n = 0;
+        for (int64_t ic = b0; ic < b1; ic++) {
+            const float mv = mp ? GGML_CPU_FP16_TO_FP32(mp[ic]) : 0.0f;
+            if (mv == -INFINITY) {
