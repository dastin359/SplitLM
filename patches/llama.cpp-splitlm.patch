+        if (m == nullptr) {
+            return;
+        }
+        const int64_t n_kv = m->ne[0], n_q = m->ne[1];
+        std::mt19937 gen(0xC0DE);
+        std::uniform_real_distribution<float> dis(-1.0f, 1.0f);
+        std::vector<float>       data_f32(ggml_nelements(m));
