+        for (uint32_t v = 1; v < nvec; v++) {
+            acc = Q6_Vqf32_vadd_Vqf32Vqf32(acc, Q6_Vqf32_vmpy_VsfVsf(x[v], x[v]));
+        }
+        s[r] = acc;
+    }
