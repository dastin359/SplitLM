+                }
+            } else {
+                for (size_t c0 = 0; c0 < nt; ++c0) {
+                    const HVX_Vector     y  = hvx_vec_swiglu_hf_h16(tsrc[c0 * tstep], tsrc[c0 * tstep + up_v], &hc);
+                    const HVX_VectorPair yp = Q6_Wqf32_vmpy_VhfVhf(y, one);
+                    hvx_vmemu(out0 + c0 * HTP_MM_HMX_TILE_N_COLS) = Q6_Vsf_equals_Vqf32(Q6_V_lo_W(yp));
+                    if (out1) {
+                        hvx_vmemu(out1 + c0 * HTP_MM_HMX_TILE_N_COLS) = Q6_Vsf_equals_Vqf32(Q6_V_hi_W(yp));
+                    }
+                }
+            }
+        } else if (mode == 2) {
+            if (aligned && out1) {
+                #pragma unroll(2)
+                for (size_t c0 = 0; c0 < nt; ++c0) {
+                    const HVX_VectorPair y = hvx_vec_swiglu_hf_qf32(tsrc[c0 * tstep], tsrc[c0 * tstep + up_v], one, &hc);
+                    ((HVX_Vector *) out0)[c0] = Q6_Vsf_equals_Vqf32(Q6_V_lo_W(y));
+                    ((HVX_Vector *) out1)[c0] = Q6_Vsf_equals_Vqf32(Q6_V_hi_W(y));
+                }
+            } else {
+                for (size_t c0 = 0; c0 < nt; ++c0) {
+                    const HVX_VectorPair y = hvx_vec_swiglu_hf_qf32(tsrc[c0 * tstep], tsrc[c0 * tstep + up_v], one, &hc);
+                    hvx_vmemu(out0 + c0 * HTP_MM_HMX_TILE_N_COLS) = Q6_Vsf_equals_Vqf32(Q6_V_lo_W(y));
+                    if (out1) {
+                        hvx_vmemu(out1 + c0 * HTP_MM_HMX_TILE_N_COLS) = Q6_Vsf_equals_Vqf32(Q6_V_hi_W(y));
+                    }
+                }
+            }
+        } else {
+            for (size_t c0 = 0; c0 < nt; ++c0) {
+                const HVX_VectorPair g = Q6_Wqf32_vmpy_VhfVhf(tsrc[c0 * tstep], one);
+                const HVX_VectorPair u = Q6_Wqf32_vmpy_VhfVhf(tsrc[c0 * tstep + up_v], one);
+                hvx_vmemu(out0 + c0 * HTP_MM_HMX_TILE_N_COLS) =
