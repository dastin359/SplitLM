+// row-major S (f32, src) -> tiled f32 W (w) and its fp16 weight tiles (w_tiles)
+// src_hi != NULL: rows >= 64 come from src_hi (the prefetched state arrives as two 64-row halves)
+static void gdn_v2_state_in2(float * restrict w, __fp16 * restrict w_tiles, const float * restrict src,
+                             const float * restrict src_hi, uint32_t S_v, HVX_Vector * restrict m, HVX_Vector * restrict tmp) {
+    const uint32_t n_sv = S_v / 32;
+    for (uint32_t ct = 0; ct < n_sv; ++ct) {
+        const float * sb = (src_hi && ct >= 2) ? src_hi + (ct - 2) * 32 * S_v : src + ct * 32 * S_v;
+        for (uint32_t dt = 0; dt < n_sv; ++dt) {
+            for (uint32_t i = 0; i < 32; ++i) {
+                m[i] = hvx_vmem(sb + i * S_v + dt * 32);
+            }
+            hvx_transpose_32x32_words(m, tmp);
+            const uint32_t T  = ct * n_sv + dt;
+            HVX_Vector *   wv = (HVX_Vector *) (w + T * 1024);
+            HVX_Vector *   ov = (HVX_Vector *) (w_tiles + T * HMX_FP16_TILE_N_ELMS);
+            for (uint32_t j = 0; j < 32; ++j) {
+                wv[j] = m[j];
+            }
+            for (uint32_t r = 0; r < 16; ++r) {
+                ov[r] = hvx_vec_f32_to_f16_shuff(m[2 * r], m[2 * r + 1]);
+            }
+        }
+    }
+}
