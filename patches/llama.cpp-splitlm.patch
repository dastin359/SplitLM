+            uint32_t mapping_stride,
+            size_t dst_nb1,
+            size_t dst_nb2,
+            uint32_t cne1) {
+    assert(n_cols % HTP_MM_HMX_TILE_N_COLS == 0);
+    const size_t nt              = n_cols / HTP_MM_HMX_TILE_N_COLS;
+    const size_t tile_row_stride = nt * HTP_MM_HMX_TILE_N_ELMS;
+    const size_t tstep           = HTP_MM_HMX_TILE_N_ELMS * sizeof(__fp16) / VLEN;  // vectors per tile
+
+    const HVX_Vector one = hvx_vec_splat_f16(1.0);
+    const struct hvx_sigmoid_qf32_consts sc = hvx_sigmoid_qf32_consts_init();
+
+    for (size_t r = 0; r < n_rows; r += 2) {
+        const uint32_t r_idx0 = start_row + r + 0;
+        const uint32_t r_idx1 = start_row + r + 1;
+        if (r_idx0 >= cne1) break;
+
+        const uint32_t lr = vtcm_start_row + r;
+        const size_t   r0 = (lr / HTP_MM_HMX_TILE_N_ROWS);
+        const size_t   r1 = (lr % HTP_MM_HMX_TILE_N_ROWS) / 2;
+        const HVX_Vector * tsrc = (const HVX_Vector *) (vtcm_src + r0 * tile_row_stride) + r1;
+
+        const struct mmid_row_mapping m0 = matrix_rows[cur_a * mapping_stride + r_idx0];
+        float * out0 = (float *) ((uint8_t *) dst + m0.i1 * dst_nb1 + m0.i2 * dst_nb2);
+        float * out1 = NULL;
+        if (r_idx1 < cne1) {
+            const struct mmid_row_mapping m1 = matrix_rows[cur_a * mapping_stride + r_idx1];
+            out1 = (float *) ((uint8_t *) dst + m1.i1 * dst_nb1 + m1.i2 * dst_nb2);
+        }
+
+        for (size_t c0 = 0; c0 < nt; ++c0) {
+            const HVX_VectorPair u = Q6_Wqf32_vmpy_VhfVhf(tsrc[c0 * tstep], one);
