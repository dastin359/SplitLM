+// (bit-identical). vals and probs are clobbered.
+static inline __attribute__((always_inline)) void topk_transpose32(HVX_Vector * t, uint32_t vstride) {
+    for (uint32_t m = 0; m < 5; ++m) {
+        for (uint32_t i = 0; i < 16; ++i) {
+            HVX_Vector * pa = t + (size_t) topk_rotr5(i, m) * vstride;
+            HVX_Vector * pb = t + (size_t) topk_rotr5(i + 16, m) * vstride;
+            HVX_VectorPair w = Q6_W_vshuff_VVR(*pb, *pa, -4);
+            *pa = Q6_V_lo_W(w);
+            *pb = Q6_V_hi_W(w);
+        }
+    }
+}
+
+// k vectors of 32 lanes (lane = row) -> k vectors holding [row][j] (log2(k) perfect-shuffle rounds)
+static inline __attribute__((always_inline)) void topk_rows_major(HVX_Vector * a, const uint32_t k) {
+    for (uint32_t h = k / 2; h >= 1; h /= 2) {
+        HVX_Vector n[TOPK_MAX_K];
+        for (uint32_t i = 0; i < k / 2; ++i) {
+            HVX_VectorPair w = Q6_W_vshuff_VVR(a[i + k / 2], a[i], -4);
+            n[2 * i]     = Q6_V_lo_W(w);
+            n[2 * i + 1] = Q6_V_hi_W(w);
+        }
+        for (uint32_t i = 0; i < k; ++i) {
+            a[i] = n[i];
+        }
+    }
+}
