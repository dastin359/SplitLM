+    c.r0     = hvx_vec_splat_f16((_Float16) 0.99970265f);
+    c.zero   = Q6_V_vzero();
+    return c;
+}
+
+// q = u / (1 + u), u = e^-a, for a = |x| (fp16, 64 lanes); sigmoid(x) = x > 0 ? 1 - q : q
+static inline HVX_Vector hvx_vec_silu_q_hf(HVX_Vector a, const struct hvx_silu_hf_consts * c) {
+    HVX_Vector t = Q6_Vhf_equals_Vqf16(Q6_Vqf16_vmpy_VhfVhf(a, c->nlog2e));   // t = -a log2 e <= 0
+    t            = Q6_Vhf_vmax_VhfVhf(t, c->tmin);
+
+    // t = k + f, k integer (round to nearest: t <= 0 truncates toward zero), f in [-0.5, 0.5]
+    const HVX_Vector k = Q6_Vh_equals_Vhf(Q6_Vhf_equals_Vqf16(Q6_Vqf16_vsub_VhfVhf(t, c->half)));
+    const HVX_Vector f = Q6_Vqf16_vsub_VhfVhf(t, Q6_Vhf_equals_Vh(k));
+
+    HVX_Vector p = Q6_Vqf16_vadd_Vqf16Vhf(Q6_Vqf16_vmpy_Vqf16Vhf(f, c->e3), c->e2);
+    p            = Q6_Vqf16_vadd_Vqf16Vhf(Q6_Vqf16_vmpy_Vqf16Vqf16(p, f), c->e1);
+    p            = Q6_Vqf16_vadd_Vqf16Vhf(Q6_Vqf16_vmpy_Vqf16Vqf16(p, f), c->e0);
+    HVX_Vector u = Q6_Vhf_equals_Vqf16(p);
+    u            = Q6_Vh_vaslacc_VhVhR(u, k, 10);  // * 2^k
+
+    HVX_Vector r = Q6_Vqf16_vadd_Vqf16Vhf(Q6_Vqf16_vmpy_VhfVhf(u, c->r4), c->r3);
+    r            = Q6_Vqf16_vadd_Vqf16Vhf(Q6_Vqf16_vmpy_Vqf16Vhf(r, u), c->r2);
+    r            = Q6_Vqf16_vadd_Vqf16Vhf(Q6_Vqf16_vmpy_Vqf16Vhf(r, u), c->r1);
+    r            = Q6_Vqf16_vadd_Vqf16Vhf(Q6_Vqf16_vmpy_Vqf16Vhf(r, u), c->r0);
+    const HVX_Vector q = Q6_Vhf_equals_Vqf16(Q6_Vqf16_vmpy_Vqf16Vhf(r, u));
+    // a >= 0, so the fp16 bit patterns compare like the values
+    return Q6_V_vmux_QVV(Q6_Q_vcmp_gt_VhVh(a, c->amax), c->zero, q);
+}
+
+static inline void hvx_vec_silu2_f32_hf(HVX_Vector x0, HVX_Vector x1, HVX_Vector * y0, HVX_Vector * y1,
+                                        const struct hvx_silu_hf_consts * c) {
+    // fp16 of x0/x1, lanes shuffled (Wqf32_vmpy_VhfVhf below undoes the shuffle)
+    const HVX_Vector h = Q6_Vhf_equals_Wqf32(Q6_W_vcombine_VV(Q6_Vqf32_vadd_VsfVsf(x1, c->zero), Q6_Vqf32_vadd_VsfVsf(x0, c->zero)));
+    const HVX_Vector a = Q6_V_vand_VV(h, c->abs16);
+    const HVX_Vector q = hvx_vec_silu_q_hf(a, c);
+
+    // -|x| * q in qf32 (lanes back in order), + max(x, 0) in f32
+    const HVX_VectorPair pq = Q6_Wqf32_vmpy_VhfVhf(q, Q6_V_vor_VV(a, c->sign16));
+    *y0 = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vadd_Vqf32Vsf(Q6_V_lo_W(pq), Q6_Vsf_vmax_VsfVsf(x0, c->zero)));
+    *y1 = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vadd_Vqf32Vsf(Q6_V_hi_W(pq), Q6_Vsf_vmax_VsfVsf(x1, c->zero)));
+}
+
+// silu(g) * u for fp16 g, u (64 lanes): the qf32 pair of products in the lane order of Wqf32_vmpy_VhfVhf(g, 1)
+static inline HVX_VectorPair hvx_vec_swiglu_hf_qf32(HVX_Vector g, HVX_Vector u, HVX_Vector one, const struct hvx_silu_hf_consts * c) {
+    const HVX_Vector     a  = Q6_V_vand_VV(g, c->abs16);
+    const HVX_Vector     q  = hvx_vec_silu_q_hf(a, c);
+    const HVX_VectorPair pq = Q6_Wqf32_vmpy_VhfVhf(q, Q6_V_vor_VV(a, c->sign16));         // -|g| q
+    const HVX_VectorPair pr = Q6_Wqf32_vmpy_VhfVhf(Q6_Vhf_vmax_VhfVhf(g, c->zero), one);  // max(g, 0)
+    const HVX_VectorPair pu = Q6_Wqf32_vmpy_VhfVhf(u, one);
+    const HVX_Vector s0 = Q6_Vqf32_vadd_Vqf32Vqf32(Q6_V_lo_W(pq), Q6_V_lo_W(pr));
+    const HVX_Vector s1 = Q6_Vqf32_vadd_Vqf32Vqf32(Q6_V_hi_W(pq), Q6_V_hi_W(pr));
+    return Q6_W_vcombine_VV(Q6_Vqf32_vmpy_Vqf32Vqf32(s1, Q6_V_hi_W(pu)), Q6_Vqf32_vmpy_Vqf32Vqf32(s0, Q6_V_lo_W(pu)));
+}
+
+// silu(g) * u for fp16 g, u (64 lanes) with the whole product in qf16: fp16 result, lanes as in g/u. For
+// consumers that round to fp16 anyway (the MoE down projection converts its activations to fp16).
+static inline HVX_Vector hvx_vec_swiglu_hf_h16(HVX_Vector g, HVX_Vector u, const struct hvx_silu_hf_consts * c) {
+    const HVX_Vector a = Q6_V_vand_VV(g, c->abs16);
+    const HVX_Vector q = hvx_vec_silu_q_hf(a, c);
+    const HVX_Vector t = Q6_Vqf16_vmpy_VhfVhf(q, Q6_V_vor_VV(a, c->sign16));        // -|g| q
+    const HVX_Vector s = Q6_Vqf16_vadd_Vqf16Vhf(t, Q6_Vhf_vmax_VhfVhf(g, c->zero));  // silu(g)
+    return Q6_Vhf_equals_Vqf16(Q6_Vqf16_vmpy_Vqf16Vhf(s, u));
+}
+
+// swiglu(g, u) = silu(g) * u, all 128-byte aligned (fp16 sigmoid, see hvx_vec_silu2_f32_hf)
+static inline void hvx_swiglu_f32_hf_aa(uint8_t * restrict dst, const uint8_t * restrict g, const uint8_t * restrict u, uint32_t n) {
+    const struct hvx_silu_hf_consts c = hvx_silu_hf_consts_init();
+
+    HVX_Vector * restrict vdst     = (HVX_Vector *) dst;
+    const HVX_Vector * restrict vg = (const HVX_Vector *) g;
+    const HVX_Vector * restrict vu = (const HVX_Vector *) u;
+
+    const uint32_t npair = n / (2 * VLEN_FP32);
+    uint32_t       rem   = n % (2 * VLEN_FP32);
+
+    uint32_t i = 0;
+    _Pragma("unroll(2)")
+    for (; i < npair; i++) {
+        HVX_Vector y0, y1;
+        hvx_vec_silu2_f32_hf(vg[2 * i], vg[2 * i + 1], &y0, &y1, &c);
+        vdst[2 * i]     = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(y0, vu[2 * i]));
+        vdst[2 * i + 1] = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(y1, vu[2 * i + 1]));
+    }
+    if (rem) {
+        const HVX_Vector x0 = vg[2 * i];
+        const HVX_Vector x1 = rem > VLEN_FP32 ? vg[2 * i + 1] : c.zero;
+        const HVX_Vector u0 = vu[2 * i];
+        const HVX_Vector u1 = rem > VLEN_FP32 ? vu[2 * i + 1] : c.zero;
+        HVX_Vector y0, y1;
+        hvx_vec_silu2_f32_hf(x0, x1, &y0, &y1, &c);
+        y0 = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(y0, u0));
+        y1 = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(y1, u1));
+        if (rem >= VLEN_FP32) {
+            vdst[2 * i] = y0;
+            rem -= VLEN_FP32;
+            if (rem) hvx_vec_store_a((void *) &vdst[2 * i + 1], rem * sizeof(float), y1);
+        } else {
+            hvx_vec_store_a((void *) &vdst[2 * i], rem * sizeof(float), y0);
+        }
+    }
+}
+
+// silu in place or dst != src, both 128-byte aligned (fp16 sigmoid, see hvx_vec_silu2_f32_hf)
+static inline void hvx_silu_f32_hf_aa(uint8_t * dst, const uint8_t * src, uint32_t n) {
+    const struct hvx_silu_hf_consts c = hvx_silu_hf_consts_init();
+
+    HVX_Vector * vdst       = (HVX_Vector *) dst;
+    const HVX_Vector * vsrc = (const HVX_Vector *) src;
+
+    const uint32_t npair = n / (2 * VLEN_FP32);
+    uint32_t       rem   = n % (2 * VLEN_FP32);
+
+    uint32_t i = 0;
+    _Pragma("unroll(2)")
+    for (; i < npair; i++) {
+        HVX_Vector y0, y1;
+        hvx_vec_silu2_f32_hf(vsrc[2 * i], vsrc[2 * i + 1], &y0, &y1, &c);
+        vdst[2 * i]     = y0;
+        vdst[2 * i + 1] = y1;
+    }
+    if (rem) {
+        const HVX_Vector x0 = vsrc[2 * i];
+        const HVX_Vector x1 = rem > VLEN_FP32 ? vsrc[2 * i + 1] : c.zero;
+        HVX_Vector y0, y1;
+        hvx_vec_silu2_f32_hf(x0, x1, &y0, &y1, &c);
+        if (rem >= VLEN_FP32) {
+            vdst[2 * i] = y0;
+            rem -= VLEN_FP32;
+            if (rem) hvx_vec_store_a((void *) &vdst[2 * i + 1], rem * sizeof(float), y1);
+        } else {
+            hvx_vec_store_a((void *) &vdst[2 * i], rem * sizeof(float), y0);
+        }
+    }
+}
+
 #endif /* HVX_SIGMOID_H */
