+// work items of a thread: its channel blocks (ith, ith + nth, ...) x the time tiles of each block, in order
+struct ssm_conv_tc_item {
+    uint32_t c0, cw, t0, tl, first, last;
+};
+
+static inline struct ssm_conv_tc_item ssm_conv_tc_item_at(uint32_t it, uint32_t ith, uint32_t nth, uint32_t n_tiles,
+                                                          uint32_t tt, uint32_t T, uint32_t cb, uint32_t c_beg, uint32_t c_end) {
+    struct ssm_conv_tc_item r;
+    const uint32_t i = it / n_tiles;
+    const uint32_t j = it - i * n_tiles;
+    r.c0    = c_beg + (ith + i * nth) * cb;
+    r.cw    = MIN(cb, c_end - r.c0);
+    r.t0    = j * tt;
+    r.tl    = MIN(tt, T - r.t0);
+    r.first = (j == 0);
+    r.last  = (j + 1 == n_tiles);
+    return r;
+}
