+    // stage the k index vectors in the (consumed) first rows of the tile: row j holds the j-th index of the 32 rows
+    int32_t * tmp = (int32_t *) vals;
+    for (uint32_t j = 0; j < k; ++j) {
+        *(HVX_Vector *) (tmp + (size_t) j * ne00) = bi[j];
+    }
+    for (uint32_t r = 0; r < n_rows; ++r) {
+        for (uint32_t j = 0; j < k; ++j) {
+            out[(size_t) r * ne00 + j] = tmp[(size_t) j * ne00 + r];
+        }
+    }
+}
+
+// GGML_HEXAGON_TOPK_V: topk_32rows_hvx with vector outputs, for k in {1, 2, 4, 8}. The same transpose and the same
+// column insertion (same compares, so the same indices in the same order); with probs, the transposed router
+// probabilities ride along as a third payload of the insertion, so the selected weights need no scalar gather from
+// VTCM. idx_out: [32][k] int32 (128-byte aligned, whole vectors written). w_out (with probs): [n_rows][k] floats of
