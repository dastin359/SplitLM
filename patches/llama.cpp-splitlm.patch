+            out[k] = (float *) ((uint8_t *) dst->data + (args->kv_head * G + fastmodulo(rr, G, &factx->div_G)) * dst->nb[1] +
+                                (args->q_start + fastdiv(rr, &factx->div_G)) * dst->nb[2] + args->ib3 * dst->nb[3]);
+        }
+        const __fp16 * row_base = o_tile_src + r0 * HMX_FP16_TILE_N_ELMS;
+        for (uint32_t d = 0; d * 32 < DV; ++d) {
+            const HVX_VectorPair vp = Q6_Wqf32_vmpy_VhfVhf(((const HVX_Vector *) (row_base + d * o_stride))[r1 / 2], ip);
