+// The buffer holds no weight data: each tensor is pointed at the HTP0 model's tiled copy.
+static enum ggml_status htptile_buffer_init_tensor(ggml_backend_buffer_t buffer, struct ggml_tensor * tensor) {
+    GGML_UNUSED(buffer);
+    if (!g_resolver || !htptile_shape_ok(tensor)) {
+        GGML_LOG_ERROR("%s: cannot alias %s (resolver %p, type %s)\n", __func__, tensor->name, (void *) g_resolver, ggml_type_name(tensor->type));
+        return GGML_STATUS_FAILED;
+    }
+    void * p = g_resolver(tensor->name, tensor, g_resolver_user);
+    if (!p) {
+        GGML_LOG_ERROR("%s: no HTP0 tensor for %s\n", __func__, tensor->name);
+        return GGML_STATUS_FAILED;
+    }
+    tensor->data = p;
+    return GGML_STATUS_SUCCESS;
+}
