+static ggml::cpu::repack::tensor_traits_base * moe_traits(const struct ggml_tensor * mmid) {
+    const ggml_tensor * w = mmid->src[0];
+    if (w->buffer == nullptr || w->buffer->buft != ggml_backend_cpu_repack_buffer_type() || w->extra == nullptr) {
+        return nullptr;
