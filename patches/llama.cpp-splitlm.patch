+// trilane: single-token decode over F16 K/V, one KV chunk per thread (split-KV path). The generic chunk kernel
+// walks the chunk once per query head: per position a vec_dot call, a scalar expf and an F16 axpy into an F16
+// accumulator. Here the GB query heads of a GQA group share one pass over each K and V row: scores come from
+// FP16 widening FMAs (FMLAL, f32 accumulation), the softmax runs once per block of FA_DEC_BKV positions with a
+// vectorized exp, and V is accumulated in f32 registers across the block. Masked (-inf) positions are skipped.
+// The f32 accumulation is also more accurate: on Qwen3.5-2B decode, the per-chunk attention output is within 8.8e-5
+// (mean relative error) of a double-precision reference, vs 1.2e-3 for the generic kernel's F16 accumulators.
+// GGML_CPU_FA_DEC=0 falls back to the generic kernel.
+#if defined(__aarch64__) && defined(__ARM_FEATURE_FP16_FML) && defined(__ARM_FEATURE_FP16_VECTOR_ARITHMETIC)
+#define GGML_FA_DEC 1
+#endif
+
+#define FA_DEC_BKV   64 // positions per softmax block (a block's V rows stay in L1 across the column-slice passes)
+#define FA_DEC_GBMAX 4  // query heads per pass over K/V
+
+// per-thread scratch of the decode kernel, in floats
+static inline int64_t ggml_fa_dec_scratch_f32(int64_t DK, int64_t DV, int64_t n_head) {
+    return n_head*DK/2 + n_head*DV + 2*n_head + FA_DEC_GBMAX*FA_DEC_BKV + 4*FA_DEC_BKV + 2*FA_DEC_BKV + 2*CACHE_LINE_SIZE_F32;
+}
+
+size_t ggml_cpu_fa_dec_scratch_size(int64_t DK, int64_t DV, int64_t n_head) {
+    return sizeof(float)*ggml_fa_dec_scratch_f32(DK, DV, n_head);
+}
+
+#ifdef GGML_FA_DEC
+static bool ggml_fa_dec_enabled() {
+    static const bool on = [] { const char * e = getenv("GGML_CPU_FA_DEC"); return !(e && atoi(e) == 0); }();
+    return on;
+}
+
+// scores of two K rows against GB query rows (f16), f32 accumulation
+template <int GB>
+static inline void ggml_fa_dec_dot2(const __fp16 * k0, const __fp16 * k1, const __fp16 * q, int64_t DK, float * s0, float * s1) {
+    float32x4_t a0[GB], b0[GB], a1[GB], b1[GB];
+    for (int j = 0; j < GB; j++) {
+        a0[j] = vdupq_n_f32(0.0f); b0[j] = vdupq_n_f32(0.0f);
+        a1[j] = vdupq_n_f32(0.0f); b1[j] = vdupq_n_f32(0.0f);
+    }
+    for (int64_t d = 0; d < DK; d += 8) {
+        const float16x8_t x0 = vld1q_f16(k0 + d);
+        const float16x8_t x1 = vld1q_f16(k1 + d);
+        for (int j = 0; j < GB; j++) {
+            const float16x8_t qv = vld1q_f16(q + j*DK + d);
+            a0[j] = vfmlalq_low_f16 (a0[j], x0, qv);
+            b0[j] = vfmlalq_high_f16(b0[j], x0, qv);
+            a1[j] = vfmlalq_low_f16 (a1[j], x1, qv);
+            b1[j] = vfmlalq_high_f16(b1[j], x1, qv);
+        }
+    }
+    for (int j = 0; j < GB; j++) {
+        s0[j] = vaddvq_f32(vaddq_f32(a0[j], b0[j]));
+        s1[j] = vaddvq_f32(vaddq_f32(a1[j], b1[j]));
