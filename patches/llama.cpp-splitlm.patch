+                    *(HVX_UVector *) (out[k] + d * 32) = vo;
+                } else {
+                    hvx_vec_store_u((void *) (out[k] + d * 32), nb, vo);
+                }
+            }
+        }
+        r += pair ? 2 : 1;
+    }
+    htp_trace_event_stop(tr, HTP_TRACE_EVT_HVX_O_PROC, (uint16_t) (args->q_start * G + start));
+}
