+            HMX_MMID_BAG_PUSH(p);
+            st->bag_ps[i][p] = st->bag_step;
+            st->bag_np[i]    = (uint8_t) (p + 1);
+        }
+        htp_trace_event_stop(tr, HTP_TRACE_EVT_HVX_A_PREP, 4001);
+    }
+#undef HMX_MMID_BAG_PUSH
+#undef HMX_MMID_BAG_BLK
