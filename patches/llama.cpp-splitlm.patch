+    int conv = -1;
+    int silu = -1;
+    int cpy  = -1;
+    // LFM2 gates (GGML_HEXAGON_CONV_GATE): x^T = transpose(MUL(b, x)) built in the kernel from b and x, and the
+    // consumer y = MUL(c, conv) applied before the store
+    int mul_b = -1;
+    int mul_c = -1;
+    const ggml_tensor * gb = nullptr; // b, x: srcs of the MUL feeding the concat
+    const ggml_tensor * gx = nullptr;
+    const ggml_tensor * gc = nullptr; // c: the other src of the MUL consuming the conv
