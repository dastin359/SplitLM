+        ((struct htp_ssm_conv_kernel_params *) last_node.kernel_params)->fuse_silu = (opt_silu_hf & 1) ? 2 : 1;
+
+        htp_op_desc & o = h_ops[n_ops - 1];
+        ((struct htp_ssm_conv_kernel_params *) o.kernel_params)->fuse_silu = (opt_silu_hf & 1) ? 2 : 1;
+        o.dst[0] = add_tensor(silu_dst);
+
+        HEX_VERBOSE("ggml-hex: %s fused SSM_CONV+SILU (#%u)\n", sess->c_name(), n_ops - 1);
+        return true;
+    }
+
+    // RMS_NORM followed by SCALE (no bias), e.g. the L2 norm of GDN q/k: the scale goes into the per-row factor
+    bool try_fuse_rms_norm_scale(const htp_opnode & node) {
+        if (n_ops == 0 || node.opcode != HTP_OP_SCALE) return false;
+
+        htp_opnode & last_node = ops[n_ops - 1];
+        if (last_node.opcode != HTP_OP_RMS_NORM || last_node.outputs.size() != 1) return false;
+
+        const ggml_tensor * rms_out   = last_node.dst();
+        const ggml_tensor * scale_src = node.src0();
+        const ggml_tensor * scale_dst = node.dst();
+
+        if (!ggml_hexagon_tensor_is_fuseable(rms_out)) return false;
+        if (scale_src != rms_out && scale_src->data != rms_out->data) return false;
+        if (rms_out->type != GGML_TYPE_F32 || scale_dst->type != GGML_TYPE_F32) return false;
+        if (!ggml_are_same_shape(rms_out, scale_dst) || !ggml_is_contiguous(rms_out) || !ggml_is_contiguous(scale_dst)) {
+            return false;
+        }
+
+        const float scale = ggml_get_op_params_f32(node.node, 0);
+        const float bias  = ggml_get_op_params_f32(node.node, 1);
+        if (bias != 0.0f || scale == 0.0f) return false;
+
+        if (!try_fuse_common({scale_dst})) {
+            return false;
+        }
+
+        last_node.name += "+SCALE";
+        last_node.outputs.clear();
+        last_node.outputs.push_back(scale_dst);
+        last_node.fused.push_back(node.node);
+
+        htp_op_desc & o = h_ops[n_ops - 1];
+        memcpy(&o.params[1], &scale, sizeof(float));
+        o.dst[0] = add_tensor(scale_dst);
+
+        HEX_VERBOSE("ggml-hex: %s fused RMS_NORM+SCALE (#%u)\n", sess->c_name(), n_ops - 1);
+        return true;
+    }
+
+    // MUL_MAT_NX(gate, up) followed by SWIGLU(gate, up): the HMX epilogue of the second weight writes
+    // silu(gate) * up straight into the SWIGLU output (gate is still written and read back from DDR)
+    bool try_fuse_mul_mat_nx_swiglu(const htp_opnode & node) {
+        if (n_ops == 0 || node.opcode != HTP_OP_GLU_SWIGLU) return false;
+
+        htp_opnode & last_node = ops[n_ops - 1];
+        if (last_node.opcode != HTP_OP_MUL_MAT_NX || last_node.outputs.size() != 2) return false;
+
+        auto * kp = (struct htp_mm_kernel_params *) last_node.kernel_params;
+        if (kp->n_hmx == 0 || kp->kernel_type != HTP_MM_KERNEL_HMX_2D || kp->epilogue != HTP_MM_EPI_NONE) return false;
+
+        // the DSP pairs gate and up columns inside each HMX job (pipelined kernel, chunks of >= 2 x 32 columns)
+        const ggml_tensor * w0 = last_node.inputs[0];
+        const ggml_tensor * w1 = last_node.inputs[1];
+        if (!kp->pipeline || kp->n_chunk < 64 || w0->ne[1] != w1->ne[1] || w0->ne[1] % 32 != 0 || w0->nb[1] != w1->nb[1]) {
+            return false;
+        }
+        if (opt_nx_swiglu == 2 && (ggml_is_quantized(w0->type) || ggml_is_quantized(w1->type))) {
+            return false;
+        }
+
+        const ggml_tensor * out0 = last_node.outputs[0];
+        const ggml_tensor * out1 = last_node.outputs[1];
+        const ggml_tensor * a    = node.src0(); // gate
+        const ggml_tensor * b    = node.src1(); // up
+        const ggml_tensor * d    = node.dst();
+
+        if (!a || !b || ggml_get_op_params_i32(node.node, 1) != 0) return false; // split, not swapped
+
+        auto same = [](const ggml_tensor * x, const ggml_tensor * y) { return x == y || x->data == y->data; };
+
+        // the epilogue of the second weight reads the first weight's output back from DDR
+        int32_t epi;
+        if (same(a, out0) && same(b, out1)) {
+            epi = HTP_MM_EPI_SWIGLU;
+        } else if (same(a, out1) && same(b, out0)) {
+            epi = HTP_MM_EPI_SWIGLU_REV;
+        } else {
+            return false;
+        }
+        if (!ggml_hexagon_tensor_is_fuseable(out1)) return false; // replaced by the SWIGLU output
+
+        for (const ggml_tensor * t : { out0, out1, a, b, d }) {
+            if (t->type != GGML_TYPE_F32 || !ggml_is_contiguous(t) || !ggml_are_same_shape(t, d)) return false;
+        }
+
+        // GGML_HEXAGON_FUSE_HAZARD: the fused op writes d while it still reads x (later m-blocks) and the gate output out0;
+        // ggml-alloc may place d over x (x's last reader was the up MUL_MAT), and the stores of one m-block then race the
+        // DMA of the next block's activations (seen on Qwen3.5-2B -c 4096 -ub 1024: last layer, every run different)
+        if (opt_fuse_hazard && (fused_output_overlaps_inputs(d, last_node) || ggml_hexagon_tensors_overlap(d, out0))) {
+            HEX_VERBOSE("ggml-hex: %s skip MUL_MAT_NX+SWIGLU fusion: %s overlaps an input\n", sess->c_name(), d->name);
+            if (opt_hazard_dbg) GGML_LOG_INFO("ggml-hex: FUSE_HAZARD refuse SWIGLU into MUL_MAT_NX: %s overlaps an input\n", d->name);
+            return false;
+        }
+
+        if (!try_fuse_common({d})) {
+            return false;
+        }
+
+        last_node.name += "+SWIGLU";
+        last_node.outputs[1] = d;
+        last_node.fused.push_back(node.node);
+        kp->epilogue = epi;
+
+        htp_op_desc & o = h_ops[n_ops - 1];
+        ((struct htp_mm_kernel_params *) o.kernel_params)->epilogue = epi;
+        o.dst[1] = add_tensor(d);
+
+        HEX_VERBOSE("ggml-hex: %s fused MUL_MAT_NX+SWIGLU (#%u)\n", sess->c_name(), n_ops - 1);
+        return true;
+    }
+
+    // MUL_MAT_ID_NX(w0, w1) on the streamed HMX expert kernel followed by SWIGLU of its two outputs: every item of
+    // the kernel computes the same columns of gate and up in one HMX job and its scatter writes only
+    // silu(gate) * up (dsts[0] == dsts[1] == the SWIGLU output); gate and up never reach DDR
+    bool try_fuse_mul_mat_id_nx_swiglu(const htp_opnode & node) {
+        if (n_ops == 0 || node.opcode != HTP_OP_GLU_SWIGLU) return false;
+        if (sess->mdev.count > 1) return false;
+
+        htp_opnode & last_node = ops[n_ops - 1];
+        if (last_node.opcode != HTP_OP_MUL_MAT_ID_NX || last_node.outputs.size() != 2) return false;
+
+        auto * kp = (struct htp_mm_kernel_params *) last_node.kernel_params;
+        if (kp->n_hmx == 0 || !(kp->pipeline & HTP_MMID_STREAM) || kp->epilogue != HTP_MM_EPI_NONE || kp->n_weights != 2) {
+            return false;
+        }
+
+        const ggml_tensor * w0 = last_node.inputs[0];
+        const ggml_tensor * w1 = last_node.inputs[1];
+        if (w0->type != w1->type || w0->ne[0] != w1->ne[0] || w0->ne[1] != w1->ne[1] || w0->ne[2] != w1->ne[2] ||
+            w0->ne[1] % 32 != 0 || w0->ne[0] % 32 != 0 || w0->nb[1] != w1->nb[1] || w0->nb[2] != w1->nb[2] ||
+            ggml_hexagon_tensor_is_tiled(w0) != ggml_hexagon_tensor_is_tiled(w1)) {
+            return false;
+        }
+
+        const ggml_tensor * out0 = last_node.outputs[0];
+        const ggml_tensor * out1 = last_node.outputs[1];
+        const ggml_tensor * a    = node.src0(); // gate
+        const ggml_tensor * b    = node.src1(); // up
+        const ggml_tensor * d    = node.dst();
+
+        if (!a || !b || ggml_get_op_params_i32(node.node, 1) != 0) return false; // split, not swapped
+
+        auto same = [](const ggml_tensor * x, const ggml_tensor * y) { return x == y || x->data == y->data; };
+
+        bool rev;
+        if (same(a, out0) && same(b, out1)) {
+            rev = false;
+        } else if (same(a, out1) && same(b, out0)) {
+            rev = true;   // gate = W1 x: the weights swap places
+        } else {
+            return false;
+        }
+        // both are replaced by the SWIGLU output
+        if (!ggml_hexagon_tensor_is_fuseable(out0) || !ggml_hexagon_tensor_is_fuseable(out1)) return false;
+
+        for (const ggml_tensor * t : { out0, out1, a, b, d }) {
+            if (t->type != GGML_TYPE_F32 || !ggml_is_contiguous(t) || !ggml_are_same_shape(t, d)) return false;
+        }
+
+        // GGML_HEXAGON_FUSE_HAZARD: the scatter writes d while later items still gather x rows and read the ids
+        if (opt_fuse_hazard && fused_output_overlaps_inputs(d, last_node)) {
+            HEX_VERBOSE("ggml-hex: %s skip MUL_MAT_ID_NX+SWIGLU fusion: %s overlaps an input\n", sess->c_name(), d->name);
+            if (opt_hazard_dbg) GGML_LOG_INFO("ggml-hex: FUSE_HAZARD refuse SWIGLU into MUL_MAT_ID_NX: %s overlaps an input\n", d->name);
+            return false;
+        }
+
+        if (!try_fuse_common({d})) {
+            return false;
+        }
+
+        const int32_t epi = !opt_swiglu_hf ? HTP_MM_EPI_SWIGLU_PAIR :
+                            opt_mmid_swiglu == 2 ? HTP_MM_EPI_SWIGLU_PAIR_H16 : HTP_MM_EPI_SWIGLU_PAIR_HF;
+
+        if (rev) {
+            std::swap(last_node.inputs[0], last_node.inputs[1]);
+        }
+        last_node.name += "+SWIGLU";
+        last_node.outputs[0] = d;
+        last_node.outputs[1] = d;
+        last_node.fused.push_back(node.node);
+        kp->epilogue = epi;
+
+        htp_op_desc & o = h_ops[n_ops - 1];
+        ((struct htp_mm_kernel_params *) o.kernel_params)->epilogue = epi;
+        if (rev) {
+            std::swap(o.src[0], o.src[1]);
+        }
+        o.dst[0] = add_tensor(d);
+        o.dst[1] = o.dst[0];
+
+        HEX_VERBOSE("ggml-hex: %s fused MUL_MAT_ID_NX+SWIGLU (#%u)\n", sess->c_name(), n_ops - 1);
+        return true;
+    }
+
+    static bool tensors_overlap(const ggml_tensor * a, const ggml_tensor * b) {
+        if (!a || !b || !a->data || !b->data) return false;
+        const uint8_t * a0 = (const uint8_t *) a->data; const uint8_t * a1 = a0 + ggml_nbytes(a);
+        const uint8_t * b0 = (const uint8_t *) b->data; const uint8_t * b1 = b0 + ggml_nbytes(b);
+        return a0 < b1 && b0 < a1;
+    }
+
+    // RMS_NORM+MUL at op n whose output is read only as src1 of 2D HMX matmuls of this batch: the norm stores fp16
+    // activation tiles and every consumer DMAs tile rows. All uses must be consumers here that accept it.
+    void try_norm_tiled(unsigned int n) {
+        const htp_opnode & node = ops[n];
+        if (sess->mdev.count > 1 || node.opcode != HTP_OP_RMS_NORM_MUL || node.outputs.size() != 1 || node.inputs.size() != 2) return;
+        if (h_ops[n].params[HTP_NORM_PARAM_GATE] != 0 || h_ops[n].params[HTP_NORM_PARAM_TILED] != 0) return;
+        const auto * up = (const struct htp_unary_kernel_params *) h_ops[n].kernel_params;
+        if (up->col_tile != 0 || !up->broadcast_weight || up->block < 32) return;
+        const ggml_tensor * x = node.dst();
+        const ggml_tensor * s0 = node.inputs[0];
+        if (!x || !x->extra || x->type != GGML_TYPE_F32 || !ggml_is_contiguous(x) || x->ne[0] % 32 != 0 || x->ne[1] <= 32 ||
+            x->ne[2] != 1 || x->ne[3] != 1 || !s0 || !ggml_is_contiguous(s0) || !ggml_are_same_shape(s0, x)) {
+            return;
+        }
+        const auto * ex = (const ggml_hexagon_tensor_extra *) x->extra;
+        if (!(ex->flags & GGML_HEXAGON_TENSOR_TILED_SRC)) return;
+        // tile rows land at other token offsets than the rows read (another thread's input rows): no in-place output
+        for (const ggml_tensor * t : node.inputs) if (tensors_overlap(t, x)) return;
+
+        std::vector<unsigned int> cons;
+        uint32_t uses = 0;
+        const bool rows16 = (ex->flags & GGML_HEXAGON_TENSOR_ROWS16) != 0;
+        int      id_cons  = -1;  // rows16: the MUL_MAT_ID_NX reading x through its view
+        for (unsigned int j = n + 1; j < n_ops; ++j) {
+            const htp_opnode & c = ops[j];
+            const auto * kp = (const struct htp_mm_kernel_params *) h_ops[j].kernel_params;
+            bool reads = false, reads_view = false;
+            for (const ggml_tensor * t : c.inputs) {
+                reads      = reads || t == x;
+                reads_view = reads_view || (t && t != x && t->view_src == x);  // not by address: later tensors reuse x's memory
+            }
+            if (reads_view && rows16) {
+                // only the streamed expert gate/up op with DMA gather (fp16 rows in the second half), once
+                const uint32_t need = HTP_MMID_STREAM | HTP_MMID_STREAM_DMA_GATHER;
+                if (reads || id_cons >= 0 || c.opcode != HTP_OP_MUL_MAT_ID_NX || kp->n_hmx == 0 ||
+                    (kp->pipeline & need) != need || kp->n_weights + 2 != c.inputs.size()) return;
+                const ggml_tensor * a = c.inputs[kp->n_weights];
+                if (!a || a->view_src != x || a->data != x->data || a->ne[0] != x->ne[0] || a->ne[1] != 1 ||
+                    a->ne[2] != x->ne[1] || a->ne[3] != 1 || a->nb[2] != x->nb[1]) return;
+                for (uint32_t q = 0; q < kp->n_weights; ++q) {
+                    if (c.inputs[q] == x || c.inputs[q]->view_src == x || c.inputs[q]->ne[0] != x->ne[0]) return;
+                }
+                id_cons = (int) j;
+                continue;
+            }
+            if (!reads) continue;
+            const bool mm  = (c.opcode == HTP_OP_MUL_MAT || c.opcode == HTP_OP_MUL_MAT_ADD) && c.inputs.size() >= 2 && c.inputs[1] == x &&
+                             c.inputs[0] != x && (c.inputs.size() < 3 || c.inputs[2] != x);
+            const bool nx  = c.opcode == HTP_OP_MUL_MAT_NX && c.inputs.back() == x && kp->n_weights + 1 == c.inputs.size();
+            if (!mm && !nx) return;
+            for (size_t q = 0; q + 1 < c.inputs.size(); ++q) if (c.inputs[q] == x && !(mm && q == 1)) return;
+            if (kp->n_hmx == 0 || kp->kernel_type != HTP_MM_KERNEL_HMX_2D || !(kp->pipeline & 1) || (kp->pipeline & HTP_MM_ACT_TILED_IN)) return;
+            if (c.inputs[0]->ne[0] != x->ne[0]) return;
+            cons.push_back(j);
+            uses += nx ? kp->n_weights : 1;
+        }
+        if (cons.empty() || uses != ex->n_mm_uses) return;
+        if (rows16 && id_cons < 0) return;  // the expert op is not in this batch: f32 rows stay
+
+        h_ops[n].params[HTP_NORM_PARAM_TILED] = 1;
+        if (rows16) {
+            h_ops[n].params[HTP_NORM_PARAM_ROWS16] = 1;
+            h_ops[id_cons].flags |= HTP_OPFLAG_ACT_F16_HI;
+            HEX_VERBOSE("ggml-hex: %s fp16 rows of RMS_NORM+MUL #%u -> MUL_MAT_ID_NX #%d\n", sess->c_name(), n, id_cons);
+        }
+        h_ops[n].params[HTP_NORM_PARAM_FUSE] |= (opt_norm_fuse & 2) | ((opt_norm_fuse & 2) && opt_norm_sched ? 8 : 0);
+        for (unsigned int j : cons) {
+            const uint8_t fl = HTP_MM_ACT_TILED_IN | ((opt_mm_flat & (ops[j].opcode == HTP_OP_MUL_MAT_NX ? 1 : 2)) ? HTP_MM_FLAT : 0);
+            ((struct htp_mm_kernel_params *) h_ops[j].kernel_params)->pipeline |= fl;
+            ((struct htp_mm_kernel_params *) ops[j].kernel_params)->pipeline |= fl;
+        }
+        HEX_VERBOSE("ggml-hex: %s fp16 tiled RMS_NORM+MUL #%u -> %zu consumers\n", sess->c_name(), n, cons.size());
+    }
+
+    // GGML_HEXAGON_MOE_NORM_TILED: the MOE_REDUCE at op n also writes the next RMS_NORM+MUL (dsts[1]); when that output is
+    // read only as src1 of 2D HMX matmuls of this batch (directly or through contiguous token-row views), it stores fp16
+    // activation tiles and the consumers DMA tile rows (bit-identical: the same conversion as the matmuls' activation prep)
+    // GGML_HEXAGON_CONV_TILED (same hand-off): the gated short-conv block (SSM_CONV tc_mode with MUL_C) at op n, output
+    // dsts[0] = c * conv, stores fp16 tiles of its token rows
+    void try_moe_norm_tiled(unsigned int n) {
+        const htp_opnode & node = ops[n];
+        if (sess->mdev.count > 1) return;
+        const bool moe  = node.opcode == HTP_OP_MOE_REDUCE && node.outputs.size() == 2 && opt_moe_norm_tiled;
+        const bool conv = node.opcode == HTP_OP_SSM_CONV && node.outputs.size() >= 1 && opt_conv_tiled;
+        if (!moe && !conv) return;
+        htp_op_desc & on = h_ops[n];
+        auto * ckp = (struct htp_ssm_conv_kernel_params *) on.kernel_params;
+        if (moe && on.params[HTP_MOE_PARAM_NORM] != 1) return;
+        if (conv && (!ckp->tc_mode || !(ckp->tc_mul & HTP_SSM_CONV_TC_MUL_C) || ckp->tc_tiled || ckp->n_t % 32 != 0 ||
+                     ckp->tc_t_tile % 32 != 0 || ckp->d_inner % 32 != 0 || ckp->d_inner_tile % 32 != 0 || ckp->silu_lut)) return;
+        const ggml_tensor * x = moe ? node.outputs[1] : node.outputs[0];
+        if (!x || !x->extra || x->type != GGML_TYPE_F32 || !ggml_is_contiguous(x) || x->ne[0] % 32 != 0 || x->ne[0] / 32 > 65535 ||
+            x->ne[1] < 32 || x->ne[1] % 32 != 0 || x->ne[2] != 1 || x->ne[3] != 1) return;
+        if (conv && (x->ne[0] != (int64_t) ckp->d_inner || x->ne[1] != (int64_t) ckp->n_t)) return;
+        const auto * ex = (const ggml_hexagon_tensor_extra *) x->extra;
+        if (!(ex->flags & GGML_HEXAGON_TENSOR_MTILED_SRC)) return;
+        for (const ggml_tensor * t : node.inputs) if (t && tensors_overlap(t, x)) return;
+        for (const ggml_tensor * t : node.outputs) if (t && t != x && tensors_overlap(t, x)) return;
+        struct htp_ssm_conv_tc_layout CL;
+        if (conv) {
+            const uint32_t tt = ckp->tc_t_tile ? ckp->tc_t_tile : ckp->n_t;
+            htp_ssm_conv_tc_layout_build(&CL, ckp->d_conv, tt, ckp->d_inner_tile, ckp->tc_mul, 1);
+            if ((size_t) CL.total * ckp->n_threads > sess->vtcm_size) return;
+        }
+        std::vector<unsigned int> cons;
+        uint32_t uses = 0;
+        for (unsigned int j = n + 1; j < n_ops; ++j) {
+            const htp_opnode & c = ops[j];
+            const ggml_tensor * v = nullptr;
+            for (const ggml_tensor * t : c.inputs) {
+                if (t && (t == x || (t->view_src == x && t->data == x->data))) {
+                    if (v && v != t) return;
+                    v = t;
+                }
+            }
+            if (!v) continue;
+            if (v->ne[0] != x->ne[0] || v->ne[1] != x->ne[1] || v->ne[2] != 1 || v->ne[3] != 1 || !ggml_is_contiguous(v)) return;
+            const auto * kp = (const struct htp_mm_kernel_params *) h_ops[j].kernel_params;
+            const bool mm = (c.opcode == HTP_OP_MUL_MAT || c.opcode == HTP_OP_MUL_MAT_ADD) && c.inputs.size() >= 2 && c.inputs[1] == v &&
+                            c.inputs[0] != v && (c.inputs.size() < 3 || c.inputs[2] != v);
+            const bool nx = c.opcode == HTP_OP_MUL_MAT_NX && c.inputs.back() == v && kp->n_weights + 1 == c.inputs.size();
+            if (!mm && !nx) return;
+            for (size_t q = 0; q + 1 < c.inputs.size(); ++q) if (c.inputs[q] == v && !(mm && q == 1)) return;
+            if (kp->n_hmx == 0 || kp->kernel_type != HTP_MM_KERNEL_HMX_2D || !(kp->pipeline & 1) || (kp->pipeline & HTP_MM_ACT_TILED_IN)) return;
+            if (c.inputs[0]->ne[0] != x->ne[0]) return;
+            cons.push_back(j);
+            uses += nx ? kp->n_weights : 1;
+        }
+        if (cons.empty() || uses != ex->n_mtiled_uses) return;
+        if (moe) {
+            on.params[HTP_MOE_PARAM_NORM] = 2;
+        } else {
+            for (auto * kp : { ckp, (struct htp_ssm_conv_kernel_params *) ops[n].kernel_params }) {
+                kp->tc_tiled                  = 1;
+                kp->vtcm_src0_size_per_thread = CL.total;
+                kp->vtcm_src0_size            = CL.total * kp->n_threads;
+                kp->vtcm_size                 = CL.total * kp->n_threads;
+            }
+        }
+        for (unsigned int j : cons) {
+            const uint8_t fl = HTP_MM_ACT_TILED_IN | ((opt_mm_flat & (ops[j].opcode == HTP_OP_MUL_MAT_NX ? 1 : 2)) ? HTP_MM_FLAT : 0);
+            ((struct htp_mm_kernel_params *) h_ops[j].kernel_params)->pipeline |= fl;
+            ((struct htp_mm_kernel_params *) ops[j].kernel_params)->pipeline |= fl;
+        }
+        ops[n].name += "+T";
+        HEX_VERBOSE("ggml-hex: %s fp16 tiled %s #%u -> %zu consumers\n", sess->c_name(), moe ? "MOE norm" : "conv block", n, cons.size());
+    }
+
+    // tiled gated norm blocking (as the DSP derives it): block, rows per block (0 = no tiled layout) and half mode
+    static void gnorm_tiled_blocking(const struct htp_unary_kernel_params * up, uint32_t tr, uint32_t * blk, uint32_t * rows, bool * half) {
+        const uint32_t cap  = (uint32_t) ((up->vtcm_src0_size_per_thread / 2) / (128 * sizeof(float)));
+        const uint32_t dfit = (uint32_t) ((up->vtcm_dst_size_per_thread / 2) / (128 * sizeof(float) * 3 / 2));
+        *blk  = std::min(std::max<uint32_t>(up->block, tr), cap);
+        *half = (size_t) (up->vtcm_dst_size_per_thread / 2) >= (size_t) tr * 128 * sizeof(float);
+        *rows = std::min(*blk, dfit) >= tr ? std::min(*blk, dfit) / tr * tr : (*blk / 2 >= tr / 2 && *half ? tr / 2 : 0);
+    }
+
+    // SCAN_ILP bit 32: the 16-head tiled gated norm (K 2048) reads its fp16 silu factor q(|z|) from a per-thread VTCM
+    // table placed after the norm's layout. The layout is rebuilt with a budget that leaves room for the tables, and
+    // the table is only used when the DSP's blocking (rows per block, half mode) stays exactly the same, and when each
+    // HVX thread has enough elements to pay for building its 64 KB table (GGML_HEXAGON_SILU_LUT_MIN)
+    void try_gnorm_lut(unsigned int n, int64_t K, uint32_t tr, uint32_t rows, bool half) {
+        if (!(opt_scan_ilp & 32) || !(opt_silu_hf & 2) || !(opt_norm_fuse & 1) || K != 2048) return;
+        const htp_opnode & node = ops[n];
+        const ggml_tensor * x = node.inputs[0];
+        auto * up = (struct htp_unary_kernel_params *) h_ops[n].kernel_params;
+        const uint32_t n_thr = up->n_threads ? up->n_threads : 1;
+        if ((uint64_t) ggml_nelements(x) / n_thr < (uint64_t) opt_silu_lut_min) return;
+        const size_t lut_bytes = (size_t) n_thr * (HTP_SILU_Q_LUT_BYTES + 1024);
+        if (sess->vtcm_size <= lut_bytes + (1u << 20)) return;
+        struct htp_unary_kernel_params kp;
+        ggml_hexagon_precompute_unary_params(sess, HTP_OP_RMS_NORM_MUL, x, node.inputs[1], node.outputs[0], &kp,
+                                             sess->vtcm_size - lut_bytes);
+        if (kp.n_threads != up->n_threads || kp.col_tile != 0 || !kp.broadcast_weight || kp.block < 2) return;
+        uint32_t blk2 = 0, rows2 = 0;
+        bool     half2 = false;
+        gnorm_tiled_blocking(&kp, tr, &blk2, &rows2, &half2);
+        const size_t off = hex_round_up((size_t) kp.vtcm_size, 2048);
+        if (opt_gnorm_tiled > 1) GGML_LOG_INFO("ggml-hex: gnorm-lut #%u rows %u/%u half %d/%d vtcm %zu -> %s\n", n, rows, rows2, half, half2, off + lut_bytes,
+                                               rows2 == rows && half2 == half && off + lut_bytes <= sess->vtcm_size ? "table" : "inline");
+        if (rows2 != rows || half2 != half || off + lut_bytes > sess->vtcm_size) return;
+        kp.block        = blk2;
+        kp.silu_lut_off = (uint32_t) off;
+        kp.vtcm_size    = (uint32_t) (off + lut_bytes);
+        memcpy(up, &kp, sizeof(kp));
+        memcpy(ops[n].kernel_params, &kp, sizeof(kp));
+    }
+
+    // GGML_HEXAGON_GNORM_TILED: the gated norm at op n (one-pass kernel) is read only through a token-row view as src1 of 2D
+    // HMX matmuls of this batch: it stores fp16 activation tiles of the token rows and the consumers DMA tile rows
+    void try_gnorm_tiled(unsigned int n) {
+        const htp_opnode & node = ops[n];
+        if (sess->mdev.count > 1 || node.opcode != HTP_OP_RMS_NORM_MUL || node.outputs.size() != 1 || node.inputs.size() != 3) return;
+        htp_op_desc & on = h_ops[n];
+        if (on.params[HTP_NORM_PARAM_GATE] != 1 || !(on.params[HTP_NORM_PARAM_FUSE] & 1) || on.params[HTP_NORM_PARAM_GTILED] ||
+            on.params[HTP_NORM_PARAM_TILED]) return;
+        const ggml_tensor * x = node.dst();
+        if (!x || !x->extra || !(((const ggml_hexagon_tensor_extra *) x->extra)->flags & GGML_HEXAGON_TENSOR_GTILED_SRC)) return;
+        const uint32_t n_uses = ((const ggml_hexagon_tensor_extra *) x->extra)->n_mm_uses;
+        auto * up = (struct htp_unary_kernel_params *) on.kernel_params;
+        if (up->col_tile != 0 || !up->broadcast_weight || up->block < 2 || x->ne[0] != 128) return;
+        // tile rows land at other token offsets than the rows read (another thread's input rows): no in-place output
+        for (const ggml_tensor * t : node.inputs) if (tensors_overlap(t, x)) return;
+        std::vector<unsigned int> cons;
+        int64_t K = 0;
+        for (unsigned int j = n + 1; j < n_ops; ++j) {
+            const htp_opnode & c = ops[j];
+            bool reads = false;
+            for (const ggml_tensor * t : c.inputs) reads = reads || (t && (t == x || (t->view_src == x && t->data == x->data)));
+            if (!reads) continue;
+            const auto * kp = (const struct htp_mm_kernel_params *) h_ops[j].kernel_params;
+            if ((c.opcode != HTP_OP_MUL_MAT && c.opcode != HTP_OP_MUL_MAT_ADD) || c.inputs.size() < 2) return;
+            const ggml_tensor * v = c.inputs[1];
+            if (!v || v->view_src != x || v->data != x->data || c.inputs[0] == v || (c.inputs.size() > 2 && c.inputs[2] == v)) return;
+            if (kp->n_hmx == 0 || kp->kernel_type != HTP_MM_KERNEL_HMX_2D || !(kp->pipeline & 1) || (kp->pipeline & HTP_MM_ACT_TILED_IN)) return;
+            if (c.inputs[0]->ne[0] != v->ne[0] || (K && K != v->ne[0])) return;
+            K = v->ne[0];
+            cons.push_back(j);
+        }
+        if (cons.empty() || cons.size() != n_uses || K % 128 != 0) return;
+        // blocks of whole 32-token tile rows: BLK = block / 2 (gate) must hold one; raise the block when VTCM allows
+        // (or one half tile row of 16 tokens when a whole one does not fit)
+        const uint32_t tr  = (uint32_t) (K / 128) * 32;
+        const uint32_t cap = (uint32_t) ((up->vtcm_src0_size_per_thread / 2) / (128 * sizeof(float)));
+        // (the DSP takes min(block, rows whose fp16 tiles + f32 gate rows fit a dst slot) rounded down to tile rows, or
+        // one half tile row (block / 2 rows) when a whole one does not fit)
+        const uint32_t dfit = (uint32_t) ((up->vtcm_dst_size_per_thread / 2) / (128 * sizeof(float) * 3 / 2));
+        uint32_t blk = std::min(std::max<uint32_t>(up->block, tr), cap);
+        // half mode (BLK = tr / 2 rows): the dst slot holds the tiles padded to a whole tile row plus the gate rows
+        const bool     half = (size_t) (up->vtcm_dst_size_per_thread / 2) >= (size_t) tr * 128 * sizeof(float);
+        const uint32_t rows = std::min(blk, dfit) >= tr ? std::min(blk, dfit) / tr * tr : (blk / 2 >= tr / 2 && half ? tr / 2 : 0);
+        if (opt_gnorm_tiled > 1) GGML_LOG_INFO("ggml-hex: gnorm-tiled #%u K %lld block %u cap %u dfit %u -> block %u rows %u\n", n, (long long) K, up->block, cap, dfit, blk, rows);
+        if (rows == 0) return;
+        up->block = blk;
+        ((struct htp_unary_kernel_params *) ops[n].kernel_params)->block = blk;
+        try_gnorm_lut(n, K, tr, rows, half);
+        on.params[HTP_NORM_PARAM_GTILED] = (int32_t) K;
+        for (unsigned int j : cons) {
+            ((struct htp_mm_kernel_params *) h_ops[j].kernel_params)->pipeline |= HTP_MM_ACT_TILED_IN;
+            ((struct htp_mm_kernel_params *) ops[j].kernel_params)->pipeline |= HTP_MM_ACT_TILED_IN;
+        }
+        ops[n].name += "+T";
+        HEX_VERBOSE("ggml-hex: %s fp16 tiled gated norm #%u (K %lld, block %u) -> %zu consumers\n", sess->c_name(), n, (long long) K, blk, cons.size());
+    }
+
+    // GGML_HEXAGON_NORM_EPI: the tiled RMS_NORM+MUL at op n reads the residual written by a 2D HMX MUL_MAT+ADD earlier in
+    // this batch: the matmul also stores the norm's tiles (dsts[1], weight src[3]) in slices between its HMX jobs, and the
+    // norm op only runs when the DSP could not (HTP_NORM_PARAM_EPI). Ops in between must not touch the tiles' memory.
+    void try_norm_epi(unsigned int n) {
+        const htp_opnode & node = ops[n];
+        if (sess->mdev.count > 1 || node.opcode != HTP_OP_RMS_NORM_MUL || node.outputs.size() != 1 || node.inputs.size() != 2) return;
+        const htp_op_desc & on = h_ops[n];
+        if (!on.params[HTP_NORM_PARAM_TILED] || on.params[HTP_NORM_PARAM_ROWS16] || on.params[HTP_NORM_PARAM_GATE] ||
+            !(on.params[HTP_NORM_PARAM_FUSE] & 2) || on.params[HTP_NORM_PARAM_EPI]) return;
+        const ggml_tensor * x = node.dst();
+        const ggml_tensor * s0 = node.inputs[0];
+        const ggml_tensor * w = node.inputs[1];
+        if (!x || !s0 || !w || w->type != GGML_TYPE_F32 || w->ne[0] != s0->ne[0] || ggml_nelements(w) != w->ne[0] ||
+            s0->ne[2] != 1 || s0->ne[3] != 1) return;
+        auto overlaps = [](const ggml_tensor * a, const ggml_tensor * b) {
+            if (!a || !b || !a->data || !b->data) return false;
+            const uint8_t * a0 = (const uint8_t *) a->data; const uint8_t * a1 = a0 + ggml_nbytes(a);
+            const uint8_t * b0 = (const uint8_t *) b->data; const uint8_t * b1 = b0 + ggml_nbytes(b);
+            return a0 < b1 && b0 < a1;
+        };
+        int p = -1;
+        for (int j = (int) n - 1; j >= 0; --j) {
+            bool writes = false;
+            for (const ggml_tensor * t : ops[j].outputs) writes = writes || overlaps(t, s0);
+            if (writes) { p = j; break; }
+        }
+        if (p < 0) return;
+        const htp_opnode & pn = ops[p];
+        htp_op_desc & op = h_ops[p];
+        if (pn.opcode != HTP_OP_MUL_MAT_ADD || pn.outputs.size() != 1 || pn.outputs[0] != s0 || op.dst[1] != 0xffff || op.src[3] != 0xffff ||
+            op.params[HTP_MM_PARAM_NORM_EPI]) return;
+        const auto * kp = (const struct htp_mm_kernel_params *) op.kernel_params;
+        if (kp->n_hmx == 0 || kp->kernel_type != HTP_MM_KERNEL_HMX_2D || !(kp->pipeline & 1) || (kp->pipeline & HTP_MM_FLAT)) return;
+        // 1: only producers with HVX slack between their HMX jobs, i.e. deep fp16-loop weights (k >= 2 n: ffn_down; the
+        // GGML_HEXAGON_I8 int8 loop has no slack: 2B ffn_down +35 ms for 18 ms of norm), 2: every producer
+        if (opt_norm_epi == 1 && (pn.inputs[0]->ne[0] < 2 * pn.inputs[0]->ne[1] || ggml_hexagon_tensor_has_i8(pn.inputs[0]))) return;
+        for (unsigned int q = (unsigned int) p + 1; q < n; ++q) {
+            for (const ggml_tensor * t : ops[q].inputs)  if (overlaps(t, x)) return;
+            for (const ggml_tensor * t : ops[q].outputs) if (overlaps(t, x) || overlaps(t, s0) || overlaps(t, w)) return;
+        }
+        if (overlaps(x, s0) || overlaps(x, w)) return;
+        // the producer writes x while it still reads its own inputs (activation, residual): ggml-alloc may hand their
+        // memory to x once the producer is done.
+        // GGML_HEXAGON_NORM_EPI_ALIAS (default 1): x may overlap the producer's tiled activation (input 1) or its f32
+        // residual (input 2) - ggml-alloc gives x the memory of an input whose last reader is the producer - when every
+        // byte of x written for token rows [0, R) lies in input rows the producer has finished with. The norm rows of
+        // an m-block are stored only after that block's last output chunk: by then the block's residual rows were read
+        // (staged or loaded in its epilogues) and its activation rows, and the next block's, were DMA'd into VTCM. With
+        // per-token-row bytes Bx (x fp16 tiles) <= Bi (activation fp16 tiles k * 2, residual row nb[1]) and
+        // d = x.data - input.data, rows [0, (b + 1) mc) of x end at d + (b + 1) mc Bx <= (b + 1) mc Bi for every block b
+        // when d + 32 Bx <= 32 Bi (mc >= 32). Weights and any other overlap: no NORM_EPI.
+        for (size_t q = 0; q < pn.inputs.size(); ++q) {
+            const ggml_tensor * t = pn.inputs[q];
+            if (!overlaps(t, x)) continue;
+            bool ok = false;
+            if (opt_norm_epi_alias && (q == 1 || q == 2) && t->type == GGML_TYPE_F32 && ggml_is_contiguous(t) && t->ne[1] == x->ne[1] &&
+                t->ne[2] == 1 && t->ne[3] == 1 && (q == 2 || (kp->pipeline & HTP_MM_ACT_TILED_IN))) {
+                const int64_t bx = x->ne[0] * 2;
+                const int64_t bi = q == 1 ? t->ne[0] * 2 : (int64_t) t->nb[1];
+                const int64_t d  = (int64_t) ((const uint8_t *) x->data - (const uint8_t *) t->data);
+                ok = bx <= bi && d + 32 * bx <= 32 * bi;
+                HEX_VERBOSE("ggml-hex: %s NORM_EPI #%u: x overlaps producer input %zu, d %lld bx %lld bi %lld -> %s\n", sess->c_name(), n, q,
+                            (long long) d, (long long) bx, (long long) bi, ok ? "ok" : "no");
+            }
+            if (!ok) return;
+        }
+        op.dst[1] = add_tensor(x);
+        op.src[3] = add_tensor(w);
+        op.params[HTP_MM_PARAM_NORM_EPI] = 1;
+        op.params[HTP_MM_PARAM_NORM_EPS] = on.params[0];
+        h_ops[n].params[HTP_NORM_PARAM_EPI] = 1;
+        ops[p].name += "+NORM";
+        HEX_VERBOSE("ggml-hex: %s RMS_NORM+MUL #%u stored by MUL_MAT+ADD #%d\n", sess->c_name(), n, p);
+    }
+
+    // Dense version of try_f16_act: a 2D HMX MUL_MAT(+ADD) whose src1 is the only use of a MUL_MAT_NX+SWIGLU output
+    // (same batch). The producer's paired epilogue writes fp16 in the consumer's activation tile layout, the
+    // consumer DMAs whole tile rows. The DSP producer takes the paired path under exactly the conditions below.
+    void try_dense_f16_act(unsigned int n) {
+        const htp_opnode & node = ops[n];
+        if (sess->mdev.count > 1 || (node.opcode != HTP_OP_MUL_MAT && node.opcode != HTP_OP_MUL_MAT_ADD)) return;
+        auto * kp = (struct htp_mm_kernel_params *) h_ops[n].kernel_params;
+        if (kp->n_hmx == 0 || kp->kernel_type != HTP_MM_KERNEL_HMX_2D || !(kp->pipeline & 1)) return;
+
+        const ggml_tensor * x = node.src1();
+        const ggml_tensor * w = node.src0();
+        if (!x || !w || !x->extra || x->type != GGML_TYPE_F32 || !ggml_is_contiguous(x) || x->ne[0] % 32 != 0 ||
+            x->ne[2] != 1 || x->ne[3] != 1 || x->ne[1] <= 32 || x->ne[0] != w->ne[0] || w->ne[2] != 1 || w->ne[3] != 1) {
+            return;
+        }
+        if (!(((const ggml_hexagon_tensor_extra *) x->extra)->flags & GGML_HEXAGON_TENSOR_F16_ACT)) return;
+
+        for (int j = (int) n - 1; j >= 0; --j) {
+            htp_opnode & p = ops[j];
+            if (p.opcode != HTP_OP_MUL_MAT_NX || p.outputs.size() != 2 || p.outputs[1] != x) continue;  // outputs[1] = the SWIGLU output
+            auto * pk = (struct htp_mm_kernel_params *) h_ops[j].kernel_params;
+            if (pk->epilogue != HTP_MM_EPI_SWIGLU && pk->epilogue != HTP_MM_EPI_SWIGLU_REV) return;
+            if (pk->n_hmx == 0 || pk->kernel_type != HTP_MM_KERNEL_HMX_2D || !(pk->pipeline & 1) || !(pk->pipeline & HTP_MM_SWIGLU_HF)) return;
+            if (pk->n_weights != 2 || p.inputs.size() < 3) return;
+            const ggml_tensor * w0 = p.inputs[0];
+            const ggml_tensor * w1 = p.inputs[1];
+            // the DSP's paired-epilogue condition (hmx_mm_nx_2d_f32 epi_pair)
+            if ((pk->n_chunk / 64) * 32 == 0 || w0->ne[1] != w1->ne[1] || w0->ne[1] % 32 != 0 || w0->nb[1] != w1->nb[1]) return;
+            if (w0->ne[1] != x->ne[0] || p.inputs.back()->ne[1] != x->ne[1]) return;
+
+            pk->pipeline |= HTP_MM_ACT_F16OUT;
+            ((struct htp_mm_kernel_params *) p.kernel_params)->pipeline |= HTP_MM_ACT_F16OUT;
+            const uint8_t fl = HTP_MM_ACT_TILED_IN | ((opt_mm_flat & 2) ? HTP_MM_FLAT : 0);
+            kp->pipeline |= fl;
+            ((struct htp_mm_kernel_params *) ops[n].kernel_params)->pipeline |= fl;
+            HEX_VERBOSE("ggml-hex: %s dense fp16 tiled SWIGLU activations #%d -> #%u\n", sess->c_name(), j, n);
+            return;
+        }
+    }
+
+    // The streamed expert MUL_MAT_ID at op n reads the SWIGLU output of a MUL_MAT_ID_NX+SWIGLU earlier in this batch,
+    // and nothing else reads it: the producer stores it as fp16 (first half of each f32 row slot) and the consumer
+    // gathers fp16 rows, which halves that intermediate's DDR traffic and skips one f32 round trip (the consumer
+    // converts its activations to fp16 anyway).
+    void try_f16_act(unsigned int n) {
+        const uint8_t bits = pair_f16_act(ops[n], (int) n - 1, (int) n);
+        if (bits) {
+            ((struct htp_mm_kernel_params *) h_ops[n].kernel_params)->pipeline |= bits;
+            ((struct htp_mm_kernel_params *) ops[n].kernel_params)->pipeline |= bits;
+        }
+    }
+
+    // Producer side of the hand-off above for the consumer `node` (the MUL_MAT_ID at op n of this batch, or not added
+    // yet: GGML_HEXAGON_MMID_XBATCH pairs a consumer that starts the next batch with a producer at the end of this one
+    // before it is flushed). Searches ops[j_from..0], sets the producer's flags and returns the consumer's pipeline
+    // bits (0 = no hand-off).
+    uint8_t pair_f16_act(const htp_opnode & node, int j_from, int n) {
+        if (node.opcode != HTP_OP_MUL_MAT_ID || sess->mdev.count > 1) return 0;
+
+        const auto * kp = (const struct htp_mm_kernel_params *) node.kernel_params;
+        const uint32_t need = HTP_MMID_STREAM | HTP_MMID_STREAM_DMA_GATHER;
+        if (kp->n_hmx == 0 || (kp->pipeline & need) != need) return 0;
+
+        const ggml_tensor * x = node.src1();
+        if (!x || !x->extra || x->type != GGML_TYPE_F32 || !ggml_is_contiguous(x) || x->ne[0] % 64 != 0 ||
+            x->nb[1] % 128 != 0 || x->nb[2] % 128 != 0 || x->ne[0] != node.src0()->ne[0]) {
+            return 0;
+        }
+        if (!(((const ggml_hexagon_tensor_extra *) x->extra)->flags & GGML_HEXAGON_TENSOR_F16_ACT)) return 0;
+
+        for (int j = j_from; j >= 0; --j) {
+            htp_opnode & p = ops[j];
+            if (p.opcode != HTP_OP_MUL_MAT_ID_NX || p.outputs.size() != 2 || p.outputs[0] != x) continue;
+            auto * pk = (struct htp_mm_kernel_params *) h_ops[j].kernel_params;
+            if (pk->epilogue != HTP_MM_EPI_SWIGLU_PAIR_HF && pk->epilogue != HTP_MM_EPI_SWIGLU_PAIR_H16) return 0;
+
+            // same math as before, rounded once to fp16 on the store
+            const uint8_t epi = pk->epilogue == HTP_MM_EPI_SWIGLU_PAIR_HF ? HTP_MM_EPI_SWIGLU_PAIR_F16OUT
+                                                                          : HTP_MM_EPI_SWIGLU_PAIR_H16_F16OUT;
+            pk->epilogue = epi;
+            ((struct htp_mm_kernel_params *) p.kernel_params)->epilogue = epi;
+            uint8_t bits = HTP_MMID_STREAM_ACT_F16;
+            HEX_VERBOSE("ggml-hex: %s fp16 SWIGLU activations #%d -> #%d\n", sess->c_name(), j, n);
+
+            // same expert ids on both ends: the expert-sorted tiled layout (the DSP falls back to rows when it does
+            // not fit and says so in a flag word)
+            const ggml_tensor * ids_p = p.inputs.back();
+            const ggml_tensor * ids_c = node.node->src[2];
+            const bool same_ids = ids_p && ids_c && (ids_p == ids_c || (ids_p->data == ids_c->data && ggml_are_same_shape(ids_p, ids_c) &&
+                                  ids_p->nb[0] == ids_c->nb[0] && ids_p->nb[1] == ids_c->nb[1] && ids_p->type == ids_c->type));
+            if (opt_mmid_act_tiled && same_ids && p.inputs.size() == 4) {
+                pk->pipeline |= HTP_MMID_STREAM_ACT_TILED;
+                ((struct htp_mm_kernel_params *) p.kernel_params)->pipeline |= HTP_MMID_STREAM_ACT_TILED;
+                bits |= HTP_MMID_STREAM_ACT_TILED;
+                HEX_VERBOSE("ggml-hex: %s tiled fp16 SWIGLU activations #%d -> #%d\n", sess->c_name(), j, n);
+            }
+            return bits;
+        }
+        return 0;
+    }
+
+    // The MOE_REDUCE at op n reads the output of a streamed expert MUL_MAT_ID earlier in this batch, and nothing else
+    // reads it: the producer stores its fp16 HMX values as fp16 rows (first half of each f32 row slot) and the MOE_REDUCE
+    // widens them exactly (half the DDR bytes of the intermediate).
+    void try_f16_moe(unsigned int n) {
+        const htp_opnode & node = ops[n];
+        if (node.opcode != HTP_OP_MOE_REDUCE || sess->mdev.count > 1) return;
+
+        const ggml_tensor * x = node.src0();
+        if (!x || !x->extra || x->type != GGML_TYPE_F32 || x->ne[0] % 64 != 0 || x->nb[0] != sizeof(float) ||
+            x->nb[1] % 128 != 0 || x->nb[2] % 128 != 0 || ((uintptr_t) x->data) % 128 != 0) {
+            return;
+        }
+        if (!(((const ggml_hexagon_tensor_extra *) x->extra)->flags & GGML_HEXAGON_TENSOR_F16_MOE)) return;
+
+        for (int j = (int) n - 1; j >= 0; --j) {
+            htp_opnode & p = ops[j];
+            if (p.outputs.size() != 1 || p.outputs[0] != x) continue;
