+    uint32_t       n_row_tiles;
+    uint32_t       n_col_tiles;
+    uint8_t *      hmx_scales;
+    atomic_uint    done;
+};
+
+static void htp_gdn_hmx_gemm2_worker(void * data) {
+    struct htp_gdn_hmx_gemm2_task * t = (struct htp_gdn_hmx_gemm2_task *) data;
+    asm volatile(HMX_SET_BIAS("%0") :: "r"((unsigned int) t->hmx_scales));
+    for (uint32_t r = 0; r < t->n_row_tiles; ++r) {
+        for (uint32_t c = 0; c < t->n_col_tiles; ++c) {
+            for (uint32_t sg = 0; sg < t->n_seg; ++sg) {
+                const __fp16 * rp = t->row[sg] + (size_t) r * t->row_stride[sg] * HMX_FP16_TILE_N_ELMS;
+                const __fp16 * cp = t->col[sg] + (size_t) c * t->col_stride[sg] * HMX_FP16_TILE_N_ELMS;
+                uint32_t k = 0;
+                for (; k + 2 <= t->n_dot[sg]; k += 2) {
+                    asm volatile(
+                        HMX_LOAD_MPY_F16("%1", "%2", "%0")
+                        HMX_LOAD_MPY_F16("%3", "%4", "%0")
+                        :: "r"(2047), "r"(rp), "r"(cp),
+                           "r"(rp + HMX_FP16_TILE_N_ELMS), "r"(cp + HMX_FP16_TILE_N_ELMS));
+                    rp += 2 * HMX_FP16_TILE_N_ELMS;
+                    cp += 2 * HMX_FP16_TILE_N_ELMS;
+                }
+                if (k < t->n_dot[sg]) {
+                    asm volatile(HMX_LOAD_MPY_F16("%1", "%2", "%0") :: "r"(2047), "r"(rp), "r"(cp));
+                }
+            }
+            __fp16 * o = t->out + (size_t) (r * t->out_rs + c * t->out_cs) * HMX_FP16_TILE_N_ELMS;
+            asm volatile(HMX_STORE_AFTER_F16("%0", "%1") :: "r"(o), "r"(0) : "memory");
+        }
+    }
+    atomic_store(&t->done, 1);
+}
+
+static inline void gdn_t2_set(struct htp_gdn_hmx_gemm2_task * t, const __fp16 * row, uint32_t rs, const __fp16 * col,
+                              uint32_t cs, uint32_t n_dot, __fp16 * out, uint32_t out_rs, uint32_t out_cs,
+                              uint32_t n_row_tiles, uint32_t n_col_tiles, uint8_t * scales) {
+    t->row[0] = row; t->row_stride[0] = rs;
+    t->col[0] = col; t->col_stride[0] = cs;
+    t->n_dot[0] = n_dot;
+    t->n_seg = 1;
+    t->out = out; t->out_rs = out_rs; t->out_cs = out_cs;
+    t->n_row_tiles = n_row_tiles; t->n_col_tiles = n_col_tiles;
+    t->hmx_scales = scales;
+}
+
+static inline void gdn_mt_push2(struct htp_gdn_mt_context * mc, struct htp_gdn_hmx_gemm2_task * task) {
+    atomic_store(&task->done, 0);
+    hmx_queue_t q = mc->octx->ctx->hmx_queue;
+    while (1) {
+        unsigned int expected = 0;
+        if (atomic_compare_exchange_weak(&mc->hmx_lock, &expected, 1)) {
+            const bool ok = hmx_queue_push(q, hmx_queue_make_desc(htp_gdn_hmx_gemm2_worker, task));
+            atomic_store(&mc->hmx_lock, 0);
+            if (ok) {
+                return;
+            }
+        }
+        hex_pause();
+    }
+}
+
+static inline void gdn_mt_wait2(struct htp_gdn_hmx_gemm2_task * task) {
+    while (!atomic_load(&task->done)) {
+        hex_pause();
+    }
+}
+
+static void gdn_mt_worker(unsigned int n, unsigned int i, void * data) {
+    (void) n;
+    struct htp_gdn_mt_context * mc = (struct htp_gdn_mt_context *) data;
+    struct htp_ops_context * octx = mc->octx;
+    const struct htp_gdn_kernel_params * kparams = mc->kparams;
+
+    const struct htp_tensor * q         = octx->src[0];
+    const struct htp_tensor * k         = octx->src[1];
+    const struct htp_tensor * v         = octx->src[2];
+    const struct htp_tensor * g         = octx->src[3];
+    const struct htp_tensor * beta      = octx->src[4];
+    const struct htp_tensor * state     = octx->src[5];
+    const struct htp_tensor * dst       = octx->dst;
+    const struct htp_tensor * dst_cache = octx->dsts[1];
+
+    const uint32_t S_v        = kparams->S_v;
+    const uint32_t H          = kparams->H;
+    const uint32_t n_tokens   = kparams->n_tokens;
+    const uint32_t chunk_size = kparams->chunk_size;
+    const uint32_t n_chunks   = kparams->n_chunks;
+    const uint32_t n_sv_tiles = S_v / 32;
+
+    const bool out_norm = (kparams->fuse & HTP_GDN_FUSE_OUT_NORM) != 0;
+    const struct htp_tensor * z_t   = out_norm ? octx->src[7]  : NULL;
+    const struct htp_tensor * out_t = out_norm ? octx->dsts[2] : NULL;
+    const uint32_t n_in = out_norm ? 4 : 3;
+    const bool     gb_v = mc->g_all != NULL;
+    const uint32_t n_gb = gb_v ? 0 : 2; // g/beta DMAs per chunk
+
+    dma_queue * dma_q = octx->ctx->dma[i];
+    uint8_t * const vtcm_base = (uint8_t *) octx->ctx->vtcm_base;
+
+    // the phase workers index heads[] by their thread argument: this thread always passes its own slot i
+    struct htp_gdn_head_ptrs * head = &mc->heads[i];
+    float * g_raw[2] = { mc->g_raw[0] + i * chunk_size, mc->g_raw[1] + i * chunk_size };
+    float * b_raw[2] = { mc->b_raw[0] + i * chunk_size, mc->b_raw[1] + i * chunk_size };
+
+    struct htp_gdn_hmx_gemm_task tk[9];
+    struct htp_gdn_hmx_gemm2_task t2[3]; // v2: delta, o, state update
+    const bool v2 = (kparams->pipeline & HTP_GDN_PIPE_V2) != 0;
+
+    struct htp_gdn_batch_context bctx;
+    bctx.heads      = mc->heads;
+    bctx.vtcm_g_raw = NULL;
+    bctx.vtcm_b_raw = NULL;
+    bctx.curr_buf   = 0;
+    bctx.c          = 0;
+    bctx.n_batch    = 1;          // g/b arrive per head (no gather)
+    bctx.S_v        = S_v;
+    bctx.scale      = kparams->scale;
+    bctx.norm_w     = mc->norm_w;
+    bctx.octx       = octx;
+    bctx.kparams    = kparams;
+    bctx.v2        = (kparams->pipeline & HTP_GDN_PIPE_V2) != 0;
+    bctx.fast      = bctx.v2 && (kparams->pipeline & HTP_GDN_PIPE_FASTNUM) != 0;
+
+    for (uint32_t r = mc->row_start + i; r < mc->row_start + mc->nrows; r += mc->n_workers) {
+        const uint32_t head_in_seq = fastmodulo(r, H, &kparams->div_H);
+        const uint32_t iv3         = fastdiv(r, &kparams->div_H);
+
+        // buffers of VTCM slot i; head indices for head_in_seq (gdn_init_head_ptrs adds the slot to base_iv1)
+        gdn_init_head_ptrs(head, &mc->L, vtcm_base, i, head_in_seq - i, iv3,
+                           q, k, v, state, dst, dst_cache, kparams, S_v, H, n_tokens, chunk_size);
+
+        dma_queue_push(dma_q, dma_make_data(v2 ? head->s_update_f32 : head->s_state, head->state_in_dma),
+                       S_v * sizeof(float), S_v * sizeof(float), S_v * sizeof(float), S_v);
+        dma_queue_pop(dma_q);
+        if (v2) {
+            gdn_v2_state_in(head->s_state, head->s_col_tiles, head->s_update_f32, S_v, head->vtcm_m, head->vtcm_tmp);
+        }
+
+        if (n_chunks > 0) {
+            if (!v2) {
+                gdn_hvx_init_state_worker(1, i, &bctx);
+            }
+
+            const uint32_t chunk0_tokens = hex_smin(chunk_size, n_tokens);
+            gdn_dma_push_chunk_inputs(dma_q, head->q_f32[0], head->k_f32[0], head->v_f32[0],
+                                      q, k, v, head->iq3, head->iq1, head->ik3, head->ik1,
+                                      head->iv3, head->iv1, 0, chunk0_tokens, S_v);
+            if (out_norm) {
+                gdn_dma_push_chunk_z(dma_q, head->z_f32[0], z_t, head->iv3, head->iv1, 0, chunk0_tokens, S_v);
+            }
+            if (!gb_v) {
+                gdn_dma_push_chunk_gb(dma_q, g_raw[0], b_raw[0], g, beta, iv3, head_in_seq, 0, chunk0_tokens, 1);
+            }
+        }
+
+        for (uint32_t c = 0; c < n_chunks; ++c) {
+            const uint32_t curr_buf = c & 1;
+            const uint32_t next_buf = (c + 1) & 1;
+            const uint32_t t_chunk  = c * chunk_size;
+
+            bctx.curr_buf   = curr_buf;
+            bctx.c          = c;
+            bctx.vtcm_g_raw = g_raw[curr_buf];
+            bctx.vtcm_b_raw = b_raw[curr_buf];
+
+            for (uint32_t j = 0; j < n_in + n_gb; ++j) {
+                dma_queue_pop(dma_q);
+            }
+            if (gb_v) {
+                const uint32_t nt = hex_smin(chunk_size, n_tokens - t_chunk);
+                for (uint32_t t = 0; t < nt; ++t) {
+                    g_raw[curr_buf][t] = mc->g_all[(t_chunk + t) * H + head_in_seq];
+                    b_raw[curr_buf][t] = mc->b_all[(t_chunk + t) * H + head_in_seq];
+                }
+            }
+
+            if (c + 1 < n_chunks) {
+                const uint32_t next_t_chunk = (c + 1) * chunk_size;
+                const uint32_t next_tokens  = hex_smin(chunk_size, n_tokens - next_t_chunk);
+                gdn_dma_push_chunk_inputs(dma_q, head->q_f32[next_buf], head->k_f32[next_buf], head->v_f32[next_buf],
+                                          q, k, v, head->iq3, head->iq1, head->ik3, head->ik1,
+                                          head->iv3, head->iv1, next_t_chunk, next_tokens, S_v);
+                if (out_norm) {
+                    gdn_dma_push_chunk_z(dma_q, head->z_f32[next_buf], z_t, head->iv3, head->iv1, next_t_chunk, next_tokens, S_v);
+                }
+                if (!gb_v) {
+                    gdn_dma_push_chunk_gb(dma_q, g_raw[next_buf], b_raw[next_buf], g, beta, iv3, head_in_seq,
+                                          next_t_chunk, next_tokens, 1);
+                }
+            }
+
+            if (c > 0) {
+                dma_queue_pop(dma_q); // the output of chunk c-1 (o_f32[next_buf]) has left VTCM
+            }
+
+            if (v2) {
+                gdn_hvx_phase1a_worker(1, i, &bctx);
+                gdn_mt_push(mc, &tk[0], head->k_row_tiles, head->k_col_tiles, head->kk_tiles, 2, 2, n_sv_tiles);
+                gdn_mt_push(mc, &tk[2], head->k_prime_row_tiles, head->s_col_tiles, head->v_inter_tiles, 2, n_sv_tiles, n_sv_tiles);
+
+                gdn_hvx_phase1b_worker(1, i, &bctx);
+                gdn_mt_wait(&tk[0]);
+                gdn_mt_push(mc, &tk[1], head->q_row_tiles, head->k_col_tiles, head->qk_tiles, 2, 2, n_sv_tiles);
+
+                gdn_hvx_phase2_worker(1, i, &bctx);
+                gdn_mt_wait(&tk[2]);
+                gdn_mt_wait(&tk[1]);
+                gdn_mt_push(mc, &tk[7], (__fp16 *) head->vtcm_m, head->inv_row_tiles + 0 * HMX_FP16_TILE_N_ELMS,
+                            (__fp16 *) head->vtcm_tmp, 1, 1, 1);
+                gdn_mt_push(mc, &tk[8], (__fp16 *) head->vtcm_m + HMX_FP16_TILE_N_ELMS, (__fp16 *) head->vtcm_tmp,
+                            head->inv_row_tiles + 2 * HMX_FP16_TILE_N_ELMS, 1, 1, 1);
+
+                gdn_hvx_phase3_worker(1, i, &bctx);
+                gdn_mt_wait(&tk[7]);
+                gdn_mt_wait(&tk[8]);
+                // delta = inv x v', written in weight-tile order (tile (a, t) at a * 2 + t)
+                gdn_t2_set(&t2[0], head->inv_row_tiles, 2, head->v_prime_col_tiles, 2, 2,
+                           head->delta_col_tiles, 1, 2, 2, n_sv_tiles, mc->scales_1);
+                gdn_mt_push2(mc, &t2[0]);
+                gdn_mt_wait2(&t2[0]);
+
+                gdn_hvx_phase4_worker(1, i, &bctx);
+                // o = scale * (q' W + A delta): one job, two dot segments
+                gdn_t2_set(&t2[1], head->q_prime_row_tiles, n_sv_tiles, head->s_col_tiles, n_sv_tiles, n_sv_tiles,
+                           head->o_inter_tiles, n_sv_tiles, 1, 2, n_sv_tiles, mc->scales_o);
+                t2[1].row[1] = head->a_row_tiles;      t2[1].row_stride[1] = 2;
+                t2[1].col[1] = head->delta_col_tiles;  t2[1].col_stride[1] = 2;
+                t2[1].n_dot[1] = 2;
+                t2[1].n_seg = 2;
+                gdn_mt_push2(mc, &t2[1]);
+                // W update = k^T d, written in weight-tile order (tile (a, b) at a * n_sv + b)
+                gdn_t2_set(&t2[2], head->d_row_tiles, 2, head->k_col_tiles_64x128, 2, 2,
+                           head->s_update_tiles, 1, n_sv_tiles, n_sv_tiles, n_sv_tiles, mc->scales_1);
+                gdn_mt_push2(mc, &t2[2]);
+                gdn_mt_wait2(&t2[1]);
+            } else {
+                gdn_hvx_phase1a_worker(1, i, &bctx);
+                gdn_mt_push(mc, &tk[0], head->k_row_tiles, head->k_col_tiles, head->kk_tiles, 2, 2, n_sv_tiles);
+                gdn_mt_push(mc, &tk[2], head->k_prime_row_tiles, head->s_col_tiles, head->v_inter_tiles, 2, n_sv_tiles, n_sv_tiles);
+
+                gdn_hvx_phase1b_worker(1, i, &bctx);
+                gdn_mt_wait(&tk[0]);
+                gdn_mt_push(mc, &tk[1], head->q_row_tiles, head->k_col_tiles, head->qk_tiles, 2, 2, n_sv_tiles);
+                gdn_mt_push(mc, &tk[3], head->q_prime_row_tiles, head->s_col_tiles, head->o_inter_tiles, 2, n_sv_tiles, n_sv_tiles);
+
+                gdn_hvx_phase2_worker(1, i, &bctx);
+                gdn_mt_wait(&tk[2]);
+                gdn_mt_wait(&tk[1]);
+                gdn_mt_push(mc, &tk[7], (__fp16 *) head->vtcm_m, head->inv_row_tiles + 0 * HMX_FP16_TILE_N_ELMS,
+                            (__fp16 *) head->vtcm_tmp, 1, 1, 1);
+                gdn_mt_push(mc, &tk[8], (__fp16 *) head->vtcm_m + HMX_FP16_TILE_N_ELMS, (__fp16 *) head->vtcm_tmp,
+                            head->inv_row_tiles + 2 * HMX_FP16_TILE_N_ELMS, 1, 1, 1);
+
+                gdn_hvx_phase3_worker(1, i, &bctx);
+                gdn_mt_wait(&tk[3]);
+                gdn_mt_wait(&tk[7]);
+                gdn_mt_wait(&tk[8]);
+                gdn_mt_push(mc, &tk[4], head->inv_row_tiles, head->v_prime_col_tiles, head->delta_tiles, 2, n_sv_tiles, 2);
+                gdn_mt_wait(&tk[4]);
+
+                gdn_hvx_phase4_worker(1, i, &bctx);
+                gdn_mt_push(mc, &tk[5], head->a_row_tiles, head->delta_col_tiles, head->o_intra_tiles, 2, n_sv_tiles, 2);
+                gdn_mt_push(mc, &tk[6], head->d_row_tiles, head->k_col_tiles_64x128, head->s_update_tiles, n_sv_tiles, n_sv_tiles, 2);
+                gdn_mt_wait(&tk[5]);
+            }
+
+            gdn_hvx_phase5_worker(1, i, &bctx);
+
+            const uint32_t valid_tokens = hex_smin(chunk_size, n_tokens - t_chunk);
+            if (out_norm) {
+                const dma_addr_t out_chunk_dma = out_t->data + (uint64_t) head->iv3 * out_t->nb[3] +
+                    (uint64_t) t_chunk * out_t->nb[2] + (uint64_t) head->iv1 * out_t->nb[1];
+                dma_queue_push(dma_q, dma_make_data(out_chunk_dma, head->o_f32[curr_buf]),
+                               out_t->nb[2], S_v * sizeof(float), S_v * sizeof(float), valid_tokens);
+            } else {
+                const dma_addr_t attn_chunk_dma = dst->data +
+                    ((uint64_t) head->iv3 * n_tokens * H + (uint64_t) t_chunk * H + head->iv1) * S_v * sizeof(float);
+                dma_queue_push(dma_q, dma_make_data(attn_chunk_dma, head->o_f32[curr_buf]),
+                               dst->nb[1], S_v * sizeof(float), S_v * sizeof(float), valid_tokens);
+            }
+
+            if (v2) {
+                gdn_mt_wait2(&t2[2]);
+            } else {
+                gdn_mt_wait(&tk[6]);
+            }
+            gdn_hvx_phase6_worker(1, i, &bctx);
+        }
+
+        if (n_chunks > 0) {
+            dma_queue_pop(dma_q);
+        }
+
+        if (v2) {
+            gdn_v2_state_out(head->s_update_f32, head->s_state, S_v, head->vtcm_m, head->vtcm_tmp);
+        }
+        dma_queue_push(dma_q, dma_make_data(head->state_out_dma, v2 ? head->s_update_f32 : head->s_state),
+                       S_v * sizeof(float), S_v * sizeof(float), S_v * sizeof(float), S_v);
+        dma_queue_pop(dma_q);
+    }
+
+    dma_queue_flush(dma_q);
+}
+
+static int gated_delta_net_f32_hmx_mt(
+    struct htp_ops_context * octx,
+    const struct htp_gdn_kernel_params * kparams,
+    uint32_t row_start,
+    uint32_t nrows
+) {
+    const uint32_t S_v        = kparams->S_v;
+    const uint32_t chunk_size = kparams->chunk_size;
+    const bool     out_norm   = (kparams->fuse & HTP_GDN_FUSE_OUT_NORM) != 0;
+    if (out_norm && (!octx->src[6] || !octx->src[7] || !octx->dsts[2])) {
+        return HTP_STATUS_INVAL_PARAMS;
+    }
+
+    struct htp_gdn_mt_context mc;
+    htp_gdn_hmx_vtcm_layout_build(&mc.L, S_v, chunk_size, kparams->n_heads_batch, kparams->n_threads, true);
+    const bool   gb_v     = (kparams->pipeline & HTP_GDN_PIPE_GB_VTCM) && kparams->n_seqs == 1;
+    const size_t gb_bytes = gb_v ? htp_gdn_gb_vtcm_bytes(kparams->n_tokens, kparams->H) : 0;
+    if (mc.L.total_bytes + 2 * gb_bytes > octx->ctx->vtcm_size) {
+        return HTP_STATUS_VTCM_TOO_SMALL;
+    }
+
+    uint8_t * const vtcm_base = (uint8_t *) octx->ctx->vtcm_base;
+    mc.octx      = octx;
+    mc.kparams   = kparams;
+    mc.g_raw[0]  = VTCM_LAYOUT_PTR(float, vtcm_base, mc.L.off_g_raw[0]);
+    mc.g_raw[1]  = VTCM_LAYOUT_PTR(float, vtcm_base, mc.L.off_g_raw[1]);
+    mc.b_raw[0]  = VTCM_LAYOUT_PTR(float, vtcm_base, mc.L.off_b_raw[0]);
+    mc.b_raw[1]  = VTCM_LAYOUT_PTR(float, vtcm_base, mc.L.off_b_raw[1]);
+    mc.scales_1  = VTCM_LAYOUT_PTR(uint8_t, vtcm_base, mc.L.off_scales_1);
+    mc.scales_o  = mc.scales_1 + 2 * sizeof(HVX_Vector); // the scales block is one 2 KB tile, the 1.0 scales use 256 B
+    mc.norm_w    = VTCM_LAYOUT_PTR(float, vtcm_base, mc.L.off_norm_w);
+    mc.row_start = row_start;
+    mc.nrows     = nrows;
+    // one VTCM head slot per worker (the raw g/b buffers hold n_heads_batch * chunk_size floats each)
+    mc.n_workers = hex_smin((uint32_t) kparams->n_heads_batch, nrows);
+    atomic_store(&mc.hmx_lock, 0);
+    mc.g_all = NULL;
+    mc.b_all = NULL;
+
+    hmx_init_column_scales(mc.scales_1, Q6_V_vsplat_R(0x3c00));
+    {
+        __fp16   hs = (__fp16) kparams->scale;
+        uint16_t hb;
+        memcpy(&hb, &hs, sizeof(hb));
+        hmx_init_column_scales(mc.scales_o, Q6_V_vsplat_R((uint32_t) hb));
+    }
+
+    dma_queue * dma_q = octx->ctx->dma[0];
+    if (out_norm) {
+        dma_queue_push(dma_q, dma_make_data((void *) mc.norm_w, octx->src[6]->data), 0, 0, S_v * sizeof(float), 1);
+        dma_queue_pop(dma_q);
+    }
+    if (gb_v) {
+        // all of g and beta before any worker writes an output (the gated-norm output may reuse their memory)
+        const struct htp_tensor * g    = octx->src[3];
+        const struct htp_tensor * beta = octx->src[4];
+        const uint32_t H = kparams->H, T = kparams->n_tokens;
+        float * g_all = VTCM_LAYOUT_PTR(float, vtcm_base, mc.L.total_bytes);
+        float * b_all = VTCM_LAYOUT_PTR(float, vtcm_base, mc.L.total_bytes + gb_bytes);
+        const uint32_t row = H * sizeof(float);
+        if (g->nb[2] == row && beta->nb[2] == row && (T * row) % 2048 == 0) {
+            // contiguous: 2 KB rows instead of one short row per token
+            dma_queue_push(dma_q, dma_make_data(g_all, g->data), 2048, 2048, 2048, T * row / 2048);
+            dma_queue_push(dma_q, dma_make_data(b_all, beta->data), 2048, 2048, 2048, T * row / 2048);
+        } else {
+            dma_queue_push(dma_q, dma_make_data(g_all, g->data), row, g->nb[2], row, T);
+            dma_queue_push(dma_q, dma_make_data(b_all, beta->data), row, beta->nb[2], row, T);
+        }
