+        for (; st->bag_nc[i] < st->bag_np[i]; ++st->bag_nc[i]) {
+            hmx_mmid_bag_cvt_blk(st->ctx->dma[i], st->bag_dst, HMX_MMID_BAG_BLK(st->bag_nc[i]), st->bag_rows, st->k);
+        }
+        st->bag_np[i] = st->bag_nc[i] = 0;
+        htp_trace_event_stop(tr, HTP_TRACE_EVT_HVX_A_PREP, 4000);
+    }
