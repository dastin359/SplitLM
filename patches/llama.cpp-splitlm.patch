+static inline void hmx_xb_push_stage(hmx_xb_t * X, uint32_t j) {
+    hmx_xb_job_t J;
+    hmx_xb_job(X, j, &J);
+    dma_queue_push(X->dma, dma_make_data(X->stage, X->src2_addr + (J.mr * X->src2_stride + J.nc) * sizeof(float)),
+                   hex_align_up(J.n_cols, 32) * sizeof(float), X->src2_stride * sizeof(float), J.n_cols * sizeof(float), J.n_rows);
+    X->seq_s = xb_push(X);
+}
+
+// int loop: readout windows of job q -> the fused output conversion (begin) or fp16 tiles in place (convert)
+static inline void hmx_xb_i8_out(hmx_xb_t * X, uint32_t q, const hmx_xb_job_t * J, __fp16 * obuf, bool convert) {
+    const uint32_t s   = hmx_xb_slot(X, q);
+    const uint32_t nct = hmx_ceil_div(J->dq_cols, HTP_MM_HMX_TILE_N_COLS);
+    const float *  rs  = X->rs[J->b % 2];
+    if (convert) {
+        const uint32_t n_rt = (uint32_t) hmx_ceil_div(J->n_rows, HTP_MM_HMX_TILE_N_ROWS);
+        if (X->a8) {
+            hmx_a8_out_convert_threaded(X->ctx, obuf, X->m8[s % 4], rs, n_rt, nct, (uint32_t) X->n_threads);
+        } else {
+            hmx_i8_out_convert_threaded(X->ctx, obuf, X->hi[q % 2], X->m8[s % 4], rs, n_rt, nct, (uint32_t) X->n_threads);
+        }
+    } else if (X->a8) {
+        hmx_a8_out_begin(obuf, X->m8[s % 4], rs, nct);
+        g_i8o.h16 = X->h16;
+    } else {
+        hmx_i8_out_begin(obuf, X->hi[q % 2], X->m8[s % 4], rs, nct);
+    }
+}
+
+static void hmx_xb_store(hmx_xb_t * X, uint32_t q, __fp16 * obuf) {
+    struct htp_context * ctx = X->ctx;
+    hmx_xb_job_t J;
+    hmx_xb_job(X, q, &J);
+    if (X->kind == 0) {
+        float *       out         = X->dst + (J.mr * X->dst_stride + J.nc);
+        const float * bias_chunk  = X->bias_base ? (X->bias_base + J.mr * X->src2_stride + J.nc) : NULL;
+        uint32_t      bias_stride = X->src2_stride;
+        if (X->i8) hmx_xb_i8_out(X, q, &J, obuf, false);
+        if (X->stage) {
+            xb_wait(X, X->seq_s);  // S_q
+            bias_chunk  = X->stage;
+            bias_stride = (uint32_t) hex_align_up(J.n_cols, 32);
+        }
+        const int chunk_dst_cols = X->dst_cols - (int) J.nc;
+        if (chunk_dst_cols > 0) {
+            transfer_output_chunk_threaded(ctx, out, bias_chunk, obuf, (int) J.n_rows, (int) J.n_cols, X->dst_stride, bias_stride,
+                                           chunk_dst_cols, X->n_threads, X->out_split);
+        }
+        g_i8o.on = 0;
+        if (X->stage && q + 1 < X->n_jobs) hmx_xb_push_stage(X, q + 1);  // the stage is free again
+        if (X->nepi) {
+            const uint32_t r = q % X->jpb;
+            if (r == X->jpb - 1) htp_nepi_ready((uint32_t) (J.mr + J.n_rows));
+            else htp_nepi_step(X->jpb - 1 - r);  // the next job of this block runs on HMX
+        }
+    } else if (X->kind == 1) {
+        if (X->f16_out) {
+            if (X->i8) hmx_xb_i8_out(X, q, &J, obuf, false);
+            hmx_tiled_swiglu_threaded(ctx, (__fp16 *) X->pdst + (J.mr / HTP_MM_HMX_TILE_N_ROWS) * X->pn * HTP_MM_HMX_TILE_N_ROWS, obuf,
+                                      (uint32_t) J.n_rows, (uint32_t) J.n_cols, (uint32_t) (J.nc / 32), (uint32_t) (X->pn / 32), X->hf,
+                                      X->n_threads);
+            g_i8o.on = 0;
+        } else {
+            if (X->i8) hmx_xb_i8_out(X, q, &J, obuf, true);
+            transfer_output_chunk_threaded_epi(ctx, X->epi_pair_id, X->pdst + (J.mr * X->pdst_stride + J.nc), NULL, obuf, (int) J.n_rows,
+                                               (int) J.n_cols, (int) X->pdst_stride, 0, X->pdst_cols - (int) J.nc, X->n_threads,
+                                               X->out_split);
+        }
+    } else {
+        const struct htp_tensor * restrict dst = X->octx->dsts[J.p];
+        float *        dst_ptr     = (float *) dst->data;
+        const size_t   dst_stride  = dst->nb[1] / sizeof(float);
+        const int      dst_cols    = (int) dst->ne[0];
+        const bool     swiglu_out  = X->epi_swiglu && J.p == 1;
+        const uint32_t epi         = swiglu_out ? (uint32_t) X->kparams->epilogue : HTP_MM_EPI_NONE;
+        const float *  gate_ptr    = swiglu_out ? (const float *) X->octx->dsts[0]->data : NULL;
+        const uint32_t gate_stride = swiglu_out ? X->octx->dsts[0]->nb[1] / sizeof(float) : 0;
+        const int      chunk_cols  = dst_cols - (int) J.nc;
+        if (X->i8) hmx_xb_i8_out(X, q, &J, obuf, epi != HTP_MM_EPI_NONE);
+        if (chunk_cols > 0) {
+            transfer_output_chunk_threaded_epi(ctx, epi, dst_ptr + (J.mr * dst_stride + J.nc),
+                                               gate_ptr ? gate_ptr + (J.mr * gate_stride + J.nc) : NULL, obuf, (int) J.n_rows,
+                                               (int) J.n_cols, (int) dst_stride, gate_stride, chunk_cols, X->n_threads, X->out_split);
+        }
+        g_i8o.on = 0;
+    }
+}
