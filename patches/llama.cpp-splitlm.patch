+// SWIGLU of a gate/up column pair computed by one HMX job: of the 2 * nt column tiles of the output chunk,
+// [0, nt) hold the gate and [nt, 2 nt) the up columns (total_n_cols = nt * 32 output columns)
+static void transfer_output_chunk_swiglu_pair_col_chunk(
+    float *restrict dst,
+    const __fp16 *restrict vtcm_src,
+    uint32_t start_row,
