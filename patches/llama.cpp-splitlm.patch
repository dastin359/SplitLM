+
+extern "C" bool ggml_cpu_repack_moe_supported(const struct ggml_tensor * mmid) {
+    if (mmid->op != GGML_OP_MUL_MAT_ID || mmid->src[1]->type != GGML_TYPE_F32 || ggml_n_dims(mmid->src[0]) != 3) {
+        return false;
+    }
+    auto * t = moe_traits(mmid);
+    return t != nullptr && t->moe_supported() && mmid->src[0]->ne[1] % QK8_0 == 0 && mmid->src[0]->ne[0] % QK8_0 == 0;
+}
+
+extern "C" void ggml_cpu_repack_moe_gate_up(const struct ggml_compute_params * params, const struct ggml_tensor * up,
+                                            const struct ggml_tensor * gate, struct ggml_tensor * glu, const struct ggml_tensor * down) {
+    moe_traits(up)->moe_gate_up(params, up, gate, glu, down);
+}
+
+extern "C" void ggml_cpu_repack_moe_down(const struct ggml_compute_params * params, const struct ggml_tensor * down,
+                                         const struct ggml_tensor * weights, struct ggml_tensor * out) {
+    moe_traits(down)->moe_down(params, down, weights, out);
+}
