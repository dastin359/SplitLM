+    float   * S   = M + n_head;                       // [n_head]
+    float   * sc  = S + n_head;                       // [GB][BKV] scores, then probabilities
+    float   * w   = sc + FA_DEC_GBMAX*FA_DEC_BKV;     // [BKV][4] probabilities by position
+    int32_t * idx = (int32_t *) (w + 4*FA_DEC_BKV);   // [BKV] unmasked positions of the block
