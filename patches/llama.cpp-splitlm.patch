+// Sigmoid that stays in qf32. v73 has no IEEE f32 vector math and issues one qf32 add/sub/convert per
+// packet, so this cuts f32 round trips: vmin/vmax clamp, magic-number rounding, 2 Newton-Raphson steps.
+// Same e^x / (e^x + 1) construction as hvx_vec_fast_sigmoid_f32. Returns qf32.
+struct hvx_sigmoid_qf32_consts {
+    HVX_Vector k, mag, hi, lo, c1, c2, l2, rcp_seed, two;
+};
+
+static inline struct hvx_sigmoid_qf32_consts hvx_sigmoid_qf32_consts_init(void) {
+    const HVX_Vector zero = Q6_V_vzero();
+    struct hvx_sigmoid_qf32_consts c;
+    c.k        = hvx_vec_splat_f32(0.72134752f);  // log2(e) / 2
+    c.mag      = hvx_vec_splat_f32(12582912.0f);  // 1.5 * 2^23, rounds to the nearest integer
+    c.hi       = hvx_vec_splat_f32(40.0f);
+    c.lo       = hvx_vec_splat_f32(-40.0f);
+    c.c1       = Q6_Vqf32_vadd_VsfVsf(Q6_V_vsplat_R(FAST_SIGMOID_C1), zero);
+    c.c2       = Q6_Vqf32_vadd_VsfVsf(Q6_V_vsplat_R(FAST_SIGMOID_C2), zero);
+    c.l2       = Q6_Vqf32_vadd_VsfVsf(Q6_V_vsplat_R(FAST_SIGMOID_LOG2F), zero);
+    c.rcp_seed = Q6_V_vsplat_R(0x7EEEEBB3);
+    c.two      = Q6_Vqf32_vadd_VsfVsf(hvx_vec_splat_f32(2.0f), zero);
+    return c;
+}
+
+static inline HVX_Vector hvx_vec_sigmoid_qf32(HVX_Vector x, const struct hvx_sigmoid_qf32_consts * c) {
+    const HVX_Vector xc  = Q6_Vsf_vmin_VsfVsf(Q6_Vsf_vmax_VsfVsf(x, c->lo), c->hi);
+    const HVX_Vector v_q = Q6_Vqf32_vmpy_VsfVsf(xc, c->k);
+    const HVX_Vector v   = Q6_Vsf_equals_Vqf32(v_q);
+
+    // v = n + f, n integer, |f| <= 0.5
+    const HVX_Vector t   = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vadd_VsfVsf(v, c->mag));
+    const HVX_Vector n   = Q6_Vw_vsub_VwVw(t, c->mag);
+    const HVX_Vector f   = Q6_Vqf32_vsub_Vqf32Vqf32(v_q, Q6_Vqf32_vsub_VsfVsf(t, c->mag));
+    const HVX_Vector ff  = Q6_Vqf32_vmpy_Vqf32Vqf32(f, f);
+
+    // 4^f ~ (v1 + v2) / (v1 - v2)
+    const HVX_Vector v1 = Q6_Vqf32_vadd_Vqf32Vqf32(Q6_Vqf32_vmpy_Vqf32Vqf32(ff, c->c2), c->l2);
+    const HVX_Vector v2 = Q6_Vqf32_vadd_Vqf32Vqf32(Q6_Vqf32_vmpy_Vqf32Vqf32(Q6_Vqf32_vmpy_Vqf32Vqf32(f, c->c1), ff), f);
+
+    // A = (v1 + v2) * 4^n, sigmoid = A / (A + v1 - v2)
+    HVX_Vector a = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vadd_Vqf32Vqf32(v2, v1));
+    a            = Q6_Vw_vaslacc_VwVwR(a, n, 24);
+    const HVX_Vector d_q = Q6_Vqf32_vadd_Vqf32Vsf(Q6_Vqf32_vsub_Vqf32Vqf32(v1, v2), a);
+    const HVX_Vector d   = Q6_Vsf_equals_Vqf32(d_q);
+
+    const HVX_Vector r0 = Q6_Vw_vsub_VwVw(c->rcp_seed, d);
+    const HVX_Vector e1 = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vsub_Vqf32Vqf32(c->two, Q6_Vqf32_vmpy_VsfVsf(r0, d)));
+    const HVX_Vector r1 = Q6_Vqf32_vmpy_VsfVsf(r0, e1);
+    const HVX_Vector e2 = Q6_Vqf32_vsub_Vqf32Vqf32(c->two, Q6_Vqf32_vmpy_Vqf32Vqf32(r1, d_q));
+    const HVX_Vector r2 = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_Vqf32Vqf32(r1, e2));
+
+    return Q6_Vqf32_vmpy_VsfVsf(a, r2);
+}
