+// RMS norm of up to 32 short rows (nvec full vectors each, no tail) at once: the per-row sums of squares
+// are reduced together with a transposed deal/add tree (lane r of the result = row r), so one rsqrt serves
+// all rows instead of a reduce + rsqrt latency chain per row. Optional broadcast weight row w.
+static inline void hvx_rms_norm_rows32_f32(const uint8_t * restrict src, uint32_t src_stride,
+                                           uint8_t * restrict dst, uint32_t dst_stride, uint32_t nvec,
+                                           uint32_t nrows, const uint8_t * restrict w, HVX_Vector inv_n_v,
+                                           HVX_Vector epsilon_v, HVX_Vector post_scale_v) {
+    HVX_Vector s[32];
+    for (uint32_t r = nrows; r < 32; r++) {
+        s[r] = Q6_V_vzero();
+    }
+    for (uint32_t r = 0; r < nrows; r++) {
+        const HVX_Vector * x = (const HVX_Vector *) (src + r * src_stride);
+        HVX_Vector acc = Q6_Vqf32_vmpy_VsfVsf(x[0], x[0]);
+        for (uint32_t v = 1; v < nvec; v++) {
+            acc = Q6_Vqf32_vadd_Vqf32Vqf32(acc, Q6_Vqf32_vmpy_VsfVsf(x[v], x[v]));
+        }
+        s[r] = acc;
+    }
+
+    // deal even/odd words of each pair and add: rows stay in order, partials per row halve each level
+    for (uint32_t n = 32; n > 1; n /= 2) {
+        for (uint32_t j = 0; j < n / 2; j++) {
+            const HVX_VectorPair d = Q6_W_vdeal_VVR(s[2 * j + 1], s[2 * j], -4);
+            s[j] = Q6_Vqf32_vadd_Vqf32Vqf32(Q6_V_lo_W(d), Q6_V_hi_W(d));
+        }
+    }
+
+    const HVX_Vector ms = Q6_Vqf32_vadd_Vqf32Vsf(Q6_Vqf32_vmpy_VsfVsf(Q6_Vsf_equals_Vqf32(s[0]), inv_n_v), epsilon_v);
+    HVX_Vector       sc = hvx_vec_rsqrt_f32(Q6_Vsf_equals_Vqf32(ms));
+    sc = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(sc, post_scale_v));
+
+    float scv[32] __attribute__((aligned(128)));
+    *(HVX_Vector *) scv = sc;
+
+    const HVX_Vector * vw = (const HVX_Vector *) w;
+    for (uint32_t r = 0; r < nrows; r++) {
+        const HVX_Vector   k = hvx_vec_splat_f32(scv[r]);
+        const HVX_Vector * x = (const HVX_Vector *) (src + r * src_stride);
+        HVX_Vector *       y = (HVX_Vector *) (dst + r * dst_stride);
+        if (vw) {
+            for (uint32_t v = 0; v < nvec; v++) {
+                const HVX_Vector t = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(x[v], k));
+                y[v] = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(t, vw[v]));
+            }
+        } else {
+            for (uint32_t v = 0; v < nvec; v++) {
+                y[v] = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(x[v], k));
+            }
+        }
+    }
+}
+
+// Same as hvx_fast_rms_norm_f32 with 1/n hoisted by the caller and an extra scale folded into the
+// per-row factor (fused RMS_NORM + SCALE)
+static inline void hvx_fast_rms_norm_scaled_f32(const uint8_t * restrict src,
+                                                uint8_t * restrict dst,
+                                                const int num_elems,
+                                                HVX_Vector inv_n_v,
+                                                HVX_Vector epsilon_v,
+                                                HVX_Vector post_scale_v) {
+    const HVX_Vector * restrict v_src = (HVX_Vector *) src;
+    HVX_Vector * restrict v_dst       = (HVX_Vector *) dst;
+
+    const int nvec = num_elems / VLEN_FP32;
+    const int nloe = num_elems % VLEN_FP32;
+
+    HVX_Vector sum_v = Q6_V_vsplat_R(0x00000000);
+
+    #pragma unroll(4)
+    for (int i = 0; i < nvec; i++) {
+        HVX_Vector v1 = v_src[i];
+        sum_v = Q6_Vqf32_vadd_Vqf32Vqf32(sum_v, Q6_Vqf32_vmpy_VsfVsf(v1, v1));
+    }
