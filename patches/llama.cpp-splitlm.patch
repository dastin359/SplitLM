+// ============================================================================
+// Causal KV-block skip
+// ============================================================================
+//
+// fa_softmax_impl() treats every mask value <= -16 as -inf. For a KV block whose mask is <= -16 in every
+// row of the query block, each row gets rowmax = -inf, so m and l stay unchanged (m is always an fp16
+// value), D = exp2(0) = 1 and P = exp2(<= -24) = 0: the block only costs an HMX pass O = 1*O + 0*V.
+// That pass is a mathematical no-op but can re-round O, so outputs match to fp16 rounding, not always
+// bit for bit. Under a causal mask every KV block past the diagonal is such a block. We skip them only
+// at the tail of the KV range so the pipeline order (block 0 first, its DMAs queued early) is unchanged.
+
+// Max over the fp16 mask values in [row, row + row_bytes) (DDR). Aligned 128-byte loads only, so the
+// scan never touches a cache line (or page) outside the row; lanes outside the row read as -inf.
+static inline HVX_Vector fa_mask_row_max(const uint8_t * row, uint32_t row_bytes, HVX_Vector v_acc) {
+    const HVX_Vector v_neg_inf = Q6_Vh_vsplat_R(0xfbff);
+    const uint32_t   a0        = (uint32_t) row;
+    const uint32_t   a1        = a0 + row_bytes;
+    for (uint32_t line = a0 & ~127u; line < a1; line += 128) {
+        const uint32_t lo = (a0 > line) ? a0 - line : 0;        // first valid byte in this line
+        const uint32_t hi = (a1 - line < 128) ? a1 - line : 128; // one past the last valid byte
+        HVX_VectorPred q  = Q6_Q_vsetq2_R(hi);
+        if (lo) {
+            q = Q6_Q_and_QQn(q, Q6_Q_vsetq_R(lo));
+        }
+        const HVX_Vector v = *(const HVX_Vector *) line;
+        v_acc = Q6_Vhf_vmax_VhfVhf(v_acc, Q6_V_vmux_QVV(q, v, v_neg_inf));
+    }
+    return v_acc;
+}
+
+static inline bool fa_mask_any_unmasked(HVX_Vector v_acc) {
+    return (float) hvx_vec_get_f16(hvx_vec_reduce_max_f16(v_acc)) > -16.0f;
+}
+
+// True when any of rows [0, n_rows) of the column range [blk, blk + row_bytes) has a mask value > -16.
+// The last row is tested first (a causal mask unmasks the most columns there).
+static inline bool fa_mask_range_any_unmasked(const uint8_t * blk, size_t row_stride, uint32_t n_rows, uint32_t row_bytes) {
+    const HVX_Vector v_neg_inf = Q6_Vh_vsplat_R(0xfbff);
+    if (fa_mask_any_unmasked(fa_mask_row_max(blk + (size_t) (n_rows - 1) * row_stride, row_bytes, v_neg_inf))) {
+        return true;
+    }
+    if (n_rows == 1) {
+        return false;
+    }
+    // Fully masked so far: the whole range must be read. Stream it into L2 ahead of the loads.
+    hex_l2fetch(blk, row_bytes, row_stride, hex_smin(n_rows - 1, 0xffffu));
+    HVX_Vector v_acc = v_neg_inf;
+    for (uint32_t r = 0; r + 1 < n_rows; ++r) {
+        v_acc = fa_mask_row_max(blk + (size_t) r * row_stride, row_bytes, v_acc);
+        if ((r & 7) == 7 && fa_mask_any_unmasked(v_acc)) {
+            return true;
+        }
+    }
+    return fa_mask_any_unmasked(v_acc);
+}
+
+// One past the last KV block that has a mask value > -16 in rows [q_start, q_start + n_rows_q) of the
+// (head-broadcast) mask. Never below 1: block 0 always runs.
+// *last_rows: the KV rows of that last block that must be processed. Trailing 64-column chunks of the block
+// that are fully masked in every row are dropped (their P is exactly 0, see the note above), so under a causal
+// mask the diagonal block stops at the last query row's position instead of running the full Bc columns.
+static __attribute__((noinline)) uint32_t fa_mask_kv_blk_end(const struct htp_tensor * mask,
+                                                             uint32_t                  q_start,
+                                                             uint32_t                  n_rows_q,
+                                                             uint32_t                  im3,
+                                                             uint32_t                  Bc,
+                                                             uint32_t                  nek1,
+                                                             uint32_t                  n_kv_blocks,
+                                                             bool                      trim_last,
+                                                             uint32_t *                last_rows) {
+    const size_t     row_stride = mask->nb[1];
+    const uint8_t *  rows       = (const uint8_t *) mask->data + (size_t) q_start * row_stride + (size_t) im3 * mask->nb[3];
+
+    uint32_t b = n_kv_blocks;
+    for (; b > 1; --b) {
+        const uint32_t  kv_start  = (b - 1) * Bc;
+        const uint32_t  row_bytes = hex_smin(Bc, nek1 - kv_start) * sizeof(__fp16);
+        if (fa_mask_range_any_unmasked(rows + (size_t) kv_start * sizeof(__fp16), row_stride, n_rows_q, row_bytes)) {
+            break;
+        }
+    }
+    if (b == 0) {
+        *last_rows = 0;
+        return 0;
+    }
+
+    const uint32_t kv_start = (b - 1) * Bc;
+    const uint32_t blk_rows = hex_smin(Bc, nek1 - kv_start);
+    uint32_t       n_rows   = blk_rows;
+    if (trim_last) {
+        // Scan 64-column chunks backwards; stop at the first one with an unmasked value in any row.
+        uint32_t n_chunks = (blk_rows + 63) / 64;
+        while (n_chunks > 1) {
+            const uint32_t c0 = (n_chunks - 1) * 64;
+            const uint32_t nb = (hex_smin(blk_rows, c0 + 64) - c0) * sizeof(__fp16);
+            if (fa_mask_range_any_unmasked(rows + (size_t) (kv_start + c0) * sizeof(__fp16), row_stride, n_rows_q, nb)) {
+                break;
+            }
+            --n_chunks;
+        }
+        n_rows = hex_smin(blk_rows, n_chunks * 64);
+    }
+    *last_rows = n_rows;
+    return b;
+}
+
+// Leading all-zero mask chunks per query row (softmax fast path, see fa_sfm_decode_mask_rows)
+#define FA_ZC_MAX_ROWS 1024
+
+typedef struct {
+    const uint8_t * rows;        // mask row q_start (DDR)
+    size_t          row_stride;
+    uint32_t        n_rows;
+    uint32_t        n_full;      // full 64-column chunks in [0, nek1)
+    uint16_t *      zc;
+} fa_zscan_args_t;
+
+// 64 fp16 mask values at a (all inside the row). Only aligned lines that hold row bytes are touched.
+static inline HVX_Vector fa_mask_chunk_load(const uint8_t * a) {
+    if (((uint32_t) a & 127) == 0) {
+        return *(const HVX_Vector *) a;
+    }
+    const HVX_Vector * p = (const HVX_Vector *) ((uint32_t) a & ~127u);
+    return Q6_V_valign_VVR(p[1], p[0], (uint32_t) a);
+}
+
+static inline bool fa_vec_any_nonzero(HVX_Vector v) {
+    v = Q6_V_vor_VV(v, Q6_V_vror_VR(v, 64));
+    v = Q6_V_vor_VV(v, Q6_V_vror_VR(v, 32));
+    v = Q6_V_vor_VV(v, Q6_V_vror_VR(v, 16));
+    v = Q6_V_vor_VV(v, Q6_V_vror_VR(v, 8));
+    v = Q6_V_vor_VV(v, Q6_V_vror_VR(v, 4));
+    return hvx_vec_get_i32(v) != 0;
+}
+
+static void fa_zscan_thread(unsigned int n, unsigned int i, void * data) {
+    const fa_zscan_args_t * args = (const fa_zscan_args_t *) data;
+    uint32_t hint = 0;
+    for (uint32_t r = i; r < args->n_rows; r += n) {
+        const uint8_t * row = args->rows + (size_t) r * args->row_stride;
+        hex_l2fetch(row, hex_smin(hex_smin(hint + 4, args->n_full) * 128u, 0xff80u), (uint32_t) args->row_stride, 1);
+        uint32_t c = 0;
+        while (c + 4 <= args->n_full) {
+            const uint8_t * a = row + (size_t) c * 128;
+            HVX_Vector      v = Q6_V_vor_VV(fa_mask_chunk_load(a), fa_mask_chunk_load(a + 128));
+            v                 = Q6_V_vor_VV(v, Q6_V_vor_VV(fa_mask_chunk_load(a + 256), fa_mask_chunk_load(a + 384)));
+            if (fa_vec_any_nonzero(v)) {
+                break;
+            }
+            c += 4;
+        }
+        while (c < args->n_full && !fa_vec_any_nonzero(fa_mask_chunk_load(row + (size_t) c * 128))) {
+            ++c;
+        }
+        args->zc[r] = (uint16_t) hex_smin(c, 0xffffu);
+        hint        = c;
+    }
+}
+
+static void fa_mask_zscan(struct hmx_fa_context * factx, const struct htp_tensor * mask, uint32_t q_start, uint32_t n_rows_q,
+                          uint32_t im3, uint32_t nek1, uint16_t * zc) {
+    fa_zscan_args_t args = {
+        (const uint8_t *) mask->data + (size_t) q_start * mask->nb[1] + (size_t) im3 * mask->nb[3],
+        mask->nb[1], n_rows_q, nek1 / 64, zc,
+    };
+    const uint32_t n = (factx->n_threads > 1 && n_rows_q >= 2 * factx->n_threads) ? factx->n_threads : 1;
+    if (n > 1) {
+        work_queue_run(factx->octx->ctx->work_queue, fa_zscan_thread, &args, n);
+    } else {
+        fa_zscan_thread(1, 0, &args);
+    }
+}
