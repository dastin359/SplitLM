+// silu_lut: q = hvx_vec_silu_q_hf(a) for all 32768 fp16 patterns a = |h| (bit 15 clear), built in VTCM per thread
+static void ssm_conv_silu_lut_build(__fp16 * restrict lut) {
+    hvx_silu_q_lut_build(lut);
+}
+
+// ssm_conv_silu_hf_x4 with q(a) gathered from the table: four 64-lane pairs per pass, the gathers of the next pass
+// issued before this pass's results are used (gb = 8 VTCM vectors, two groups). Same per-element ops as
+// hvx_vec_silu2_f32_hf around the table read.
+static inline __attribute__((always_inline)) void ssm_conv_silu_lut_issue(const HVX_Vector * restrict x, HVX_Vector * restrict a,
+                                                                          HVX_Vector * g, const __fp16 * lut,
+                                                                          const struct hvx_silu_hf_consts * cs) {
+    #pragma unroll
+    for (int j = 0; j < 4; j++) {
+        // as hvx_vec_silu2_f32_hf: fp16 of the pair (lanes shuffled), a = |h|
+        const HVX_Vector h = Q6_Vhf_equals_Wqf32(Q6_W_vcombine_VV(Q6_Vqf32_vadd_VsfVsf(x[2 * j + 1], cs->zero),
+                                                                  Q6_Vqf32_vadd_VsfVsf(x[2 * j], cs->zero)));
+        a[j] = Q6_V_vand_VV(h, cs->abs16);
+        Q6_vgather_ARMVh(&g[j], (size_t) lut, 65535, Q6_Vh_vasl_VhR(a[j], 1));
+    }
+}
+
+static inline __attribute__((always_inline)) void ssm_conv_silu_lut_use(const HVX_Vector * restrict x, HVX_Vector * restrict y,
+                                                                        const HVX_Vector * restrict a, HVX_Vector * g,
+                                                                        const struct hvx_silu_hf_consts * cs) {
+    hvx_gather_sync(&g[3]);
