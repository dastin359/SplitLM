+            m.silu = m.conv + 1;
+        }
+    }
+
+    // everything runs at the position of the CONCAT: the outputs must not touch memory that nodes up to
+    // the last replaced node still use, and must not partially overlap the inputs (x may be reused in place)
+    const ggml_tensor * out  = graph->nodes[m.silu >= 0 ? m.silu : m.conv];
+    const ggml_tensor * nst  = m.cpy >= 0 ? graph->nodes[m.cpy] : nullptr;
+    const int           last = std::max({ m.conv, m.silu, m.cpy });
+
+    if (ggml_hexagon_ranges_overlap(out, st) || ggml_hexagon_ranges_overlap(out, w)) return false;
+    if (ggml_hexagon_ranges_overlap(out, x) && (out->data != x->data || x->nb[0] != out->nb[1])) return false;
+    if (nst && (ggml_hexagon_ranges_overlap(nst, x) || ggml_hexagon_ranges_overlap(nst, out) ||
+                ggml_hexagon_ranges_overlap(nst, w))) return false;
+    if (nst && ggml_hexagon_ranges_overlap(nst, st) && nst->data != st->data) return false;
+
+    for (int j = i + 1; j <= last; j++) {
+        if (j == m.conv || j == m.silu || j == m.cpy) continue;
+        const ggml_tensor * n = graph->nodes[j];
+        if (n == w || n == w->view_src) return false;
+        if (ggml_op_is_empty(n->op)) continue;
+        for (const ggml_tensor * o : { out, nst }) {
+            if (!o) continue;
+            if (ggml_hexagon_ranges_overlap(o, n)) return false;
+            for (int s = 0; s < GGML_MAX_SRC; s++) {
+                if (ggml_hexagon_ranges_overlap(o, n->src[s])) return false;
+            }
+        }
+    }
+    return true;
+}
+
+// GATED_DELTA_NET (HMX chunked kernel) with its Qwen3.5 neighbours:
+//   q = SCALE(RMS_NORM(q_raw)), k = SCALE(RMS_NORM(k_raw))            -> IN_NORM (normalized per chunk in VTCM)
+//   CPY(view(gdn, state tail), cache)                                  -> state written to the cache
+//   out = MUL(MUL(RMS_NORM(view(gdn, attn)), w), SILU(z))              -> OUT_NORM (gated norm before the output DMA)
+// All of it runs at the position of the GATED_DELTA_NET node.
+struct ggml_hexagon_gdn_fuse {
+    int   fuse = 0;          // HTP_GDN_FUSE_*
+    const ggml_tensor * q_raw = nullptr;
+    const ggml_tensor * k_raw = nullptr;
+    const ggml_tensor * w     = nullptr;
+    const ggml_tensor * z     = nullptr;
+    float in_eps = 0.f, in_scale = 0.f, out_eps = 0.f;
+    int   cpy = -1, rms = -1, mul_w = -1, silu = -1, mul_z = -1;
+    int   in_nodes[4] = { -1, -1, -1, -1 }; // q rms, q scale, k rms, k scale
+};
+
+static bool ggml_hexagon_used_only_by_nodes(const ggml_cgraph * graph, const ggml_tensor * t, std::initializer_list<const ggml_tensor *> users) {
+    if (t->flags & GGML_TENSOR_FLAG_OUTPUT) return false;
+    for (int j = 0; j < graph->n_nodes; j++) {
+        const ggml_tensor * n = graph->nodes[j];
+        if (ggml_op_is_empty(n->op)) continue;
+        for (int s = 0; s < GGML_MAX_SRC; s++) {
+            const ggml_tensor * src = n->src[s];
+            if (!src) continue;
+            if (src == t || src->view_src == t) {
+                bool ok = false;
+                for (const ggml_tensor * u : users) ok = ok || (u == n);
+                if (!ok) return false;
+            }
+        }
+    }
+    return true;
+}
+
+// q or k input of the GDN: SCALE(RMS_NORM(raw)) with raw rows contiguous
+static bool ggml_hexagon_match_gdn_l2(const ggml_cgraph * graph, const ggml_tensor * gdn, const ggml_tensor * sc,
+                                      const ggml_tensor *& raw, float & eps, float & scale) {
+    if (!sc || sc->op != GGML_OP_SCALE || sc->type != GGML_TYPE_F32) return false;
+    float bias = 0.f;
+    memcpy(&scale, (const float *) sc->op_params + 0, sizeof(float));
+    memcpy(&bias,  (const float *) sc->op_params + 1, sizeof(float));
+    if (bias != 0.f) return false;
+    const ggml_tensor * rn = sc->src[0];
+    if (!rn || rn->op != GGML_OP_RMS_NORM || rn->type != GGML_TYPE_F32) return false;
+    memcpy(&eps, rn->op_params, sizeof(float));
+    raw = rn->src[0];
+    if (!raw || raw->type != GGML_TYPE_F32 || !ggml_are_same_shape(raw, sc) || raw->nb[0] != sizeof(float)) return false;
+    if (!ggml_is_contiguous(rn) || !ggml_is_contiguous(sc)) return false;
+    return ggml_hexagon_used_only_by_nodes(graph, rn, { sc }) && ggml_hexagon_used_only_by_nodes(graph, sc, { gdn });
+}
+
+static bool ggml_hexagon_match_gdn_fuse(const ggml_cgraph * graph, int i, const std::unordered_map<const ggml_tensor *, int> & idx,
+                                        ggml_hexagon_gdn_fuse & m) {
+    const ggml_tensor * gdn = graph->nodes[i];
+    m = {};
+    if (opt_gdn_fuse <= 0 || gdn->op != GGML_OP_GATED_DELTA_NET || gdn->type != GGML_TYPE_F32) return false;
+    if (gdn->flags & GGML_TENSOR_FLAG_OUTPUT) return false;
+
+    const ggml_tensor * v = gdn->src[2];
+    const int64_t S_v = v->ne[0], H = v->ne[1], T = v->ne[2], n_seqs = v->ne[3];
+    const int64_t K   = ggml_get_op_params_i32(gdn, 0);
+    if (K != 1 || S_v % 32 != 0) return false;
+
+    auto index_of = [&](const ggml_tensor * t) { auto it = idx.find(t); return it == idx.end() ? -1 : it->second; };
+
+    // the state CPY (same rules as the GATED_DELTA_NET+CPY fusion) and the norm of the attention rows
+    const size_t tail_off = (size_t) S_v * H * T * n_seqs * sizeof(float);
+    const ggml_tensor * attn = nullptr; // view of the attention rows
+    for (int j = i + 1; j < graph->n_nodes; j++) {
+        const ggml_tensor * n = graph->nodes[j];
+        if (ggml_op_is_empty(n->op)) continue;
+        for (int s = 0; s < GGML_MAX_SRC; s++) {
+            const ggml_tensor * src = n->src[s];
+            if (!src || (src != gdn && src->view_src != gdn)) continue;
+            if (n->op == GGML_OP_CPY && s == 0 && m.cpy < 0 && src->op == GGML_OP_VIEW && src->view_offs == tail_off &&
+                ggml_is_contiguous(src) && n->type == GGML_TYPE_F32 && n->src[1] && n->src[1]->ne[0] == S_v * S_v * H &&
+                n->src[1]->ne[1] == n_seqs && n->src[1]->nb[0] == sizeof(float) &&
+                (n_seqs == 1 || n->src[1]->nb[1] == (size_t) S_v * S_v * H * sizeof(float)) && !(n->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+                m.cpy = j;
+            } else if (n->op == GGML_OP_RMS_NORM && s == 0 && m.rms < 0 && src->view_src == gdn && src->view_offs == 0 &&
+                       src->ne[0] == S_v && src->ne[1] == H && src->ne[2] == T && src->ne[3] == n_seqs && ggml_is_contiguous(src)) {
+                m.rms = j;
+                attn  = src;
+            } else {
+                return false;
+            }
+        }
+    }
+    if (m.cpy < 0) return false;
+
+    if ((opt_gdn_fuse & HTP_GDN_FUSE_OUT_NORM) && m.rms >= 0) {
+        const ggml_tensor * rn = graph->nodes[m.rms];
+        const ggml_tensor * mw = nullptr, * sl = nullptr, * mz = nullptr;
+        for (int j = m.rms + 1; j < graph->n_nodes && !mw; j++) {
+            const ggml_tensor * n = graph->nodes[j];
+            if (n->op == GGML_OP_MUL && (n->src[0] == rn || n->src[1] == rn)) mw = n;
+        }
+        if (mw) {
+            const ggml_tensor * w = mw->src[0] == rn ? mw->src[1] : mw->src[0];
+            for (int j = index_of(mw) + 1; j < graph->n_nodes && !mz; j++) {
+                const ggml_tensor * n = graph->nodes[j];
+                if (n->op == GGML_OP_MUL && (n->src[0] == mw || n->src[1] == mw)) mz = n;
+            }
+            if (mz) {
+                sl = mz->src[0] == mw ? mz->src[1] : mz->src[0];
+            }
+            const ggml_tensor * z = sl ? sl->src[0] : nullptr;
+            const bool ok =
+                w && w->type == GGML_TYPE_F32 && w->ne[0] == S_v && ggml_nelements(w) == S_v && ggml_is_contiguous(w) &&
+                sl && sl->op == GGML_OP_UNARY && ggml_get_unary_op(sl) == GGML_UNARY_OP_SILU && sl->type == GGML_TYPE_F32 &&
+                z && z->type == GGML_TYPE_F32 && ggml_are_same_shape(z, attn) && z->nb[0] == sizeof(float) &&
+                mz->type == GGML_TYPE_F32 && ggml_are_same_shape(mz, attn) && ggml_is_contiguous(mz) &&
+                rn->type == GGML_TYPE_F32 && mw->type == GGML_TYPE_F32 && ggml_are_same_shape(mw, attn) &&
+                !(mz->flags & GGML_TENSOR_FLAG_OUTPUT) &&
+                index_of(sl) > i && index_of(mz) > i &&
+                ggml_hexagon_used_only_by_nodes(graph, rn, { mw }) &&
+                ggml_hexagon_used_only_by_nodes(graph, mw, { mz }) &&
+                ggml_hexagon_used_only_by_nodes(graph, sl, { mz });
+            if (ok) {
+                m.mul_w = index_of(mw);
+                m.silu  = index_of(sl);
+                m.mul_z = index_of(mz);
+                m.w     = w;
+                m.z     = z;
+                memcpy(&m.out_eps, rn->op_params, sizeof(float));
+                m.fuse |= HTP_GDN_FUSE_OUT_NORM;
+            }
+        }
+    }
+
+    if (opt_gdn_fuse & HTP_GDN_FUSE_IN_NORM) {
+        const ggml_tensor * qr = nullptr, * kr = nullptr;
+        float qe = 0, qs = 0, ke = 0, ks = 0;
+        if (ggml_hexagon_match_gdn_l2(graph, gdn, gdn->src[0], qr, qe, qs) &&
+            ggml_hexagon_match_gdn_l2(graph, gdn, gdn->src[1], kr, ke, ks) && qe == ke && qs == ks &&
+            index_of(gdn->src[0]) >= 0 && index_of(gdn->src[1]) >= 0 &&
+            index_of(gdn->src[0]->src[0]) >= 0 && index_of(gdn->src[1]->src[0]) >= 0) {
+            m.q_raw       = qr;
+            m.k_raw       = kr;
+            m.in_eps      = qe;
+            m.in_scale    = qs;
+            m.in_nodes[0] = index_of(gdn->src[0]->src[0]);
+            m.in_nodes[1] = index_of(gdn->src[0]);
+            m.in_nodes[2] = index_of(gdn->src[1]->src[0]);
+            m.in_nodes[3] = index_of(gdn->src[1]);
+            m.fuse |= HTP_GDN_FUSE_IN_NORM;
+        }
+    }
+
+    if (!m.fuse) return false;
+
+    // hazards: everything now runs at position i. The fused output must not overlap any input of the op or of
+    // the nodes between the first and last absorbed node; the raw q/k must not be written between their norm
+    // and i; z must not be written between i and the gated mul.
+    const ggml_tensor * out = (m.fuse & HTP_GDN_FUSE_OUT_NORM) ? graph->nodes[m.mul_z] : nullptr;
+    int first = i, last = m.cpy;
+    if (m.fuse & HTP_GDN_FUSE_IN_NORM) first = std::min({ m.in_nodes[0], m.in_nodes[2] });
+    if (out) last = std::max(last, m.mul_z);
+    auto absorbed = [&](int j) {
+        if (j == i || j == m.cpy) return true;
+        if (out && (j == m.rms || j == m.mul_w || j == m.silu || j == m.mul_z)) return true;
+        if (m.fuse & HTP_GDN_FUSE_IN_NORM) {
+            for (int k = 0; k < 4; k++) if (j == m.in_nodes[k]) return true;
+        }
+        return false;
+    };
+    if (out) {
+        const ggml_tensor * ins[] = { m.q_raw ? m.q_raw : gdn->src[0], m.k_raw ? m.k_raw : gdn->src[1], gdn->src[2],
+                                      gdn->src[3], gdn->src[4], gdn->src[5], graph->nodes[m.cpy]->src[1], m.w };
+        for (const ggml_tensor * t : ins) {
+            if (ggml_hexagon_ranges_overlap(out, t)) return false;
+        }
+        // z may be updated in place (same rows), nothing else
+        if (ggml_hexagon_ranges_overlap(out, m.z) &&
+            (out->data != m.z->data || out->nb[1] != m.z->nb[1] || out->nb[2] != m.z->nb[2] || out->nb[3] != m.z->nb[3])) {
+            return false;
+        }
+    }
+    for (int j = first; j <= last; j++) {
+        if (absorbed(j)) continue;
+        const ggml_tensor * n = graph->nodes[j];
+        if (ggml_op_is_empty(n->op)) continue;
+        if (out) {
+            if (ggml_hexagon_ranges_overlap(out, n)) return false;
+            for (int s = 0; s < GGML_MAX_SRC; s++) {
+                if (ggml_hexagon_ranges_overlap(out, n->src[s])) return false;
+            }
+            if (j > i && ggml_hexagon_ranges_overlap(n, m.z)) return false;
+        }
+        if (j < i && (m.fuse & HTP_GDN_FUSE_IN_NORM)) {
+            if (ggml_hexagon_ranges_overlap(n, m.q_raw) || ggml_hexagon_ranges_overlap(n, m.k_raw)) return false;
+        }
+    }
+    return true;
+}
+
+static bool ggml_hexagon_precompute_ssm_conv_tc_params(const struct ggml_hexagon_session * sess, uint32_t d_conv,
+                                                      uint32_t d_inner, uint32_t n_t, bool silu, bool state_out,
+                                                      struct htp_ssm_conv_kernel_params * kparams) {
+    memset(kparams, 0, sizeof(*kparams));
+
+    const uint32_t n_threads = (std::min)((uint32_t) sess->n_threads, d_inner / 32);
+    if (n_threads == 0) return false;
+
+    // channel block cb (DMA rows of cb floats) x time tiles of tt tokens: wide DMA rows matter more than
+    // long tiles (the K - 1 rows in front of a tile are copied from the previous one), so keep cb at 128
+    // and shorten the tile when the whole sequence does not fit
+    uint32_t cb = 0, tt = 0;
+    struct htp_ssm_conv_tc_layout L;
+    const uint32_t cb_req = opt_conv_cb > 0 ? (uint32_t) opt_conv_cb : 128u;
+    const uint32_t tt_req = opt_conv_tt > 0 ? (uint32_t) opt_conv_tt : n_t;
+    for (uint32_t c : { cb_req, 128u, 96u, 64u, 32u }) {
+        if (c % 32 != 0 || c > 512) continue;
+        for (uint32_t t = std::min(tt_req, n_t); t >= 16; t = (t + 1) / 2) {
+            htp_ssm_conv_tc_layout_build(&L, d_conv, t, c);
+            if ((size_t) L.total * n_threads <= sess->vtcm_size) {
+                cb = c;
+                tt = t;
+                break;
+            }
+            if (t == 16) break;
+        }
+        if (cb) break;
+    }
+    if (cb == 0) return false;
+
+    kparams->n_threads    = n_threads;
+    kparams->d_conv       = d_conv;
+    kparams->d_inner      = d_inner;
+    kparams->n_t          = n_t;
+    kparams->n_s          = 1;
+    kparams->d_inner_tile = cb;
+
+    kparams->vtcm_src0_size_per_thread = L.total;
+    kparams->vtcm_src0_size            = L.total * n_threads;
+    kparams->vtcm_size                 = L.total * n_threads;
+
+    kparams->fuse_silu    = silu ? 1 : 0;
+    kparams->tc_mode      = 1;
+    kparams->tc_state_out = state_out ? 1 : 0;
+    kparams->tc_t_tile    = tt < n_t ? tt : 0;
+    return true;
+}
