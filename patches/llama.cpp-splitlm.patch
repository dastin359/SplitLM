+// Modes 4 / 5 of transfer_output_chunk_scattered_swiglu_pair for the expert-sorted tiled layout
+// (HTP_MMID_STREAM_ACT_TILED): the products stay in HMX tile order (row pairs interleaved), so every output vector
+// is one aligned store into the activation tile of the consumer. dst_seg = tile row 0 of this M-chunk (k_tiles
+// tiles per tile row), the chunk covers tile columns [col_tile0, col_tile0 + n_cols / 32). Rows [vtcm_start_row,
+// vtcm_start_row + n_rows) of the chunk, whole row pairs (an odd last row's partner is padding, never read back
+// for a stored output).
+// v2 (default, HTP_MMID_OPT_SCAT_V1 clear): four column tiles of a row pair per loop iteration, so the compiler
+// interleaves four independent qf16 chains: v73 issues one qf multiply and one qf add / convert per packet, and the two
+// chains of the v1 loop (unroll 2) ran in lockstep (both waiting for the same slot), ~32 packets per output vector.
+// Same intrinsics per vector in the same order (bit-identical results).
+static void transfer_output_chunk_tiled_swiglu_pair(
+            __fp16 *restrict dst_seg,
+            const __fp16 *restrict vtcm_src,
+            uint32_t vtcm_start_row,
+            uint32_t n_rows,
+            uint32_t n_cols,
+            uint32_t col_tile0,
+            uint32_t k_tiles,
+            uint32_t mode,
+            bool v1) {
+    assert(n_cols % HTP_MM_HMX_TILE_N_COLS == 0);
+    const size_t nt              = n_cols / HTP_MM_HMX_TILE_N_COLS;
+    const size_t tile_row_stride = 2 * nt * HTP_MM_HMX_TILE_N_ELMS;
+    const size_t tstep           = HTP_MM_HMX_TILE_N_ELMS * sizeof(__fp16) / VLEN;  // vectors per tile
+    const size_t up_v            = nt * tstep;                                      // gate -> up, in vectors
+
+    const HVX_Vector one = hvx_vec_splat_f16(1.0);
+    const struct hvx_silu_hf_consts hc = hvx_silu_hf_consts_init();
+
+    for (size_t r = 0; r < n_rows; r += 2) {
+        const uint32_t lr = vtcm_start_row + r;
+        const size_t   r0 = lr / HTP_MM_HMX_TILE_N_ROWS;
+        const size_t   r1 = (lr % HTP_MM_HMX_TILE_N_ROWS) / 2;
+        const HVX_Vector * tsrc = (const HVX_Vector *) (vtcm_src + r0 * tile_row_stride) + r1;
+        HVX_Vector *       out  = (HVX_Vector *) (dst_seg + (r0 * k_tiles + col_tile0) * HTP_MM_HMX_TILE_N_ELMS) + r1;
+        if (!v1) {
+            size_t c0 = 0;
+            if (mode == 4) {
+                for (; c0 + 4 <= nt; c0 += 4) {
+                    const HVX_Vector y0 = Q6_Vhf_equals_Wqf32(hvx_vec_swiglu_hf_qf32(tsrc[(c0 + 0) * tstep], tsrc[(c0 + 0) * tstep + up_v], one, &hc));
+                    const HVX_Vector y1 = Q6_Vhf_equals_Wqf32(hvx_vec_swiglu_hf_qf32(tsrc[(c0 + 1) * tstep], tsrc[(c0 + 1) * tstep + up_v], one, &hc));
+                    const HVX_Vector y2 = Q6_Vhf_equals_Wqf32(hvx_vec_swiglu_hf_qf32(tsrc[(c0 + 2) * tstep], tsrc[(c0 + 2) * tstep + up_v], one, &hc));
+                    const HVX_Vector y3 = Q6_Vhf_equals_Wqf32(hvx_vec_swiglu_hf_qf32(tsrc[(c0 + 3) * tstep], tsrc[(c0 + 3) * tstep + up_v], one, &hc));
+                    out[(c0 + 0) * tstep] = y0;
+                    out[(c0 + 1) * tstep] = y1;
+                    out[(c0 + 2) * tstep] = y2;
+                    out[(c0 + 3) * tstep] = y3;
+                }
+                for (; c0 < nt; ++c0) {
+                    out[c0 * tstep] = Q6_Vhf_equals_Wqf32(hvx_vec_swiglu_hf_qf32(tsrc[c0 * tstep], tsrc[c0 * tstep + up_v], one, &hc));
+                }
+            } else {
+                for (; c0 + 4 <= nt; c0 += 4) {
+                    const HVX_Vector y0 = hvx_vec_swiglu_hf_h16(tsrc[(c0 + 0) * tstep], tsrc[(c0 + 0) * tstep + up_v], &hc);
+                    const HVX_Vector y1 = hvx_vec_swiglu_hf_h16(tsrc[(c0 + 1) * tstep], tsrc[(c0 + 1) * tstep + up_v], &hc);
+                    const HVX_Vector y2 = hvx_vec_swiglu_hf_h16(tsrc[(c0 + 2) * tstep], tsrc[(c0 + 2) * tstep + up_v], &hc);
+                    const HVX_Vector y3 = hvx_vec_swiglu_hf_h16(tsrc[(c0 + 3) * tstep], tsrc[(c0 + 3) * tstep + up_v], &hc);
+                    out[(c0 + 0) * tstep] = y0;
+                    out[(c0 + 1) * tstep] = y1;
+                    out[(c0 + 2) * tstep] = y2;
+                    out[(c0 + 3) * tstep] = y3;
+                }
+                for (; c0 < nt; ++c0) {
+                    out[c0 * tstep] = hvx_vec_swiglu_hf_h16(tsrc[c0 * tstep], tsrc[c0 * tstep + up_v], &hc);
+                }
+            }
+        } else if (mode == 4) {
+            #pragma unroll(2)
+            for (size_t c0 = 0; c0 < nt; ++c0) {
+                out[c0 * tstep] = Q6_Vhf_equals_Wqf32(hvx_vec_swiglu_hf_qf32(tsrc[c0 * tstep], tsrc[c0 * tstep + up_v], one, &hc));
+            }
+        } else {
+            #pragma unroll(2)
+            for (size_t c0 = 0; c0 < nt; ++c0) {
+                out[c0 * tstep] = hvx_vec_swiglu_hf_h16(tsrc[c0 * tstep], tsrc[c0 * tstep + up_v], &hc);
+            }
+        }
+    }
+}
+
+// Per-expert fallback of the fused MUL_MAT_ID_NX+SWIGLU: the gate weight's scatter wrote silu's input to dst (f32);
+// the up weight's scatter (this) reads it back and stores silu(gate) * up in place (qf32 sigmoid).
+static void transfer_output_chunk_scattered_swiglu_combine(
+            float *restrict dst,
+            const __fp16 *restrict vtcm_src,
+            uint32_t start_row,
+            uint32_t vtcm_start_row,
+            uint32_t n_rows,
+            uint32_t n_cols,
+            const struct mmid_row_mapping *matrix_rows,
+            uint32_t cur_a,
+            uint32_t mapping_stride,
+            size_t dst_nb1,
+            size_t dst_nb2,
+            uint32_t cne1) {
+    assert(n_cols % HTP_MM_HMX_TILE_N_COLS == 0);
+    const size_t nt              = n_cols / HTP_MM_HMX_TILE_N_COLS;
+    const size_t tile_row_stride = nt * HTP_MM_HMX_TILE_N_ELMS;
+    const size_t tstep           = HTP_MM_HMX_TILE_N_ELMS * sizeof(__fp16) / VLEN;  // vectors per tile
+
+    const HVX_Vector one = hvx_vec_splat_f16(1.0);
+    const struct hvx_sigmoid_qf32_consts sc = hvx_sigmoid_qf32_consts_init();
+
+    for (size_t r = 0; r < n_rows; r += 2) {
+        const uint32_t r_idx0 = start_row + r + 0;
+        const uint32_t r_idx1 = start_row + r + 1;
+        if (r_idx0 >= cne1) break;
+
+        const uint32_t lr = vtcm_start_row + r;
+        const size_t   r0 = (lr / HTP_MM_HMX_TILE_N_ROWS);
+        const size_t   r1 = (lr % HTP_MM_HMX_TILE_N_ROWS) / 2;
+        const HVX_Vector * tsrc = (const HVX_Vector *) (vtcm_src + r0 * tile_row_stride) + r1;
+
+        const struct mmid_row_mapping m0 = matrix_rows[cur_a * mapping_stride + r_idx0];
+        float * out0 = (float *) ((uint8_t *) dst + m0.i1 * dst_nb1 + m0.i2 * dst_nb2);
+        float * out1 = NULL;
+        if (r_idx1 < cne1) {
+            const struct mmid_row_mapping m1 = matrix_rows[cur_a * mapping_stride + r_idx1];
+            out1 = (float *) ((uint8_t *) dst + m1.i1 * dst_nb1 + m1.i2 * dst_nb2);
+        }
+
+        for (size_t c0 = 0; c0 < nt; ++c0) {
+            const HVX_VectorPair u = Q6_Wqf32_vmpy_VhfVhf(tsrc[c0 * tstep], one);
+            float * p0 = out0 + c0 * HTP_MM_HMX_TILE_N_COLS;
+            hvx_vmemu(p0) = hmx_epi_swiglu(Q6_Vsf_equals_Vqf32(Q6_V_lo_W(u)), hvx_vmemu(p0), false, &sc);
+            if (out1) {
+                float * p1 = out1 + c0 * HTP_MM_HMX_TILE_N_COLS;
+                hvx_vmemu(p1) = hmx_epi_swiglu(Q6_Vsf_equals_Vqf32(Q6_V_hi_W(u)), hvx_vmemu(p1), false, &sc);
+            }
+        }
+    }
+}
