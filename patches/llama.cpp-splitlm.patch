+// trilane r7: Q4_0 row-quad layout (HTP_OPFLAG_Q4_TL): the 4 column pairs of a row are bytes 4 * row .. 4 * row + 3
+static inline void hvx_dequantize_row_tiled_q4_0_tl_f32(float * dst_spad, const uint8_t * src_spad, uint32_t n_k_tiles, uint32_t tile_stride, uint32_t row) {
