+static void hmx_mmid_hvx_step_worker(unsigned int n, unsigned int i, void * data) {
+    (void) n;
+    hmx_mmid_hvx_step_t * st = (hmx_mmid_hvx_step_t *) data;
+    struct htp_thread_trace * tr = &st->traces[i];
+
+#define HMX_MMID_BAG_BLK(j) ((i - 1) + (j) * st->bag_nw)
+#define HMX_MMID_BAG_PUSH(j) hmx_mmid_bag_push_blk(st->ctx->dma[i], st->bag_dst, (const __fp16 *) st->g_src, st->bag_mr, \
+        HMX_MMID_BAG_BLK(j), st->bag_rows, st->k, st->matrix_rows, st->bag_a, st->mapping_stride, st->ne11, &st->ne11_div, \
