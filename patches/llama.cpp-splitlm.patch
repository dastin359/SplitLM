+// acc[j][:] = acc[j][:]*rescale[j] + sum_t w[t][j]*V(idx[t])[:], 16 columns at a time held in registers
+template <int GB>
+static inline void ggml_fa_dec_accum_v(float * acc, const float * rescale, const char * vbase, size_t nbv1,
+                                       const int32_t * idx, const float * w, int n, int64_t DV) {
+    for (int64_t d = 0; d < DV; d += 16) {
+        float32x4_t r[GB][4];
+        for (int j = 0; j < GB; j++) {
+            const float32x4_t sc = vdupq_n_f32(rescale[j]);
+            for (int c = 0; c < 4; c++) {
+                r[j][c] = vmulq_f32(vld1q_f32(acc + j*DV + d + 4*c), sc);
+            }
+        }
+        for (int t = 0; t < n; t++) {
+            const __fp16 * vp = (const __fp16 *) (vbase + (size_t) idx[t]*nbv1) + d;
+            const float16x8_t v0 = vld1q_f16(vp);
+            const float16x8_t v1 = vld1q_f16(vp + 8);
+            const float32x4_t f0 = vcvt_f32_f16(vget_low_f16(v0));
+            const float32x4_t f1 = vcvt_high_f32_f16(v0);
+            const float32x4_t f2 = vcvt_f32_f16(vget_low_f16(v1));
+            const float32x4_t f3 = vcvt_high_f32_f16(v1);
+            for (int j = 0; j < GB; j++) {
+                const float wj = w[4*t + j];
+                r[j][0] = vfmaq_n_f32(r[j][0], f0, wj);
+                r[j][1] = vfmaq_n_f32(r[j][1], f1, wj);
+                r[j][2] = vfmaq_n_f32(r[j][2], f2, wj);
+                r[j][3] = vfmaq_n_f32(r[j][3], f3, wj);
+            }
+        }
+        for (int j = 0; j < GB; j++) {
+            for (int c = 0; c < 4; c++) {
+                vst1q_f32(acc + j*DV + d + 4*c, r[j][c]);
+            }
+        }
+    }
+}
+
+static inline void ggml_fa_dec_prefetch_row(const char * p, int64_t nbytes, int locality) {
+    for (int64_t o = 0; o < nbytes; o += 64) {
+        if (locality == 3) {
+            __builtin_prefetch(p + o, 0, 3);
+        } else {
+            __builtin_prefetch(p + o, 0, 2);
+        }
+    }
+}
+
+// partials (M, S, VKQ) of all query heads over KV positions [ic_start, ic_end). Blocks of positions are the outer
+// loop, so the K/V rows of all KV heads of a cell are used while they are hot; each GB-head group shares one pass
+// over its KV head's rows.
+template <int GB>
+static void ggml_fa_dec_chunk_t(
+        const ggml_tensor * dst, int64_t ic_start, int64_t ic_end, float * scratch, float * partials, int64_t partial_stride) {
+    const ggml_tensor * q     = dst->src[0];
+    const ggml_tensor * k     = dst->src[1];
+    const ggml_tensor * v     = dst->src[2];
+    const ggml_tensor * mask  = dst->src[3];
+    const ggml_tensor * sinks = dst->src[4];
+
+    const int64_t DK     = k->ne[0];
+    const int64_t DV     = v->ne[0];
+    const int64_t n_head = q->ne[2];
+    const int64_t rk2    = q->ne[2]/k->ne[2];
+    const int64_t rv2    = q->ne[2]/v->ne[2];
+    const size_t  nbk1   = k->nb[1];
+    const size_t  nbv1   = v->nb[1];
+
+    float scale         = 1.0f;
+    float max_bias      = 0.0f;
+    float logit_softcap = 0.0f;
+    memcpy(&scale,         (const float *) dst->op_params + 0, sizeof(float));
+    memcpy(&max_bias,      (const float *) dst->op_params + 1, sizeof(float));
+    memcpy(&logit_softcap, (const float *) dst->op_params + 2, sizeof(float));
+    if (logit_softcap != 0) {
+        scale /= logit_softcap;
+    }
+    const uint32_t n_head_log2 = 1u << (uint32_t) floor(log2((double) n_head));
+    const float m0 = powf(2.0f, -(max_bias       ) / n_head_log2);
+    const float m1 = powf(2.0f, -(max_bias / 2.0f) / n_head_log2);
+
+    // scratch layout
+    __fp16  * Q16 = (__fp16 *) scratch;               // [n_head][DK]
+    float   * acc = scratch + n_head*DK/2;            // [n_head][DV]
+    float   * M   = acc + n_head*DV;                  // [n_head]
+    float   * S   = M + n_head;                       // [n_head]
+    float   * sc  = S + n_head;                       // [GB][BKV] scores, then probabilities
+    float   * w   = sc + FA_DEC_GBMAX*FA_DEC_BKV;     // [BKV][4] probabilities by position
+    int32_t * idx = (int32_t *) (w + 4*FA_DEC_BKV);   // [BKV] unmasked positions of the block
+    float   * mvl = (float *) (idx + FA_DEC_BKV);     // [BKV] their mask values
+
+    for (int64_t h = 0; h < n_head; h++) {
+        const float * pq = (const float *) ((const char *) q->data + h*q->nb[2]);
+        for (int64_t d = 0; d < DK; d++) {
+            Q16[h*DK + d] = (__fp16) pq[d];
+        }
+        M[h] = -INFINITY;
+        S[h] = 0.0f;
+    }
+    memset(acc, 0, n_head*DV*sizeof(float));
+
+    const ggml_fp16_t * mp = mask ? (const ggml_fp16_t *) mask->data : NULL;
+
+    for (int64_t b0 = ic_start; b0 < ic_end; b0 += FA_DEC_BKV) {
+        const int64_t b1 = std::min(b0 + FA_DEC_BKV, ic_end);
+        const int64_t bn = std::min(b1 + FA_DEC_BKV, ic_end); // end of the next block, for prefetch
+
+        // unmasked positions of this block (the mask is shared by all heads)
+        int n = 0;
+        for (int64_t ic = b0; ic < b1; ic++) {
+            const float mv = mp ? GGML_CPU_FP16_TO_FP32(mp[ic]) : 0.0f;
+            if (mv == -INFINITY) {
+                continue;
+            }
+            idx[n] = (int32_t) ic;
+            mvl[n] = mv;
+            n++;
+        }
+        if (n == 0) {
+            continue;
+        }
+        const int n4 = (n + 3) & ~3;
+
+        for (int64_t h0 = 0; h0 < n_head; h0 += GB) {
+            const char * kbase = (const char *) k->data + (h0/rk2)*k->nb[2];
+            const char * vbase = (const char *) v->data + (h0/rv2)*v->nb[2];
+            const __fp16 * Qg  = Q16 + h0*DK;
+
+            // scores; meanwhile prefetch this block's V rows (used right after) and the next block's K rows
+            float s0[GB], s1[GB];
+            int t = 0;
+            for (; t + 1 < n; t += 2) {
+                ggml_fa_dec_prefetch_row(vbase + (size_t) idx[t]*nbv1,     DV*sizeof(ggml_fp16_t), 3);
+                ggml_fa_dec_prefetch_row(vbase + (size_t) idx[t + 1]*nbv1, DV*sizeof(ggml_fp16_t), 3);
+                if (b1 + t + 1 < bn) {
+                    ggml_fa_dec_prefetch_row(kbase + (b1 + t)*nbk1,     DK*sizeof(ggml_fp16_t), 2);
+                    ggml_fa_dec_prefetch_row(kbase + (b1 + t + 1)*nbk1, DK*sizeof(ggml_fp16_t), 2);
+                }
+                ggml_fa_dec_dot2<GB>((const __fp16 *) (kbase + (size_t) idx[t]*nbk1), (const __fp16 *) (kbase + (size_t) idx[t + 1]*nbk1), Qg, DK, s0, s1);
+                for (int j = 0; j < GB; j++) {
+                    sc[j*FA_DEC_BKV + t]     = s0[j];
+                    sc[j*FA_DEC_BKV + t + 1] = s1[j];
+                }
+            }
+            if (t < n) {
+                ggml_fa_dec_dot1<GB>((const __fp16 *) (kbase + (size_t) idx[t]*nbk1), Qg, DK, s0);
+                for (int j = 0; j < GB; j++) {
+                    sc[j*FA_DEC_BKV + t] = s0[j];
+                }
+            }
+
+            // block softmax, merged into the running (M, S) of each head
+            float rescale[GB];
+            for (int j = 0; j < GB; j++) {
+                const int64_t h = h0 + j;
+                const float slope = (max_bias > 0.0f) ? (h < n_head_log2 ? powf(m0, h + 1) : powf(m1, 2*(h - n_head_log2) + 1)) : 1.0f;
+                float * s = sc + j*FA_DEC_BKV;
+                float mb = -INFINITY;
+                for (int i = 0; i < n; i++) {
+                    float x = s[i]*scale;
+                    if (logit_softcap != 0.0f) {
+                        x = logit_softcap*tanhf(x);
+                    }
+                    x += slope*mvl[i];
+                    s[i] = x;
+                    mb = std::max(mb, x);
+                }
+                for (int i = n; i < n4; i++) {
+                    s[i] = -INFINITY;
+                }
+                const float Mnew = std::max(M[h], mb);
+                rescale[j] = M[h] == -INFINITY ? 0.0f : expf(M[h] - Mnew);
+                M[h] = Mnew;
+                const float32x4_t vm = vdupq_n_f32(Mnew);
+                float32x4_t vsum = vdupq_n_f32(0.0f);
+                for (int i = 0; i < n4; i += 4) {
+                    const float32x4_t p = ggml_v_expf(vsubq_f32(vld1q_f32(s + i), vm));
+                    vst1q_f32(s + i, p);
+                    vsum = vaddq_f32(vsum, p);
+                }
+                S[h] = S[h]*rescale[j] + vaddvq_f32(vsum);
+            }
+            for (int i = 0; i < n; i++) {
+                for (int j = 0; j < GB; j++) {
+                    w[4*i + j] = sc[j*FA_DEC_BKV + i];
+                }
+            }
+
+            ggml_fa_dec_accum_v<GB>(acc + h0*DV, rescale, vbase, nbv1, idx, w, n, DV);
+        }
+    }
+
+    for (int64_t h = 0; h < n_head; h++) {
+        float * VKQ = acc + h*DV;
+
+        // sinks - apply only on the first kv-chunk
+        if (sinks && ic_start == 0) {
+            const float s = ((const float *) sinks->data)[h];
+            float ms = 1.0f;
+            float vs = 1.0f;
+            if (s > M[h]) {
+                ms = expf(M[h] - s);
+                M[h] = s;
+                ggml_vec_scale_f32(DV, VKQ, ms);
+            } else {
+                vs = expf(s - M[h]);
+            }
+            S[h] = S[h]*ms + vs;
+        }
+
+        float * partial = partials + h*partial_stride;
+        partial[0] = M[h];
+        partial[1] = S[h];
+        memcpy(partial + 2, VKQ, DV*sizeof(float));
+    }
+}
+
+
+// r6-fa: v2 of the decode kernel for GQA groups of 4 query heads (LFM2.5: 32/8 heads, Qwen3.5: 8/2). Same arithmetic
+// as ggml_fa_dec_chunk_t<4>, fewer instructions per KV position, plus a software prefetch of the contiguous K/V cells
+// a few blocks ahead:
+//  - the scores of the 4 heads of a position are reduced with a pairwise-add tree straight into one vector (the same
+//    pairwise order as vaddvq_f32), so they land in position-major [t][4] layout: no transpose, no scalar stores;
+//  - the block softmax runs across the 4 heads in one vector per position (max, exp, sums kept per position mod 4 and
+//    combined in vaddvq_f32 order), replacing the per-head scalar scale/mask/max loop;
+//  - V is accumulated with lane-indexed FMAs on the probability vector of a position (one load instead of four);
+//  - the K and V cells (all KV heads, contiguous in the KV cache) one block ahead are prefetched, spread over the
+//    current block's work (the first block's cells up front), so DRAM reads overlap the compute; the per-head-group
+//    loop reads each cell in 1-KB-strided pieces, which the hardware prefetcher does not run ahead of.
+// Results are bit-identical to the template kernel (checked on random masks incl. finite non-zero values,
+// ALiBi, softcap, sinks, head sizes 64-256, 1/5/8 threads). GGML_CPU_FA_DEC_V2=0 restores the template kernel;
+// GGML_CPU_FA_DEC_PFD=0 disables the prefetch, GGML_CPU_FA_DEC_PFC=<cells> sets its distance.
+static int ggml_fa_dec_env(const char * name, int def) {
+    const char * e = getenv(name);
+    return e ? atoi(e) : def;
+}
+
+static bool ggml_fa_dec_v2_enabled() {
+    static const bool on = ggml_fa_dec_env("GGML_CPU_FA_DEC_V2", 1) != 0;
+    return on;
+}
+
+// prefetch distance in KV cells (GGML_CPU_FA_DEC_PFC, default one block)
+static int ggml_fa_dec_pfd() {
+    static const int pfd = ggml_fa_dec_env("GGML_CPU_FA_DEC_PFD", 1) != 0 ? std::max(0, ggml_fa_dec_env("GGML_CPU_FA_DEC_PFC", FA_DEC_BKV)) : 0;
+    return pfd;
+}
+
+// software prefetch cursor over [p, end)
+struct ggml_fa_dec_pf {
+    const char * p   = nullptr;
+    const char * end = nullptr;
+    inline void step(int nlines) {
+        for (int i = 0; i < nlines && p < end; i++, p += 64) {
+            __builtin_prefetch(p, 0, 2);
+        }
+    }
+};
+
+// lane j = (vj[0] + vj[1]) + (vj[2] + vj[3]): the order in which vaddvq_f32 adds its lanes
+static inline float32x4_t ggml_fa_dec_hsum4(float32x4_t v0, float32x4_t v1, float32x4_t v2, float32x4_t v3) {
+    return vpaddq_f32(vpaddq_f32(v0, v1), vpaddq_f32(v2, v3));
+}
+
+static inline void ggml_fa_dec_dot2_g4(const __fp16 * k0, const __fp16 * k1, const __fp16 * q, int64_t DK, float * w0, float * w1) {
+    float32x4_t a0[4], b0[4], a1[4], b1[4];
+    for (int j = 0; j < 4; j++) {
+        a0[j] = vdupq_n_f32(0.0f); b0[j] = vdupq_n_f32(0.0f);
+        a1[j] = vdupq_n_f32(0.0f); b1[j] = vdupq_n_f32(0.0f);
+    }
+    for (int64_t d = 0; d < DK; d += 8) {
+        const float16x8_t x0 = vld1q_f16(k0 + d);
+        const float16x8_t x1 = vld1q_f16(k1 + d);
+        for (int j = 0; j < 4; j++) {
+            const float16x8_t qv = vld1q_f16(q + j*DK + d);
+            a0[j] = vfmlalq_low_f16 (a0[j], x0, qv);
+            b0[j] = vfmlalq_high_f16(b0[j], x0, qv);
+            a1[j] = vfmlalq_low_f16 (a1[j], x1, qv);
+            b1[j] = vfmlalq_high_f16(b1[j], x1, qv);
+        }
+    }
+    vst1q_f32(w0, ggml_fa_dec_hsum4(vaddq_f32(a0[0], b0[0]), vaddq_f32(a0[1], b0[1]), vaddq_f32(a0[2], b0[2]), vaddq_f32(a0[3], b0[3])));
+    vst1q_f32(w1, ggml_fa_dec_hsum4(vaddq_f32(a1[0], b1[0]), vaddq_f32(a1[1], b1[1]), vaddq_f32(a1[2], b1[2]), vaddq_f32(a1[3], b1[3])));
+}
+
+static inline void ggml_fa_dec_dot1_g4(const __fp16 * k0, const __fp16 * q, int64_t DK, float * w0) {
+    float32x4_t a0[4], b0[4];
+    for (int j = 0; j < 4; j++) { a0[j] = vdupq_n_f32(0.0f); b0[j] = vdupq_n_f32(0.0f); }
+    for (int64_t d = 0; d < DK; d += 8) {
+        const float16x8_t x0 = vld1q_f16(k0 + d);
+        for (int j = 0; j < 4; j++) {
+            const float16x8_t qv = vld1q_f16(q + j*DK + d);
+            a0[j] = vfmlalq_low_f16 (a0[j], x0, qv);
+            b0[j] = vfmlalq_high_f16(b0[j], x0, qv);
+        }
+    }
+    vst1q_f32(w0, ggml_fa_dec_hsum4(vaddq_f32(a0[0], b0[0]), vaddq_f32(a0[1], b0[1]), vaddq_f32(a0[2], b0[2]), vaddq_f32(a0[3], b0[3])));
+}
+
+// acc[j][:] = acc[j][:]*rescale[j] + sum_t w[t][j]*V(idx[t])[:], 16 columns at a time held in registers
+static inline void ggml_fa_dec_accum_v_g4(float * acc, float32x4_t rescale, const char * vbase, size_t nbv1,
+                                          const int32_t * idx, const float * w, int n, int64_t DV, ggml_fa_dec_pf & pf, int pfn) {
+    const float32x4_t s0 = vdupq_laneq_f32(rescale, 0);
+    const float32x4_t s1 = vdupq_laneq_f32(rescale, 1);
+    const float32x4_t s2 = vdupq_laneq_f32(rescale, 2);
+    const float32x4_t s3 = vdupq_laneq_f32(rescale, 3);
+    for (int64_t d = 0; d < DV; d += 16) {
+        float32x4_t r[4][4];
+        for (int c = 0; c < 4; c++) {
+            r[0][c] = vmulq_f32(vld1q_f32(acc + 0*DV + d + 4*c), s0);
+            r[1][c] = vmulq_f32(vld1q_f32(acc + 1*DV + d + 4*c), s1);
+            r[2][c] = vmulq_f32(vld1q_f32(acc + 2*DV + d + 4*c), s2);
+            r[3][c] = vmulq_f32(vld1q_f32(acc + 3*DV + d + 4*c), s3);
+        }
+        for (int t = 0; t < n; t++) {
+            const __fp16 * vp = (const __fp16 *) (vbase + (size_t) idx[t]*nbv1) + d;
+            const float16x8_t v0 = vld1q_f16(vp);
+            const float16x8_t v1 = vld1q_f16(vp + 8);
+            const float32x4_t f0 = vcvt_f32_f16(vget_low_f16(v0));
+            const float32x4_t f1 = vcvt_high_f32_f16(v0);
+            const float32x4_t f2 = vcvt_f32_f16(vget_low_f16(v1));
+            const float32x4_t f3 = vcvt_high_f32_f16(v1);
+            const float32x4_t wt = vld1q_f32(w + 4*t);
+            r[0][0] = vfmaq_laneq_f32(r[0][0], f0, wt, 0); r[0][1] = vfmaq_laneq_f32(r[0][1], f1, wt, 0);
+            r[0][2] = vfmaq_laneq_f32(r[0][2], f2, wt, 0); r[0][3] = vfmaq_laneq_f32(r[0][3], f3, wt, 0);
+            r[1][0] = vfmaq_laneq_f32(r[1][0], f0, wt, 1); r[1][1] = vfmaq_laneq_f32(r[1][1], f1, wt, 1);
+            r[1][2] = vfmaq_laneq_f32(r[1][2], f2, wt, 1); r[1][3] = vfmaq_laneq_f32(r[1][3], f3, wt, 1);
+            r[2][0] = vfmaq_laneq_f32(r[2][0], f0, wt, 2); r[2][1] = vfmaq_laneq_f32(r[2][1], f1, wt, 2);
+            r[2][2] = vfmaq_laneq_f32(r[2][2], f2, wt, 2); r[2][3] = vfmaq_laneq_f32(r[2][3], f3, wt, 2);
+            r[3][0] = vfmaq_laneq_f32(r[3][0], f0, wt, 3); r[3][1] = vfmaq_laneq_f32(r[3][1], f1, wt, 3);
+            r[3][2] = vfmaq_laneq_f32(r[3][2], f2, wt, 3); r[3][3] = vfmaq_laneq_f32(r[3][3], f3, wt, 3);
+            if ((t & 3) == 3) {
+                pf.step(pfn);
+            }
+        }
+        for (int j = 0; j < 4; j++) {
+            for (int c = 0; c < 4; c++) {
+                vst1q_f32(acc + j*DV + d + 4*c, r[j][c]);
+            }
+        }
+    }
+}
+
+static void ggml_fa_dec_chunk_g4(
+        const ggml_tensor * dst, int64_t ic_start, int64_t ic_end, float * scratch, float * partials, int64_t partial_stride) {
+    const ggml_tensor * q     = dst->src[0];
+    const ggml_tensor * k     = dst->src[1];
+    const ggml_tensor * v     = dst->src[2];
+    const ggml_tensor * mask  = dst->src[3];
+    const ggml_tensor * sinks = dst->src[4];
+
+    const int64_t DK     = k->ne[0];
+    const int64_t DV     = v->ne[0];
+    const int64_t n_head = q->ne[2];
+    const int64_t rk2    = q->ne[2]/k->ne[2];
+    const int64_t rv2    = q->ne[2]/v->ne[2];
+    const size_t  nbk1   = k->nb[1];
+    const size_t  nbv1   = v->nb[1];
+
+    float scale         = 1.0f;
+    float max_bias      = 0.0f;
+    float logit_softcap = 0.0f;
+    memcpy(&scale,         (const float *) dst->op_params + 0, sizeof(float));
+    memcpy(&max_bias,      (const float *) dst->op_params + 1, sizeof(float));
+    memcpy(&logit_softcap, (const float *) dst->op_params + 2, sizeof(float));
+    if (logit_softcap != 0) {
+        scale /= logit_softcap;
+    }
+    const uint32_t n_head_log2 = 1u << (uint32_t) floor(log2((double) n_head));
+    const float m0 = powf(2.0f, -(max_bias       ) / n_head_log2);
+    const float m1 = powf(2.0f, -(max_bias / 2.0f) / n_head_log2);
+
+    // scratch layout as in the template kernel (its [GB][BKV] score area is unused here)
+    __fp16  * Q16 = (__fp16 *) scratch;               // [n_head][DK]
+    float   * acc = scratch + n_head*DK/2;            // [n_head][DV]
+    float   * M   = acc + n_head*DV;                  // [n_head]
+    float   * S   = M + n_head;                       // [n_head]
+    float   * w   = S + n_head + FA_DEC_GBMAX*FA_DEC_BKV; // [BKV][4] scores, then probabilities, by position
+    int32_t * idx = (int32_t *) (w + 4*FA_DEC_BKV);   // [BKV] unmasked positions of the block
+    float   * mvl = (float *) (idx + FA_DEC_BKV);     // [BKV] their mask values
+
+    for (int64_t h = 0; h < n_head; h++) {
+        const float * pq = (const float *) ((const char *) q->data + h*q->nb[2]);
+        for (int64_t d = 0; d < DK; d++) {
+            Q16[h*DK + d] = (__fp16) pq[d];
+        }
+        M[h] = -INFINITY;
+        S[h] = 0.0f;
+    }
+    memset(acc, 0, n_head*DV*sizeof(float));
+
+    // ALiBi slopes / soft-capping take the per-lane path
+    const bool plain = max_bias == 0.0f && logit_softcap == 0.0f;
+
+    const ggml_fp16_t * mp = mask ? (const ggml_fp16_t *) mask->data : NULL;
+
+    // prefetch: the KV heads of a cell are contiguous in the KV cache rows
+    const int     pfd   = ggml_fa_dec_pfd();
+    const size_t  kspan = (size_t) (k->ne[2] - 1)*k->nb[2] + DK*sizeof(ggml_fp16_t);
+    const size_t  vspan = (size_t) (v->ne[2] - 1)*v->nb[2] + DV*sizeof(ggml_fp16_t);
+    const bool    pfok  = pfd > 0 && kspan <= nbk1 && vspan <= nbv1;
+    const int64_t n_grp = n_head/4;
+
+    for (int64_t b0 = ic_start; b0 < ic_end; b0 += FA_DEC_BKV) {
+        const int64_t b1 = std::min(b0 + FA_DEC_BKV, ic_end);
+
+        // unmasked positions of this block (the mask is shared by all heads)
+        int n = 0;
+        for (int64_t ic = b0; ic < b1; ic++) {
+            const float mv = mp ? GGML_CPU_FP16_TO_FP32(mp[ic]) : 0.0f;
+            if (mv == -INFINITY) {
+                continue;
+            }
+            idx[n] = (int32_t) ic;
+            mvl[n] = mv;
+            n++;
+        }
+
+        // cells of the block pfd blocks ahead: K lines spread over the score passes, V lines over the V passes
+        ggml_fa_dec_pf kpf, vpf;
+        int kpfn = 0, vpfn = 0;
+        if (pfok && b0 == ic_start) {
+            // prologue: the cells before the first prefetched block, all at once (each thread's first block is ~1/8
+            // of its chunk at 4K context)
+            ggml_fa_dec_pf pk, pv;
+            const int64_t e = std::min<int64_t>(ic_start + pfd, ic_end);
+            pk.p = (const char *) k->data + ic_start*nbk1; pk.end = (const char *) k->data + e*nbk1;
+            pv.p = (const char *) v->data + ic_start*nbv1; pv.end = (const char *) v->data + e*nbv1;
+            pk.step(1 << 20);
+            pv.step(1 << 20);
+        }
+        if (pfok) {
+            const int64_t p0 = b0 + pfd;
+            const int64_t p1 = std::min(p0 + FA_DEC_BKV, ic_end);
+            if (p0 < p1) {
+                kpf.p = (const char *) k->data + p0*nbk1; kpf.end = (const char *) k->data + (p1 - 1)*nbk1 + kspan;
+                vpf.p = (const char *) v->data + p0*nbv1; vpf.end = (const char *) v->data + (p1 - 1)*nbv1 + vspan;
+                const int64_t klines = (kpf.end - kpf.p + 63)/64;
+                const int64_t vlines = (vpf.end - vpf.p + 63)/64;
+                const int64_t ksteps = std::max<int64_t>(1, n_grp*(n/2));
+                const int64_t vsteps = std::max<int64_t>(1, n_grp*(DV/16)*(n/4));
+                kpfn = (int) ((klines + ksteps - 1)/ksteps);
+                vpfn = (int) ((vlines + vsteps - 1)/vsteps);
+            }
+        }
+
+        for (int64_t h0 = 0; n > 0 && h0 < n_head; h0 += 4) {
+            const char * kbase = (const char *) k->data + (h0/rk2)*k->nb[2];
+            const char * vbase = (const char *) v->data + (h0/rv2)*v->nb[2];
+            const __fp16 * Qg  = Q16 + h0*DK;
+
+            // scores, position-major
+            int t = 0;
+            for (; t + 1 < n; t += 2) {
+                ggml_fa_dec_dot2_g4((const __fp16 *) (kbase + (size_t) idx[t]*nbk1), (const __fp16 *) (kbase + (size_t) idx[t + 1]*nbk1), Qg, DK, w + 4*t, w + 4*(t + 1));
+                kpf.step(kpfn);
+            }
+            if (t < n) {
+                ggml_fa_dec_dot1_g4((const __fp16 *) (kbase + (size_t) idx[t]*nbk1), Qg, DK, w + 4*t);
+            }
+
+            // block softmax across the 4 heads, merged into the running (M, S)
+            float32x4_t vmb = vdupq_n_f32(-INFINITY);
+            if (plain) {
+                const float32x4_t vscale = vdupq_n_f32(scale);
+                for (int i = 0; i < n; i++) {
+                    // round s*scale before adding the mask, as the template kernel's scalar loop does; with
+                    // -ffp-model=fast the compiler would otherwise fuse this into one FMA (differs for finite
+                    // non-zero mask values when scale is not a power of 2)
+                    float32x4_t xs = vmulq_f32(vld1q_f32(w + 4*i), vscale);
+                    __asm__("" : "+w"(xs));
+                    const float32x4_t x = vaddq_f32(xs, vdupq_n_f32(mvl[i]));
+                    vst1q_f32(w + 4*i, x);
+                    vmb = vmaxq_f32(vmb, x);
+                }
+            } else {
+                float slope[4];
+                float mb[4] = { -INFINITY, -INFINITY, -INFINITY, -INFINITY };
+                for (int j = 0; j < 4; j++) {
+                    const int64_t h = h0 + j;
+                    slope[j] = (max_bias > 0.0f) ? (h < n_head_log2 ? powf(m0, h + 1) : powf(m1, 2*(h - n_head_log2) + 1)) : 1.0f;
+                }
+                for (int i = 0; i < n; i++) {
+                    for (int j = 0; j < 4; j++) {
+                        float x = w[4*i + j]*scale;
+                        if (logit_softcap != 0.0f) {
+                            x = logit_softcap*tanhf(x);
+                        }
+                        x += slope[j]*mvl[i];
+                        w[4*i + j] = x;
+                        mb[j] = std::max(mb[j], x);
+                    }
+                }
+                vmb = vld1q_f32(mb);
+            }
+            float mo[4], mn[4], rs[4];
+            vst1q_f32(mo, vld1q_f32(M + h0));
+            const float32x4_t Mnew = vmaxq_f32(vld1q_f32(mo), vmb);
+            vst1q_f32(mn, Mnew);
+            for (int j = 0; j < 4; j++) {
+                rs[j] = mo[j] == -INFINITY ? 0.0f : expf(mo[j] - mn[j]);
+            }
+            vst1q_f32(M + h0, Mnew);
+            const float32x4_t rescale = vld1q_f32(rs);
+
+            // sums kept per position mod 4 and combined as vaddvq_f32 combines its lanes
+            float32x4_t s4[4] = { vdupq_n_f32(0.0f), vdupq_n_f32(0.0f), vdupq_n_f32(0.0f), vdupq_n_f32(0.0f) };
+            int i = 0;
+            for (; i + 3 < n; i += 4) {
+                const float32x4_t p0 = ggml_v_expf(vsubq_f32(vld1q_f32(w + 4*i + 0),  Mnew));
+                const float32x4_t p1 = ggml_v_expf(vsubq_f32(vld1q_f32(w + 4*i + 4),  Mnew));
+                const float32x4_t p2 = ggml_v_expf(vsubq_f32(vld1q_f32(w + 4*i + 8),  Mnew));
+                const float32x4_t p3 = ggml_v_expf(vsubq_f32(vld1q_f32(w + 4*i + 12), Mnew));
+                vst1q_f32(w + 4*i + 0, p0); s4[0] = vaddq_f32(s4[0], p0);
+                vst1q_f32(w + 4*i + 4, p1); s4[1] = vaddq_f32(s4[1], p1);
+                vst1q_f32(w + 4*i + 8, p2); s4[2] = vaddq_f32(s4[2], p2);
+                vst1q_f32(w + 4*i + 12, p3); s4[3] = vaddq_f32(s4[3], p3);
+            }
+            for (; i < n; i++) {
+                const float32x4_t p = ggml_v_expf(vsubq_f32(vld1q_f32(w + 4*i), Mnew));
+                vst1q_f32(w + 4*i, p);
+                s4[i & 3] = vaddq_f32(s4[i & 3], p);
+            }
+            const float32x4_t tot = vaddq_f32(vaddq_f32(s4[0], s4[1]), vaddq_f32(s4[2], s4[3]));
+            vst1q_f32(S + h0, vfmaq_f32(tot, vld1q_f32(S + h0), rescale));
+
+            ggml_fa_dec_accum_v_g4(acc + h0*DV, rescale, vbase, nbv1, idx, w, n, DV, vpf, vpfn);
+        }
+        // whatever the passes did not cover
+        kpf.step(1 << 20);
+        vpf.step(1 << 20);
+    }
+
+    for (int64_t h = 0; h < n_head; h++) {
+        float * VKQ = acc + h*DV;
+
+        // sinks - apply only on the first kv-chunk
+        if (sinks && ic_start == 0) {
+            const float s = ((const float *) sinks->data)[h];
+            float ms = 1.0f;
+            float vs = 1.0f;
+            if (s > M[h]) {
+                ms = expf(M[h] - s);
+                M[h] = s;
+                ggml_vec_scale_f32(DV, VKQ, ms);
+            } else {
+                vs = expf(s - M[h]);
+            }
+            S[h] = S[h]*ms + vs;
+        }
+
+        float * partial = partials + h*partial_stride;
+        partial[0] = M[h];
+        partial[1] = S[h];
+        memcpy(partial + 2, VKQ, DV*sizeof(float));
+    }
+}
+
+// can the decode kernel take this FLASH_ATTN_EXT node (given the split-KV path is taken)?
+static bool ggml_fa_dec_supported(const ggml_tensor * dst, bool streams = false) {
+    const ggml_tensor * q    = dst->src[0];
+    const ggml_tensor * k    = dst->src[1];
+    const ggml_tensor * v    = dst->src[2];
+    const ggml_tensor * mask = dst->src[3];
+    if (!ggml_fa_dec_enabled()) {
+        return false;
+    }
+    if (k->type != GGML_TYPE_F16 || v->type != GGML_TYPE_F16) {
+        return false;
+    }
+    if (k->ne[0] % 8 != 0 || v->ne[0] % 16 != 0 || k->ne[2] != v->ne[2] || q->ne[2] % k->ne[2] != 0) {
+        return false;
+    }
+    // streams (batch-invariant path): one mask plane per KV stream, viewed per row by the caller
+    if (mask && (mask->type != GGML_TYPE_F16 || mask->ne[2] != 1 || (streams ? q->ne[3] % mask->ne[3] != 0 : mask->ne[3] != 1))) {
+        return false;
+    }
+    return true;
+}
+
+// heads per pass over K/V: the largest of 4, 3, 2 dividing the GQA ratio, else 1
+static int ggml_fa_dec_gb(int64_t rk2) {
+    for (int gb = FA_DEC_GBMAX; gb > 1; gb--) {
+        if (rk2 % gb == 0) {
+            return gb;
+        }
+    }
+    return 1;
+}
+
+static void ggml_fa_dec_chunk(
+        const ggml_tensor * dst, int64_t ic_start, int64_t ic_end, float * scratch, float * partials, int64_t partial_stride) {
+    switch (ggml_fa_dec_gb(dst->src[0]->ne[2] / dst->src[1]->ne[2])) {
+        case 4:
+            if (ggml_fa_dec_v2_enabled()) {
+                ggml_fa_dec_chunk_g4(dst, ic_start, ic_end, scratch, partials, partial_stride);
+            } else {
+                ggml_fa_dec_chunk_t<4>(dst, ic_start, ic_end, scratch, partials, partial_stride);
+            }
+            break;
+        case 3:  ggml_fa_dec_chunk_t<3>(dst, ic_start, ic_end, scratch, partials, partial_stride); break;
+        case 2:  ggml_fa_dec_chunk_t<2>(dst, ic_start, ic_end, scratch, partials, partial_stride); break;
+        default: ggml_fa_dec_chunk_t<1>(dst, ic_start, ic_end, scratch, partials, partial_stride); break;
+    }
+}
+#endif // GGML_FA_DEC
+
+// trilane srv-spec: batch-invariant mode (GGML_CPU_BATCH_INVARIANT=1, see repack.cpp): a query row's result must not
+// depend on how many rows share the call (tiled kernel for many rows), on the cache size (split-KV kernel for one row
+// and >= 512 cells) or on the thread count (split-KV chunk size); see ggml_fa_bi below
+static bool fa_batch_invariant() {
+    static const bool v = [] { const char * e = getenv("GGML_CPU_BATCH_INVARIANT"); return e && atoi(e) != 0; }();
+    return v;
+}
+
+// Batch-invariant split-KV attention: the KV cells are cut into chunks at FIXED absolute cell indices (multiples of
+// FA_BI_CHUNK), each (query row, chunk) runs the F16 decode kernel (all heads, blocks of FA_DEC_BKV cells from the
+// chunk start), and the chunk partials of a row are folded in chunk order. A row's result therefore depends only on its
+// unmasked cells (masked ones are skipped by the kernel), not on the row count, the cache size or the thread count, and
+// long contexts keep the KV parallelism of the split-KV decode path. Rows are spread over threads when there are
+// enough of them, (row, chunk) pairs otherwise; both give the same bits. Larger row sets (prompt prefill) keep the
+// regular paths.
+#define FA_BI_CHUNK    128
+#define FA_BI_MAX_ROWS 64
+
+#ifdef GGML_FA_DEC
+static bool ggml_fa_bi_applies(const ggml_tensor * dst) {
+    const ggml_tensor * q = dst->src[0];
+    return fa_batch_invariant() && q->type == GGML_TYPE_F32 && q->ne[1]*q->ne[3] <= FA_BI_MAX_ROWS &&
+           q->ne[3] % dst->src[1]->ne[3] == 0 && q->ne[3] % dst->src[2]->ne[3] == 0 && ggml_fa_dec_supported(dst, true);
+}
+
+static int64_t ggml_fa_bi_thread_f32(int64_t DK, int64_t DV, int64_t H) {
+    return ggml_fa_dec_scratch_f32(DK, DV, H) + 2*H*(2 + DV) + 2*CACHE_LINE_SIZE_F32;
+}
+
+size_t ggml_cpu_fa_bi_wsize(const ggml_tensor * dst, int n_tasks) {
+    if (!ggml_fa_bi_applies(dst)) {
+        return 0;
+    }
+    const ggml_tensor * q = dst->src[0];
+    const int64_t DK = dst->src[1]->ne[0], DV = dst->src[2]->ne[0], H = q->ne[2];
+    const int64_t rows = q->ne[1]*q->ne[3];
+    const int64_t nch  = (dst->src[1]->ne[1] + FA_BI_CHUNK - 1)/FA_BI_CHUNK;
+    int64_t n = n_tasks*ggml_fa_bi_thread_f32(DK, DV, H) + 2*CACHE_LINE_SIZE_F32;
+    if (rows < n_tasks) {
+        n += rows*H*nch*(2 + DV);
+    }
+    return sizeof(float)*n;
+}
+
+// trilane r12-dec: GGML_CPU_BI_FA_HSPLIT (default 1): when there are fewer (row, chunk) tasks than threads (one decode
+// row at short context: 2-4 chunks for 12 threads), each task covers one KV head's group of query heads instead of
+// all heads, so up to n_kv_head times more threads share the work. A head's partials are computed by the same kernel
+// over the same cells (heads of different KV groups never interact), so the bits are unchanged. Only without ALiBi
+// and sinks (both index heads by their absolute number). 0 = one task per (row, chunk).
+static bool fa_bi_hsplit() {
+    static const bool v = [] { const char * e = getenv("GGML_CPU_BI_FA_HSPLIT"); return !(e && atoi(e) == 0); }();
+    return v;
+}
+
+// one (row, chunk): a view of q / mask at row (iq1, iq3) and of k / v at its stream, then the decode kernel; with
+// nkv > 0 only KV heads [kv0, kv0 + nkv) and their query heads (partials then point at the first of those heads)
+static void ggml_fa_bi_chunk(const ggml_tensor * dst, int64_t row, int64_t ic0, int64_t ic1, float * scratch, float * partials, int64_t stride,
+                             int64_t kv0 = 0, int64_t nkv = 0) {
+    const ggml_tensor * q = dst->src[0];
+    const ggml_tensor * k = dst->src[1];
+    const ggml_tensor * v = dst->src[2];
+    const ggml_tensor * m = dst->src[3];
+    const int64_t iq1 = row % q->ne[1], iq3 = row / q->ne[1];
+    ggml_tensor qr = *q, kr = *k, vr = *v, mr;
+    qr.data = (char *) q->data + iq1*q->nb[1] + iq3*q->nb[3]; qr.ne[1] = 1; qr.ne[3] = 1;
+    kr.data = (char *) k->data + (iq3/(q->ne[3]/k->ne[3]))*k->nb[3]; kr.ne[3] = 1;
+    vr.data = (char *) v->data + (iq3/(q->ne[3]/v->ne[3]))*v->nb[3]; vr.ne[3] = 1;
+    if (nkv > 0) {
+        const int64_t rk = q->ne[2]/k->ne[2];
+        qr.data = (char *) qr.data + kv0*rk*q->nb[2]; qr.ne[2] = nkv*rk;
+        kr.data = (char *) kr.data + kv0*k->nb[2];    kr.ne[2] = nkv;
+        vr.data = (char *) vr.data + kv0*v->nb[2];    vr.ne[2] = nkv;
+    }
+    ggml_tensor d = *dst;
+    d.src[0] = &qr; d.src[1] = &kr; d.src[2] = &vr;
+    if (m) {
+        mr = *m;
+        mr.data = (char *) m->data + iq1*m->nb[1] + (iq3 % m->ne[3])*m->nb[3]; mr.ne[1] = 1; mr.ne[3] = 1;
+        d.src[3] = &mr;
+    }
+    ggml_fa_dec_chunk(&d, ic0, ic1, scratch, partials, stride);
+}
+
+// running (M, S, VKQ) of one head += one chunk partial (same arithmetic as ggml_flash_attn_ext_reduce_partials)
+static inline void ggml_fa_bi_fold(float * run, const float * part, int64_t DV) {
+    const float Mc = part[0], Sc = part[1];
+    if (Sc == 0.0f) {
+        return;
+    }
+    const float Mn = fmaxf(run[0], Mc);
+    const float so = expf(run[0] - Mn);
+    const float sn = expf(Mc - Mn);
+    for (int64_t d = 0; d < DV; ++d) {
+        run[2 + d] = run[2 + d]*so + part[2 + d]*sn;
+    }
+    run[1] = run[1]*so + Sc*sn;
+    run[0] = Mn;
+}
+
+static inline void ggml_fa_bi_write(ggml_tensor * dst, int64_t row, int64_t h, float * run, int64_t DV) {
+    const int64_t N = dst->src[0]->ne[1];
+    const int64_t iq1 = row % N, iq3 = row / N;
+    if (run[1] != 0.0f) {
+        ggml_vec_scale_f32(DV, run + 2, 1.0f/run[1]);
+    }
+    // permute(0, 2, 1, 3)
+    memcpy((char *) dst->data + (iq3*dst->ne[2]*dst->ne[1] + h + iq1*dst->ne[1])*dst->nb[1], run + 2, dst->nb[1]);
+}
+
+static void ggml_fa_bi(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * q = dst->src[0];
+    const int64_t DK = dst->src[1]->ne[0], DV = dst->src[2]->ne[0], H = q->ne[2];
+    const int64_t rows = q->ne[1]*q->ne[3];
+    const int64_t nek1 = dst->src[1]->ne[1];
+    const int64_t nch  = (nek1 + FA_BI_CHUNK - 1)/FA_BI_CHUNK;
+    const int64_t ps   = 2 + DV;
+    const int ith = params->ith, nth = params->nth;
+
+    float * base      = (float *) GGML_PAD((uintptr_t) params->wdata, CACHE_LINE_SIZE);
+    const int64_t tsz = ggml_fa_bi_thread_f32(DK, DV, H);
+    float * scratch   = (float *) GGML_PAD((uintptr_t) (base + ith*tsz), CACHE_LINE_SIZE);
+    float * part      = scratch + ggml_fa_dec_scratch_f32(DK, DV, H);   // [H][ps] one chunk
+    float * run       = part + H*ps;                                     // [H][ps] running fold
+
+    if (rows >= nth) {
+        for (int64_t r = ith; r < rows; r += nth) {
+            for (int64_t h = 0; h < H; h++) {
+                run[h*ps] = -INFINITY; run[h*ps + 1] = 0.0f;
+                memset(run + h*ps + 2, 0, DV*sizeof(float));
+            }
+            for (int64_t c = 0; c < nch; c++) {
+                ggml_fa_bi_chunk(dst, r, c*FA_BI_CHUNK, std::min((c + 1)*FA_BI_CHUNK, nek1), scratch, part, ps);
+                for (int64_t h = 0; h < H; h++) {
+                    ggml_fa_bi_fold(run + h*ps, part + h*ps, DV);
+                }
+            }
+            for (int64_t h = 0; h < H; h++) {
+                ggml_fa_bi_write(dst, r, h, run + h*ps, DV);
+            }
+        }
+        return;
+    }
+    // few rows: (row, chunk) tasks into shared partials [row][head][chunk], then one fold per (row, head)
+    float * G = base + nth*tsz + CACHE_LINE_SIZE_F32;
+    float max_bias = 0.0f;
+    memcpy(&max_bias, (const float *) dst->op_params + 1, sizeof(float));
+    const int64_t nkvh = dst->src[1]->ne[2];
+    // KV-head groups per task: as many groups as needed to give every thread a task, if splitting is allowed
+    int64_t ng = 1;
+    if (fa_bi_hsplit() && max_bias == 0.0f && dst->src[4] == NULL && dst->src[1]->ne[2] == dst->src[2]->ne[2]) {
+        while (ng < nkvh && rows*nch*ng < nth) {
+            ng++;
+            while (nkvh % ng != 0) {
+                ng++;
+            }
+        }
+    }
+    if (ng <= 1) {
+        for (int64_t t = ith; t < rows*nch; t += nth) {
+            const int64_t r = t / nch, c = t % nch;
+            ggml_fa_bi_chunk(dst, r, c*FA_BI_CHUNK, std::min((c + 1)*FA_BI_CHUNK, nek1), scratch, G + (r*H*nch + c)*ps, nch*ps);
