+// HTP_GDN_PIPE_VSPLAT: the same k^T pack with the 32x32 word transpose done in two register passes. Stages 1-3 of
+// hvx_transpose_32x32_words only mix vectors inside blocks of 8 (pass A: 8 rows in registers, one store each to the
+// scratch m), stages 4-5 only mix the stage-3 vectors i, i + 8, i + 16, i + 24, which give the final vectors
+// 4i .. 4i + 3 (pass B: those go straight into both tile buffers). Same shuffles in the same pairs: same bits.
+static inline void gdn_v2_pack_kT_tiles_2p(__fp16 * restrict kT_row, __fp16 * restrict k_col, const __fp16 * restrict k_f16,
+                                           uint32_t S_v, HVX_Vector * restrict m) {
