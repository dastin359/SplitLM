+template <int GB>
+static inline void ggml_fa_dec_dot1(const __fp16 * k0, const __fp16 * q, int64_t DK, float * s0) {
+    float32x4_t a0[GB], b0[GB];
+    for (int j = 0; j < GB; j++) { a0[j] = vdupq_n_f32(0.0f); b0[j] = vdupq_n_f32(0.0f); }
+    for (int64_t d = 0; d < DK; d += 8) {
+        const float16x8_t x0 = vld1q_f16(k0 + d);
+        for (int j = 0; j < GB; j++) {
+            const float16x8_t qv = vld1q_f16(q + j*DK + d);
+            a0[j] = vfmlalq_low_f16 (a0[j], x0, qv);
+            b0[j] = vfmlalq_high_f16(b0[j], x0, qv);
+        }
+    }
+    for (int j = 0; j < GB; j++) {
+        s0[j] = vaddvq_f32(vaddq_f32(a0[j], b0[j]));
+    }
