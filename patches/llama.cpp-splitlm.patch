new file mode 100644
index 0000000..44335c9
--- /dev/null
+++ b/ggml/src/ggml-cpu/htp-tile.cpp
@@ -0,0 +1,720 @@
+#define GGML_COMMON_IMPL_CPP
+#define GGML_COMMON_DECL_CPP
+#include "ggml-common.h"
+#include "ggml-backend-impl.h"
+
+#include "ggml-impl.h"
+#include "ggml-cpu.h"
+#include "ggml-cpu-impl.h"
+#include "simd-mappings.h"
+#include "traits.h"
+#include "quants.h"
+#include "htp-tile.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+#if defined(__ARM_NEON)
+#include <arm_neon.h>
+#endif
+
+// Hexagon Q4_0 tile (see ggml-hexagon/htp-repack.cpp): 32 rows x 32 k, byte cp*32+row holds
+// q[row][2cp] | q[row][2cp+1] << 4 (raw nibbles, value = (q - 8) * d), then 32 fp16 row scales at byte 512.
+// Tiles are ordered row-band major then k, so with ne0 and ne1 multiples of 32 the band offsets equal flat Q4_0 offsets.
+static constexpr int    HT_ROWS  = 32;
+static constexpr size_t HT_BYTES = 576;
+
+static ggml_backend_cpu_htptile_resolver_t g_resolver      = nullptr;
+static void *                              g_resolver_user = nullptr;
+
+void ggml_backend_cpu_htptile_set_resolver(ggml_backend_cpu_htptile_resolver_t fn, void * user) {
+    g_resolver      = fn;
+    g_resolver_user = user;
+}
+
+// 2-D weights (MUL_MAT) or 3-D expert stacks (MUL_MAT_ID)
+static bool htptile_shape_ok(const ggml_tensor * t) {
+    return t->type == GGML_TYPE_Q4_0 && t->ne[3] == 1 && t->ne[0] % 32 == 0 && t->ne[1] % HT_ROWS == 0 && ggml_is_contiguous(t);
+}
+
+// y[r] = sum_k w[r][k] * x[k] for one 32-row band over n_kt k-tiles
+static void htptile_band_ref(const uint8_t * band, const block_q8_0 * x, int n_kt, float * y) {
+    float acc[HT_ROWS] = { 0 };
+    for (int kt = 0; kt < n_kt; kt++) {
+        const uint8_t *   tile = band + kt * HT_BYTES;
+        const ggml_half * sc   = (const ggml_half *) (tile + 512);
+        const float       dx   = GGML_CPU_FP16_TO_FP32(x[kt].d);
+        for (int r = 0; r < HT_ROWS; r++) {
+            int sum = 0;
+            for (int cp = 0; cp < 16; cp++) {
+                const uint8_t v = tile[cp * 32 + r];
+                sum += ((int) (v & 0x0F) - 8) * x[kt].qs[2 * cp] + ((int) (v >> 4) - 8) * x[kt].qs[2 * cp + 1];
+            }
+            acc[r] += sum * GGML_CPU_FP16_TO_FP32(sc[r]) * dx;
+        }
+    }
+    memcpy(y, acc, sizeof(acc));
+}
+
+#if defined(__ARM_NEON) && defined(__ARM_FEATURE_DOTPROD)
+// Zip the transposed nibbles back into per-row groups of 4 consecutive k, then SDOT against broadcast activations.
+static void htptile_band_neon(const uint8_t * band, const block_q8_0 * x, int n_kt, float * y) {
+    float32x4_t facc[8];
+    for (int i = 0; i < 8; i++) facc[i] = vdupq_n_f32(0.0f);
+    const uint8x16_t m4 = vdupq_n_u8(0x0F);
+
+    for (int kt = 0; kt < n_kt; kt++) {
+        const uint8_t * tile = band + kt * HT_BYTES;
+        const int8_t *  xq   = x[kt].qs;
+
+        int32_t sx = 0;
+        for (int k = 0; k < 32; k++) sx += xq[k];
+
+        for (int h = 0; h < 2; h++) {
+            int32x4_t acc[4] = { vdupq_n_s32(0), vdupq_n_s32(0), vdupq_n_s32(0), vdupq_n_s32(0) };
+            for (int j = 0; j < 8; j++) {
+                const uint8x16_t v0 = vld1q_u8(tile + (2 * j + 0) * 32 + h * 16); // k = 4j, 4j+1
+                const uint8x16_t v1 = vld1q_u8(tile + (2 * j + 1) * 32 + h * 16); // k = 4j+2, 4j+3
+                const uint8x16_t l0 = vandq_u8(v0, m4), h0 = vshrq_n_u8(v0, 4);
+                const uint8x16_t l1 = vandq_u8(v1, m4), h1 = vshrq_n_u8(v1, 4);
+                const uint16x8_t a = vreinterpretq_u16_u8(vzip1q_u8(l0, h0)); // rows 0-7:  k0 k1
+                const uint16x8_t b = vreinterpretq_u16_u8(vzip2q_u8(l0, h0)); // rows 8-15: k0 k1
+                const uint16x8_t c = vreinterpretq_u16_u8(vzip1q_u8(l1, h1)); // rows 0-7:  k2 k3
+                const uint16x8_t d = vreinterpretq_u16_u8(vzip2q_u8(l1, h1)); // rows 8-15: k2 k3
+                int32_t xg;
+                memcpy(&xg, xq + 4 * j, 4);
+                const int8x16_t xb = vreinterpretq_s8_s32(vdupq_n_s32(xg));
+                acc[0] = vdotq_s32(acc[0], vreinterpretq_s8_u16(vzip1q_u16(a, c)), xb); // rows 0-3
+                acc[1] = vdotq_s32(acc[1], vreinterpretq_s8_u16(vzip2q_u16(a, c)), xb); // rows 4-7
+                acc[2] = vdotq_s32(acc[2], vreinterpretq_s8_u16(vzip1q_u16(b, d)), xb); // rows 8-11
+                acc[3] = vdotq_s32(acc[3], vreinterpretq_s8_u16(vzip2q_u16(b, d)), xb); // rows 12-15
+            }
+            const float       dx  = GGML_CPU_FP16_TO_FP32(x[kt].d);
+            const int32x4_t   off = vdupq_n_s32(8 * sx);
+            const float16_t * sc  = (const float16_t *) (tile + 512) + h * 16;
+            for (int g = 0; g < 4; g++) {
+                const float32x4_t s = vmulq_n_f32(vcvt_f32_f16(vld1_f16(sc + 4 * g)), dx);
+                facc[h * 4 + g] = vfmaq_f32(facc[h * 4 + g], vcvtq_f32_s32(vsubq_s32(acc[g], off)), s);
+            }
+        }
+    }
+    for (int i = 0; i < 8; i++) vst1q_f32(y + 4 * i, facc[i]);
+}
+
+// htptile_band_neon for NT tokens at once: each band's nibbles are unpacked and zipped once and reused by every
+// token, so a speculative verification batch costs about one pass over the weights instead of NT.
+// Per token the integer and float operation order is the same as the single-token kernel, so results are identical.
+template <int NT>
+static void htptile_band_neon_multi(const uint8_t * band, const block_q8_0 * const * x, const int32_t * const * xsum, int n_kt, float * const * y) {
+    float32x4_t facc[NT][8];
+    for (int t = 0; t < NT; t++) for (int i = 0; i < 8; i++) facc[t][i] = vdupq_n_f32(0.0f);
+    const uint8x16_t m4 = vdupq_n_u8(0x0F);
+
+    for (int kt = 0; kt < n_kt; kt++) {
+        const uint8_t * tile = band + kt * HT_BYTES;
+        for (int h = 0; h < 2; h++) {
+            int32x4_t acc[NT][4];
+            for (int t = 0; t < NT; t++) for (int g = 0; g < 4; g++) acc[t][g] = vdupq_n_s32(0);
+            for (int j = 0; j < 8; j++) {
+                const uint8x16_t v0 = vld1q_u8(tile + (2 * j + 0) * 32 + h * 16);
+                const uint8x16_t v1 = vld1q_u8(tile + (2 * j + 1) * 32 + h * 16);
+                const uint8x16_t l0 = vandq_u8(v0, m4), h0 = vshrq_n_u8(v0, 4);
+                const uint8x16_t l1 = vandq_u8(v1, m4), h1 = vshrq_n_u8(v1, 4);
+                const uint16x8_t a = vreinterpretq_u16_u8(vzip1q_u8(l0, h0));
+                const uint16x8_t b = vreinterpretq_u16_u8(vzip2q_u8(l0, h0));
+                const uint16x8_t c = vreinterpretq_u16_u8(vzip1q_u8(l1, h1));
+                const uint16x8_t d = vreinterpretq_u16_u8(vzip2q_u8(l1, h1));
+                const int8x16_t w0 = vreinterpretq_s8_u16(vzip1q_u16(a, c));
+                const int8x16_t w1 = vreinterpretq_s8_u16(vzip2q_u16(a, c));
+                const int8x16_t w2 = vreinterpretq_s8_u16(vzip1q_u16(b, d));
+                const int8x16_t w3 = vreinterpretq_s8_u16(vzip2q_u16(b, d));
+                for (int t = 0; t < NT; t++) {
+                    int32_t xg;
+                    memcpy(&xg, x[t][kt].qs + 4 * j, 4);
+                    const int8x16_t xb = vreinterpretq_s8_s32(vdupq_n_s32(xg));
+                    acc[t][0] = vdotq_s32(acc[t][0], w0, xb);
+                    acc[t][1] = vdotq_s32(acc[t][1], w1, xb);
+                    acc[t][2] = vdotq_s32(acc[t][2], w2, xb);
+                    acc[t][3] = vdotq_s32(acc[t][3], w3, xb);
+                }
+            }
+            const float16_t * sc = (const float16_t *) (tile + 512) + h * 16;
+            for (int t = 0; t < NT; t++) {
+                const float     dx  = GGML_CPU_FP16_TO_FP32(x[t][kt].d);
+                const int32x4_t off = vdupq_n_s32(8 * xsum[t][kt]);
+                for (int g = 0; g < 4; g++) {
+                    const float32x4_t s = vmulq_n_f32(vcvt_f32_f16(vld1_f16(sc + 4 * g)), dx);
+                    facc[t][h * 4 + g] = vfmaq_f32(facc[t][h * 4 + g], vcvtq_f32_s32(vsubq_s32(acc[t][g], off)), s);
+                }
+            }
+        }
+    }
+    for (int t = 0; t < NT; t++) for (int i = 0; i < 8; i++) vst1q_f32(y[t] + 4 * i, facc[t][i]);
+}
+#endif
+
+// int32 sum of each q8_0 block's quants (the -8 nibble offset term), for kernels that take precomputed sums
+static void htptile_block_sums(const block_q8_0 * xb, int32_t * xsum, int n_kt) {
+    for (int kt = 0; kt < n_kt; kt++) {
+        int32_t s = 0;
+        for (int k = 0; k < 32; k++) s += xb[kt].qs[k];
+        xsum[kt] = s;
+    }
+}
+
+#if defined(__ARM_NEON) && defined(__ARM_FEATURE_MATMUL_INT8)
+#define HTPTILE_I8MM 1
+// Activation blocks for this kernel are pre-permuted per group of 8 k: [k0 k2 k4 k6 k1 k3 k5 k7].
+// Transposing 4 column-pair bytes per row puts the even k in the low nibbles and the odd k in the high ones,
+// so USDOT(byte & 0x0F, even x) + USDOT(byte & 0xF0, odd x) / 16 needs no nibble shuffles.
+static void htptile_band_i8mm(const uint8_t * band, const block_q8_0 * x, const int32_t * xsum, int n_kt, float * y) {
+    float32x4_t facc[8];
+    for (int i = 0; i < 8; i++) facc[i] = vdupq_n_f32(0.0f);
+    const uint8x16_t mlo = vdupq_n_u8(0x0F);
+    const uint8x16_t mhi = vdupq_n_u8(0xF0);
+
+    for (int kt = 0; kt < n_kt; kt++) {
+        const uint8_t * tile = band + kt * HT_BYTES;
+        const int8x16_t xa = vld1q_s8(x[kt].qs);
+        const int8x16_t xb = vld1q_s8(x[kt].qs + 16);
+
+        for (int h = 0; h < 2; h++) {
+            int32x4_t lo[4], hi[4];
+            for (int i = 0; i < 4; i++) { lo[i] = vdupq_n_s32(0); hi[i] = vdupq_n_s32(0); }
+
+#define HTPTILE_GROUP(m, XV, LLO, LHI)                                                                      \
+            {                                                                                               \
+                const uint8_t * p = tile + (4 * (m)) * 32 + h * 16;                                         \
+                const uint8x16_t v0 = vld1q_u8(p), v1 = vld1q_u8(p + 32), v2 = vld1q_u8(p + 64), v3 = vld1q_u8(p + 96); \
+                const uint16x8_t t0 = vreinterpretq_u16_u8(vzip1q_u8(v0, v1));                              \
+                const uint16x8_t t1 = vreinterpretq_u16_u8(vzip2q_u8(v0, v1));                              \
+                const uint16x8_t t2 = vreinterpretq_u16_u8(vzip1q_u8(v2, v3));                              \
+                const uint16x8_t t3 = vreinterpretq_u16_u8(vzip2q_u8(v2, v3));                              \
+                const uint8x16_t w[4] = { vreinterpretq_u8_u16(vzip1q_u16(t0, t2)), vreinterpretq_u8_u16(vzip2q_u16(t0, t2)), \
+                                          vreinterpretq_u8_u16(vzip1q_u16(t1, t3)), vreinterpretq_u8_u16(vzip2q_u16(t1, t3)) }; \
+                for (int i = 0; i < 4; i++) {                                                               \
+                    lo[i] = vusdotq_laneq_s32(lo[i], vandq_u8(w[i], mlo), XV, LLO);                         \
+                    hi[i] = vusdotq_laneq_s32(hi[i], vandq_u8(w[i], mhi), XV, LHI);                         \
+                }                                                                                           \
+            }
+            HTPTILE_GROUP(0, xa, 0, 1)
+            HTPTILE_GROUP(1, xa, 2, 3)
+            HTPTILE_GROUP(2, xb, 0, 1)
+            HTPTILE_GROUP(3, xb, 2, 3)
+#undef HTPTILE_GROUP
+
+            const float       dx  = GGML_CPU_FP16_TO_FP32(x[kt].d);
+            const int32x4_t   off = vdupq_n_s32(8 * xsum[kt]);
+            const float16_t * sc  = (const float16_t *) (tile + 512) + h * 16;
+            for (int g = 0; g < 4; g++) {
+                const int32x4_t   q = vsubq_s32(vaddq_s32(lo[g], vshrq_n_s32(hi[g], 4)), off);
+                const float32x4_t s = vmulq_n_f32(vcvt_f32_f16(vld1_f16(sc + 4 * g)), dx);
+                facc[h * 4 + g] = vfmaq_f32(facc[h * 4 + g], vcvtq_f32_s32(q), s);
+            }
+        }
+    }
+    for (int i = 0; i < 8; i++) vst1q_f32(y + 4 * i, facc[i]);
+}
+
+// htptile_band_i8mm for NT (2..4) tokens: USMMLA multiplies a 2-row x 8-k weight block by an 8-k x 2-token block of
+// (pre-permuted) activations, 32 MACs per instruction, and each band is transposed once for all tokens.
+// The integer sums and the float update per (row, token) are the same as in the single-token kernels.
+template <int NT>
+static void htptile_band_mmla(const uint8_t * band, const block_q8_0 * const * x, const int32_t * const * xsum, int n_kt, float * const * y) {
+    constexpr int TP = (NT + 1) / 2; // token pairs; an odd last token is paired with itself
+    int tok[2 * TP];
+    for (int i = 0; i < 2 * TP; i++) tok[i] = std::min(i, NT - 1);
+    // [half][row pair][token pair], lanes (r0,t0) (r0,t1) (r1,t0) (r1,t1)
+    float32x4_t facc[2][8][TP];
+    for (int h = 0; h < 2; h++) for (int rp = 0; rp < 8; rp++) for (int q = 0; q < TP; q++) facc[h][rp][q] = vdupq_n_f32(0.0f);
+    const uint8x16_t mlo = vdupq_n_u8(0x0F);
+
+    for (int kt = 0; kt < n_kt; kt++) {
+        const uint8_t * tile = band + kt * HT_BYTES;
+        int8x16_t   xb[4][TP];
+        float32x4_t dxv[TP];
+        int32x4_t   offv[TP];
+        for (int q = 0; q < TP; q++) {
+            const block_q8_0 * x0 = x[tok[2 * q]] + kt;
+            const block_q8_0 * x1 = x[tok[2 * q + 1]] + kt;
+            for (int m = 0; m < 4; m++) xb[m][q] = vcombine_s8(vld1_s8(x0->qs + 8 * m), vld1_s8(x1->qs + 8 * m));
+            const float d0 = GGML_CPU_FP16_TO_FP32(x0->d), d1 = GGML_CPU_FP16_TO_FP32(x1->d);
+            const float    dv[4] = { d0, d1, d0, d1 };
+            const int32_t  ov[4] = { 8 * xsum[tok[2 * q]][kt], 8 * xsum[tok[2 * q + 1]][kt], 8 * xsum[tok[2 * q]][kt], 8 * xsum[tok[2 * q + 1]][kt] };
+            dxv[q]  = vld1q_f32(dv);
+            offv[q] = vld1q_s32(ov);
+        }
+        for (int h = 0; h < 2; h++) {
+            int32x4_t acc[8][TP];
+            for (int rp = 0; rp < 8; rp++) for (int q = 0; q < TP; q++) acc[rp][q] = vdupq_n_s32(0);
+            for (int m = 0; m < 4; m++) {
+                const uint8_t * p = tile + (4 * m) * 32 + h * 16;
+                const uint8x16_t v0 = vld1q_u8(p), v1 = vld1q_u8(p + 32), v2 = vld1q_u8(p + 64), v3 = vld1q_u8(p + 96);
+                const uint16x8_t t0 = vreinterpretq_u16_u8(vzip1q_u8(v0, v1));
+                const uint16x8_t t1 = vreinterpretq_u16_u8(vzip2q_u8(v0, v1));
+                const uint16x8_t t2 = vreinterpretq_u16_u8(vzip1q_u8(v2, v3));
+                const uint16x8_t t3 = vreinterpretq_u16_u8(vzip2q_u8(v2, v3));
+                // rows 4i..4i+3, 4 bytes each: even k in the low nibbles, odd k in the high ones
+                const uint8x16_t w[4] = { vreinterpretq_u8_u16(vzip1q_u16(t0, t2)), vreinterpretq_u8_u16(vzip2q_u16(t0, t2)),
+                                          vreinterpretq_u8_u16(vzip1q_u16(t1, t3)), vreinterpretq_u8_u16(vzip2q_u16(t1, t3)) };
+                for (int i = 0; i < 4; i++) {
+                    const uint32x4_t lo = vreinterpretq_u32_u8(vandq_u8(w[i], mlo));
+                    const uint32x4_t hi = vreinterpretq_u32_u8(vshrq_n_u8(w[i], 4));
+                    // two rows of [k0 k2 k4 k6 k1 k3 k5 k7], the activation permutation of htptile_prep_x
+                    const uint8x16_t a0 = vreinterpretq_u8_u32(vzip1q_u32(lo, hi));
+                    const uint8x16_t a1 = vreinterpretq_u8_u32(vzip2q_u32(lo, hi));
+                    for (int q = 0; q < TP; q++) {
+                        acc[2 * i + 0][q] = vusmmlaq_s32(acc[2 * i + 0][q], a0, xb[m][q]);
+                        acc[2 * i + 1][q] = vusmmlaq_s32(acc[2 * i + 1][q], a1, xb[m][q]);
+                    }
+                }
+            }
+            const float16_t * sc = (const float16_t *) (tile + 512) + h * 16;
+            for (int g = 0; g < 4; g++) {
+                const float32x4_t s4 = vcvt_f32_f16(vld1_f16(sc + 4 * g)); // rows 4g..4g+3
+                const float32x4_t sp[2] = { vzip1q_f32(s4, s4), vzip2q_f32(s4, s4) }; // [s0 s0 s1 s1], [s2 s2 s3 s3]
+                for (int j = 0; j < 2; j++) {
+                    for (int q = 0; q < TP; q++) {
+                        float32x4_t & f = facc[h][2 * g + j][q];
+                        f = vfmaq_f32(f, vcvtq_f32_s32(vsubq_s32(acc[2 * g + j][q], offv[q])), vmulq_f32(sp[j], dxv[q]));
+                    }
+                }
+            }
+        }
+    }
+    for (int h = 0; h < 2; h++) {
+        for (int rp = 0; rp < 8; rp++) {
+            const int r = h * 16 + 2 * rp;
+            for (int q = 0; q < TP; q++) {
+                float v[4];
+                vst1q_f32(v, facc[h][rp][q]);
+                y[2 * q][r] = v[0];
+                y[2 * q][r + 1] = v[2];
+                if (2 * q + 1 < NT) {
+                    y[2 * q + 1][r] = v[1];
+                    y[2 * q + 1][r + 1] = v[3];
+                }
+            }
+        }
+    }
+}
+
+// [k0..k7] -> [k0 k2 k4 k6 k1 k3 k5 k7] in every group of 8, and per-block sums for the -8 offset
+static void htptile_prep_x(block_q8_0 * xb, int32_t * xsum, int n_kt) {
+    for (int kt = 0; kt < n_kt; kt++) {
+        int8_t tmp[32];
+        int32_t s = 0;
+        for (int m = 0; m < 4; m++) {
+            for (int i = 0; i < 4; i++) {
+                tmp[8 * m + i]     = xb[kt].qs[8 * m + 2 * i];
+                tmp[8 * m + 4 + i] = xb[kt].qs[8 * m + 2 * i + 1];
+            }
+        }
+        for (int k = 0; k < 32; k++) s += xb[kt].qs[k];
+        memcpy(xb[kt].qs, tmp, 32);
+        xsum[kt] = s;
+    }
+}
+#endif
+
+// MMLA: batches only (activations permuted as for USDOT); groups of 2-4 tokens use USMMLA, single tokens USDOT
+enum htptile_kernel { HTPTILE_REF, HTPTILE_DOT, HTPTILE_USDOT, HTPTILE_MMLA };
+
+static htptile_kernel htptile_pick_kernel() {
+    // dot is the default: the expert stream is bandwidth-bound, and usdot's fewer instructions measured no faster
+    const char * e = getenv("GGML_HTPTILE_KERNEL"); // ref | dot | usdot
+    if (getenv("GGML_HTPTILE_REF") || (e && strcmp(e, "ref") == 0)) return HTPTILE_REF;
+#if defined(HTPTILE_I8MM)
+    if (e && strcmp(e, "usdot") == 0) return HTPTILE_USDOT;
+#endif
+#if defined(__ARM_NEON) && defined(__ARM_FEATURE_DOTPROD)
+    return HTPTILE_DOT;
+#else
+    return HTPTILE_REF;
+#endif
+}
+
+static void htptile_band(htptile_kernel kern, const uint8_t * band, const block_q8_0 * x, const int32_t * xsum, int n_kt, float * y) {
+    switch (kern) {
+#if defined(HTPTILE_I8MM)
+        case HTPTILE_USDOT:
+        case HTPTILE_MMLA:  htptile_band_i8mm(band, x, xsum, n_kt, y); return;
+#endif
+#if defined(__ARM_NEON) && defined(__ARM_FEATURE_DOTPROD)
+        case HTPTILE_DOT: htptile_band_neon(band, x, n_kt, y); return;
+#endif
+        default: htptile_band_ref(band, x, n_kt, y); return;
+    }
+    GGML_UNUSED(xsum);
+}
+
+// up to HT_MULTI tokens against one band; the dot kernel shares the unpack, other kernels run per token
+static constexpr int HT_MULTI = 4;
+static void htptile_band_multi(htptile_kernel kern, const uint8_t * band, const block_q8_0 * const * x, const int32_t * const * xsum,
+                               int n_kt, float * const * y, int nt) {
+#if defined(__ARM_NEON) && defined(__ARM_FEATURE_DOTPROD)
+    static const bool no_multi = getenv("GGML_HTPTILE_NO_MULTI") != nullptr;
+#if defined(HTPTILE_I8MM)
+    if (kern == HTPTILE_MMLA && !no_multi && nt > 1) {
+        switch (nt) {
+            case 2: htptile_band_mmla<2>(band, x, xsum, n_kt, y); return;
+            case 3: htptile_band_mmla<3>(band, x, xsum, n_kt, y); return;
+            case 4: htptile_band_mmla<4>(band, x, xsum, n_kt, y); return;
+            default: break;
+        }
+    }
+#endif
+    if (kern == HTPTILE_DOT && !no_multi && nt > 1) {
+        switch (nt) {
+            case 2: htptile_band_neon_multi<2>(band, x, xsum, n_kt, y); return;
+            case 3: htptile_band_neon_multi<3>(band, x, xsum, n_kt, y); return;
+            case 4: htptile_band_neon_multi<4>(band, x, xsum, n_kt, y); return;
+            default: break;
+        }
+    }
+#endif
+    for (int t = 0; t < nt; t++) htptile_band(kern, band, x[t], xsum[t], n_kt, y[t]);
+}
