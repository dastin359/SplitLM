+static inline uint32_t topk_rotr5(uint32_t j, uint32_t m) {
+    return ((j >> m) | (j << (5 - m))) & 31;
+}
+
+static void topk_32rows_hvx(float * vals, int32_t * out, uint32_t ne00, uint32_t n_rows, uint32_t k) {
+    HVX_Vector bv[TOPK_MAX_K];
+    HVX_Vector bi[TOPK_MAX_K];
+    const HVX_Vector neg_inf = hvx_vec_splat_f32(-INFINITY);
+    const HVX_Vector none    = Q6_V_vsplat_R(-1);
+    const HVX_Vector zero    = Q6_V_vzero();
+    for (uint32_t j = 0; j < k; ++j) {
+        bv[j] = neg_inf;
+        bi[j] = none;
+    }
