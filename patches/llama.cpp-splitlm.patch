+    if (i > 0 && st->bag_inc) {
+        htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_A_PREP, 4001);
+        const uint32_t c = st->bag_nc[i];
+        if (c < st->bag_np[i] && st->bag_ps[i][c] + HMX_MMID_BAG_DELAY <= st->bag_step) {
+            hmx_mmid_bag_cvt_blk(st->ctx->dma[i], st->bag_dst, HMX_MMID_BAG_BLK(c), st->bag_rows, st->k);
