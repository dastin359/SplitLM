+// Not safe for concurrent sessions in one PD (the table is process-global); sessions run one at a time today.
+uint32_t htp_fa_mscan_gen = 1;
+#define FA_MSC_SLOTS 64
+struct fa_msc_entry {
+    uint32_t        gen;
+    const uint8_t * rows;
+    uint32_t        stride, nek1, n_rows, mode, lu_cols;
+};
