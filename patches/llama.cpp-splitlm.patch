+// un-popped real jobs (not WAKEUP/SUSPEND/KILL signals) in the HMX queue
+static uint32_t htp_hmxq_left(hmx_queue_t q) {
+    uint32_t n = 0;
+    const unsigned int iw = atomic_load(&q->idx_write);
+    for (unsigned int ip = q->idx_pop; ip != iw; ip = (ip + 1) & q->idx_mask) {
+        const uint32_t sig = (uint32_t) q->desc[ip].func;
+        if (!(sig && sig <= HMX_QUEUE_KILL)) n++;
+    }
+    return n;
+}
