+// v2: only the per-row factors of the L2 norm (same reduction and rsqrt as hvx_rms_norm_rows32_f32, rows
+// interleaved four at a time; each row keeps its own accumulation order); the multiply happens in the fp16
+// conversion. fac[64] gets one factor per row (rows past n_rows: zero rows, finite factor).
+static inline void gdn_rows_l2_factors(const float * restrict x, float * restrict fac, uint32_t n_rows, uint32_t S_v,
+                                       const struct htp_gdn_kernel_params * kp) {
+    const HVX_Vector inv_n_v = hvx_vec_inverse_f32(hvx_vec_splat_f32((float) S_v));
+    const HVX_Vector eps_v   = hvx_vec_splat_f32(kp->in_eps);
+    const HVX_Vector scale_v = hvx_vec_splat_f32(kp->in_scale);
+    const uint32_t   nvec    = S_v / VLEN_FP32;
+    for (uint32_t r0 = 0; r0 < 64; r0 += 32) {
+        HVX_Vector s[32];
+        const uint32_t nr = (n_rows > r0) ? MIN(32, n_rows - r0) : 0;
+        for (uint32_t r = nr; r < 32; r++) {
+            s[r] = Q6_V_vzero();
+        }
+        uint32_t r = 0;
+        if (nvec == 4) {
+            for (; r + 4 <= nr; r += 4) {
+                const HVX_Vector * xa = (const HVX_Vector *) (x + (r0 + r + 0) * S_v);
+                const HVX_Vector * xb = (const HVX_Vector *) (x + (r0 + r + 1) * S_v);
+                const HVX_Vector * xc = (const HVX_Vector *) (x + (r0 + r + 2) * S_v);
+                const HVX_Vector * xd = (const HVX_Vector *) (x + (r0 + r + 3) * S_v);
+                HVX_Vector a = Q6_Vqf32_vmpy_VsfVsf(xa[0], xa[0]);
+                HVX_Vector b = Q6_Vqf32_vmpy_VsfVsf(xb[0], xb[0]);
+                HVX_Vector c = Q6_Vqf32_vmpy_VsfVsf(xc[0], xc[0]);
+                HVX_Vector d = Q6_Vqf32_vmpy_VsfVsf(xd[0], xd[0]);
+                for (uint32_t v = 1; v < 4; v++) {
+                    a = Q6_Vqf32_vadd_Vqf32Vqf32(a, Q6_Vqf32_vmpy_VsfVsf(xa[v], xa[v]));
+                    b = Q6_Vqf32_vadd_Vqf32Vqf32(b, Q6_Vqf32_vmpy_VsfVsf(xb[v], xb[v]));
+                    c = Q6_Vqf32_vadd_Vqf32Vqf32(c, Q6_Vqf32_vmpy_VsfVsf(xc[v], xc[v]));
+                    d = Q6_Vqf32_vadd_Vqf32Vqf32(d, Q6_Vqf32_vmpy_VsfVsf(xd[v], xd[v]));
+                }
+                s[r + 0] = a;
+                s[r + 1] = b;
+                s[r + 2] = c;
+                s[r + 3] = d;
+            }
+        }
+        for (; r < nr; r++) {
+            const HVX_Vector * xr = (const HVX_Vector *) (x + (r0 + r) * S_v);
+            HVX_Vector acc = Q6_Vqf32_vmpy_VsfVsf(xr[0], xr[0]);
+            for (uint32_t v = 1; v < nvec; v++) {
+                acc = Q6_Vqf32_vadd_Vqf32Vqf32(acc, Q6_Vqf32_vmpy_VsfVsf(xr[v], xr[v]));
+            }
+            s[r] = acc;
+        }
+        for (uint32_t n = 32; n > 1; n /= 2) {
+            for (uint32_t j = 0; j < n / 2; j++) {
+                const HVX_VectorPair dd = Q6_W_vdeal_VVR(s[2 * j + 1], s[2 * j], -4);
+                s[j] = Q6_Vqf32_vadd_Vqf32Vqf32(Q6_V_lo_W(dd), Q6_V_hi_W(dd));
+            }
+        }
+        const HVX_Vector ms = Q6_Vqf32_vadd_Vqf32Vsf(Q6_Vqf32_vmpy_VsfVsf(Q6_Vsf_equals_Vqf32(s[0]), inv_n_v), eps_v);
+        HVX_Vector       sc = hvx_vec_rsqrt_f32(Q6_Vsf_equals_Vqf32(ms));
+        hvx_vmem(fac + r0) = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(sc, scale_v));
+    }
+}
