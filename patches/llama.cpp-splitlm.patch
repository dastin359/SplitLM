+    }
+    return fa_msc_buf ? fa_msc_buf + (size_t) slot * 2 * FA_ZC_MAX_ROWS : NULL;
+}
+
+static uint32_t fa_mask_zscan(struct hmx_fa_context * factx, const struct htp_tensor * mask, uint32_t q_start, uint32_t n_rows_q,
+                              uint32_t im3, uint32_t nek1, uint16_t * zc, bool want_lu, uint16_t * lu_rows) {
+    fa_zscan_args_t args;
+    memset(&args, 0, sizeof(args));
+    args.rows       = (const uint8_t *) mask->data + (size_t) q_start * mask->nb[1] + (size_t) im3 * mask->nb[3];
+    args.row_stride = mask->nb[1];
+    args.n_rows     = n_rows_q;
+    args.n_full     = nek1 / 64;
+    args.zc         = zc;
+    args.nek1       = nek1;
+    args.want_lu    = want_lu;
