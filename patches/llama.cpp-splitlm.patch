+    }
+
+    double max_nmse_err() override { return 5e-4; }
+
+    bool run_whole_graph() override { return true; }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * m = ggml_new_tensor_4d(ctx, computed ? GGML_TYPE_F32 : GGML_TYPE_F16, kv, nb, 1, 1);
+        ggml_set_name(m, "m");
+        ggml_tensor * out = nullptr;
+        for (int64_t l = 0; l < n_layers; ++l) {
+            ggml_tensor * q = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, hs, nb, nh*nr2, 1);
+            ggml_tensor * k = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, hs, kv, nh, 1);
+            ggml_tensor * v = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, hs, kv, nh, 1);
+            ggml_tensor * ml = m;
+            if (computed) {
+                ggml_tensor * b = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, kv, nb, 1, 1);
+                ml = ggml_cast(ctx, ggml_add(ctx, m, b), GGML_TYPE_F16);
+            }
+            ggml_tensor * o = ggml_flash_attn_ext(ctx, q, k, v, ml, 1.0f/sqrtf((float) hs), 0.0f, 0.0f);
