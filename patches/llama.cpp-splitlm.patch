+// Pointwise f32 ops on contiguous tensors with short rows (e.g. sigmoid on [1, 16, 512]) pay a DMA
+// descriptor and a kernel call per row; host and DSP both run them on a flat view instead:
+// [n] if n <= HTP_UNARY_FLAT_NE0, else [HTP_UNARY_FLAT_NE0, n / HTP_UNARY_FLAT_NE0].
+#define HTP_UNARY_FLAT_NE0 2048
+
+static inline bool htp_unary_flat_shape(uint32_t op, uint32_t type, const uint32_t ne[4],
+                                        const uint32_t src_nb[4], const uint32_t dst_nb[4], uint32_t flat_ne[4]) {
+    switch (op) {
+        case HTP_OP_UNARY_SIGMOID:
+        case HTP_OP_UNARY_SILU:
+        case HTP_OP_UNARY_SOFTPLUS:
+            break;
+        default:
+            return false;
+    }
+    if (type != HTP_TYPE_F32 || ne[0] >= 1024) {
+        return false;
+    }
+    const uint32_t es = sizeof(float);
+    if (src_nb[0] != es || src_nb[1] != ne[0] * es || src_nb[2] != src_nb[1] * ne[1] || src_nb[3] != src_nb[2] * ne[2] ||
+        dst_nb[0] != es || dst_nb[1] != ne[0] * es || dst_nb[2] != dst_nb[1] * ne[1] || dst_nb[3] != dst_nb[2] * ne[2]) {
+        return false;
+    }
+    const uint64_t n = (uint64_t) ne[0] * ne[1] * ne[2] * ne[3];
+    if (n <= HTP_UNARY_FLAT_NE0) {
+        flat_ne[0] = (uint32_t) n;
+        flat_ne[1] = 1;
+    } else if (n % HTP_UNARY_FLAT_NE0 == 0) {
+        flat_ne[0] = HTP_UNARY_FLAT_NE0;
+        flat_ne[1] = (uint32_t) (n / HTP_UNARY_FLAT_NE0);
+    } else {
+        return false;
+    }
+    flat_ne[2] = 1;
+    flat_ne[3] = 1;
+    return true;
+}
