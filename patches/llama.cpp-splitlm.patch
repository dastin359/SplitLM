+    c.e2     = hvx_vec_splat_f16((_Float16) 0.24261114f);
+    c.e1     = hvx_vec_splat_f16((_Float16) 0.693261f);
+    c.e0     = hvx_vec_splat_f16((_Float16) 0.99992807f);
+    c.r4     = hvx_vec_splat_f16((_Float16) 0.1522428f);
+    c.r3     = hvx_vec_splat_f16((_Float16) -0.5328533f);
+    c.r2     = hvx_vec_splat_f16((_Float16) 0.86589105f);
