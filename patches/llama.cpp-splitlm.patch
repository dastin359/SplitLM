+    c.tmin   = hvx_vec_splat_f16((_Float16) -13.0f);  // u >= 2^-13.5: stays a normal fp16
+    c.amax   = hvx_vec_splat_f16((_Float16) 9.7f);    // q = 0 above: balances the clamp error below it
