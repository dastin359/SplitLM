diff --git a/ggml/src/ggml-hexagon/htp/hmx-i8-cvt.h b/ggml/src/ggml-hexagon/htp/hmx-i8-cvt.h
new file mode 100644
index 0000000..9a689a5
--- /dev/null
+++ b/ggml/src/ggml-hexagon/htp/hmx-i8-cvt.h
@@ -0,0 +1,54 @@
+// GGML_HEXAGON_I8: int readout windows -> values, fused into the output epilogues (included before hmx-mm-kernels-tiled.h)
+//   lo window tile (bits 8..23 of the accumulator) at p, hi window (bits 24..39) at p + hi_delta, same tile order;
+//   y = (float) ((hi << 16) | lo) * cs[col] * rs[row]  (cs includes the readout's 1/256)
+#pragma once
+
+#include "hmx-i8-fmt.h"
+#include "hmx-a8-core.h"
+
+struct hmx_i8_out_ctx {
+    int             on;
+    const uint8_t * lo;        // base of the lo-window tiles of the current chunk
+    ptrdiff_t       hi_delta;  // hi tile = lo tile + hi_delta bytes
+    const uint8_t * cs;        // meta + HTP_I8_META_CS_OFF of col tile 0 (stride HTP_I8_META_BYTES)
+    const float *   rs;        // row scales of the m-block
+    uint32_t        nct;       // col tiles per tile row of the chunk
+    int             blk;       // GGML_HEXAGON_A8_BLK: one row scale per 64-row block (with a8 only)
+    float           csmin;     // GGML_HEXAGON_A8: smallest nonzero fp16 column scale of the chunk (BLK fast-path guard)
+    int             h16;       // GGML_HEXAGON_A8_H16: tiled SWIGLU epilogue in qf16 (with a8 only)
+    int             a8;        // GGML_HEXAGON_A8: lo = W8A8 readout planes (plane 0 of block (q, c) in fp16 tile (2q, c),
+                               // plane 1 in tile (2q + 1, c), hi_delta = nct * 2048), see hmx-a8-core.h
+};
+
+static struct hmx_i8_out_ctx g_i8o;  // set by the int8 loop around its output stores (one op at a time on the NPU)
+static int g_epi_v1;      // HTP_OPFLAG_MM_EPI_V1 of the current dense matmul op: round-11 output epilogue loops
+static int g_epi_noquad;  // HTP_OPFLAG_MM_EPI_QUAD_OFF of the current dense matmul op: one row pair at a time
+                          // (both are set by the dense matmul entry points and cleared by the MUL_MAT_ID ones)
+
+// one 128-B output vector (row pair, 32 columns) -> qf32 even-row / odd-row values
+static inline HVX_VectorPair hmx_i8_cvt_qf32(const HVX_Vector * lo_vec, ptrdiff_t hi_delta, HVX_Vector vc, HVX_Vector rse, HVX_Vector rso) {
+    const HVX_Vector vl = *lo_vec;
+    const HVX_Vector vh = *(const HVX_Vector *) ((const uint8_t *) lo_vec + hi_delta);
+    const HVX_Vector fe = Q6_Vsf_equals_Vw(Q6_Vh_vshuffe_VhVh(vh, vl));
+    const HVX_Vector fo = Q6_Vsf_equals_Vw(Q6_Vh_vshuffo_VhVh(vh, vl));
+    const HVX_Vector pe = Q6_Vqf32_vmpy_Vqf32Vqf32(Q6_Vqf32_vmpy_VsfVsf(fe, vc), rse);
+    const HVX_Vector po = Q6_Vqf32_vmpy_Vqf32Vqf32(Q6_Vqf32_vmpy_VsfVsf(fo, vc), rso);
+    return Q6_W_vcombine_VV(po, pe);
+}
+
+static inline HVX_Vector hmx_i8_cvt_hf(const HVX_Vector * lo_vec, ptrdiff_t hi_delta, HVX_Vector vc, HVX_Vector rse, HVX_Vector rso) {
+    return Q6_Vhf_equals_Wqf32(hmx_i8_cvt_qf32(lo_vec, hi_delta, vc, rse, rso));
+}
+
+// tile row / col tile of a tile pointer inside the current chunk
+static inline void hmx_i8_tile_pos(const void * tile, uint32_t * rt, uint32_t * ct) {
+    const uint32_t t = (uint32_t) (((const uint8_t *) tile - g_i8o.lo) / 2048);
+    *rt = t / g_i8o.nct;
+    *ct = t - *rt * g_i8o.nct;
+}
+
+// GGML_HEXAGON_A8: fp16 output values of tile (rt, ct) row pair rp of the current chunk (W8A8 planes)
+static inline HVX_Vector hmx_a8_cvt_hf_at(uint32_t rt, uint32_t ct, uint32_t rp, HVX_Vector vc, HVX_Vector rse, HVX_Vector rso) {
+    const HVX_Vector h = hmx_a8_h16(hmx_a8_vec(g_i8o.lo, g_i8o.nct, rt, ct, rp), g_i8o.hi_delta, rp & 1);
+    return Q6_Vhf_equals_Wqf32(hmx_a8_cvt_qf32_h(h, vc, rse, rso));
+}
diff --git a/ggml/src/ggml-hexagon/htp/hmx-i8-fmt.h b/ggml/src/ggml-hexagon/htp/hmx-i8-fmt.h
new file mode 100644
index 0000000..e0dec73
--- /dev/null
+++ b/ggml/src/ggml-hexagon/htp/hmx-i8-fmt.h
@@ -0,0 +1,23 @@
+// GGML_HEXAGON_I8: DDR format of the per-output-channel int8 copy of a tiled weight (shared by host and HTP)
+//
+// The int8 copy is appended to the tensor's normal (tiled) data, so every other path (HVX GEMV, CPU_HTPTILE
+// aliasing) keeps reading the original weights:
+//   [original tiled data, ne1p * nb1 bytes][pad to 4 KB]
+//   [int8 tiles: ne1p/32 column groups x (k/32) tiles x 1 KB, tile byte (k%32/4)*128 + (n%32)*4 + k%4]
+//   [meta: ne1p/32 column groups x 768 B: HMX bias table lo window (256 B), hi window (256 B), 32 f32 column scales (128 B), pad]
+#pragma once
+
+#define HTP_I8_META_BYTES   768   // 256-B aligned bias tables (mxmem2)
+#define HTP_I8_META_CS_OFF  512
+#define HTP_I8_META_CSH_OFF 640   // GGML_HEXAGON_A8 only: column scales as fp16, each twice (fp16 tile lane order)
+#define HTP_I8_EXP_LO       16    // readout window: bits 8..23 of the accumulator
+#define HTP_I8_EXP_HI       0     // readout window: bits 24..39
+
+// byte offset of the int8 tiles from the tensor data; nb1 = (tiled) row size, ne1p = rows padded to 32
+static inline size_t htp_i8_offset(size_t nb1, size_t ne1p) {
+    return (nb1 * ne1p + 4095) & ~(size_t) 4095;
+}
+
+static inline size_t htp_i8_bytes(size_t ne0p, size_t ne1p) {
+    return ne0p * ne1p + (ne1p / 32) * HTP_I8_META_BYTES;
+}
diff --git a/ggml/src/ggml-hexagon/htp/hmx-i8.h b/ggml/src/ggml-hexagon/htp/hmx-i8.h
new file mode 100644
index 0000000..37c4161
--- /dev/null
+++ b/ggml/src/ggml-hexagon/htp/hmx-i8.h
@@ -0,0 +1,530 @@
+// W8A16 integer HMX path for dense MUL_MAT / MUL_MAT_NX (GGML_HEXAGON_I8, see hmx-i8-fmt.h for the DDR format)
+//
+// Numerics (verified bit-exact in hexagon-sim v73, wt/r8-i8-tools/sim/tw2.c):
+//   activations: per row fp16 -> int16 with a power-of-two row scale 2^e (amax * 2^e in [2^14, 2^15)), stored as
+//                uint16 = int16 ^ 0x8000 in the unchanged fp16 activation tile layout (16x8 mode: each 32-bit word
+//                holds the 16-bit values of rows 2i and 2i+1; HMX sees them as uint8 rows LL/HL).
+//                The conversion is exact for |x| >= amax / 16 (x * 2^e >= 1024, where fp16 values are integers);
+//                smaller values are rounded to the integer grid (relative error <= 2^-1 / (x * 2^e)).
+//   weights:     per-output-channel int8 (weight.b, 1 KB per 32x32 tile), column scale cs (f32).
+//   accumulate:  int (activation.ub x weight.b, 16x8 pairing), zero point removed by the bias word
+//                -128 * colsum (bias is added in units of 256 accumulator lsb).
+//   readout:     two uh:2x1 windows of floor(acc / 256): exponent 16 -> bits 8..23 (retain), exponent 0 -> bits 24..39;
+//                q = (hi << 16) | lo is exact for |acc| < 2^39 (max |acc| = 32767 * 127 * K).
+//   output:      y = (float) q * 256 * cs * 2^-e   (the 256 is folded into cs at load time)
+//
+// Accuracy (Qwen3.5-2B, wikitext-2): the int16 activations + readout are free (same weights on the fp16 path: KLD vs
+// BF16 0.002565 vs 0.002567); the cost is the re-rounding of 4-bit weights to the per-channel int8 grid when the copy is
+// made from Q4_0 (all blk weights: PPL +0.52%; the default selection, FFN + GDN in_proj: -0.08%, KLD +0.0004). A GGUF
+// whose weights are Q8_0 with one scale per row converts exactly.
+#pragma once
+
+#include "hmx-i8-fmt.h"
+
+typedef struct {
+    __fp16 *        out_lo;     // window bits 8..23  (2 KB tile per (row tile, col tile), fp16 tile order)
+    __fp16 *        out_hi;     // window bits 24..39
+    const __fp16 *  act;        // int16 (offset) activation tiles, same layout as the fp16 tiles
+    const int8_t *  wt;         // int8 weight tiles: [col tile][k tile] 1 KB each
+    const uint8_t * meta;       // per col tile: bias table lo (256 B), bias table hi (256 B), col scales (128 B)
+    uint32_t        n_row_tiles;
+    uint32_t        n_col_tiles;
+    uint32_t        n_dot_tiles;
+} hmx_i8_job_t;
+
+static void hmx_i8_worker_fn(void * data) {
+    const hmx_i8_job_t * job = (const hmx_i8_job_t *) data;
+    const uint32_t n_dot = job->n_dot_tiles;
+    const size_t act_stride = (size_t) n_dot * 2048;
+    const size_t wt_stride  = (size_t) n_dot * 1024;
+    for (uint32_t r = 0; r < job->n_row_tiles; ++r) {
+        const uint8_t * row_base = (const uint8_t *) job->act + r * act_stride;
+        const int8_t *  col_base = job->wt;
+        const uint8_t * meta     = job->meta;
+        uint8_t * lo = (uint8_t *) job->out_lo + (size_t) r * job->n_col_tiles * 2048;
+        uint8_t * hi = (uint8_t *) job->out_hi + (size_t) r * job->n_col_tiles * 2048;
+        for (uint32_t c = 0; c < job->n_col_tiles; ++c) {
+            const uint8_t * a = row_base;
+            const int8_t *  w = col_base;
+            asm volatile("mxclracc\n");
+            uint32_t left = n_dot;
+            while (left > 0) {
+                const uint32_t nb = left > 32 ? 32 : left;
+                asm volatile("{ activation.ub = mxmem(%0, %2):deep\n weight.b = mxmem(%1, %3) }\n"
+                             :: "r"(a), "r"(w), "r"(nb * 2048 - 1), "r"(nb * 1024 - 1));
+                a += nb * 2048; w += nb * 1024; left -= nb;
+            }
+            asm volatile("bias = mxmem2(%0)\n" :: "r"((unsigned int) meta));
+            asm volatile("mxmem(%0, %1):after:retain.uh = acc:2x1\n" :: "r"(lo), "r"(0) : "memory");
+            asm volatile("bias = mxmem2(%0)\n" :: "r"((unsigned int) (meta + 256)));
+            asm volatile("mxmem(%0, %1):after.uh = acc:2x1\n" :: "r"(hi), "r"(0) : "memory");
+            col_base += wt_stride;
+            meta     += HTP_I8_META_BYTES;
+            lo       += 2048;
+            hi       += 2048;
+        }
+    }
+}
+
+// ---- activation: fp16 tiles -> offset int16 tiles in place, per-row power-of-two scale ----
+typedef struct {
+    __fp16 * act;          // n_row_tiles x n_k_tiles fp16 tiles
+    float *  row_scale;    // out: 2^-e per row
+    uint32_t n_rows;       // valid rows (rows above are padding: quantized too, never stored)
+    uint32_t n_k_tiles;
+    uint32_t n_pairs;      // row pairs to process (ceil(n_rows_padded / 2))
+    struct htp_thread_trace * traces;
+} hmx_i8_act_state_t;
+
+// one unit = 8 row pairs (half a 32-row tile row): the max pass reads the 8 contiguous vectors of every k tile into
+// 8 independent accumulators; the per-row exponent / fp16 scale factors are computed in HVX (no per-row scalar math)
+#define HMX_I8_AQ_PAIRS 8
+static void hmx_i8_act_worker(unsigned int n, unsigned int i, void * data) {
+    const hmx_i8_act_state_t * st = (const hmx_i8_act_state_t *) data;
+    struct htp_thread_trace * tr = &st->traces[i];
+    htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_A_QUANT, 0);
+    const uint32_t n_units = st->n_pairs / HMX_I8_AQ_PAIRS;
+    const uint32_t per = (n_units + n - 1) / n;
+    const uint32_t u0 = i * per;
+    const uint32_t u1 = u0 + per < n_units ? u0 + per : n_units;
+    const HVX_Vector absm = Q6_Vh_vsplat_R(0x7fff);
+    const HVX_Vector sgn  = Q6_Vh_vsplat_R(0x8000);
+    const HVX_Vector c1f  = Q6_Vh_vsplat_R(0x1f);
+    const HVX_Vector c29  = Q6_Vh_vsplat_R(29);
+    const HVX_Vector c15  = Q6_Vh_vsplat_R(15);
+    const HVX_Vector zero = Q6_V_vzero();
+    const size_t tv = 2048 / VLEN;  // vectors per tile
+    const uint32_t nkt = st->n_k_tiles;
+    for (uint32_t u = u0; u < u1; ++u) {
+        const uint32_t rt = u / 2, v0 = (u % 2) * HMX_I8_AQ_PAIRS;
+        HVX_Vector * base = (HVX_Vector *) st->act + (size_t) rt * nkt * tv + v0;
+        HVX_Vector m[HMX_I8_AQ_PAIRS];
+        for (int j = 0; j < HMX_I8_AQ_PAIRS; ++j) m[j] = zero;
+        for (uint32_t t = 0; t < nkt; ++t) {
+            const HVX_Vector * src = base + t * tv;
+            for (int j = 0; j < HMX_I8_AQ_PAIRS; ++j) m[j] = Q6_Vh_vmax_VhVh(m[j], Q6_V_vand_VV(src[j], absm));
+        }
+        HVX_Vector vs1[HMX_I8_AQ_PAIRS], vs2[HMX_I8_AQ_PAIRS];
+        HVX_Vector bor = zero;
+        for (int j = 0; j < HMX_I8_AQ_PAIRS; ++j) {
+            HVX_Vector x = m[j];
+            // all-reduce over the 32 words, even (row 2p) and odd (row 2p+1) halfwords apart
+            x = Q6_Vh_vmax_VhVh(x, Q6_V_vror_VR(x, 64));
+            x = Q6_Vh_vmax_VhVh(x, Q6_V_vror_VR(x, 32));
+            x = Q6_Vh_vmax_VhVh(x, Q6_V_vror_VR(x, 16));
+            x = Q6_Vh_vmax_VhVh(x, Q6_V_vror_VR(x, 8));
+            x = Q6_Vh_vmax_VhVh(x, Q6_V_vror_VR(x, 4));
+            // fp16 exponent field E -> e = 29 - E (amax * 2^e in [2^14, 2^15)); E = 31 (inf/nan) -> e = 0
+            const HVX_Vector E  = Q6_V_vand_VV(Q6_Vuh_vlsr_VuhR(x, 10), c1f);
+            const HVX_Vector e  = Q6_V_vmux_QVV(Q6_Q_vcmp_eq_VhVh(E, c1f), zero, Q6_Vh_vsub_VhVh(c29, E));
+            const HVX_Vector a  = Q6_Vh_vmin_VhVh(e, c15);                      // first factor 2^a, a <= 15
+            const HVX_Vector b  = Q6_Vh_vmax_VhVh(Q6_Vh_vsub_VhVh(e, c15), zero); // second factor 2^b for tiny rows
+            vs1[j] = Q6_Vh_vasl_VhR(Q6_Vh_vadd_VhVh(a, c15), 10);
+            vs2[j] = Q6_Vh_vasl_VhR(Q6_Vh_vadd_VhVh(b, c15), 10);
+            bor = Q6_V_vor_VV(bor, b);
+            const uint32_t w2 = (uint32_t) Q6_R_vextract_VR(e, 0);
+            const int32_t  e0 = (int16_t) (w2 & 0xffff), e1 = (int16_t) (w2 >> 16);
+            union { uint32_t u; float f; } r0 = { (uint32_t) (127 - e0) << 23 }, r1 = { (uint32_t) (127 - e1) << 23 };
+            const uint32_t row = rt * 32 + 2 * (v0 + j);
+            st->row_scale[row]     = r0.f;   // 2^-e
+            st->row_scale[row + 1] = r1.f;
+        }
+        const bool two = Q6_R_vextract_VR(bor, 0) != 0;
+        for (int j = 0; j < HMX_I8_AQ_PAIRS; ++j) {
+            HVX_Vector * restrict p = base + j;
+            const HVX_Vector s1 = vs1[j];
+            if (!two) {
+                #pragma unroll(4)
+                for (uint32_t t = 0; t < nkt; ++t) {
+                    const HVX_Vector x = Q6_Vhf_equals_Vqf16(Q6_Vqf16_vmpy_VhfVhf(p[t * tv], s1));
+                    p[t * tv] = Q6_V_vxor_VV(Q6_Vh_equals_Vhf(x), sgn);
+                }
+            } else {
+                const HVX_Vector s2 = vs2[j];
+                for (uint32_t t = 0; t < nkt; ++t) {
+                    HVX_Vector x = Q6_Vhf_equals_Vqf16(Q6_Vqf16_vmpy_VhfVhf(p[t * tv], s1));
+                    x = Q6_Vhf_equals_Vqf16(Q6_Vqf16_vmpy_VhfVhf(x, s2));
+                    p[t * tv] = Q6_V_vxor_VV(Q6_Vh_equals_Vhf(x), sgn);
+                }
+            }
+        }
+    }
+    htp_trace_event_stop(tr, HTP_TRACE_EVT_HVX_A_QUANT, 0);
+}
+
+static void hmx_i8_act_quant_threaded(struct htp_context * ctx, __fp16 * act, float * row_scale, uint32_t n_rows,
+                                      uint32_t n_k_tiles, uint32_t n_threads) {
+    hmx_i8_act_state_t st = {
+        .act = act, .row_scale = row_scale, .n_rows = n_rows, .n_k_tiles = n_k_tiles,
+        .n_pairs = ((n_rows + 31) / 32) * 16, .traces = ctx->trace,
+    };
+    uint32_t nt = n_threads;
+    if (nt > st.n_pairs / HMX_I8_AQ_PAIRS) nt = st.n_pairs / HMX_I8_AQ_PAIRS;
+    if (nt <= 1) {
+        hmx_i8_act_worker(1, 0, &st);
+    } else {
+        worker_pool_run_func(ctx->worker_pool, hmx_i8_act_worker, &st, nt);
+    }
+}
+
+// ---- output: two int windows -> fp16 tiles (in place over the lo window) ----
+typedef struct {
+    __fp16 *        out_lo;
+    const __fp16 *  out_hi;
+    const uint8_t * meta;
+    const float *   row_scale;
+    uint32_t        n_row_tiles;
+    uint32_t        n_col_tiles;
+    struct htp_thread_trace * traces;
+} hmx_i8_out_state_t;
+
+static void hmx_i8_out_worker(unsigned int n, unsigned int i, void * data) {
+    const hmx_i8_out_state_t * st = (const hmx_i8_out_state_t *) data;
+    struct htp_thread_trace * tr = &st->traces[i];
+    htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_W_PREP, 0);
+    const uint32_t n_pairs = st->n_row_tiles * 16;
+    const uint32_t per = (n_pairs + n - 1) / n;
+    const uint32_t p0 = i * per;
+    const uint32_t p1 = p0 + per < n_pairs ? p0 + per : n_pairs;
+    const HVX_Vector zero = Q6_V_vzero();
+    const size_t tv = 2048 / VLEN;
+    for (uint32_t p = p0; p < p1; ++p) {
+        const uint32_t rt = p / 16, v = p % 16;
+        const HVX_Vector rse = Q6_Vqf32_vadd_VsfVsf(hvx_vec_splat_f32(st->row_scale[2 * p]), zero);
+        const HVX_Vector rso = Q6_Vqf32_vadd_VsfVsf(hvx_vec_splat_f32(st->row_scale[2 * p + 1]), zero);
+        HVX_Vector * restrict       lo = (HVX_Vector *) st->out_lo + (size_t) rt * st->n_col_tiles * tv + v;
+        const HVX_Vector * restrict hi = (const HVX_Vector *) st->out_hi + (size_t) rt * st->n_col_tiles * tv + v;
+        const uint8_t * restrict    cs = st->meta + HTP_I8_META_CS_OFF;
+        #pragma unroll(4)
+        for (uint32_t c = 0; c < st->n_col_tiles; ++c) {
+            const HVX_Vector vl = lo[c * tv];
+            const HVX_Vector vh = hi[c * tv];
+            const HVX_Vector vc = *(const HVX_Vector *) (cs + (size_t) c * HTP_I8_META_BYTES);
+            const HVX_Vector fe = Q6_Vsf_equals_Vw(Q6_Vh_vshuffe_VhVh(vh, vl));
+            const HVX_Vector fo = Q6_Vsf_equals_Vw(Q6_Vh_vshuffo_VhVh(vh, vl));
+            const HVX_Vector pe = Q6_Vqf32_vmpy_Vqf32Vqf32(Q6_Vqf32_vmpy_VsfVsf(fe, vc), rse);
+            const HVX_Vector po = Q6_Vqf32_vmpy_Vqf32Vqf32(Q6_Vqf32_vmpy_VsfVsf(fo, vc), rso);
+            lo[c * tv] = Q6_Vhf_equals_Wqf32(Q6_W_vcombine_VV(po, pe));
+        }
+    }
+    htp_trace_event_stop(tr, HTP_TRACE_EVT_HVX_W_PREP, 0);
+}
+
+static void hmx_i8_out_convert_threaded(struct htp_context * ctx, __fp16 * out_lo, const __fp16 * out_hi, const uint8_t * meta,
+                                        const float * row_scale, uint32_t n_row_tiles, uint32_t n_col_tiles, uint32_t n_threads) {
+    hmx_i8_out_state_t st = {
+        .out_lo = out_lo, .out_hi = out_hi, .meta = meta, .row_scale = row_scale,
+        .n_row_tiles = n_row_tiles, .n_col_tiles = n_col_tiles, .traces = ctx->trace,
+    };
+    uint32_t nt = n_threads;
+    if (nt > n_row_tiles * 16) nt = n_row_tiles * 16;
+    if (nt <= 1) {
+        hmx_i8_out_worker(1, 0, &st);
+    } else {
+        worker_pool_run_func(ctx->worker_pool, hmx_i8_out_worker, &st, nt);
+    }
+}
+
+// ---- VTCM plan inside the unchanged 2D layout (planned for the original weight type) ----
+//   weights: 4 slots of nc * k bytes = the two dequant scratch buffers split in halves
+//   hi window + 4 meta slots: the two raw (quantized) weight buffers, which the int path does not use
+//   row scales: after the meta slots in the second raw buffer
+typedef struct {
+    int8_t *  w[4];
+    uint8_t * meta[4];
+    __fp16 *  hi[2];
+    float *   row_scale;
+    uint32_t  mc;           // rows per m-block (multiple of 32), 0 = does not fit
+} hmx_i8_plan_t;
+
+static inline void hmx_i8_plan(hmx_i8_plan_t * P, uint8_t * base, const struct htp_mm_hmx_vtcm_layout * L, uint32_t k, uint32_t nc,
+                               uint32_t m_chunk, bool pipeline, bool a8) {
+    memset(P, 0, sizeof(*P));
+    if (!pipeline || (nc % 32) != 0 || (k % 32) != 0) return;
+    const size_t wbytes = (size_t) nc * k;
+    if (L->scratch_bytes[0] < 2 * wbytes || L->scratch_bytes[1] < 2 * wbytes) return;
+    const size_t mbytes = (size_t) (nc / 32) * HTP_I8_META_BYTES;
+    const size_t mbytes_al = (mbytes + 255) & ~(size_t) 255;
+    if (L->weight_area_bytes < 2 * mbytes_al + 32 * (size_t) nc * 2) return;
+    // per raw buffer: hi window (mc x nc fp16-sized) + 2 meta slots; raw1 also holds the mc row scales
+    size_t mc = (L->weight_area_bytes - 2 * mbytes_al - 128) / ((size_t) nc * 2 + 4);
+    mc = mc / 32 * 32;
+    if (mc > (size_t) m_chunk) mc = (size_t) m_chunk / 32 * 32;
+    if (a8) {
+        // W8A8: both readout planes live in the fp16 output buffer (mc x nc fp16 = 2 planes of mc x nc bytes), the
+        // raw areas only hold the tables + row scales -> m-blocks of up to m_chunk rows, in 64-row units
+        if (L->weight_area_bytes < 2 * mbytes_al + 4 * (size_t) m_chunk + 128) return;
+        mc = (size_t) m_chunk / 64 * 64;
+    }
+    if (mc < 32 || (a8 && mc < 64)) return;
+    uint8_t * s0 = base + L->off_scratch[0];
+    uint8_t * s1 = base + L->off_scratch[1];
+    P->w[0] = (int8_t *) s0; P->w[1] = (int8_t *) s1; P->w[2] = (int8_t *) (s0 + wbytes); P->w[3] = (int8_t *) (s1 + wbytes);
+    uint8_t * r0 = base + L->off_weight[0];
+    uint8_t * r1 = base + L->off_weight[1];
+    const size_t hib = a8 ? 0 : mc * nc * 2;
+    P->hi[0] = (__fp16 *) r0; P->hi[1] = (__fp16 *) r1;
+    P->meta[0] = r0 + hib; P->meta[1] = r1 + hib; P->meta[2] = r0 + hib + mbytes_al; P->meta[3] = r1 + hib + mbytes_al;
+    P->row_scale = (float *) (r1 + hib + 2 * mbytes_al);
+    P->mc = (uint32_t) mc;
+}
+
+// push the DMAs of columns [c0, c0 + n_cols) of one weight (int8 tiles + meta); 2 pushes
+static inline void hmx_i8_push_cols(dma_queue * q, int8_t * wdst, uint8_t * mdst, dma_addr_t w_i8, dma_addr_t meta_i8,
+                                    uint32_t k, size_t c0, size_t n_cols) {
+    const size_t g0 = c0 / 32, ng = (n_cols + 31) / 32;
+    const size_t wb = ng * (size_t) k * 32;
+    dma_queue_push(q, dma_make_data(wdst, w_i8 + g0 * (size_t) k * 32), 0, 0, wb, 1);
+    dma_queue_push(q, dma_make_data(mdst, meta_i8 + g0 * HTP_I8_META_BYTES), 0, 0, ng * HTP_I8_META_BYTES, 1);
+}
+
+// tiled fp16 activations of rows [mr, mr + n_rows) (whole 32-row tile rows) -> VTCM; 1 push
+static inline void hmx_i8_push_act(dma_queue * q, __fp16 * dst, dma_addr_t act, size_t mr, size_t n_rows, size_t k) {
+    dma_queue_push(q, dma_make_data(dst, act + (mr / HTP_MM_HMX_TILE_N_ROWS) * k * HTP_MM_HMX_TILE_N_ROWS * sizeof(__fp16)),
+                   0, 0, hex_align_up(n_rows, HTP_MM_HMX_TILE_N_ROWS) * k * sizeof(__fp16), 1);
+}
+
+// SWIGLU pair: gate columns [pc, pc + hc) then the same up columns, back to back in one slot; 4 pushes
+static inline void hmx_i8_push_pair(dma_queue * q, int8_t * wdst, uint8_t * mdst, dma_addr_t g_i8, dma_addr_t g_m8,
+                                    dma_addr_t u_i8, dma_addr_t u_m8, uint32_t k, size_t pc, size_t hc) {
+    const size_t gb = (hc + 31) / 32;
+    hmx_i8_push_cols(q, wdst, mdst, g_i8, g_m8, k, pc, hc);
+    hmx_i8_push_cols(q, wdst + gb * 32 * (size_t) k, mdst + gb * HTP_I8_META_BYTES, u_i8, u_m8, k, pc, hc);
+}
+
+// fused output conversion: the next output store reads the two windows directly (hmx-i8-cvt.h); clear g_i8o.on after it
+static inline void hmx_i8_out_begin(__fp16 * lo, __fp16 * hi, const uint8_t * meta, const float * rs, uint32_t nct) {
+    g_i8o.lo       = (const uint8_t *) lo;
+    g_i8o.hi_delta = (const uint8_t *) hi - (const uint8_t *) lo;
+    g_i8o.cs       = meta + HTP_I8_META_CS_OFF;
+    g_i8o.rs       = rs;
+    g_i8o.nct      = nct;
+    g_i8o.a8       = 0;
+    g_i8o.h16      = 0;
+    g_i8o.blk      = 0;
+    g_i8o.on       = 1;
+}
+
+// ======================= GGML_HEXAGON_A8: W8A8 (hmx-a8-core.h) =======================
+
+// HMX job: per 64-row block q (activation croutons at fp16 tile row 2q), per column tile: :deep accumulation, two
+// .ub readouts into fp16 tiles (2q, c) and (2q + 1, c) of out_lo (n_row_tiles = 32-row tiles)
+static void hmx_a8_worker_fn(void * data) {
+    const hmx_i8_job_t * job = (const hmx_i8_job_t *) data;
+    const uint32_t n_dot = job->n_dot_tiles;
+    const uint32_t nct   = job->n_col_tiles;
+    const size_t act_stride = (size_t) n_dot * 2048 * 2;
+    const size_t wt_stride  = (size_t) n_dot * 1024;
+    const uint32_t n_q = (job->n_row_tiles + 1) / 2;
+    for (uint32_t q = 0; q < n_q; ++q) {
+        const uint8_t * row_base = (const uint8_t *) job->act + q * act_stride;
+        const int8_t *  col_base = job->wt;
+        const uint8_t * meta     = job->meta;
+        uint8_t * p0 = (uint8_t *) job->out_lo + (size_t) (2 * q) * nct * 2048;
+        uint8_t * p1 = p0 + (size_t) nct * 2048;
+        for (uint32_t c = 0; c < nct; ++c) {
+            const uint8_t * a = row_base;
+            const int8_t *  w = col_base;
+            asm volatile("mxclracc\n");
+            uint32_t left = n_dot;
+            while (left > 0) {
+                const uint32_t nb = left > 32 ? 32 : left;
+                asm volatile("{ activation.ub = mxmem(%0, %2):deep\n weight.b = mxmem(%1, %3) }\n"
+                             :: "r"(a), "r"(w), "r"(nb * 2048 - 1), "r"(nb * 1024 - 1));
+                a += nb * 2048; w += nb * 1024; left -= nb;
+            }
+            asm volatile("bias = mxmem2(%0)\n" :: "r"((unsigned int) meta));
+            asm volatile("mxmem(%0, %1):after:retain.ub = acc\n" :: "r"(p0), "r"(0) : "memory");
