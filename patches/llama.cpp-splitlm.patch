+// trilane: per-op profile on thread 0 (GGML_CPU_PROF=N prints cumulative stats every N graphs)
+static int     cpu_prof_every = 0;
+static int64_t cpu_prof_graphs = 0;
+static int64_t cpu_prof_t_end_prev = 0;  // thread 0: end of the previous graph (us)
+static int64_t cpu_prof_gap_us = 0;      // time between graphs (outside ggml graph compute)
+static int64_t cpu_prof_graph_us = 0;    // thread 0: first node start to last node end
+static int     cpu_dump_graph = 0;       // GGML_CPU_DUMP_GRAPH=N: print the node list of the first graph with >= N nodes
+static int     cpu_barrier_bench = 0;    // GGML_CPU_BARRIER_BENCH=N: time N back-to-back barriers once (balanced arrivals)
+static int64_t cpu_prof_count[GGML_OP_COUNT];
+static int64_t cpu_prof_work_us[GGML_OP_COUNT];
+static int64_t cpu_prof_wait_us[GGML_OP_COUNT];
+
+// matmul shapes: weight bytes streamed vs time, to see which kernels fall short of DRAM bandwidth
+struct cpu_prof_mm { int type, op; int64_t ne0, ne1, n, us_work, us_wait; double bytes; };
+static struct cpu_prof_mm cpu_prof_mms[64];
+static int cpu_prof_n_mm = 0;
+// trilane r6: GGML_CPU_PROF_G=1 also prints one line per graph (nodes, wall, per weight shape and token count: us)
+static int cpu_prof_g = -1;
+struct cpu_prof_gmm { int type, tile; int64_t ne0, ne1, nt, us; }; // tile: weight in CPU_HTPTILE (printed as type/t)
+#define CPU_PROF_GMM_MAX 64
+static struct cpu_prof_gmm cpu_prof_gmms[CPU_PROF_GMM_MAX];
+static int64_t cpu_prof_gmm_dropped = 0; // us of shapes beyond CPU_PROF_GMM_MAX in the current graph (reported separately)
+static int cpu_prof_n_gmm = 0;
+
+// trilane: before a thread waits at a barrier, start streaming its first chunk of the next single-token matmul's
+// weights (GGML_PF_NEXT_KB = KiB per thread, 0 = off; GGML_REPACK_CHUNKS must match repack.cpp's chunking)
+static int cpu_pf_next_kb = 0;
+static int cpu_pf_chunks  = 4;
+
+static void cpu_prefetch_next_weights(const struct ggml_cgraph * cgraph, int node_n, int ith, int nth, int * pf_done) {
+    for (int j = node_n + 1; j < cgraph->n_nodes && j <= node_n + 16; j++) {
+        const struct ggml_tensor * t = cgraph->nodes[j];
+        if (t->op == GGML_OP_MUL_MAT_ID) {
+            return; // expert rows depend on routing not known yet
+        }
+        if (t->op != GGML_OP_MUL_MAT) {
+            continue;
+        }
+        if (j == *pf_done || ggml_nrows(t->src[1]) != 1 || !ggml_is_quantized(t->src[0]->type)) {
+            return;
+        }
+        *pf_done = j;
+        const struct ggml_tensor * w = t->src[0];
+        const int64_t nr0 = ggml_nrows(w);
+        const int64_t dr  = (nr0 + (int64_t) nth * cpu_pf_chunks - 1) / ((int64_t) nth * cpu_pf_chunks);
+        const int64_t r0  = MIN(nr0, dr * ith);
+        const size_t  nb  = MIN((size_t) (MIN(nr0, r0 + dr) - r0) * w->nb[1], (size_t) cpu_pf_next_kb * 1024);
+        const char *  p   = (const char *) w->data + r0 * w->nb[1];
+        for (size_t off = 0; off < nb; off += 64) {
+            __builtin_prefetch(p + off, 0, 2);
+        }
+        return;
+    }
+}
+
+// trilane: barrier elision. Row-split element-wise ops on a single row run entirely on thread 0
+// (get_thread_range / ith-strided row loops give every other thread an empty range). Between two such
+// nodes the barrier only makes threads 1..n-1 wait for work they do not take part in, and thread 0 sees
+// its own writes, so the barrier can be skipped. A chain of skipped barriers ends at the first node that
+// is not thread-0-only, where the normal barrier runs. GGML_CPU_BAR_ELIDE=0 disables.
+static int     cpu_bar_elide = 1;
+static int64_t cpu_prof_elided = 0;
+static int     cpu_ab = 0;          // GGML_CPU_AB=mask: odd graphs run with the masked trilane optimizations off (GGML_CPU_AB_*)
+static int64_t cpu_ab_graph = 0;
+static int64_t cpu_prof_ab_us[2], cpu_prof_ab_gap_us[2], cpu_prof_ab_n[2];
+
+// trilane GGML_CPU_ELIDE2 (default 1): small single-token glue nodes join barrier-elided thread-0-only chains:
+// ARGSORT / SUM_ROWS / CLAMP of one row are thread-0-only by construction; the small nodes below are run by thread 0
+// alone with nth = 1 (the other threads skip them): the MoE router weights GET_ROWS, the short-conv state CPY and the
+// per-head ROPE of decode. None of them starts a fused-op pattern. (Short-conv CONCAT and SSM_CONV were slower on one
+// thread than split + barrier: CONCAT 12.6 us vs ~8 us per node, LFM2.5 decode, so they keep the normal path.)
+static int cpu_elide2 = 1;
+#define CPU_SMALL_T0_ELEMS 8192
+
+static bool cpu_node_small_t0(const struct ggml_tensor * t) {
+    switch (t->op) {
+        case GGML_OP_GET_ROWS:
+        case GGML_OP_CPY:
+        case GGML_OP_ROPE:
+            break;
+        default:
+            return false;
+    }
+    if (ggml_nelements(t) > CPU_SMALL_T0_ELEMS) {
+        return false;
+    }
+    for (int s = 0; s < GGML_MAX_SRC && t->src[s]; s++) {
+        if (ggml_nelements(t->src[s]) > 2 * CPU_SMALL_T0_ELEMS && !(t->op == GGML_OP_GET_ROWS && s == 0)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool cpu_node_t0_only(const struct ggml_tensor * t, bool ext) {
+    if (ext && cpu_node_small_t0(t)) {
+        return true;
+    }
+    if (ext && t->src[0] != NULL && t->src[0]->type == GGML_TYPE_F32) {
+        // MoE router glue
+        if (t->op == GGML_OP_ARGSORT && t->type == GGML_TYPE_I32 && ggml_nrows(t->src[0]) == 1) {
+            return true; // argsort_f32: rows ith, ith+nth, ...
+        }
+        if (t->type == GGML_TYPE_F32 && ggml_nrows(t) == 1 && ggml_nrows(t->src[0]) == 1 &&
+            (t->op == GGML_OP_SUM_ROWS || t->op == GGML_OP_CLAMP)) {
+            return true; // sum_rows_f32: thread 0 only; clamp_f32: rows ith, ith+nth, ...
+        }
+    }
+    if (t->type != GGML_TYPE_F32 || t->src[0] == NULL || t->src[0]->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if (ggml_nrows(t) != 1 || ggml_nrows(t->src[0]) != 1) {
+        return false;
+    }
+    switch (t->op) {
+        case GGML_OP_ADD:
+        case GGML_OP_SUB:
+        case GGML_OP_MUL:
+        case GGML_OP_DIV:
+            // binary_op: apply_binary_op splits the rows of src0
+            return t->src[1] != NULL && t->src[1]->type == GGML_TYPE_F32;
+        case GGML_OP_SCALE:    // scale_f32: rows of src0
+        case GGML_OP_RMS_NORM: // rms_norm_f32 (also fused with MUL): i01 = ith, ith+nth, ...
+            return true;
+        case GGML_OP_UNARY:
+            switch (ggml_get_unary_op(t)) {
+                case GGML_UNARY_OP_SILU:     // silu_f32: rows of src0
+                case GGML_UNARY_OP_SIGMOID:  // unary_op: get_thread_range(src0)
+                case GGML_UNARY_OP_SOFTPLUS:
+                    return true;
+                default:
+                    return false;
+            }
+        case GGML_OP_GLU:
+            // swiglu_f32: rows of src0 (split or fused gate/up)
+            return ggml_get_glu_op(t) == GGML_GLU_OP_SWIGLU &&
+                (t->src[1] == NULL || (t->src[1]->type == GGML_TYPE_F32 && ggml_nrows(t->src[1]) == 1));
+        default:
+            return false;
+    }
+}
+
+// trilane: nodes the compute loop skips without a barrier: NOPs, nodes not flagged for compute and (skip_empty)
+// zero-element nodes, e.g. the recurrent-state zeroing view of build_rs when no state is cleared (2 per GDN layer
+// on Qwen3.5). A zero-element node reads and writes nothing (ggml_compute_forward returns early), so the barrier
+// after it orders nothing that the barrier before it did not. Off by default (paired A/B: -0.6%, noise level);
+// GGML_CPU_SKIP_EMPTY=1 enables.
+static int cpu_skip_empty = 0;
+static int64_t cpu_prof_skipped = 0;
+
+static inline bool cpu_node_skipped(const struct ggml_tensor * t, bool skip_empty) {
+    return ggml_op_is_empty(t->op) || (t->flags & GGML_TENSOR_FLAG_COMPUTE) == 0 || (skip_empty && ggml_is_empty(t));
+}
+
+// index of the next node the compute loop will execute after node_n (same skip rules as the loop)
+static int cpu_next_compute_node(const struct ggml_cgraph * cgraph, int node_n, bool skip_empty) {
+    int j = node_n + 1;
+    while (j < cgraph->n_nodes && cpu_node_skipped(cgraph->nodes[j], skip_empty)) {
+        j++;
+    }
+    return j;
+}
+
+// n_mm: number of MUL_MAT_ID weight tensors read by this (possibly fused) node range, counted by the caller
+static void cpu_prof_mm_add(const struct ggml_tensor * node, int64_t us_work, int64_t us_wait, int n_mm) {
+    const struct ggml_tensor * w = node->src[0];
+    double bytes = (double) ggml_nbytes(w);
+    if (node->op == GGML_OP_MUL_MAT_ID) {
+        const struct ggml_tensor * ids = node->src[2];
+        const int64_t used = ids->ne[0] * ids->ne[1];
+        bytes = (double) w->nb[2] * (double) MIN(w->ne[2], used); // upper bound on experts touched
+        bytes *= (double) MAX(n_mm, 1); // fused gate_up reads two weight tensors of the same shape
+    }
+    int k = 0;
+    for (; k < cpu_prof_n_mm; k++) {
+        struct cpu_prof_mm * m = &cpu_prof_mms[k];
+        if (m->type == (int) w->type && m->op == (int) node->op && m->ne0 == w->ne[0] && m->ne1 == w->ne[1]) break;
+    }
+    if (k == cpu_prof_n_mm) {
+        if (k == 64) return;
+        cpu_prof_mms[k] = (struct cpu_prof_mm) { (int) w->type, (int) node->op, w->ne[0], w->ne[1], 0, 0, 0, 0 };
+        cpu_prof_n_mm++;
+    }
+    cpu_prof_mms[k].n++;
+    cpu_prof_mms[k].us_work += us_work;
+    cpu_prof_mms[k].us_wait += us_wait;
+    cpu_prof_mms[k].bytes   += bytes;
+    if (cpu_prof_g < 0) { const char * e = getenv("GGML_CPU_PROF_G"); cpu_prof_g = e ? atoi(e) : 0; }
+    if (cpu_prof_g > 0) {
+        const int64_t nt = node->op == GGML_OP_MUL_MAT_ID ? node->src[1]->ne[2] : node->src[1]->ne[1];
+        const int tile = w->buffer && strcmp(ggml_backend_buffer_name(w->buffer), "CPU_HTPTILE") == 0;
+        int j = 0;
+        for (; j < cpu_prof_n_gmm; j++) {
+            struct cpu_prof_gmm * g = &cpu_prof_gmms[j];
+            if (g->type == (int) w->type && g->tile == tile && g->ne0 == w->ne[0] && g->ne1 == w->ne[1] && g->nt == nt) break;
+        }
+        if (j == cpu_prof_n_gmm && j < CPU_PROF_GMM_MAX) {
+            cpu_prof_gmms[j] = (struct cpu_prof_gmm) { (int) w->type, tile, w->ne[0], w->ne[1], nt, 0 };
+            cpu_prof_n_gmm++;
+        }
+        if (j < CPU_PROF_GMM_MAX) cpu_prof_gmms[j].us += us_work + us_wait;
+        else cpu_prof_gmm_dropped += us_work + us_wait;
+    }
+}
