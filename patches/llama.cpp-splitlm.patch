diff --git a/ggml/src/ggml-hexagon/htp/binary-ops.c b/ggml/src/ggml-hexagon/htp/binary-ops.c
index 78ce4bb..098b547 100644
--- a/ggml/src/ggml-hexagon/htp/binary-ops.c
+++ b/ggml/src/ggml-hexagon/htp/binary-ops.c
@@ -1345,3 +1345,176 @@ int op_binary(struct htp_ops_context * octx) {
 
     return HTP_STATUS_NO_SUPPORT;
 }
+
+
+// MOE_REDUCE: dst[:, t] = (src2[:, t] +) ((w0 x0 + w1 x1) + w2 x2) + ...   with x_e = src0[:, e, t], w_e = src1[0, e, t]
+// One pass over the expert outputs for the MUL by the router weights, the ADD chain over the experts and an
+// optional residual ADD, in the same order of multiplies and adds as the ops it replaces. The result is not bitwise
+// identical to the separate MUL/ADD ops (it rounds within the noise of a ubatch-size change; greedy text can drift
+// after some tokens). GGML_HEXAGON_MOE_REDUCE=0 restores the separate ops.
+// Each thread streams blocks of tokens through VTCM on its own DMA queue, two blocks in flight.
+#define MOE_REDUCE_MAX_E   16
+#define MOE_REDUCE_MAX_BLK 8
+
+typedef struct {
+    const struct htp_tensor * x;
+    const struct htp_tensor * w;
+    const struct htp_tensor * r;
+    const struct htp_tensor * d;
+    struct htp_context *      ctx;
+    uint32_t                  n_tok;
+    uint32_t                  tok_per_task;
+    uint32_t                  blk;          // tokens per block
+    size_t                    thread_bytes; // VTCM per thread
+} moe_reduce_ctx_t;
+
+static inline bool moe_reduce_x_flat(const moe_reduce_ctx_t * st) {
+    const size_t row = (size_t) st->d->ne[0] * sizeof(float);
+    return st->x->nb[1] == row && st->x->nb[2] == st->x->ne[1] * row;
+}
+
+static void moe_reduce_push_reads(const moe_reduce_ctx_t * st, dma_queue * q, uint8_t * xv, uint8_t * rv, uint32_t t, uint32_t nt) {
+    const uint32_t n   = st->d->ne[0];
+    const uint32_t n_e = st->x->ne[1];
+    const size_t   row = (size_t) n * sizeof(float);
+    const struct htp_tensor * x = st->x;
+    if (moe_reduce_x_flat(st)) {
+        dma_queue_push(q, dma_make_data(xv, x->data + (size_t) t * x->nb[2]), row, row, row, (size_t) nt * n_e);
+    } else {
+        for (uint32_t k = 0; k < nt; ++k) {
+            dma_queue_push(q, dma_make_data(xv + (size_t) k * n_e * row, x->data + (size_t) (t + k) * x->nb[2]), row, x->nb[1], row, n_e);
+        }
+    }
+    if (st->r) {
+        dma_queue_push(q, dma_make_data(rv, st->r->data + (size_t) t * st->r->nb[1]), row, st->r->nb[1], row, nt);
+    }
+}
+
+static void moe_reduce_worker(unsigned int nth, unsigned int ith, void * data) {
+    (void) nth;
+    const moe_reduce_ctx_t * st = (const moe_reduce_ctx_t *) data;
+    const uint32_t t0 = ith * st->tok_per_task;
+    const uint32_t t1 = MIN(t0 + st->tok_per_task, st->n_tok);
+    if (t0 >= t1) return;
+
+    const uint32_t n    = st->d->ne[0];
+    const uint32_t n_e  = st->x->ne[1];
+    const uint32_t nvec = n / VLEN_FP32;  // n % VLEN_FP32 == 0
+    const size_t   row  = (size_t) n * sizeof(float);
+    const uint32_t blk  = st->blk;
+    const bool     has_r = st->r != NULL;
+
+    // per slot: x block, residual block, output block
+    const size_t x_bytes = (size_t) blk * n_e * row;
+    const size_t r_bytes = (size_t) blk * row;
+    const size_t slot    = x_bytes + 2 * r_bytes;
+    uint8_t * base = st->ctx->vtcm_base + (size_t) ith * st->thread_bytes;
+    dma_queue * q = st->ctx->dma[ith];
+    struct htp_thread_trace * tr = &st->ctx->trace[ith];
+
+    const uint32_t n_tok = t1 - t0;
+    const uint32_t n_blk = (n_tok + blk - 1) / blk;
+#define MOE_BLK_N(b) MIN(blk, n_tok - (b) * blk)
+#define MOE_N_READS(nt) ((moe_reduce_x_flat(st) ? 1u : (nt)) + (has_r ? 1u : 0u))
+
+    for (uint32_t b = 0; b < n_blk && b < 2; ++b) {
+        uint8_t * s = base + (size_t) b * slot;
+        moe_reduce_push_reads(st, q, s, s + x_bytes, t0 + b * blk, MOE_BLK_N(b));
+    }
+
+    for (uint32_t b = 0; b < n_blk; ++b) {
+        uint8_t * s  = base + (size_t) (b & 1) * slot;
+        uint8_t * xv = s;
+        uint8_t * rv = s + x_bytes;
+        uint8_t * ov = s + x_bytes + r_bytes;
+        const uint32_t tb = t0 + b * blk;
+        const uint32_t nt = MOE_BLK_N(b);
+
+        // FIFO: [write(b - 2)], reads(b)
+        if (b >= 2) {
+            dma_queue_pop(q);
+        }
+        for (uint32_t k = MOE_N_READS(nt); k > 0; --k) {
+            dma_queue_pop(q);
+        }
