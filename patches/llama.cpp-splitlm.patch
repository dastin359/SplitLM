+// ---- HTP_GDN_PIPE_V2 helpers ------------------------------------------------------------------------------------
+// The state S [a = value][b = key] is kept as W = S^T in HMX weight-tile order: tile (a_tile, b_tile) at
+// a_tile * n_sv + b_tile, and inside a tile vector r holds rows b = 2r, 2r + 1 interleaved per column a. The f32
+// copy uses the same tiles, one f32 vector pair per tile vector (b = 2r and b = 2r + 1, lanes = a), which is a
+// plain 32x32 transpose of the S block. The HMX update k^T d then lands directly in that order (no vscatter).
+
+// k_f16 [64 t][S_v b] -> k^T tiles twice: kT_row = row operand of the state update (tile (b_tile, t_tile) at
+// b_tile * 2 + t_tile) and k_col = weight operand of kk / qk (tile (t_tile, b_tile) at t_tile * n_sv + b_tile)
+static inline void gdn_v2_pack_kT_tiles(__fp16 * restrict kT_row, __fp16 * restrict k_col, const __fp16 * restrict k_f16,
+                                        uint32_t S_v, HVX_Vector * restrict m, HVX_Vector * restrict tmp) {
+    const uint32_t n_sv = S_v / 32;
+    for (uint32_t col_half = 0; col_half < S_v / 64; ++col_half) {
+        for (uint32_t c0 = 0; c0 < 2; ++c0) {
+            for (uint32_t s_local = 0; s_local < 32; ++s_local) {
+                m[s_local] = hvx_vmem(k_f16 + (c0 * 32 + s_local) * S_v + col_half * 64);
+            }
+            hvx_transpose_32x32_words(m, tmp);
+            for (uint32_t h = 0; h < 2; ++h) {
+                const uint32_t b_tile = col_half * 2 + h;
+                HVX_Vector * tr = (HVX_Vector *) (kT_row + (b_tile * 2 + c0) * HMX_FP16_TILE_N_ELMS);
+                HVX_Vector * tc = (HVX_Vector *) (k_col + (c0 * n_sv + b_tile) * HMX_FP16_TILE_N_ELMS);
+                for (uint32_t r = 0; r < 16; ++r) {
+                    const HVX_Vector v = m[h * 16 + r];
+                    tr[r] = v;
+                    tc[r] = v;
+                }
+            }
+        }
+    }
+}
