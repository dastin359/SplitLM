+// acc[j][:] = acc[j][:]*rescale[j] + sum_t w[t][j]*V(idx[t])[:], 16 columns at a time held in registers
+template <int GB>
+static inline void ggml_fa_dec_accum_v(float * acc, const float * rescale, const char * vbase, size_t nbv1,
+                                       const int32_t * idx, const float * w, int n, int64_t DV) {
+    for (int64_t d = 0; d < DV; d += 16) {
+        float32x4_t r[GB][4];
+        for (int j = 0; j < GB; j++) {
+            const float32x4_t sc = vdupq_n_f32(rescale[j]);
+            for (int c = 0; c < 4; c++) {
+                r[j][c] = vmulq_f32(vld1q_f32(acc + j*DV + d + 4*c), sc);
+            }
+        }
+        for (int t = 0; t < n; t++) {
+            const __fp16 * vp = (const __fp16 *) (vbase + (size_t) idx[t]*nbv1) + d;
+            const float16x8_t v0 = vld1q_f16(vp);
+            const float16x8_t v1 = vld1q_f16(vp + 8);
+            const float32x4_t f0 = vcvt_f32_f16(vget_low_f16(v0));
+            const float32x4_t f1 = vcvt_high_f32_f16(v0);
+            const float32x4_t f2 = vcvt_f32_f16(vget_low_f16(v1));
+            const float32x4_t f3 = vcvt_high_f32_f16(v1);
+            for (int j = 0; j < GB; j++) {
+                const float wj = w[4*t + j];
+                r[j][0] = vfmaq_n_f32(r[j][0], f0, wj);
+                r[j][1] = vfmaq_n_f32(r[j][1], f1, wj);
+                r[j][2] = vfmaq_n_f32(r[j][2], f2, wj);
+                r[j][3] = vfmaq_n_f32(r[j][3], f3, wj);
+            }
+        }
+        for (int j = 0; j < GB; j++) {
+            for (int c = 0; c < 4; c++) {
