+// HTP_MMID_STREAM_OUT_F16: as transfer_output_chunk_fp16_to_fp32_scattered, but each mapped dst row gets the HMX
+// fp16 values as they are (fp16 in the first half of the f32 row slot; dst points at fp16 columns, rows at the f32
+// row strides). Two column tiles at a time: the row pair is de-interleaved into one 64-column vector per row.
+// The reader widens with the same exact fp16 -> f32 conversion, so the values it sees are identical.
+static void transfer_output_chunk_f16_scattered(
+            __fp16 *restrict dst,
+            const __fp16 *restrict vtcm_src,
+            uint32_t start_row,
+            uint32_t vtcm_start_row,
+            uint32_t n_rows,
+            uint32_t n_cols,
+            const struct mmid_row_mapping *matrix_rows,
+            uint32_t cur_a,
+            uint32_t mapping_stride,
+            size_t dst_nb1,
+            size_t dst_nb2,
+            uint32_t cne1,
+            bool aligned_ok) {
+    assert(n_cols % HTP_MM_HMX_TILE_N_COLS == 0);
+    const size_t nt              = n_cols / HTP_MM_HMX_TILE_N_COLS;
+    const size_t tile_row_stride = nt * HTP_MM_HMX_TILE_N_ELMS;
+    const size_t tstep           = HTP_MM_HMX_TILE_N_ELMS * sizeof(__fp16) / VLEN;  // vectors per tile
+    const bool   aligned = aligned_ok && hex_is_aligned(dst, VLEN) && (dst_nb1 % VLEN) == 0 && (dst_nb2 % VLEN) == 0;
+
+    for (size_t r = 0; r < n_rows; r += 2) {
+        const uint32_t r_idx0 = start_row + r + 0;
+        const uint32_t r_idx1 = start_row + r + 1;
+        if (r_idx0 >= cne1) break;
+
+        const uint32_t lr = vtcm_start_row + r;
+        const size_t   r0 = (lr / HTP_MM_HMX_TILE_N_ROWS);
+        const size_t   r1 = (lr % HTP_MM_HMX_TILE_N_ROWS) / 2;
+        const HVX_Vector * tsrc = (const HVX_Vector *) (vtcm_src + r0 * tile_row_stride) + r1;
+
+        const struct mmid_row_mapping m0 = matrix_rows[cur_a * mapping_stride + r_idx0];
+        __fp16 * h0 = (__fp16 *) ((uint8_t *) dst + m0.i1 * dst_nb1 + m0.i2 * dst_nb2);
+        __fp16 * h1 = NULL;
+        if (r_idx1 < cne1) {
+            const struct mmid_row_mapping m1 = matrix_rows[cur_a * mapping_stride + r_idx1];
+            h1 = (__fp16 *) ((uint8_t *) dst + m1.i1 * dst_nb1 + m1.i2 * dst_nb2);
+        }
+
+        size_t c0 = 0;
+        if (aligned && h1) {
+            #pragma unroll(2)
+            for (; c0 + 2 <= nt; c0 += 2) {
+                const HVX_VectorPair d = Q6_W_vdeal_VVR(tsrc[(c0 + 1) * tstep], tsrc[c0 * tstep], -2);
+                *(HVX_Vector *) (h0 + c0 * HTP_MM_HMX_TILE_N_COLS) = Q6_V_lo_W(d);
+                *(HVX_Vector *) (h1 + c0 * HTP_MM_HMX_TILE_N_COLS) = Q6_V_hi_W(d);
+            }
+        } else {
+            for (; c0 + 2 <= nt; c0 += 2) {
+                const HVX_VectorPair d = Q6_W_vdeal_VVR(tsrc[(c0 + 1) * tstep], tsrc[c0 * tstep], -2);
+                hvx_vmemu(h0 + c0 * HTP_MM_HMX_TILE_N_COLS) = Q6_V_lo_W(d);
+                if (h1) {
+                    hvx_vmemu(h1 + c0 * HTP_MM_HMX_TILE_N_COLS) = Q6_V_hi_W(d);
+                }
+            }
+        }
+        if (c0 < nt) {
+            const HVX_Vector     ya = tsrc[c0 * tstep];
+            const HVX_VectorPair d  = Q6_W_vdeal_VVR(ya, ya, -2);
+            hvx_vec_store_u(h0 + c0 * HTP_MM_HMX_TILE_N_COLS, HTP_MM_HMX_TILE_N_COLS * sizeof(__fp16), Q6_V_lo_W(d));
+            if (h1) {
+                hvx_vec_store_u(h1 + c0 * HTP_MM_HMX_TILE_N_COLS, HTP_MM_HMX_TILE_N_COLS * sizeof(__fp16), Q6_V_hi_W(d));
+            }
+        }
+    }
