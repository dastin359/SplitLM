     }
+#undef HMX_MMID_PUSH_PAIR
+#undef HMX_MMID_ROW_SRC
+}
+
+static void hmx_mmid_hvx_step_worker(unsigned int n, unsigned int i, void * data) {
+    (void) n;
+    hmx_mmid_hvx_step_t * st = (hmx_mmid_hvx_step_t *) data;
+    struct htp_thread_trace * tr = &st->traces[i];
+
+    if (i > 0 && st->n_g_dma > 0) {
+        dma_queue * q    = st->ctx->dma[i];
+        float *     ring = st->dma_ring + (size_t) (i - 1) * st->dma_ring_floats;
+        for (;;) {
+            const uint32_t j = atomic_fetch_add(&st->g_next, 1);
+            if (j >= st->n_g_dma) break;
+            const uint32_t r0 = j * st->g_task_rows;
+            int rows = (int) st->g_cne1 - (int) (st->g_mr + r0);  // signed: hex_smin is unsigned
+            if (rows > (int) st->g_task_rows) rows = (int) st->g_task_rows;
+            if (rows <= 0) continue;
+            htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_A_PREP, j);
+            hmx_mmid_gather_dma(q, ring, st->g_dst, st->g_src, st->g_mr + r0, r0, (uint32_t) rows, st->k,
+                                st->matrix_rows, st->g_a, st->mapping_stride, st->ne11, &st->ne11_div,
+                                st->nb11, st->nb12, st->k_valid, st->act_f16);
+            htp_trace_event_stop(tr, HTP_TRACE_EVT_HVX_A_PREP, j);
+        }
+    }
+
+    for (;;) {
+        const uint32_t t = atomic_fetch_add(&st->next, 1);
+        if (t >= st->n_tasks) break;
+        const uint32_t j = st->idx[t];
+        switch (st->type[t]) {
+            case HMX_MMID_T_GATHER: {
+                const uint32_t r0 = j * st->g_task_rows;
+                int rows = (int) st->g_cne1 - (int) (st->g_mr + r0);  // signed: hex_smin is unsigned
+                if (rows > (int) st->g_task_rows) rows = (int) st->g_task_rows;
+                if (rows <= 0) break;
+                htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_A_PREP, j);
+                if (st->ne11 == 1) {
+                    transfer_activation_chunk_fp32_to_fp16_gathered_flat(
+                        st->g_dst, st->g_src, st->g_mr + r0, r0, (uint32_t) rows, st->k,
+                        st->matrix_rows, st->g_a, st->mapping_stride, st->nb12, st->g_cne1, st->k_valid);
+                } else {
+                    transfer_activation_chunk_fp32_to_fp16_gathered(
+                        st->g_dst, st->g_src, st->g_mr + r0, r0, (uint32_t) rows, st->k,
+                        st->matrix_rows, st->g_a, st->mapping_stride, st->ne11, &st->ne11_div,
+                        st->nb11, st->nb12, st->g_cne1, st->k_valid);
+                }
+                htp_trace_event_stop(tr, HTP_TRACE_EVT_HVX_A_PREP, j);
+                break;
+            }
+            case HMX_MMID_T_SCATTER: {
+                const uint32_t r0 = j * st->s_task_rows;
+                int rows = (int) st->s_n_rows - (int) r0;
+                if (rows > (int) st->s_task_rows) rows = (int) st->s_task_rows;
+                if (rows <= 0 || st->s_mr + r0 >= st->s_cne1) break;
+                htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_O_PROC, j);
+                if (st->s_swiglu) {
+                    transfer_output_chunk_scattered_swiglu_pair(
+                        st->s_dst, st->s_src, st->s_mr + r0, r0, (uint32_t) rows, st->s_n_cols,
+                        st->matrix_rows, st->s_a, st->mapping_stride, st->s_nb1, st->s_nb2, st->s_cne1,
+                        st->s_aligned, st->s_swiglu);
+                } else {
+                    transfer_output_chunk_fp16_to_fp32_scattered(
+                        st->s_dst, st->s_src, st->s_mr + r0, r0, (uint32_t) rows, st->s_n_cols,
+                        st->matrix_rows, st->s_a, st->mapping_stride, st->s_nb1, st->s_nb2, st->s_cne1,
+                        st->s_aligned);
+                }
+                htp_trace_event_stop(tr, HTP_TRACE_EVT_HVX_O_PROC, j);
+                break;
+            }
+            default: {
+                const uint32_t start = j * st->dq.n_tiles_per_task;
+                const uint32_t end   = hex_smin(start + st->dq.n_tiles_per_task, st->dq.n_tot_tiles);
+                if (start >= end) break;
+                htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_W_DEQUANT, j);
+                st->dq.task_fn(&st->dq, start, end);
+                htp_trace_event_stop(tr, HTP_TRACE_EVT_HVX_W_DEQUANT, j);
+                break;
+            }
+        }
+    }
+}
+
+// task list: memory-bound tasks first and spread out, dequant tasks in between
+static void hmx_mmid_hvx_step_build(hmx_mmid_hvx_step_t * st, uint32_t n_g, uint32_t n_s, uint32_t n_d, bool dma_gather) {
+    st->n_g_dma = dma_gather ? n_g : 0;
+    atomic_store(&st->g_next, 0);
+    if (dma_gather) n_g = 0;
+    uint32_t g = 0, s = 0, d = 0, t = 0;
+    assert(n_g <= HMX_MMID_MAX_G && n_s <= HMX_MMID_MAX_S && n_d <= HMX_MMID_MAX_D);
+    while (g < n_g || s < n_s || d < n_d) {
+        if (g < n_g) { st->type[t] = HMX_MMID_T_GATHER;  st->idx[t++] = (uint8_t) g++; }
+        if (s < n_s) { st->type[t] = HMX_MMID_T_SCATTER; st->idx[t++] = (uint8_t) s++; }
+        if (d < n_d) { st->type[t] = HMX_MMID_T_DEQUANT; st->idx[t++] = (uint8_t) d++; }
+    }
+    st->n_tasks = t;
+    atomic_store(&st->next, 0);
+}
+
+// Returns 1 when the op cannot use the streamed kernel (nothing was done, use the per-expert kernel),
+// 0 on success, -1 on error.
+static int hmx_mm_id_stream_f32(struct htp_context *ctx,
+                                dma_queue *weight_dma,
+                                int n_w,
+                                float * const * dsts,
+                                const size_t * dst_nb1s,
+                                const size_t * dst_nb2s,
+                                const dma_addr_t * w_data,       // per weight: expert 0
+                                const size_t * w_nb2,            // per weight: expert stride
+                                const float *activation,
+                                int k, int n,
+                                int k_valid,
+                                int ne11,
+                                size_t act_nb1, size_t act_nb2,
+                                int weight_stride,
+                                int weight_type,
+                                int tile_size,
+                                int aligned_tile_size,
+                                const uint32_t * row_counts,
+                                uint32_t n_as,
+                                const struct mmid_row_mapping *matrix_rows,
+                                int mapping_stride,
+                                int n_threads,
+                                uint32_t flags,    // HTP_MMID_STREAM_* bits
+                                uint32_t swiglu) { // n_w == 2: dsts[0] = silu(W0 x) * (W1 x), 1 = qf32, 2 = fp16 sigmoid, 3 = all fp16,
+                                                   // 4 = 2 stored as fp16, 5 = 3 stored as fp16
+    struct htp_thread_trace * tr = &ctx->trace[0];
+
+    if (flags & HTP_MMID_STREAM_TEST_PER_EXPERT) return 1;
+    if (n_w <= 0) return 1;
+    if (swiglu && n_w != 2) return 1;
+    if (k % 32 != 0 || n % 32 != 0) return 1;
+    if (!hex_is_aligned(activation, VLEN)) return 1;
+    for (int w = 0; w < n_w; ++w) {
+        if (!hex_is_aligned(dsts[w], VLEN)) return 1;
+    }
+
+    const size_t row_stride = htp_tensor_get_row_size(weight_type, k);
+    if (row_stride == 0) return 1;
+
+    const bool is_tiled = (tile_size > 0);
+    tiled_dequant_task_fn_t dequant_worker_fn = hmx_get_dequant_worker_fn(weight_type, is_tiled);
+    if (!dequant_worker_fn) return 1;  // HMX would read the raw buffers directly: per-expert kernel
+
+    htp_trace_event_start(tr, HTP_TRACE_EVT_INIT, 0);
+    const bool aligned_out = (flags & HTP_MMID_STREAM_ALIGNED_OUT) != 0;
+    const bool act_f16     = (flags & HTP_MMID_STREAM_ACT_F16) != 0;
+    if (act_f16 && (n_threads <= 1 || !(flags & HTP_MMID_STREAM_DMA_GATHER) || k % 64 != 0 || k_valid != k ||
+                    act_nb1 % VLEN != 0 || act_nb2 % VLEN != 0)) {
+        htp_trace_event_stop(tr, HTP_TRACE_EVT_INIT, 0);
+        return 1;
+    }
+
+    const int n_k_tiles = k / HTP_MM_HMX_TILE_N_COLS;
+    const uint32_t n_weight_tiles = k / htp_tensor_get_tile_k(weight_type);
+    const struct fastdiv_values n_k_tiles_div = init_fastdiv_values(n_k_tiles);
+
+    const size_t vec_dot_size = k * sizeof(__fp16);
+
+    const uint32_t dma_dst_stride  = is_tiled ? aligned_tile_size : row_stride;
+    const uint32_t dma_src_stride  = is_tiled ? tile_size : weight_stride;
+    const uint32_t dma_width_bytes = is_tiled ? tile_size : row_stride;
+    const size_t   w_col_bytes     = is_tiled ? (size_t) (n_weight_tiles * aligned_tile_size) / 32 : row_stride;
+
+    // DMA gather rings for worker threads 1..n-1 (thread 0's DMA queue carries the weights)
+    const bool   dma_gather      = (n_threads > 1) && (flags & HTP_MMID_STREAM_DMA_GATHER);
+    const size_t dma_ring_floats = (size_t) 2 * HMX_MMID_DMA_PAIRS * k;
+    const size_t dma_ring_size   = dma_gather ? hex_align_up((size_t) (n_threads - 1) * dma_ring_floats * sizeof(float), HTP_MM_HMX_TILE_SIZE) : 0;
+
+    // SWIGLU pairing: one item = the same columns of both weights (gate then up) in one raw/fp16 weight buffer
+    // and one HMX job of 2 x hc columns, so the scatter combines the two halves in VTCM and writes only the
+    // SWIGLU output. Items then run over a single virtual weight of 2n columns, in chunks of 2 x 32 columns.
+    const int n_wi = swiglu ? 1 : n_w;  // weights in the item stream
+    size_t mc = 0, nc = 0, vtcm_used = 0;
+    if (hmx_mmid_stream_plan(ctx->vtcm_size, row_counts, n_as, n_wi, k, swiglu ? 2 * n : n, swiglu ? 64 : 32,
+                             w_col_bytes, vec_dot_size, dma_ring_size, &mc, &nc, &vtcm_used)) {
+        htp_trace_event_stop(tr, HTP_TRACE_EVT_INIT, 0);
+        return 1;
+    }
+
+    const size_t raw_size = hex_align_up(nc * w_col_bytes, HTP_MM_HMX_TILE_SIZE);
+    const size_t wf_size  = hex_align_up(nc * vec_dot_size, HTP_MM_HMX_TILE_SIZE);
+    const size_t act_size = hex_align_up((mc + HMX_MMID_ACT_SLACK_ROWS) * vec_dot_size, HTP_MM_HMX_TILE_SIZE);
+    const size_t out_size = hex_align_up(mc * nc * sizeof(__fp16), HTP_MM_HMX_TILE_SIZE);
+
+    uint8_t * vtcm_ptr = (uint8_t *) ctx->vtcm_base;
+    void *   raw_bufs[2];
+    __fp16 * wf_bufs[2];
+    __fp16 * act_bufs[2];
+    __fp16 * out_bufs[2];
+    for (int b = 0; b < 2; ++b) raw_bufs[b] = vtcm_seq_alloc(&vtcm_ptr, raw_size);
+    for (int b = 0; b < 2; ++b) wf_bufs[b]  = (__fp16 *) vtcm_seq_alloc(&vtcm_ptr, wf_size);
+    for (int b = 0; b < 2; ++b) act_bufs[b] = (__fp16 *) vtcm_seq_alloc(&vtcm_ptr, act_size);
+    for (int b = 0; b < 2; ++b) out_bufs[b] = (__fp16 *) vtcm_seq_alloc(&vtcm_ptr, out_size);
+    __fp16 * vtcm_scales = (__fp16 *) vtcm_seq_alloc(&vtcm_ptr, 256);
+    float *  dma_ring    = dma_gather ? (float *) vtcm_seq_alloc(&vtcm_ptr, dma_ring_size) : NULL;
+
+    if ((size_t) (vtcm_ptr - (uint8_t *) ctx->vtcm_base) > ctx->vtcm_size) {
+        htp_trace_event_stop(tr, HTP_TRACE_EVT_INIT, 0);
+        return 1;
+    }
+
+    hmx_init_column_scales(vtcm_scales, Q6_V_vsplat_R(0x3c00));
+
+    const size_t nc_w = swiglu ? nc / 2 : nc;  // columns of each weight per item
+    const int n_chunk_cnt = (n + (int) nc_w - 1) / (int) nc_w;
+
+    FARF(HIGH, "hmx-mm-id-stream: n_w %d k %d n %d mc %zu nc %zu vtcm %zu/%zu", n_w, k, n, mc, nc, vtcm_used, ctx->vtcm_size);
+
+    htp_trace_event_stop(tr, HTP_TRACE_EVT_INIT, 0);
+
+#define HMX_MMID_DMA_HEIGHT(cols) ((uint32_t) (is_tiled ? hmx_ceil_div((cols), 32) * n_weight_tiles : (cols)))
+#define HMX_MMID_DMA_PUSH(p, buf) do {                                                                          \
+        const size_t nc_d     = (size_t) (p).i * nc_w;                                                          \
+        const size_t n_cols_d = hex_smin((size_t) n - nc_d, nc_w);                                              \
+        const dma_addr_t src_d = w_data[(p).w] + (dma_addr_t) ((size_t) (p).a * w_nb2[(p).w] + nc_d * weight_stride); \
+        dma_queue_push(weight_dma, dma_make_data((buf), src_d), dma_dst_stride, dma_src_stride, dma_width_bytes,  \
+                       HMX_MMID_DMA_HEIGHT(n_cols_d));                                                          \
+        if (swiglu) {  /* the up columns right after the gate columns */                                        \
+            const dma_addr_t src_u = w_data[1] + (dma_addr_t) ((size_t) (p).a * w_nb2[1] + nc_d * weight_stride); \
+            dma_queue_push(weight_dma,                                                                          \
+                           dma_make_data((uint8_t *) (buf) + (size_t) HMX_MMID_DMA_HEIGHT(n_cols_d) * dma_dst_stride, src_u), \
+                           dma_dst_stride, dma_src_stride, dma_width_bytes, HMX_MMID_DMA_HEIGHT(n_cols_d));        \
+        }                                                                                                       \
+    } while (0)
+
+    struct hmx_mmid_pos cur, ahead;
+    hmx_mmid_pos_init(&cur, row_counts, n_as);
+    ahead = cur;
+
+    // prologue: weight chunks of items 0 and 1
+    for (int b = 0; b < 2 && ahead.valid; ++b) {
+        HMX_MMID_DMA_PUSH(ahead, raw_bufs[b]);
+        hmx_mmid_pos_advance(&ahead, n_wi, n_chunk_cnt, (int) mc);
+    }
+
+    hmx_mmid_hvx_step_t step;
+    step.traces          = ctx->trace;
+    step.ctx             = ctx;
+    step.dma_ring        = dma_ring;
+    step.dma_ring_floats = dma_ring_floats;
+    step.act_f16         = act_f16;
+    step.matrix_rows    = matrix_rows;
+    step.mapping_stride = (uint32_t) mapping_stride;
+    step.g_src          = activation;
+    step.k              = (uint32_t) k;
+    step.k_valid        = (uint32_t) k_valid;
+    step.ne11           = (uint32_t) ne11;
+    step.ne11_div       = ne11 > 1 ? init_fastdiv_values(ne11) : (struct fastdiv_values){ 0, 0 };
+    step.nb11           = act_nb1;
+    step.nb12           = act_nb2;
+
+    tiled_dequantize_state_t * dq = &step.dq;
+    memset(dq, 0, sizeof(*dq));
+    dq->task_fn           = dequant_worker_fn;
+    dq->k_block           = k;
+    dq->row_stride        = row_stride;
+    dq->weight_type       = weight_type;
+    dq->n_k_tiles         = n_k_tiles;
+    dq->n_weight_tiles    = n_weight_tiles;
+    dq->n_k_tiles_div     = n_k_tiles_div;
+    dq->traces            = ctx->trace;
+    dq->ctx               = ctx;
+    dq->tile_size         = htp_tensor_get_tile_size(weight_type);
+    dq->aligned_tile_size = htp_tensor_get_tile_padded_size(weight_type);
+
+    // pending items for the scatter: [0] = item - 2, [1] = item - 1
+    struct hmx_mmid_out {
+        float * dst;
+        size_t  nb1, nb2;
+        int     a, cne1, mr, n_rows, n_cols;
+    } pend[2];
+    int      n_pend = 0;
+    uint32_t item = 0;
+    uint32_t seg  = 0;
+    hmx_matmul_job_t job_slots[2];
+
+    // item j: pop DMA(j); pop HMX(j - 2); [scatter(j - 2) | gather(segment of j) | dequant(j)]; DMA(j + 2); push HMX(j)
+    while (cur.valid) {
+        const size_t n_rows = hex_smin((size_t) (cur.m_end - cur.mr), mc);
+        const bool   new_seg = (cur.w == 0 && cur.i == 0);
+        if (new_seg && item > 0) ++seg;
+
+        const size_t nc_cur   = (size_t) cur.i * nc_w;
+        const size_t n_cols_w = hex_smin((size_t) n - nc_cur, nc_w);   // output columns
+        const size_t n_cols   = swiglu ? 2 * n_cols_w : n_cols_w;     // HMX / weight buffer columns
+
+        void * curr_raw = (void *) dma_queue_pop(weight_dma).dst;
+        if (swiglu) dma_queue_pop(weight_dma);
+
+        const bool do_scatter = (n_pend == 2);
+        if (do_scatter) {
+            hmx_queue_pop(ctx->hmx_queue);  // HMX(item - 2): frees wf/out[item % 2] and the act buffer of segment - 2
+        }
+
+        uint32_t n_g = 0, n_s = 0;
+        if (new_seg) {
+            step.g_dst  = act_bufs[seg % 2];
+            step.g_a    = (uint32_t) cur.a;
+            step.g_cne1 = (uint32_t) cur.cne1;
+            step.g_mr   = (uint32_t) cur.mr;
+            step.g_n_rows = (uint32_t) n_rows;
+            step.g_task_rows = 32 * hmx_ceil_div((uint32_t) n_rows, 32 * HMX_MMID_MAX_G);
+            n_g = hmx_ceil_div((uint32_t) n_rows, step.g_task_rows);
+        }
+        if (do_scatter) {
+            const struct hmx_mmid_out * o = &pend[0];
+            step.s_dst    = o->dst;
+            step.s_src    = out_bufs[item % 2];
+            step.s_a      = (uint32_t) o->a;
+            step.s_cne1   = (uint32_t) o->cne1;
+            step.s_mr     = (uint32_t) o->mr;
+            step.s_n_rows = (uint32_t) o->n_rows;
+            step.s_n_cols = (uint32_t) o->n_cols;
+            step.s_nb1    = o->nb1;
+            step.s_nb2    = o->nb2;
+            step.s_aligned = aligned_out;
+            step.s_swiglu  = swiglu;
+            step.s_task_rows = 16 * hmx_ceil_div((uint32_t) o->n_rows, 16 * HMX_MMID_MAX_S);
+            n_s = hmx_ceil_div((uint32_t) o->n_rows, step.s_task_rows);
+        }
+        {
+            const uint32_t n_tot_tiles = (uint32_t) hmx_ceil_div(n_cols, HTP_MM_HMX_TILE_N_COLS) * n_weight_tiles;
+            dq->dst              = wf_bufs[item % 2];
+            dq->src              = (const uint8_t *) curr_raw;
+            dq->n_cols           = (uint32_t) n_cols;
+            dq->n_tot_tiles      = n_tot_tiles;
+            dq->n_tiles_per_task = hmx_ceil_div(n_tot_tiles, 2 * (uint32_t) n_threads);
+            dq->n_tasks          = hmx_ceil_div(n_tot_tiles, dq->n_tiles_per_task);
+        }
+        hmx_mmid_hvx_step_build(&step, n_g, n_s, dq->n_tasks, dma_gather);
+        if (n_threads > 1) {
+            worker_pool_run_func(ctx->worker_pool, hmx_mmid_hvx_step_worker, &step, n_threads);
+        } else {
+            hmx_mmid_hvx_step_worker(1, 0, &step);
+        }
+
+        if (do_scatter) {
+            pend[0] = pend[1];
+            n_pend  = 1;
+        }
+
+        // the raw buffer is free again: weight chunk of item + 2
+        if (ahead.valid) {
+            HMX_MMID_DMA_PUSH(ahead, curr_raw);
+            hmx_mmid_pos_advance(&ahead, n_wi, n_chunk_cnt, (int) mc);
+        }
+
+        hmx_matmul_job_init(&job_slots[item % 2], out_bufs[item % 2], act_bufs[seg % 2], wf_bufs[item % 2], vtcm_scales,
+                            hmx_ceil_div(n_rows, HTP_MM_HMX_TILE_N_ROWS), hmx_ceil_div(n_cols, HTP_MM_HMX_TILE_N_COLS),
+                            k / HTP_MM_HMX_TILE_N_ROWS);
+        hmx_queue_push(ctx->hmx_queue, hmx_queue_make_desc(hmx_matmul_worker_fn, &job_slots[item % 2]));
+
+        struct hmx_mmid_out * o = &pend[n_pend++];
+        o->dst    = swiglu >= 4 ? (float *) ((__fp16 *) dsts[cur.w] + nc_cur) : dsts[cur.w] + nc_cur;
+        o->nb1    = dst_nb1s[cur.w];
+        o->nb2    = dst_nb2s[cur.w];
+        o->a      = cur.a;
+        o->cne1   = cur.cne1;
+        o->mr     = cur.mr;
+        o->n_rows = (int) n_rows;
+        o->n_cols = (int) n_cols_w;
+
+        hmx_mmid_pos_advance(&cur, n_wi, n_chunk_cnt, (int) mc);
+        ++item;
+    }
+
+    // epilogue: the last one or two items, oldest first
+    for (int p = 0; p < n_pend; ++p) {
+        hmx_queue_pop(ctx->hmx_queue);
+        const struct hmx_mmid_out * o = &pend[p];
+        const uint32_t it = item - (uint32_t) n_pend + (uint32_t) p;
+        transfer_output_chunk_scattered_threaded(
+            ctx, o->dst, out_bufs[it % 2], o->mr, o->n_rows, o->n_cols,
+            matrix_rows, o->a, mapping_stride, o->nb1, o->nb2, o->cne1, n_threads, aligned_out, swiglu);
+    }
+
+#undef HMX_MMID_DMA_PUSH
+#undef HMX_MMID_DMA_HEIGHT
 
