+// acc[j][:] = acc[j][:]*rescale[j] + sum_t w[t][j]*V(idx[t])[:], 16 columns at a time held in registers
+template <int GB>
+static inline void ggml_fa_dec_accum_v(float * acc, const float * rescale, const char * vbase, size_t nbv1,
+                                       const int32_t * idx, const float * w, int n, int64_t DV) {
+    for (int64_t d = 0; d < DV; d += 16) {
+        float32x4_t r[GB][4];
+        for (int j = 0; j < GB; j++) {
+            const float32x4_t sc = vdupq_n_f32(rescale[j]);
+            for (int c = 0; c < 4; c++) {
+                r[j][c] = vmulq_f32(vld1q_f32(acc + j*DV + d + 4*c), sc);
+            }
+        }
+        for (int t = 0; t < n; t++) {
+            const __fp16 * vp = (const __fp16 *) (vbase + (size_t) idx[t]*nbv1) + d;
+            const float16x8_t v0 = vld1q_f16(vp);
+            const float16x8_t v1 = vld1q_f16(vp + 8);
+            const float32x4_t f0 = vcvt_f32_f16(vget_low_f16(v0));
+            const float32x4_t f1 = vcvt_high_f32_f16(v0);
+            const float32x4_t f2 = vcvt_f32_f16(vget_low_f16(v1));
+            const float32x4_t f3 = vcvt_high_f32_f16(v1);
+            for (int j = 0; j < GB; j++) {
+                const float wj = w[4*t + j];
+                r[j][0] = vfmaq_n_f32(r[j][0], f0, wj);
+                r[j][1] = vfmaq_n_f32(r[j][1], f1, wj);
+                r[j][2] = vfmaq_n_f32(r[j][2], f2, wj);
+                r[j][3] = vfmaq_n_f32(r[j][3], f3, wj);
+            }
+        }
+        for (int j = 0; j < GB; j++) {
+            for (int c = 0; c < 4; c++) {
+                vst1q_f32(acc + j*DV + d + 4*c, r[j][c]);
+            }
+        }
+    }
+}
+
+static inline void ggml_fa_dec_prefetch_row(const char * p, int64_t nbytes, int locality) {
+    for (int64_t o = 0; o < nbytes; o += 64) {
+        if (locality == 3) {
+            __builtin_prefetch(p + o, 0, 3);
+        } else {
+            __builtin_prefetch(p + o, 0, 2);
+        }
+    }
+}
+
+// partials (M, S, VKQ) of all query heads over KV positions [ic_start, ic_end). Blocks of positions are the outer
+// loop, so the K/V rows of all KV heads of a cell are used while they are hot; each GB-head group shares one pass
+// over its KV head's rows.
+template <int GB>
+static void ggml_fa_dec_chunk_t(
+        const ggml_tensor * dst, int64_t ic_start, int64_t ic_end, float * scratch, float * partials, int64_t partial_stride) {
+    const ggml_tensor * q     = dst->src[0];
+    const ggml_tensor * k     = dst->src[1];
+    const ggml_tensor * v     = dst->src[2];
+    const ggml_tensor * mask  = dst->src[3];
+    const ggml_tensor * sinks = dst->src[4];
+
+    const int64_t DK     = k->ne[0];
+    const int64_t DV     = v->ne[0];
+    const int64_t n_head = q->ne[2];
+    const int64_t rk2    = q->ne[2]/k->ne[2];
+    const int64_t rv2    = q->ne[2]/v->ne[2];
+    const size_t  nbk1   = k->nb[1];
+    const size_t  nbv1   = v->nb[1];
+
+    float scale         = 1.0f;
+    float max_bias      = 0.0f;
+    float logit_softcap = 0.0f;
+    memcpy(&scale,         (const float *) dst->op_params + 0, sizeof(float));
+    memcpy(&max_bias,      (const float *) dst->op_params + 1, sizeof(float));
+    memcpy(&logit_softcap, (const float *) dst->op_params + 2, sizeof(float));
+    if (logit_softcap != 0) {
+        scale /= logit_softcap;
+    }
+    const uint32_t n_head_log2 = 1u << (uint32_t) floor(log2((double) n_head));
+    const float m0 = powf(2.0f, -(max_bias       ) / n_head_log2);
+    const float m1 = powf(2.0f, -(max_bias / 2.0f) / n_head_log2);
+
+    // scratch layout
+    __fp16  * Q16 = (__fp16 *) scratch;               // [n_head][DK]
+    float   * acc = scratch + n_head*DK/2;            // [n_head][DV]
+    float   * M   = acc + n_head*DV;                  // [n_head]
+    float   * S   = M + n_head;                       // [n_head]
+    float   * sc  = S + n_head;                       // [GB][BKV] scores, then probabilities
+    float   * w   = sc + FA_DEC_GBMAX*FA_DEC_BKV;     // [BKV][4] probabilities by position
+    int32_t * idx = (int32_t *) (w + 4*FA_DEC_BKV);   // [BKV] unmasked positions of the block
+    float   * mvl = (float *) (idx + FA_DEC_BKV);     // [BKV] their mask values
+
+    for (int64_t h = 0; h < n_head; h++) {
+        const float * pq = (const float *) ((const char *) q->data + h*q->nb[2]);
+        for (int64_t d = 0; d < DK; d++) {
+            Q16[h*DK + d] = (__fp16) pq[d];
+        }
+        M[h] = -INFINITY;
+        S[h] = 0.0f;
+    }
+    memset(acc, 0, n_head*DV*sizeof(float));
+
+    const ggml_fp16_t * mp = mask ? (const ggml_fp16_t *) mask->data : NULL;
+
+    for (int64_t b0 = ic_start; b0 < ic_end; b0 += FA_DEC_BKV) {
+        const int64_t b1 = std::min(b0 + FA_DEC_BKV, ic_end);
+        const int64_t bn = std::min(b1 + FA_DEC_BKV, ic_end); // end of the next block, for prefetch
+
+        // unmasked positions of this block (the mask is shared by all heads)
+        int n = 0;
+        for (int64_t ic = b0; ic < b1; ic++) {
+            const float mv = mp ? GGML_CPU_FP16_TO_FP32(mp[ic]) : 0.0f;
+            if (mv == -INFINITY) {
+                continue;
+            }
+            idx[n] = (int32_t) ic;
+            mvl[n] = mv;
+            n++;
+        }
+        if (n == 0) {
+            continue;
+        }
+        const int n4 = (n + 3) & ~3;
+
+        for (int64_t h0 = 0; h0 < n_head; h0 += GB) {
+            const char * kbase = (const char *) k->data + (h0/rk2)*k->nb[2];
+            const char * vbase = (const char *) v->data + (h0/rv2)*v->nb[2];
+            const __fp16 * Qg  = Q16 + h0*DK;
+
+            // scores; meanwhile prefetch this block's V rows (used right after) and the next block's K rows
+            float s0[GB], s1[GB];
+            int t = 0;
+            for (; t + 1 < n; t += 2) {
+                ggml_fa_dec_prefetch_row(vbase + (size_t) idx[t]*nbv1,     DV*sizeof(ggml_fp16_t), 3);
+                ggml_fa_dec_prefetch_row(vbase + (size_t) idx[t + 1]*nbv1, DV*sizeof(ggml_fp16_t), 3);
+                if (b1 + t + 1 < bn) {
+                    ggml_fa_dec_prefetch_row(kbase + (b1 + t)*nbk1,     DK*sizeof(ggml_fp16_t), 2);
+                    ggml_fa_dec_prefetch_row(kbase + (b1 + t + 1)*nbk1, DK*sizeof(ggml_fp16_t), 2);
+                }
+                ggml_fa_dec_dot2<GB>((const __fp16 *) (kbase + (size_t) idx[t]*nbk1), (const __fp16 *) (kbase + (size_t) idx[t + 1]*nbk1), Qg, DK, s0, s1);
+                for (int j = 0; j < GB; j++) {
+                    sc[j*FA_DEC_BKV + t]     = s0[j];
+                    sc[j*FA_DEC_BKV + t + 1] = s1[j];
+                }
+            }
+            if (t < n) {
+                ggml_fa_dec_dot1<GB>((const __fp16 *) (kbase + (size_t) idx[t]*nbk1), Qg, DK, s0);
+                for (int j = 0; j < GB; j++) {
+                    sc[j*FA_DEC_BKV + t] = s0[j];
+                }
+            }
+
+            // block softmax, merged into the running (M, S) of each head
+            float rescale[GB];
+            for (int j = 0; j < GB; j++) {
+                const int64_t h = h0 + j;
+                const float slope = (max_bias > 0.0f) ? (h < n_head_log2 ? powf(m0, h + 1) : powf(m1, 2*(h - n_head_log2) + 1)) : 1.0f;
+                float * s = sc + j*FA_DEC_BKV;
+                float mb = -INFINITY;
+                for (int i = 0; i < n; i++) {
+                    float x = s[i]*scale;
+                    if (logit_softcap != 0.0f) {
+                        x = logit_softcap*tanhf(x);
+                    }
+                    x += slope*mvl[i];
+                    s[i] = x;
+                    mb = std::max(mb, x);
+                }
+                for (int i = n; i < n4; i++) {
+                    s[i] = -INFINITY;
+                }
+                const float Mnew = std::max(M[h], mb);
+                rescale[j] = M[h] == -INFINITY ? 0.0f : expf(M[h] - Mnew);
+                M[h] = Mnew;
+                const float32x4_t vm = vdupq_n_f32(Mnew);
+                float32x4_t vsum = vdupq_n_f32(0.0f);
+                for (int i = 0; i < n4; i += 4) {
+                    const float32x4_t p = ggml_v_expf(vsubq_f32(vld1q_f32(s + i), vm));
+                    vst1q_f32(s + i, p);
+                    vsum = vaddq_f32(vsum, p);
+                }
+                S[h] = S[h]*rescale[j] + vaddvq_f32(vsum);
+            }
+            for (int i = 0; i < n; i++) {
+                for (int j = 0; j < GB; j++) {
+                    w[4*i + j] = sc[j*FA_DEC_BKV + i];
+                }
+            }
+
+            ggml_fa_dec_accum_v<GB>(acc + h0*DV, rescale, vbase, nbv1, idx, w, n, DV);
+        }
+    }
+
+    for (int64_t h = 0; h < n_head; h++) {
+        float * VKQ = acc + h*DV;
+
+        // sinks - apply only on the first kv-chunk
+        if (sinks && ic_start == 0) {
+            const float s = ((const float *) sinks->data)[h];
+            float ms = 1.0f;
+            float vs = 1.0f;
+            if (s > M[h]) {
+                ms = expf(M[h] - s);
+                M[h] = s;
+                ggml_vec_scale_f32(DV, VKQ, ms);
+            } else {
+                vs = expf(s - M[h]);
+            }
+            S[h] = S[h]*ms + vs;
+        }
+
+        float * partial = partials + h*partial_stride;
+        partial[0] = M[h];
+        partial[1] = S[h];
+        memcpy(partial + 2, VKQ, DV*sizeof(float));
+    }
+}
+
+
+// r6-fa: v2 of the decode kernel for GQA groups of 4 query heads (LFM2.5: 32/8 heads, Qwen3.5: 8/2). Same arithmetic
+// as ggml_fa_dec_chunk_t<4>, fewer instructions per KV position, plus a software prefetch of the contiguous K/V cells
+// a few blocks ahead:
+//  - the scores of the 4 heads of a position are reduced with a pairwise-add tree straight into one vector (the same
+//    pairwise order as vaddvq_f32), so they land in position-major [t][4] layout: no transpose, no scalar stores;
+//  - the block softmax runs across the 4 heads in one vector per position (max, exp, sums kept per position mod 4 and
+//    combined in vaddvq_f32 order), replacing the per-head scalar scale/mask/max loop;
+//  - V is accumulated with lane-indexed FMAs on the probability vector of a position (one load instead of four);
+//  - the K and V cells (all KV heads, contiguous in the KV cache) one block ahead are prefetched, spread over the
+//    current block's work (the first block's cells up front), so DRAM reads overlap the compute; the per-head-group
+//    loop reads each cell in 1-KB-strided pieces, which the hardware prefetcher does not run ahead of.
+// Results are bit-identical to the template kernel (checked on random masks incl. finite non-zero values,
+// ALiBi, softcap, sinks, head sizes 64-256, 1/5/8 threads). GGML_CPU_FA_DEC_V2=0 restores the template kernel;
+// GGML_CPU_FA_DEC_PFD=0 disables the prefetch, GGML_CPU_FA_DEC_PFC=<cells> sets its distance.
+static int ggml_fa_dec_env(const char * name, int def) {
+    const char * e = getenv(name);
+    return e ? atoi(e) : def;
+}
+
+static bool ggml_fa_dec_v2_enabled() {
+    static const bool on = ggml_fa_dec_env("GGML_CPU_FA_DEC_V2", 1) != 0;
+    return on;
+}
+
+// prefetch distance in KV cells (GGML_CPU_FA_DEC_PFC, default one block)
+static int ggml_fa_dec_pfd() {
+    static const int pfd = ggml_fa_dec_env("GGML_CPU_FA_DEC_PFD", 1) != 0 ? std::max(0, ggml_fa_dec_env("GGML_CPU_FA_DEC_PFC", FA_DEC_BKV)) : 0;
+    return pfd;
+}
+
+// software prefetch cursor over [p, end)
+struct ggml_fa_dec_pf {
+    const char * p   = nullptr;
+    const char * end = nullptr;
+    inline void step(int nlines) {
+        for (int i = 0; i < nlines && p < end; i++, p += 64) {
+            __builtin_prefetch(p, 0, 2);
+        }
+    }
+};
+
+// lane j = (vj[0] + vj[1]) + (vj[2] + vj[3]): the order in which vaddvq_f32 adds its lanes
+static inline float32x4_t ggml_fa_dec_hsum4(float32x4_t v0, float32x4_t v1, float32x4_t v2, float32x4_t v3) {
+    return vpaddq_f32(vpaddq_f32(v0, v1), vpaddq_f32(v2, v3));
+}
+
+static inline void ggml_fa_dec_dot2_g4(const __fp16 * k0, const __fp16 * k1, const __fp16 * q, int64_t DK, float * w0, float * w1) {
+    float32x4_t a0[4], b0[4], a1[4], b1[4];
+    for (int j = 0; j < 4; j++) {
+        a0[j] = vdupq_n_f32(0.0f); b0[j] = vdupq_n_f32(0.0f);
+        a1[j] = vdupq_n_f32(0.0f); b1[j] = vdupq_n_f32(0.0f);
+    }
+    for (int64_t d = 0; d < DK; d += 8) {
+        const float16x8_t x0 = vld1q_f16(k0 + d);
+        const float16x8_t x1 = vld1q_f16(k1 + d);
+        for (int j = 0; j < 4; j++) {
+            const float16x8_t qv = vld1q_f16(q + j*DK + d);
+            a0[j] = vfmlalq_low_f16 (a0[j], x0, qv);
+            b0[j] = vfmlalq_high_f16(b0[j], x0, qv);
+            a1[j] = vfmlalq_low_f16 (a1[j], x1, qv);
+            b1[j] = vfmlalq_high_f16(b1[j], x1, qv);
+        }
+    }
+    vst1q_f32(w0, ggml_fa_dec_hsum4(vaddq_f32(a0[0], b0[0]), vaddq_f32(a0[1], b0[1]), vaddq_f32(a0[2], b0[2]), vaddq_f32(a0[3], b0[3])));
+    vst1q_f32(w1, ggml_fa_dec_hsum4(vaddq_f32(a1[0], b1[0]), vaddq_f32(a1[1], b1[1]), vaddq_f32(a1[2], b1[2]), vaddq_f32(a1[3], b1[3])));
+}
+
+static inline void ggml_fa_dec_dot1_g4(const __fp16 * k0, const __fp16 * q, int64_t DK, float * w0) {
+    float32x4_t a0[4], b0[4];
+    for (int j = 0; j < 4; j++) { a0[j] = vdupq_n_f32(0.0f); b0[j] = vdupq_n_f32(0.0f); }
+    for (int64_t d = 0; d < DK; d += 8) {
+        const float16x8_t x0 = vld1q_f16(k0 + d);
+        for (int j = 0; j < 4; j++) {
+            const float16x8_t qv = vld1q_f16(q + j*DK + d);
+            a0[j] = vfmlalq_low_f16 (a0[j], x0, qv);
+            b0[j] = vfmlalq_high_f16(b0[j], x0, qv);
+        }
+    }
+    vst1q_f32(w0, ggml_fa_dec_hsum4(vaddq_f32(a0[0], b0[0]), vaddq_f32(a0[1], b0[1]), vaddq_f32(a0[2], b0[2]), vaddq_f32(a0[3], b0[3])));
+}
+
+// acc[j][:] = acc[j][:]*rescale[j] + sum_t w[t][j]*V(idx[t])[:], 16 columns at a time held in registers
+static inline void ggml_fa_dec_accum_v_g4(float * acc, float32x4_t rescale, const char * vbase, size_t nbv1,
+                                          const int32_t * idx, const float * w, int n, int64_t DV, ggml_fa_dec_pf & pf, int pfn) {
+    const float32x4_t s0 = vdupq_laneq_f32(rescale, 0);
+    const float32x4_t s1 = vdupq_laneq_f32(rescale, 1);
+    const float32x4_t s2 = vdupq_laneq_f32(rescale, 2);
+    const float32x4_t s3 = vdupq_laneq_f32(rescale, 3);
+    for (int64_t d = 0; d < DV; d += 16) {
+        float32x4_t r[4][4];
+        for (int c = 0; c < 4; c++) {
+            r[0][c] = vmulq_f32(vld1q_f32(acc + 0*DV + d + 4*c), s0);
+            r[1][c] = vmulq_f32(vld1q_f32(acc + 1*DV + d + 4*c), s1);
+            r[2][c] = vmulq_f32(vld1q_f32(acc + 2*DV + d + 4*c), s2);
+            r[3][c] = vmulq_f32(vld1q_f32(acc + 3*DV + d + 4*c), s3);
+        }
+        for (int t = 0; t < n; t++) {
+            const __fp16 * vp = (const __fp16 *) (vbase + (size_t) idx[t]*nbv1) + d;
+            const float16x8_t v0 = vld1q_f16(vp);
+            const float16x8_t v1 = vld1q_f16(vp + 8);
+            const float32x4_t f0 = vcvt_f32_f16(vget_low_f16(v0));
+            const float32x4_t f1 = vcvt_high_f32_f16(v0);
+            const float32x4_t f2 = vcvt_f32_f16(vget_low_f16(v1));
+            const float32x4_t f3 = vcvt_high_f32_f16(v1);
+            const float32x4_t wt = vld1q_f32(w + 4*t);
+            r[0][0] = vfmaq_laneq_f32(r[0][0], f0, wt, 0); r[0][1] = vfmaq_laneq_f32(r[0][1], f1, wt, 0);
+            r[0][2] = vfmaq_laneq_f32(r[0][2], f2, wt, 0); r[0][3] = vfmaq_laneq_f32(r[0][3], f3, wt, 0);
+            r[1][0] = vfmaq_laneq_f32(r[1][0], f0, wt, 1); r[1][1] = vfmaq_laneq_f32(r[1][1], f1, wt, 1);
+            r[1][2] = vfmaq_laneq_f32(r[1][2], f2, wt, 1); r[1][3] = vfmaq_laneq_f32(r[1][3], f3, wt, 1);
+            r[2][0] = vfmaq_laneq_f32(r[2][0], f0, wt, 2); r[2][1] = vfmaq_laneq_f32(r[2][1], f1, wt, 2);
+            r[2][2] = vfmaq_laneq_f32(r[2][2], f2, wt, 2); r[2][3] = vfmaq_laneq_f32(r[2][3], f3, wt, 2);
+            r[3][0] = vfmaq_laneq_f32(r[3][0], f0, wt, 3); r[3][1] = vfmaq_laneq_f32(r[3][1], f1, wt, 3);
+            r[3][2] = vfmaq_laneq_f32(r[3][2], f2, wt, 3); r[3][3] = vfmaq_laneq_f32(r[3][3], f3, wt, 3);
+            if ((t & 3) == 3) {
+                pf.step(pfn);
+            }
+        }
+        for (int j = 0; j < 4; j++) {
+            for (int c = 0; c < 4; c++) {
+                vst1q_f32(acc + j*DV + d + 4*c, r[j][c]);
+            }
+        }
+    }
+}
+
+static void ggml_fa_dec_chunk_g4(
+        const ggml_tensor * dst, int64_t ic_start, int64_t ic_end, float * scratch, float * partials, int64_t partial_stride) {
+    const ggml_tensor * q     = dst->src[0];
+    const ggml_tensor * k     = dst->src[1];
+    const ggml_tensor * v     = dst->src[2];
+    const ggml_tensor * mask  = dst->src[3];
+    const ggml_tensor * sinks = dst->src[4];
+
+    const int64_t DK     = k->ne[0];
+    const int64_t DV     = v->ne[0];
+    const int64_t n_head = q->ne[2];
+    const int64_t rk2    = q->ne[2]/k->ne[2];
+    const int64_t rv2    = q->ne[2]/v->ne[2];
+    const size_t  nbk1   = k->nb[1];
+    const size_t  nbv1   = v->nb[1];
+
+    float scale         = 1.0f;
+    float max_bias      = 0.0f;
+    float logit_softcap = 0.0f;
+    memcpy(&scale,         (const float *) dst->op_params + 0, sizeof(float));
+    memcpy(&max_bias,      (const float *) dst->op_params + 1, sizeof(float));
+    memcpy(&logit_softcap, (const float *) dst->op_params + 2, sizeof(float));
+    if (logit_softcap != 0) {
+        scale /= logit_softcap;
+    }
+    const uint32_t n_head_log2 = 1u << (uint32_t) floor(log2((double) n_head));
+    const float m0 = powf(2.0f, -(max_bias       ) / n_head_log2);
+    const float m1 = powf(2.0f, -(max_bias / 2.0f) / n_head_log2);
+
+    // scratch layout as in the template kernel (its [GB][BKV] score area is unused here)
+    __fp16  * Q16 = (__fp16 *) scratch;               // [n_head][DK]
+    float   * acc = scratch + n_head*DK/2;            // [n_head][DV]
+    float   * M   = acc + n_head*DV;                  // [n_head]
+    float   * S   = M + n_head;                       // [n_head]
