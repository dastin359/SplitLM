+
+// Stack headroom probe (profile modes 1 and 3; reported per op as 'stack_free'): at the start of a batch every thread
+// paints the unused part of its stack, from FRAMELIMIT (QuRT's per-thread stack limit) up to 1 KB below its current
+// frame; stacks grow down, so the painted words left at the low end after an op are the bytes it never reached
+#define HTP_STACK_PAINT 0xA5A5A5A5u
+
+struct htp_stack_probe {
+    uintptr_t lo;
+    size_t    size;
+};
+
+static struct htp_stack_probe htp_stk[HTP_MAX_NTHREADS];
+
+static void htp_stack_probe_paint(struct htp_stack_probe * p) {
+    uint32_t lim;
+    asm volatile("%0 = framelimit" : "=r"(lim));
+    const uintptr_t sp = (uintptr_t) __builtin_frame_address(0);
+    const uintptr_t lo = ((uintptr_t) lim + 7) & ~(uintptr_t) 7;
+    p->lo   = 0;
+    p->size = 0;
+    if (lim != 0 && lo + 1024 < sp && sp - lo < (1u << 20)) {
+        p->lo   = lo;
+        p->size = (sp - 1024 - lo) & ~(size_t) 3;
+        volatile uint32_t * w = (volatile uint32_t *) p->lo;
+        for (size_t i = 0; i < p->size / 4; i++) w[i] = HTP_STACK_PAINT;
+    }
+}
+
+static uint32_t htp_stack_probe_headroom(const struct htp_stack_probe * p) {
+    const volatile uint32_t * w = (const volatile uint32_t *) p->lo;
+    size_t i = 0;
+    while (i < p->size / 4 && w[i] == HTP_STACK_PAINT) i++;
+    return (uint32_t) (i * 4);
+}
