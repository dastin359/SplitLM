+            for (int j = 0; j < 4; j++) {
+                const HVX_VectorPair pq = Q6_Wqf32_vmpy_VhfVhf(g[j], Q6_V_vor_VV(a[j], c.sign16));
+                sa[j] = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vadd_Vqf32Vsf(Q6_V_lo_W(pq), Q6_Vsf_vmax_VsfVsf(za[j], c.zero)));
+                sb[j] = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vadd_Vqf32Vsf(Q6_V_hi_W(pq), Q6_Vsf_vmax_VsfVsf(zb[j], c.zero)));
+            }
+            #pragma unroll
+            for (int j = 0; j < 4; j++) {
+                const HVX_Vector oa = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(sa[j], ya[j]));
+                const HVX_Vector ob = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(sb[j], yb[j]));
+                tbase[(h * 4 + j) * 16] = hvx_vec_f32_to_f16_shuff(oa, ob);
+            }
+        }
+    }
+    const uint32_t n_tok  = num_rows / 16;
+    const uint32_t padded = (n_tok + 31) & ~31u;
+    for (uint32_t t = n_tok; t < padded; t += 2) {
+        HVX_Vector * restrict tbase = (HVX_Vector *) (tiles + (size_t) (t / 32) * k_tiles * 1024) + (t % 32) / 2;
+        for (uint32_t cc = 0; cc < k_tiles; cc++) {
+            tbase[cc * 16] = hvx_vec_f32_to_f16_shuff(Q6_V_vzero(), Q6_V_vzero());
+        }
+    }
+}
