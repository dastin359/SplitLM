+// HMX_L: l of the 32 rows of a row tile as f32, from O's l column tile (every column of that tile holds the row's l;
+// vector j has rows 2j, 2j + 1 in its even / odd lanes, so word 0 of vector j is that row pair).
+static inline HVX_Vector fa_tile_l_f32(const HVX_Vector * lt) {
+    HVX_Vector acc = Q6_V_vzero();
+    for (uint32_t j = 0; j < 16; ++j) {
+        const HVX_VectorPred q_w = Q6_Q_and_QQn(Q6_Q_vsetq2_R(4 * j + 4), Q6_Q_vsetq_R(4 * j));
+        acc = Q6_V_vmux_QVV(q_w, Q6_V_vror_VR(lt[j], (128 - 4 * j) & 127), acc);
+    }
+    return Q6_V_lo_W(hvx_vec_f16_to_f32(acc));
+}
+
+// 1/l of the 32 rows of a row tile as fp16 in lanes 0..31 (and again in 32..63)
+static inline HVX_Vector fa_tile_inv_l_f16(const HVX_Vector * lt) {
+    const HVX_Vector inv = hvx_vec_inverse_f32(fa_tile_l_f32(lt));
+    return hvx_vec_f32_to_f16(inv, inv);
+}
