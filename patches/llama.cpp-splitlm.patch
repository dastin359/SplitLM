+                    for (uint32_t e = 1; e < n_e; ++e) {
+                        p  = Q6_Wqf32_vmpy_VhfVhf(xs[e][v], one);
+                        s0 = Q6_Vqf32_vadd_Vqf32Vqf32(s0, Q6_Vqf32_vmpy_Vqf32Vqf32(Q6_V_lo_W(p), wq[e]));
+                        s1 = Q6_Vqf32_vadd_Vqf32Vqf32(s1, Q6_Vqf32_vmpy_Vqf32Vqf32(Q6_V_hi_W(p), wq[e]));
+                    }
+                    if (has_r) {
+                        const HVX_VectorPair rd = Q6_W_vdeal_VVR(rr[2 * v + 1], rr[2 * v], -4);
+                        s0 = Q6_Vqf32_vadd_Vqf32Vsf(s0, Q6_V_lo_W(rd));
+                        s1 = Q6_Vqf32_vadd_Vqf32Vsf(s1, Q6_V_hi_W(rd));
+                    }
+                    const HVX_VectorPair o = Q6_W_vshuff_VVR(Q6_Vsf_equals_Vqf32(s1), Q6_Vsf_equals_Vqf32(s0), -4);
+                    dr[2 * v]     = Q6_V_lo_W(o);
+                    dr[2 * v + 1] = Q6_V_hi_W(o);
+                }
+            } else if (st->qacc) {
+                #pragma unroll(2)
+                for (uint32_t v = 0; v < nvec; ++v) {
+                    HVX_Vector s0 = Q6_Vqf32_vmpy_VsfVsf(xs[0][v], ws[0]);
+                    for (uint32_t e = 1; e < n_e; ++e) {
+                        s0 = Q6_Vqf32_vadd_Vqf32Vqf32(s0, Q6_Vqf32_vmpy_VsfVsf(xs[e][v], ws[e]));
+                    }
+                    if (has_r) {
+                        s0 = Q6_Vqf32_vadd_Vqf32Vsf(s0, rr[v]);
+                    }
+                    dr[v] = Q6_Vsf_equals_Vqf32(s0);
+                }
+            } else if (st->x_f16 && n_e == 4 && st->f16_chain) {
+                // fp16 rows, 4 experts: each vector widens exactly (as the f32 scatter of the producer did) to the
+                // even / odd elements of 64 columns, then the same qf32 chain as the f32 branch below (bit-identical
+                // results); the sums run on that lane order and are re-interleaved once
+                const HVX_Vector one = hvx_vec_splat_f16(1.0);
+                for (uint32_t v = 0; v < nvec / 2; ++v) {
+                    HVX_Vector a[4], b[4];
+                    for (uint32_t e = 0; e < 4; ++e) {
+                        const HVX_VectorPair p = Q6_Wqf32_vmpy_VhfVhf(xs[e][v], one);
+                        // no moe_keep on this exact widening: the barrier here cost ~1.5% of LFM prefill (worse
+                        // scheduling). Folding it would turn the next vmpy into qf32 x qf32 and break the bit-exact
+                        // match, which GGML_TEST_SEED + GGML_TEST_HASH runs of MOE_DOWN_REDUCE (F16=0 vs 1) detect
+                        a[e] = Q6_Vsf_equals_Vqf32(Q6_V_lo_W(p));
+                        b[e] = Q6_Vsf_equals_Vqf32(Q6_V_hi_W(p));
+                    }
+                    HVX_Vector s0 = Q6_Vqf32_vmpy_VsfVsf(a[0], ws[0]);
+                    HVX_Vector s1 = Q6_Vqf32_vmpy_VsfVsf(b[0], ws[0]);
+                    for (uint32_t e = 1; e < 4; ++e) {
+                        s0 = Q6_Vqf32_vadd_Vqf32Vqf32(s0, Q6_Vqf32_vmpy_VsfVsf(a[e], ws[e]));
+                        s1 = Q6_Vqf32_vadd_Vqf32Vqf32(s1, Q6_Vqf32_vmpy_VsfVsf(b[e], ws[e]));
+                    }
+                    if (has_r) {
+                        const HVX_VectorPair rd = Q6_W_vdeal_VVR(rr[2 * v + 1], rr[2 * v], -4);
+                        s0 = Q6_Vqf32_vadd_Vqf32Vsf(s0, Q6_V_lo_W(rd));
+                        s1 = Q6_Vqf32_vadd_Vqf32Vsf(s1, Q6_V_hi_W(rd));
+                    }
+                    const HVX_VectorPair o = Q6_W_vshuff_VVR(Q6_Vsf_equals_Vqf32(s1), Q6_Vsf_equals_Vqf32(s0), -4);
+                    dr[2 * v]     = Q6_V_lo_W(o);
+                    dr[2 * v + 1] = Q6_V_hi_W(o);
+                }
+            } else if (st->x_f16) {
+                // fp16 rows (n % 64 == 0): each vector widens exactly (as the f32 scatter of the producer did) to the
+                // even / odd elements of 64 columns; the sums run on that lane order and are re-interleaved once.
+                // Every product and sum is rounded to f32 (moe_keep), as in the generic f32 loop below (n_e != 4).
+                const HVX_Vector one = hvx_vec_splat_f16(1.0);
+                #define MOE_X16(e, v, lo_, hi_) do { const HVX_VectorPair p_ = Q6_Wqf32_vmpy_VhfVhf(xs[(e)][(v)], one); lo_ = moe_keep(Q6_Vsf_equals_Vqf32(Q6_V_lo_W(p_))); hi_ = moe_keep(Q6_Vsf_equals_Vqf32(Q6_V_hi_W(p_))); } while (0)
+                for (uint32_t v = 0; v < nvec / 2; ++v) {
+                    HVX_Vector a0, a1, b0, b1;
+                    MOE_X16(0, v, a0, a1);
+                    HVX_Vector s0 = moe_mul_f32(a0, ws[0]);
+                    HVX_Vector s1 = moe_mul_f32(a1, ws[0]);
+                    for (uint32_t e = 1; e < n_e; ++e) {
+                        MOE_X16(e, v, b0, b1);
+                        s0 = moe_add_f32(s0, moe_mul_f32(b0, ws[e]));
+                        s1 = moe_add_f32(s1, moe_mul_f32(b1, ws[e]));
+                    }
+                    if (has_r) {
+                        const HVX_VectorPair rd = Q6_W_vdeal_VVR(rr[2 * v + 1], rr[2 * v], -4);
+                        s0 = moe_add_f32(Q6_V_lo_W(rd), s0);
+                        s1 = moe_add_f32(Q6_V_hi_W(rd), s1);
+                    }
+                    const HVX_VectorPair o = Q6_W_vshuff_VVR(s1, s0, -4);
+                    dr[2 * v]     = Q6_V_lo_W(o);
+                    dr[2 * v + 1] = Q6_V_hi_W(o);
+                }
+                #undef MOE_X16
+            } else if (n_e == 4) {
+                // qf32 products and sums, one rounding at the end: written out, this is the code hexagon-clang
+                // generated for the per-op rounded form of this straight-line sum (it folds each sf conversion into
+                // the next qf32 add), so results do not depend on that optimization; the fp16 branch above matches it
+                #pragma unroll(2)
+                for (uint32_t v = 0; v < nvec; ++v) {
+                    HVX_Vector s0 = Q6_Vqf32_vmpy_VsfVsf(xs[0][v], ws[0]);
+                    s0 = Q6_Vqf32_vadd_Vqf32Vqf32(s0, Q6_Vqf32_vmpy_VsfVsf(xs[1][v], ws[1]));
+                    s0 = Q6_Vqf32_vadd_Vqf32Vqf32(s0, Q6_Vqf32_vmpy_VsfVsf(xs[2][v], ws[2]));
+                    s0 = Q6_Vqf32_vadd_Vqf32Vqf32(s0, Q6_Vqf32_vmpy_VsfVsf(xs[3][v], ws[3]));
+                    if (has_r) {
+                        s0 = Q6_Vqf32_vadd_Vqf32Vsf(s0, rr[v]);
+                    }
+                    dr[v] = Q6_Vsf_equals_Vqf32(s0);
+                }
+            } else {
+                for (uint32_t v = 0; v < nvec; ++v) {
+                    HVX_Vector s0 = moe_mul_f32(xs[0][v], ws[0]);
+                    for (uint32_t e = 1; e < n_e; ++e) {
+                        s0 = moe_add_f32(s0, moe_mul_f32(xs[e][v], ws[e]));
+                    }
+                    dr[v] = has_r ? moe_add_f32(rr[v], s0) : s0;
+                }
+            }
+            if (has_n) {
+                // same kernel as the RMS_NORM+MUL op on these rows
+                hvx_fast_rms_norm_mul_f32((const uint8_t *) dr, (const uint8_t *) st->nw, nv + (size_t) k * row, n, inv_n_v, epsilon_v);
+            }
+        }
+        htp_trace_event_stop(tr, HTP_TRACE_EVT_HVX_COMP, (uint16_t) b);
+
+        dma_queue_push(q, dma_make_data(st->d->data + (size_t) tb * st->d->nb[1], ov), st->d->nb[1], row, row, nt);
+        if (has_n) {
+            dma_queue_push(q, dma_make_data(st->nd->data + (size_t) tb * st->nd->nb[1], nv), st->nd->nb[1], row, row, nt);
+        }
+        if (b + 2 < n_blk) {
+            moe_reduce_push_reads(st, q, xv, rv, t0 + (b + 2) * blk, MOE_BLK_N(b + 2));
+        }
+    }
+#undef MOE_N_READS
+#undef MOE_BLK_N
+    dma_queue_flush(q);
+}
+
+int op_moe_reduce(struct htp_ops_context * octx) {
+    const struct htp_tensor * x = octx->src[0];
+    const struct htp_tensor * w = octx->src[1];
+    const struct htp_tensor * r = octx->src[2];
+    const struct htp_tensor * d = octx->dst;
+    if (!x || !w || !d || x->type != HTP_TYPE_F32 || w->type != HTP_TYPE_F32 || d->type != HTP_TYPE_F32 ||
+        x->ne[1] < 1 || x->ne[1] > MOE_REDUCE_MAX_E || (r && r->type != HTP_TYPE_F32) || d->ne[0] % VLEN_FP32 != 0) {
+        return HTP_STATUS_NO_SUPPORT;
+    }
+
+    moe_reduce_ctx_t st;
+    st.x     = x;
+    st.w     = w;
+    st.r     = r;
+    st.d     = d;
+    st.ctx   = octx->ctx;
+    st.n_tok = d->ne[1];
+    st.nd    = NULL;
+    st.nw    = NULL;
+    st.eps   = 0.0f;
+    st.x_f16 = octx->op_params[HTP_MOE_PARAM_X_F16] == 1 || octx->op_params[HTP_MOE_PARAM_X_F16] == 2;
+    st.f16_chain = octx->op_params[HTP_MOE_PARAM_X_F16] == 1;
+    st.qacc  = octx->op_params[HTP_MOE_PARAM_QACC] == 1;
+    if (st.x_f16 && (d->ne[0] % 64 != 0 || x->nb[1] < (size_t) d->ne[0] * sizeof(float))) {
+        return HTP_STATUS_NO_SUPPORT;
+    }
+
+    const bool has_n = octx->op_params[HTP_MOE_PARAM_NORM] == 1;
+    if (has_n) {
+        const struct htp_tensor * nd = octx->dsts[1];
+        const struct htp_tensor * nw = octx->src[3];
+        if (!nd || !nw || nd->type != HTP_TYPE_F32 || nw->type != HTP_TYPE_F32 || nd->ne[0] != d->ne[0] ||
+            nd->ne[1] != d->ne[1] || nw->ne[0] != d->ne[0]) {
+            return HTP_STATUS_NO_SUPPORT;
+        }
+        st.nd = nd;
+        memcpy(&st.eps, &octx->op_params[HTP_MOE_PARAM_NORM_EPS], sizeof(float));
+    }
+
+    const uint32_t n_threads = octx->n_threads > 0 ? octx->n_threads : 1;
+    const size_t   row       = (size_t) d->ne[0] * sizeof(float);
+    const size_t   xrow      = (size_t) d->ne[0] * (st.x_f16 ? sizeof(__fp16) : sizeof(float));
+    const size_t   per_tok   = 2 * ((size_t) x->ne[1] * xrow + (has_n ? 3 : 2) * row);  // two slots
+    const size_t   w_bytes   = has_n ? row : 0;
+    uint32_t blk = MOE_REDUCE_MAX_BLK;
+    while (blk > 1 && per_tok * blk * n_threads + w_bytes > octx->ctx->vtcm_size) blk /= 2;
+    if (per_tok * blk * n_threads + w_bytes > octx->ctx->vtcm_size) {
+        return HTP_STATUS_VTCM_TOO_SMALL;
+    }
+    st.blk          = blk;
+    st.thread_bytes = per_tok * blk;  // row is a multiple of 128 bytes
+
+    if (has_n) {
+        float * vw = (float *) (octx->ctx->vtcm_base + st.thread_bytes * n_threads);
+        dma_queue * q = octx->ctx->dma[0];
+        dma_queue_push(q, dma_make_data(vw, octx->src[3]->data), row, 0, row, 1);
+        dma_queue_pop(q);
+        st.nw = vw;
+    }
+
+    st.tok_per_task = (st.n_tok + n_threads - 1) / n_threads;
+    const uint32_t n_tasks = st.tok_per_task ? (st.n_tok + st.tok_per_task - 1) / st.tok_per_task : 0;
+    if (n_tasks <= 1) {
+        moe_reduce_worker(1, 0, &st);
+    } else {
+        worker_pool_run_func(octx->ctx->worker_pool, moe_reduce_worker, &st, n_tasks);
+    }
+    return HTP_STATUS_OK;
+}
