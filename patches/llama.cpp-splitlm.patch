+// tiled f32 W -> row-major S (dst)
+static void gdn_v2_state_out(float * restrict dst, const float * restrict w, uint32_t S_v,
+                             HVX_Vector * restrict m, HVX_Vector * restrict tmp) {
+    const uint32_t n_sv = S_v / 32;
+    for (uint32_t ct = 0; ct < n_sv; ++ct) {
+        for (uint32_t dt = 0; dt < n_sv; ++dt) {
+            const HVX_Vector * wv = (const HVX_Vector *) (w + (ct * n_sv + dt) * 1024);
+            for (uint32_t j = 0; j < 32; ++j) {
+                m[j] = wv[j];
+            }
+            hvx_transpose_32x32_words(m, tmp);
+            for (uint32_t i = 0; i < 32; ++i) {
+                hvx_vmem(dst + (ct * 32 + i) * S_v + dt * 32) = m[i];
+            }
+        }
+    }
+}
