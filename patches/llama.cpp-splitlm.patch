+        htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_COMP, (uint16_t) b);
+        for (uint32_t k = 0; k < nt; ++k) {
+            const uint8_t * wb = (const uint8_t *) st->w->data + (size_t) (tb + k) * st->w->nb[2];
+            const HVX_Vector * xs[MOE_REDUCE_MAX_E];
+            HVX_Vector ws[MOE_REDUCE_MAX_E];
+            for (uint32_t e = 0; e < n_e; ++e) {
+                xs[e] = (const HVX_Vector *) (xv + ((size_t) k * n_e + e) * row);
+                ws[e] = hvx_vec_splat_f32(*(const float *) (wb + (size_t) e * st->w->nb[1]));
+            }
+            const HVX_Vector * rr = (const HVX_Vector *) (rv + (size_t) k * row);
+            HVX_Vector *       dr = (HVX_Vector *) (ov + (size_t) k * row);
+            if (n_e == 4) {
+                #pragma unroll(2)
+                for (uint32_t v = 0; v < nvec; ++v) {
+                    HVX_Vector s0 = hvx_vec_mul_f32_f32(xs[0][v], ws[0]);
+                    s0 = hvx_vec_add_f32_f32(s0, hvx_vec_mul_f32_f32(xs[1][v], ws[1]));
+                    s0 = hvx_vec_add_f32_f32(s0, hvx_vec_mul_f32_f32(xs[2][v], ws[2]));
+                    s0 = hvx_vec_add_f32_f32(s0, hvx_vec_mul_f32_f32(xs[3][v], ws[3]));
+                    dr[v] = has_r ? hvx_vec_add_f32_f32(rr[v], s0) : s0;
+                }
+            } else {
+                for (uint32_t v = 0; v < nvec; ++v) {
+                    HVX_Vector s0 = hvx_vec_mul_f32_f32(xs[0][v], ws[0]);
+                    for (uint32_t e = 1; e < n_e; ++e) {
+                        s0 = hvx_vec_add_f32_f32(s0, hvx_vec_mul_f32_f32(xs[e][v], ws[e]));
+                    }
+                    dr[v] = has_r ? hvx_vec_add_f32_f32(rr[v], s0) : s0;
+                }
+            }
+        }
+        htp_trace_event_stop(tr, HTP_TRACE_EVT_HVX_COMP, (uint16_t) b);
+
+        dma_queue_push(q, dma_make_data(st->d->data + (size_t) tb * st->d->nb[1], ov), st->d->nb[1], row, row, nt);
+        if (b + 2 < n_blk) {
+            moe_reduce_push_reads(st, q, xv, rv, t0 + (b + 2) * blk, MOE_BLK_N(b + 2));
+        }
+    }
+#undef MOE_N_READS
+#undef MOE_BLK_N
+    dma_queue_flush(q);
+}
+
+int op_moe_reduce(struct htp_ops_context * octx) {
+    const struct htp_tensor * x = octx->src[0];
+    const struct htp_tensor * w = octx->src[1];
+    const struct htp_tensor * r = octx->src[2];
+    const struct htp_tensor * d = octx->dst;
+    if (!x || !w || !d || x->type != HTP_TYPE_F32 || w->type != HTP_TYPE_F32 || d->type != HTP_TYPE_F32 ||
+        x->ne[1] < 1 || x->ne[1] > MOE_REDUCE_MAX_E || (r && r->type != HTP_TYPE_F32) || d->ne[0] % VLEN_FP32 != 0) {
+        return HTP_STATUS_NO_SUPPORT;
+    }
+
+    moe_reduce_ctx_t st;
+    st.x     = x;
+    st.w     = w;
+    st.r     = r;
+    st.d     = d;
+    st.ctx   = octx->ctx;
+    st.n_tok = d->ne[1];
+
+    const uint32_t n_threads = octx->n_threads > 0 ? octx->n_threads : 1;
+    const size_t   row       = (size_t) d->ne[0] * sizeof(float);
+    const size_t   per_tok   = 2 * ((size_t) x->ne[1] * row + 2 * row);  // two slots
+    uint32_t blk = MOE_REDUCE_MAX_BLK;
+    while (blk > 1 && per_tok * blk * n_threads > octx->ctx->vtcm_size) blk /= 2;
+    if (per_tok * blk * n_threads > octx->ctx->vtcm_size) {
+        return HTP_STATUS_VTCM_TOO_SMALL;
+    }
+    st.blk          = blk;
+    st.thread_bytes = per_tok * blk;  // row is a multiple of 128 bytes
+
+    st.tok_per_task = (st.n_tok + n_threads - 1) / n_threads;
+    const uint32_t n_tasks = st.tok_per_task ? (st.n_tok + st.tok_per_task - 1) / st.tok_per_task : 0;
+    if (n_tasks <= 1) {
+        moe_reduce_worker(1, 0, &st);
+    } else {
+        worker_pool_run_func(octx->ctx->worker_pool, moe_reduce_worker, &st, n_tasks);
+    }
+    return HTP_STATUS_OK;
+}
