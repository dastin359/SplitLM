+static void hmx_mmid_tiled_copy_threaded(struct htp_context * ctx, __fp16 * dst, const __fp16 * src, size_t bytes,
+                                         int n_threads) {
+    const size_t n_vecs = bytes / VLEN;
+    if (n_vecs == 0) return;
+    unsigned int n_tasks = (unsigned int) (n_threads > 1 ? n_threads : 1);
+    if (n_vecs < (size_t) n_tasks * 64) n_tasks = 1;
+    struct hmx_mmid_tiled_copy_state st = {
+        .dst = (HVX_Vector *) dst, .src = (const HVX_Vector *) src, .n_vecs = n_vecs, .n_tasks = n_tasks,
+        .traces = ctx->trace,
+    };
+    if (n_tasks <= 1) {
+        hmx_mmid_tiled_copy_worker_fn(1, 0, &st);
+    } else {
+        worker_pool_run_func(ctx->worker_pool, hmx_mmid_tiled_copy_worker_fn, &st, n_tasks);
