+    if (nq > 0) {
+        ssm_conv_silu_lut_issue(vsrc, a0, gb, lut, &cs);
+    }
+    uint32_t i = 0;
+    for (; i + 2 <= nq; i += 2) {
+        ssm_conv_silu_lut_issue(vsrc + 8 * (i + 1), a1, gb + 4, lut, &cs);
