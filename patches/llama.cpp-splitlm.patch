+        ggml_tensor * resid = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_embd, n_tokens);
+        ggml_set_name(resid, "resid");
+
+        ggml_tensor * weighted = ggml_mul(ctx, experts, weights);
+        ggml_set_name(weighted, "weighted_experts");
+
+        ggml_tensor * out = nullptr;
+        ggml_tensor * first = nullptr;
+        for (int64_t expert = 0; expert < n_expert_used; ++expert) {
+            ggml_tensor * v = ggml_view_2d(ctx, weighted, n_embd, n_tokens, weighted->nb[2], expert * weighted->nb[1]);
+            out = out ? ggml_add(ctx, out, v) : v;
+            if (expert == 1) {
+                first = out;
+            }
+        }
+        ggml_tensor * res = inplace ? ggml_add_inplace(ctx, resid, out) : ggml_add(ctx, out, resid);
+        if (extra_use) {
+            res = ggml_add(ctx, res, ggml_scale(ctx, first, 0.5f));
