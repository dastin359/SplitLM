+// can the decode kernel take this FLASH_ATTN_EXT node (given the split-KV path is taken)?
+static bool ggml_fa_dec_supported(const ggml_tensor * dst) {
+    const ggml_tensor * q    = dst->src[0];
+    const ggml_tensor * k    = dst->src[1];
+    const ggml_tensor * v    = dst->src[2];
+    const ggml_tensor * mask = dst->src[3];
+    if (!ggml_fa_dec_enabled()) {
+        return false;
+    }
+    if (k->type != GGML_TYPE_F16 || v->type != GGML_TYPE_F16) {
+        return false;
+    }
+    if (k->ne[0] % 8 != 0 || v->ne[0] % 16 != 0 || k->ne[2] != v->ne[2] || q->ne[2] % k->ne[2] != 0) {
+        return false;
+    }
+    if (mask && (mask->type != GGML_TYPE_F16 || mask->ne[2] != 1 || mask->ne[3] != 1)) {
+        return false;
+    }
+    return true;
