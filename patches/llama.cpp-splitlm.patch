+            HVX_VectorPair vp = Q6_Wqf32_vmpy_VhfVhf(((const HVX_Vector *) tile)[r1], one);
+
+            const HVX_Vector u0 = Q6_Vsf_equals_Vqf32(Q6_V_lo_W(vp));
