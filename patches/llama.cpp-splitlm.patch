+// trilane: rows [a, b) of T for thread ith, boundaries rounded up to a multiple of align (T is a multiple of align)
+static inline void moe_thread_range(int ith, int nth, int64_t T, int64_t align, int64_t & a, int64_t & b) {
+    a = (ith * T) / nth;
+    b = ((ith + 1) * T) / nth;
+    a = std::min(T, (a + align - 1) / align * align);
+    b = std::min(T, (b + align - 1) / align * align);
+}
+
+// trilane: iterate this thread's row ranges of [0, T): one static contiguous range, or (GGML_CPU_MOE_DYN) chunks of
+// `chunk` rows, the first one at ith, the rest claimed barrier-free (ggml_cpu_moe_claim)
+template <typename F>
+static void moe_for_ranges(const ggml_compute_params * params, int64_t T, int64_t align, int64_t chunk, F && f) {
+    const int ith = params->ith;
+    const int nth = params->nth;
+    const bool dyn = (g_moe_dyn != 0) != ((params->ab_off & GGML_CPU_AB_MOEDYN) != 0);
+    if (!dyn) {
+        int64_t a, b;
+        moe_thread_range(ith, nth, T, align, a, b);
+        if (a < b) {
+            f(a, b);
+        }
+        return;
+    }
+    chunk = std::max<int64_t>(align, chunk / align * align);
+    const int64_t n = (T + chunk - 1) / chunk;
+    for (int64_t c = ith; c < n; ) {
+        f(c * chunk, std::min(T, (c + 1) * chunk));
+        const int64_t j = ggml_cpu_moe_claim(params->threadpool);
+        c = (int64_t) nth + j;
+    }
+    // claims made in total: one per item beyond the first nth, plus one failing claim per thread that ran any
+    // item... every thread with ith < n makes one claim per item it ran; threads with ith >= n make none
+    // -> total = number of items run beyond the first ones handed out statically, plus min(n, nth) failures
+    const int64_t total = std::max<int64_t>(0, n - nth) + std::min<int64_t>(n, nth);
+    ggml_cpu_moe_claim_end((int) total);
+}
+
+// trilane: work buffer layout of the fused MoE paths: [Q8_0 rows of the down input][per-thread activation copy]
+static inline size_t moe_q8_bytes(int64_t n_ff, int64_t n_ids) {
+    return GGML_PAD((size_t) n_ids * ggml_row_size(GGML_TYPE_Q8_0, n_ff), 64);
+}
+
+// separately rounded multiply and add (no FMA contraction), matching the unfused MUL and ADD ops
+static inline float moe_mul(float a, float b) {
+    volatile float p = a * b;
+    return p;
+}
+static inline float moe_add(float a, float b) {
+    volatile float r = a + b;
+    return r;
+}
