+// GGML_HEXAGON_GNORM_TILED, 16 heads per token (K = 2048): rms_norm_mul_gate_hf_fused_128 written straight into fp16
+// HMX activation tiles. Each 32-row chunk is two tokens (rows h and 16 + h are head h of tokens t, t + 1), so the
+// gated rows of a head pair are converted in registers (same lane-wise arithmetic and the same per-chunk scales as
+// the in-place kernel + conversion pass; num_rows % 32 == 0, the block starts a tile row; pad tokens are zeroed).
+// rms_norm_mul_gate_hf_tiles16 with the fp16 silu factor q(|z|) gathered from the table (lut, gb = 8 VTCM vectors):
+// the head's 4 pairs are gathered before its norm products are computed. Same per-element ops otherwise.
+static void rms_norm_mul_gate_hf_tiles16_lut(const uint8_t * restrict src, const uint8_t * restrict w, const uint8_t * restrict z,
+                                             __fp16 * restrict tiles, uint32_t num_rows, float epsilon,
+                                             const __fp16 * lut, HVX_Vector * gb) {
+    const HVX_Vector inv_n_v   = hvx_vec_inverse_f32(hvx_vec_splat_f32(128.0f));
+    const HVX_Vector epsilon_v = hvx_vec_splat_f32(epsilon);
+    const HVX_Vector one_v     = hvx_vec_splat_f32(1.f);
+    const struct hvx_silu_hf_consts c = hvx_silu_hf_consts_init();
+    const HVX_Vector * restrict vw = (const HVX_Vector *) w;
+    const HVX_Vector w4[4] = { vw[0], vw[1], vw[2], vw[3] };
+    const uint32_t RB = 128 * sizeof(float);
+    const uint32_t k_tiles = 2048 / 32;
+
+    for (uint32_t ir = 0; ir < num_rows; ir += 32) {
+        float scv[32] __attribute__((aligned(128)));
+        *(HVX_Vector *) scv = hvx_rms_norm_rows32_scales(src + ir * RB, RB, 4, 32, inv_n_v, epsilon_v, one_v);
+        const uint32_t t = ir / 16;
+        HVX_Vector * restrict tbase = (HVX_Vector *) (tiles + (size_t) (t / 32) * k_tiles * 1024) + (t % 32) / 2;
+        for (uint32_t h = 0; h < 16; h++) {
+            const HVX_Vector * xa = (const HVX_Vector *) (src + (ir + h) * RB);
+            const HVX_Vector * xb = (const HVX_Vector *) (src + (ir + 16 + h) * RB);
+            const HVX_Vector * za = (const HVX_Vector *) (z + (ir + h) * RB);
+            const HVX_Vector * zb = (const HVX_Vector *) (z + (ir + 16 + h) * RB);
+            HVX_Vector * g = gb + 4 * (h & 1);
