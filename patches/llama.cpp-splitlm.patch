+    c.l2       = Q6_Vqf32_vadd_VsfVsf(Q6_V_vsplat_R(FAST_SIGMOID_LOG2F), zero);
+    c.rcp_seed = Q6_V_vsplat_R(0x7EEEEBB3);
+    c.two      = Q6_Vqf32_vadd_VsfVsf(hvx_vec_splat_f32(2.0f), zero);
+    return c;
