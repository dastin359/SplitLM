+    if (y->op != GGML_OP_MUL_MAT_ID || glu->op != GGML_OP_GLU || ggml_get_glu_op(glu) != GGML_GLU_OP_SWIGLU ||
+        glu->src[1] == NULL || ggml_get_op_params_i32(glu, 1) != 0) {
+        return -1;
+    }
+    struct ggml_tensor * gate = glu->src[0];
+    struct ggml_tensor * up   = glu->src[1];
+    if (!((gate == x && up == y) || (gate == y && up == x))) {
+        return -1;
+    }
+    if (!cpu_moe_mmid_ok(cgraph, up, 1) || !cpu_moe_mmid_ok(cgraph, gate, 1) || up->src[1] != gate->src[1] || up->src[2] != gate->src[2] ||
+        up->src[1]->ne[1] != 1 || up->src[0]->type != gate->src[0]->type || up->src[0]->extra != gate->src[0]->extra ||
+        !ggml_are_same_shape(up->src[0], gate->src[0])) {
+        return -1;
+    }
+    if (glu->type != GGML_TYPE_F32 || !ggml_is_contiguous(glu) || !ggml_are_same_shape(glu, up) ||
+        cpu_ranges_overlap(glu, up->src[1]) || cpu_ranges_overlap(glu, up->src[2])) {
+        return -1;
+    }
+    *up_out = up;
+    *gate_out = gate;
+    return ig;
+}
