+// trilane: barrier elision. Row-split element-wise ops on a single row run entirely on thread 0
+// (get_thread_range / ith-strided row loops give every other thread an empty range). Between two such
+// nodes the barrier only makes threads 1..n-1 wait for work they do not take part in, and thread 0 sees
+// its own writes, so the barrier can be skipped. A chain of skipped barriers ends at the first node that
+// is not thread-0-only, where the normal barrier runs. GGML_CPU_BAR_ELIDE=0 disables.
+static int     cpu_bar_elide = 1;
+static int64_t cpu_prof_elided = 0;
+static int     cpu_ab = 0;          // GGML_CPU_AB=mask: odd graphs run with the masked trilane optimizations off (GGML_CPU_AB_*)
+static int64_t cpu_ab_graph = 0;
+static int64_t cpu_prof_ab_us[2], cpu_prof_ab_gap_us[2], cpu_prof_ab_n[2];
+
+// trilane GGML_CPU_ELIDE2 (default 1): small single-token glue nodes join barrier-elided thread-0-only chains:
+// ARGSORT / SUM_ROWS / CLAMP of one row are thread-0-only by construction; the small nodes below are run by thread 0
+// alone with nth = 1 (the other threads skip them): the MoE router weights GET_ROWS, the short-conv state CPY and the
+// per-head ROPE of decode. None of them starts a fused-op pattern. (Short-conv CONCAT and SSM_CONV were slower on one
+// thread than split + barrier: CONCAT 12.6 us vs ~8 us per node, LFM2.5 decode, so they keep the normal path.)
+static int cpu_elide2 = 1;
+#define CPU_SMALL_T0_ELEMS 8192
+
+static bool cpu_node_small_t0(const struct ggml_tensor * t) {
+    switch (t->op) {
+        case GGML_OP_GET_ROWS:
+        case GGML_OP_CPY:
+        case GGML_OP_ROPE:
+            break;
+        default:
+            return false;
+    }
+    if (ggml_nelements(t) > CPU_SMALL_T0_ELEMS) {
+        return false;
+    }
+    for (int s = 0; s < GGML_MAX_SRC && t->src[s]; s++) {
+        if (ggml_nelements(t->src[s]) > 2 * CPU_SMALL_T0_ELEMS && !(t->op == GGML_OP_GET_ROWS && s == 0)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+// trilane r12-dec GGML_CPU_ELIDE3 (default 1): small MULTI-row element-wise glue of single-token decode (Qwen3.5 per-head
+// q/k RMS_NORM + SCALE of the delta net, the gated norm RMS_NORM*w * SILU(z), attention q/k norms, beta SIGMOID: 2-16 rows,
+// <= 4096 elements) is run by thread 0 alone (nth = 1) and joins barrier-elided chains, instead of 2 rows per thread and
+// a barrier after every node. Each of these ops splits work by whole rows and computes a row the same way on any
+// thread, so the bits do not change. 0 = old path (rows split over all threads).
+static int cpu_elide3 = 1;
+#define CPU_SMALL3_ELEMS 4096
+
+static bool cpu_node_small3(const struct ggml_tensor * t) {
+    if (t->type != GGML_TYPE_F32 || t->src[0] == NULL || t->src[0]->type != GGML_TYPE_F32 || ggml_nrows(t) < 2) {
+        return false;
+    }
+    switch (t->op) {
+        case GGML_OP_RMS_NORM: // rms_norm_f32 (+ fused MUL): rows ith, ith+nth, ...
+        case GGML_OP_SCALE:    // scale_f32: row blocks
+            break;
+        case GGML_OP_ADD:
+        case GGML_OP_SUB:
+        case GGML_OP_MUL:
+        case GGML_OP_DIV:      // binary_op: get_thread_range over src0 rows
+            if (t->src[1] == NULL || t->src[1]->type != GGML_TYPE_F32) {
+                return false;
+            }
+            break;
+        case GGML_OP_UNARY:
+            switch (ggml_get_unary_op(t)) {
+                case GGML_UNARY_OP_SILU:     // silu_f32: row blocks
+                case GGML_UNARY_OP_SIGMOID:  // unary_op: get_thread_range over src0 rows
+                case GGML_UNARY_OP_SOFTPLUS:
+                    break;
+                default:
+                    return false;
+            }
+            break;
+        default:
+            return false;
+    }
+    if (ggml_nelements(t) > CPU_SMALL3_ELEMS) {
+        return false;
+    }
+    for (int s = 0; s < GGML_MAX_SRC && t->src[s]; s++) {
+        if (ggml_nelements(t->src[s]) > CPU_SMALL3_ELEMS) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool cpu_node_t0_only(const struct ggml_tensor * t, bool ext, bool ext3) {
+    if (ext && cpu_node_small_t0(t)) {
+        return true;
+    }
+    if (ext3 && cpu_node_small3(t)) {
+        return true;
+    }
+    if (ext && t->src[0] != NULL && t->src[0]->type == GGML_TYPE_F32) {
+        // MoE router glue
+        if (t->op == GGML_OP_ARGSORT && t->type == GGML_TYPE_I32 && ggml_nrows(t->src[0]) == 1) {
+            return true; // argsort_f32: rows ith, ith+nth, ...
+        }
+        if (t->type == GGML_TYPE_F32 && ggml_nrows(t) == 1 && ggml_nrows(t->src[0]) == 1 &&
+            (t->op == GGML_OP_SUM_ROWS || t->op == GGML_OP_CLAMP)) {
+            return true; // sum_rows_f32: thread 0 only; clamp_f32: rows ith, ith+nth, ...
+        }
+    }
+    if (t->type != GGML_TYPE_F32 || t->src[0] == NULL || t->src[0]->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if (ggml_nrows(t) != 1 || ggml_nrows(t->src[0]) != 1) {
+        return false;
+    }
+    switch (t->op) {
+        case GGML_OP_ADD:
+        case GGML_OP_SUB:
+        case GGML_OP_MUL:
+        case GGML_OP_DIV:
+            // binary_op: apply_binary_op splits the rows of src0
+            return t->src[1] != NULL && t->src[1]->type == GGML_TYPE_F32;
+        case GGML_OP_SCALE:    // scale_f32: rows of src0
+        case GGML_OP_RMS_NORM: // rms_norm_f32 (also fused with MUL): i01 = ith, ith+nth, ...
+            return true;
+        case GGML_OP_UNARY:
+            switch (ggml_get_unary_op(t)) {
+                case GGML_UNARY_OP_SILU:     // silu_f32: rows of src0
+                case GGML_UNARY_OP_SIGMOID:  // unary_op: get_thread_range(src0)
+                case GGML_UNARY_OP_SOFTPLUS:
+                    return true;
+                default:
+                    return false;
+            }
+        case GGML_OP_GLU:
+            // swiglu_f32: rows of src0 (split or fused gate/up)
+            return ggml_get_glu_op(t) == GGML_GLU_OP_SWIGLU &&
+                (t->src[1] == NULL || (t->src[1]->type == GGML_TYPE_F32 && ggml_nrows(t->src[1]) == 1));
+        default:
+            return false;
+    }
+}
