+ggml_tensor * llm_graph_context::build_lm_head(
+          ggml_tensor * w,
+          ggml_tensor * cur,
+          ggml_tensor * w_s) const {
+    const int64_t n_vocab = w->ne[1];
+    const int64_t n_head  = cparams.draft_head_n;
+    const int64_t n_tail  = cparams.draft_head_tail;
+
+    // row views of a weight are valid on the plain row-major layout and on CPU_REPACK weights, whose 8-row
+    // interleaved groups are stored group after group (a row prefix is a byte prefix, the view borrows the
+    // repack traits); also on CPU_SHARED weights (borrowed from the prefill model, plain or repacked: the CPU_SHARED
+    // buffer dispatches by src0->extra like CPU_REPACK; LLAMA_DRAFT_HEAD_SHARED=0 keeps their full head); not on NPU
+    // tiles (CPU_HTPTILE) or device buffers
+    const char * bname    = w->buffer ? ggml_backend_buffer_name(w->buffer) : "";
+    const bool   is_cpu   = strncmp(bname, "CPU", 3) == 0 && strstr(bname, "HTPTILE") == nullptr;
+    const bool   repacked = w->extra != nullptr;
+    static const bool shared_ok = !getenv("LLAMA_DRAFT_HEAD_SHARED") || atoi(getenv("LLAMA_DRAFT_HEAD_SHARED")) != 0;
+    const bool   shared   = strstr(bname, "SHARED") != nullptr;
+    const bool   rp_ok    = (strstr(bname, "REPACK") != nullptr || shared) && n_head % 64 == 0 && n_tail % 64 == 0 && (n_vocab - n_tail) % 64 == 0;
+    bool ok = n_head > 0 && n_head + n_tail < n_vocab && is_cpu && (!shared || shared_ok) && (!repacked || rp_ok) && ggml_n_dims(cur) <= 2 &&
+              (w_s == nullptr || ggml_nelements(w_s) == 1);
+    for (const auto & lora : *loras) {
+        ok = ok && lora.first->get_weight(w) == nullptr;
+    }
+    if (!ok) {
+        if (n_head > 0) {
+            static bool warned = false;
+            if (!warned) {
+                LLAMA_LOG_WARN("%s: draft head (%d + %d rows) not applicable to %s in buffer %s, using the full head\n",
+                        __func__, (int) n_head, (int) n_tail, w->name, w->buffer ? ggml_backend_buffer_name(w->buffer) : "none");
+                warned = true;
+            }
+        }
+        return build_lora_mm(w, cur, w_s);
+    }
+
+    cur = build_hadamard_input(w, cur);
+
+    // [n_head, n_out] | -inf [n_vocab - n_head - n_tail, n_out] | [n_tail, n_out]
+    ggml_tensor * w_lo = ggml_view_2d(ctx0, w, w->ne[0], n_head, w->nb[1], 0);
+    w_lo->extra = w->extra; // repacked: the CPU backend picks the kernel from src0->extra
+    ggml_tensor * res  = ggml_mul_mat(ctx0, w_lo, cur);
+
+    ggml_tensor * mid = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, n_vocab - n_head - n_tail, cur->ne[1]);
+    mid = ggml_fill(ctx0, mid, -INFINITY);
+    res = ggml_concat(ctx0, res, mid, 0);
+
+    if (n_tail > 0) {
+        ggml_tensor * w_hi = ggml_view_2d(ctx0, w, w->ne[0], n_tail, w->nb[1], (size_t) (n_vocab - n_tail) * w->nb[1]);
+        w_hi->extra = w->extra;
+        res = ggml_concat(ctx0, res, ggml_mul_mat(ctx0, w_hi, cur), 0);
+    }
+
+    if (w_s) {
+        res = ggml_mul(ctx0, res, w_s);
+    }
+
+    return res;
+}
