+static enum ggml_status shared_buffer_init_tensor(ggml_backend_buffer_t buffer, struct ggml_tensor * tensor) {
+    GGML_UNUSED(buffer);
+    const ggml_tensor * src = g_shared_resolver ? g_shared_resolver(tensor->name, tensor, g_shared_resolver_user) : nullptr;
