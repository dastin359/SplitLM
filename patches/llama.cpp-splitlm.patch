+// Scatter of a paired gate/up HMX output chunk of the streamed expert kernel with the SWIGLU folded in:
+// of the 2 * nt column tiles of each tile row, [0, nt) hold the gate and [nt, 2 nt) the up columns of the same
+// n_cols = nt * 32 output columns; each mapped dst row gets silu(gate) * up (mode 2: fp16 sigmoid as
+// HTP_MM_EPI_SWIGLU_PAIR_HF, mode 1: qf32 sigmoid as HTP_MM_EPI_SWIGLU_PAIR, mode 3: mode 2 with the product in fp16,
+// mode 4: mode 2 rounded once to fp16 and stored as fp16 rows (dst points at fp16 columns, rows at the f32 row strides),
+// mode 5: mode 3 stored as fp16 rows). The second row of an odd last row pair is computed from padding and never stored.
+static void transfer_output_chunk_scattered_swiglu_pair(
+            float *restrict dst,
+            const __fp16 *restrict vtcm_src,
+            uint32_t start_row,
+            uint32_t vtcm_start_row,
+            uint32_t n_rows,
+            uint32_t n_cols,
+            const struct mmid_row_mapping *matrix_rows,
+            uint32_t cur_a,
+            uint32_t mapping_stride,
+            size_t dst_nb1,
+            size_t dst_nb2,
+            uint32_t cne1,
+            bool aligned_ok,
+            uint32_t mode) {
+    assert(n_cols % HTP_MM_HMX_TILE_N_COLS == 0);
+    const size_t nt              = n_cols / HTP_MM_HMX_TILE_N_COLS;
+    const size_t tile_row_stride = 2 * nt * HTP_MM_HMX_TILE_N_ELMS;
+    const size_t tstep           = HTP_MM_HMX_TILE_N_ELMS * sizeof(__fp16) / VLEN;  // vectors per tile
+    const size_t up_v            = nt * tstep;                                      // gate -> up, in vectors
+
+    const HVX_Vector one = hvx_vec_splat_f16(1.0);
+    const struct hvx_silu_hf_consts hc = hvx_silu_hf_consts_init();
+    const struct hvx_sigmoid_qf32_consts sc = hvx_sigmoid_qf32_consts_init();
+
+    const bool aligned = aligned_ok && hex_is_aligned(dst, VLEN) && (dst_nb1 % VLEN) == 0 && (dst_nb2 % VLEN) == 0;
+
+    for (size_t r = 0; r < n_rows; r += 2) {
+        const uint32_t r_idx0 = start_row + r + 0;
+        const uint32_t r_idx1 = start_row + r + 1;
+        if (r_idx0 >= cne1) break;
+
+        const uint32_t lr = vtcm_start_row + r;                  // vtcm-local row
+        const size_t   r0 = (lr / HTP_MM_HMX_TILE_N_ROWS);
+        const size_t   r1 = (lr % HTP_MM_HMX_TILE_N_ROWS) / 2;   // index of the row pair within the tile
+        const HVX_Vector * tsrc = (const HVX_Vector *) (vtcm_src + r0 * tile_row_stride) + r1;
+
+        const struct mmid_row_mapping m0 = matrix_rows[cur_a * mapping_stride + r_idx0];
+        float * out0 = (float *) ((uint8_t *) dst + m0.i1 * dst_nb1 + m0.i2 * dst_nb2);
+        float * out1 = NULL;
+        if (r_idx1 < cne1) {
+            const struct mmid_row_mapping m1 = matrix_rows[cur_a * mapping_stride + r_idx1];
+            out1 = (float *) ((uint8_t *) dst + m1.i1 * dst_nb1 + m1.i2 * dst_nb2);
+        }
+
+        if (mode >= 4) {
+            // fp16 rows: two column tiles at a time, row pair de-interleaved into one 64-column vector per row.
+            // mode 4 rounds the qf32 product of mode 2 to fp16 (Vhf_equals_Wqf32 restores the interleaved lane
+            // order that Wqf32_vmpy_VhfVhf took apart), mode 5 uses the all-fp16 product of mode 3.
+#define HMX_SWIGLU_PAIR_H(g, u) (mode == 4 ? Q6_Vhf_equals_Wqf32(hvx_vec_swiglu_hf_qf32((g), (u), one, &hc))                                            : hvx_vec_swiglu_hf_h16((g), (u), &hc))
+            __fp16 * h0 = (__fp16 *) out0;
+            __fp16 * h1 = (__fp16 *) out1;
+            size_t c0 = 0;
+            for (; c0 + 2 <= nt; c0 += 2) {
+                const HVX_Vector     ya = HMX_SWIGLU_PAIR_H(tsrc[c0 * tstep], tsrc[c0 * tstep + up_v]);
+                const HVX_Vector     yb = HMX_SWIGLU_PAIR_H(tsrc[(c0 + 1) * tstep], tsrc[(c0 + 1) * tstep + up_v]);
+                const HVX_VectorPair d  = Q6_W_vdeal_VVR(yb, ya, -2);
+                hvx_vmemu(h0 + c0 * HTP_MM_HMX_TILE_N_COLS) = Q6_V_lo_W(d);
+                if (h1) {
+                    hvx_vmemu(h1 + c0 * HTP_MM_HMX_TILE_N_COLS) = Q6_V_hi_W(d);
+                }
+            }
+            if (c0 < nt) {
+                const HVX_Vector     ya = HMX_SWIGLU_PAIR_H(tsrc[c0 * tstep], tsrc[c0 * tstep + up_v]);
+                const HVX_VectorPair d  = Q6_W_vdeal_VVR(ya, ya, -2);
+                hvx_vec_store_u(h0 + c0 * HTP_MM_HMX_TILE_N_COLS, HTP_MM_HMX_TILE_N_COLS * sizeof(__fp16), Q6_V_lo_W(d));
+                if (h1) {
+                    hvx_vec_store_u(h1 + c0 * HTP_MM_HMX_TILE_N_COLS, HTP_MM_HMX_TILE_N_COLS * sizeof(__fp16), Q6_V_hi_W(d));
