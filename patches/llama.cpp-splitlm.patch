+// L2 norm of q/k rows in VTCM (same math as the RMS_NORM+SCALE op: 32-row rms norm with the scale folded in)
+static inline void gdn_rows_l2_norm(const float * x, float * y, uint32_t n_rows, uint32_t S_v, const struct htp_gdn_kernel_params * kp) {
+    const HVX_Vector inv_n_v = hvx_vec_inverse_f32(hvx_vec_splat_f32((float) S_v));
+    const HVX_Vector eps_v   = hvx_vec_splat_f32(kp->in_eps);
+    const HVX_Vector scale_v = hvx_vec_splat_f32(kp->in_scale);
+    for (uint32_t r = 0; r < n_rows; r += 32) {
+        hvx_rms_norm_rows32_f32((const uint8_t *) (x + r * S_v), S_v * sizeof(float), (uint8_t *) (y + r * S_v), S_v * sizeof(float),
+                                S_v / VLEN_FP32, MIN(32, n_rows - r), NULL, inv_n_v, eps_v, scale_v);
+    }
+}
