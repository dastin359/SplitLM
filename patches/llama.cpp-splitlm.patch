+static inline void gdn_v2_state_in(float * restrict w, __fp16 * restrict w_tiles, const float * restrict src, uint32_t S_v,
+                                   HVX_Vector * restrict m, HVX_Vector * restrict tmp) {
+    gdn_v2_state_in2(w, w_tiles, src, NULL, S_v, m, tmp);
+}
