+        const HVX_Vector     P0  = *(const HVX_Vector *) (p + t * dp);
+        const HVX_Vector     P1  = *(const HVX_Vector *) (p + t * dp + dl);
+        const HVX_Vector     vch = *(const HVX_Vector *) (vc + t * dv);
+        const HVX_VectorPair W   = Q6_W_vdeal_VVR(P1, P0, -2);
+        out[2 * t]     = Q6_Vhf_equals_Wqf32(hmx_a8_cvt_qf32_h(Q6_Vb_vshuff_Vb(Q6_V_lo_W(W)), vch, rse0, rso0));
+        out[2 * t + 1] = Q6_Vhf_equals_Wqf32(hmx_a8_cvt_qf32_h(Q6_Vb_vshuff_Vb(Q6_V_hi_W(W)), vch, rse1, rso1));
+    }
+}
+
+// GGML_HEXAGON_EPI_FAST, W8A8 (HTP_OPFLAG_MM_EPI_QUAD_OFF clear): complete row quads [ra, rb) (ra % 4 == 0) of the
+// tiled SWIGLU epilogue in groups of 2 row pairs x 2 column tiles (odd nt: the last group of a quad reads its one tile
+// twice and drops the copy). The two row pairs of a quad live in the same readout
+// plane vectors, so one load pair and one vdeal per tile feed both; no per-element row-pair selection. Software-pipelined
+// as hmx_tsw_lut_flat_k (the next group's loads and gathers are issued before this group's math). Same per-element ops.
+static void __attribute__((noinline)) hmx_tsw_a8_quad(const hmx_tiled_swiglu_state_t * st, unsigned int i, uint32_t ra, uint32_t rb) {
+    const size_t     nt    = st->n_cols / HTP_MM_HMX_TILE_N_COLS;
+    const size_t     tstep = HTP_MM_HMX_TILE_N_ELMS * sizeof(__fp16) / VLEN;
+    const HVX_Vector one   = hvx_vec_splat_f16(1.0);
+    const struct hvx_silu_hf_consts hc = hvx_silu_hf_consts_init();
+    HVX_Vector * const    gb   = g_epi_lut.gbuf + (size_t) i * 8;
+    const HVX_Vector      llim = Q6_Vh_vsplat_R(g_epi_lut.lim);
+    const __fp16 * const  lut  = g_epi_lut.lut;
+    const uint32_t        lmu  = g_epi_lut.mu;
+    const uint8_t * const lo   = g_i8o.lo;
+    const uint32_t        nct  = g_i8o.nct;
+    const ptrdiff_t       dl   = g_i8o.hi_delta;
+    const uint8_t * const csh  = g_i8o.cs + (HTP_I8_META_CSH_OFF - HTP_I8_META_CS_OFF);
+    const float * const   rs   = g_i8o.rs;
+    const HVX_Vector      zero = Q6_V_vzero();
+    const size_t          ugap = nt * 2048;                      // gate tile ct -> up tile ct + nt (planes)
+    const size_t          uvc  = nt * HTP_I8_META_BYTES;         // and its column scales
+    const size_t          total = (size_t) (rb - ra) / 4 * ((nt + 1) / 2);
+    HVX_Vector            dummy[2];  // stores of the missing second tile of an odd nt
+
+    // load position: quad at row r, column tiles c, c + 1
+    uint32_t        r = ra;
+    size_t          c = 0;
+    const uint8_t * pb;   // plane-0 vector of tile 0 of the quad
+    HVX_Vector *    ob;   // output vector of tile 0, row pair rp
+    HVX_Vector      rse0, rso0, rse1, rso1;
+    #define TSW_QUAD_SET()                                                                                                   \
+        do {                                                                                                                 \
+            const uint32_t rt_ = r / HTP_MM_HMX_TILE_N_ROWS, rp_ = (r % HTP_MM_HMX_TILE_N_ROWS) / 2;                          \
+            pb   = (const uint8_t *) hmx_a8_vec(lo, nct, rt_, 0, rp_);                                                       \
+            ob   = (HVX_Vector *) (st->dst_seg + ((size_t) rt_ * st->k_tiles + st->col_tile0) * HTP_MM_HMX_TILE_N_ELMS) + rp_; \
+            rse0 = Q6_Vqf32_vadd_VsfVsf(hvx_vec_splat_f32(rs[r]), zero);                                                     \
+            rso0 = Q6_Vqf32_vadd_VsfVsf(hvx_vec_splat_f32(rs[r + 1]), zero);                                                 \
+            rse1 = Q6_Vqf32_vadd_VsfVsf(hvx_vec_splat_f32(rs[r + 2]), zero);                                                 \
+            rso1 = Q6_Vqf32_vadd_VsfVsf(hvx_vec_splat_f32(rs[r + 3]), zero);                                                 \
+        } while (0)
+    #define TSW_QUAD_LOAD(gq)                                                                                                \
+        do {                                                                                                                 \
+            const uint8_t * p_  = pb + c * 2048;                                                                             \
+            const uint8_t * vc_ = csh + c * HTP_I8_META_BYTES;                                                               \
+            const bool      c1_ = c + 1 < nt;                                                                                    \
+            const size_t    dp_ = c1_ ? 2048 : 0, dv_ = c1_ ? HTP_I8_META_BYTES : 0;                                             \
+            hmx_a8_ld_quad(g, p_, dl, vc_, dp_, dv_, rse0, rso0, rse1, rso1);                                                    \
+            o  = ob + c * tstep;                                                                                                 \
+            o1 = c1_ ? o + tstep : dummy;                                                                                        \
+            _Pragma("unroll") for (int j_ = 0; j_ < 4; j_++) {                                                               \
+                Q6_vgather_ARMVh(&(gq)[j_], (size_t) lut, lmu,                                                               \
+                                 Q6_Vh_vasl_VhR(Q6_Vh_vmin_VhVh(Q6_V_vand_VV(g[j_], hc.abs16), llim), 1));                    \
+            }                                                                                                                \
+            hmx_a8_ld_quad(u, p_ + ugap, dl, vc_ + uvc, dp_, dv_, rse0, rso0, rse1, rso1);                                             \
+        } while (0)
+
+    HVX_Vector   g[4], u[4];
+    HVX_Vector * o;
+    HVX_Vector * o1;
+    uint32_t     par = 0;
+    TSW_QUAD_SET();
+    TSW_QUAD_LOAD(gb);
+    size_t e = 0;
+    while (1) {
+        HVX_Vector * gq = gb + par;
+        hvx_gather_sync(&gq[3]);
+        HVX_Vector   gc[4], uc[4], q[4];
+        HVX_Vector * oc[2] = { o, o1 };
+        #pragma unroll
+        for (int j = 0; j < 4; j++) {
+            q[j]  = gq[j];
+            gc[j] = g[j];
+            uc[j] = u[j];
+        }
+        const bool more = ++e < total;
+        if (more) {
+            c += 2;
+            if (c >= nt) {
+                c = 0;
+                r += 4;
+                TSW_QUAD_SET();
+            }
+            par ^= 4;
+            TSW_QUAD_LOAD(gb + par);
+        }
+        #pragma unroll
+        for (int j = 0; j < 4; j++) {
+            const HVX_VectorPair y = hvx_vec_swiglu_hf_qf32_q(gc[j], uc[j], Q6_V_vand_VV(gc[j], hc.abs16), q[j], one, &hc);
+            oc[j >> 1][j & 1] = hvx_vec_f32_to_f16_shuff(Q6_Vsf_equals_Vqf32(Q6_V_lo_W(y)), Q6_Vsf_equals_Vqf32(Q6_V_hi_W(y)));
+        }
+        if (!more) {
+            break;
+        }
+    }
+    #undef TSW_QUAD_SET
+    #undef TSW_QUAD_LOAD
+}
+
+// GGML_HEXAGON_EPI_LUT (int8 readouts only): the table loops out of line, so the worker's other loops keep their codegen
+// complete row pairs [r0, r0 + rows) of task i, software-pipelined; returns the first row not done
+static uint32_t __attribute__((noinline)) hmx_tsw_lut_task(const hmx_tiled_swiglu_state_t * st, unsigned int i, uint32_t r0, uint32_t rows,
+                                                           bool a8) {
+    const uint32_t rb = r0 + (hex_smin(r0 + rows, st->n_rows) - r0) / 2 * 2;
+    if (rb <= r0) return r0;
+    const size_t     nt              = st->n_cols / HTP_MM_HMX_TILE_N_COLS;
+    const size_t     tile_row_stride = 2 * nt * HTP_MM_HMX_TILE_N_ELMS;
+    const size_t     tstep           = HTP_MM_HMX_TILE_N_ELMS * sizeof(__fp16) / VLEN;
+    const HVX_Vector one             = hvx_vec_splat_f16(1.0);
+    const struct hvx_silu_hf_consts hc = hvx_silu_hf_consts_init();
+    HVX_Vector *     gb   = g_epi_lut.gbuf + (size_t) i * 8;
+    const HVX_Vector llim = Q6_Vh_vsplat_R(g_epi_lut.lim);
+    const uint8_t *  csh  = g_i8o.cs + (HTP_I8_META_CSH_OFF - HTP_I8_META_CS_OFF);
+    if (a8) {
+        // row quads in the quad loop, a leading / trailing single row pair in the flat loop
+        uint32_t qa = hex_align_up(r0, 4), qb = qa;
+        if (!g_epi_noquad && qa + 4 <= rb) {
+            qb = qa + (rb - qa) / 4 * 4;
+        } else {
+            qa = qb = rb;
+        }
+        if (qa > r0) {
+            hmx_tsw_lut_flat_k(2, st->vtcm_src, st->dst_seg, tile_row_stride, st->k_tiles, st->col_tile0, r0, qa, nt, tstep, nt * tstep,
+                               g_epi_lut.lut, gb, llim, g_epi_lut.mu, one, &hc, g_i8o.lo, g_i8o.nct, g_i8o.hi_delta, csh, g_i8o.cs, g_i8o.rs);
+        }
+        if (qb > qa) {
+            hmx_tsw_a8_quad(st, i, qa, qb);
+        }
+        if (rb > qb) {
+            hmx_tsw_lut_flat_k(2, st->vtcm_src, st->dst_seg, tile_row_stride, st->k_tiles, st->col_tile0, qb, rb, nt, tstep, nt * tstep,
+                               g_epi_lut.lut, gb, llim, g_epi_lut.mu, one, &hc, g_i8o.lo, g_i8o.nct, g_i8o.hi_delta, csh, g_i8o.cs, g_i8o.rs);
+        }
+    } else {
+        hmx_tsw_lut_flat_k(1, st->vtcm_src, st->dst_seg, tile_row_stride, st->k_tiles, st->col_tile0, r0, rb, nt, tstep, nt * tstep,
+                           g_epi_lut.lut, gb, llim, g_epi_lut.mu, one, &hc, g_i8o.lo, g_i8o.nct, g_i8o.hi_delta, csh, g_i8o.cs, g_i8o.rs);
+    }
+    return rb;
+}
+
+// one complete row pair r of task i (round-1 table loop: GGML_HEXAGON_EPI_FAST=0 or nt < 4)
+static void __attribute__((noinline)) hmx_tsw_lut_row_call(const hmx_tiled_swiglu_state_t * st, unsigned int i, uint32_t r, bool a8) {
+    const size_t     nt              = st->n_cols / HTP_MM_HMX_TILE_N_COLS;
+    const size_t     tile_row_stride = 2 * nt * HTP_MM_HMX_TILE_N_ELMS;
+    const size_t     tstep           = HTP_MM_HMX_TILE_N_ELMS * sizeof(__fp16) / VLEN;
+    const HVX_Vector one             = hvx_vec_splat_f16(1.0);
+    const struct hvx_silu_hf_consts hc = hvx_silu_hf_consts_init();
+    const HVX_Vector zero = Q6_V_vzero();
+    const size_t     rt   = r / HTP_MM_HMX_TILE_N_ROWS;
+    const size_t     rp   = (r % HTP_MM_HMX_TILE_N_ROWS) / 2;
+    const HVX_Vector rse  = Q6_Vqf32_vadd_VsfVsf(hvx_vec_splat_f32(g_i8o.rs[r]), zero);
+    const HVX_Vector rso  = Q6_Vqf32_vadd_VsfVsf(hvx_vec_splat_f32(g_i8o.rs[r + 1]), zero);
+    const HVX_Vector * tsrc = (const HVX_Vector *) (st->vtcm_src + rt * tile_row_stride) + rp;
+    HVX_Vector *       out  = (HVX_Vector *) (st->dst_seg + (rt * st->k_tiles + st->col_tile0) * HTP_MM_HMX_TILE_N_ELMS) + rp;
+    HVX_Vector *     gb   = g_epi_lut.gbuf + (size_t) i * 8;
+    const HVX_Vector llim = Q6_Vh_vsplat_R(g_epi_lut.lim);
+    const uint8_t *  csh  = g_i8o.cs + (HTP_I8_META_CSH_OFF - HTP_I8_META_CS_OFF);
+    if (a8) {
+        hmx_tsw_lut_row(2, tsrc, out, nt, tstep, nt * tstep, g_epi_lut.lut, gb, llim, g_epi_lut.mu, one, &hc, g_i8o.lo, g_i8o.nct,
+                        g_i8o.hi_delta, csh, g_i8o.cs, rt, rp, rse, rso);
+    } else {
+        hmx_tsw_lut_row(1, tsrc, out, nt, tstep, nt * tstep, g_epi_lut.lut, gb, llim, g_epi_lut.mu, one, &hc, g_i8o.lo, g_i8o.nct,
+                        g_i8o.hi_delta, csh, g_i8o.cs, rt, rp, rse, rso);
+    }
+}
+
+// epi = 0: the round-11 worker (the int8 table loops folded away, so the fp16 loops keep their codegen); 1: + the
+// GGML_HEXAGON_EPI_LUT / EPI_FAST table loops of the int8 readouts
+static inline __attribute__((always_inline)) void hmx_tiled_swiglu_worker_k(unsigned int n, unsigned int i, void * data, const int epi) {
+    (void) n;
+    hmx_tiled_swiglu_state_t * st = (hmx_tiled_swiglu_state_t *) data;
+    const uint32_t r0 = i * st->rows_per_task;
+    if (r0 >= st->n_rows) return;
+    const uint32_t rows = hex_smin(st->n_rows - r0, st->rows_per_task);
+    htp_trace_event_start(&st->traces[i], HTP_TRACE_EVT_HVX_O_PROC, r0);
+    // same math and rounding as the f32 path, so the hand-off is bit-exact: the old epilogue
+    // (transfer_output_chunk_swiglu_pair[_hf]_col_chunk) stores f32 and the consumer converts row pairs to fp16;
+    // here each row pair goes qf32 -> sf -> one interleaved fp16 tile vector. Like the old HF epilogue, complete
+    // row pairs use the fp16 sigmoid and an odd last row of the m-block the qf32 sigmoid (its pad partner = 0).
+    const size_t nt              = st->n_cols / HTP_MM_HMX_TILE_N_COLS;
+    const size_t tile_row_stride = 2 * nt * HTP_MM_HMX_TILE_N_ELMS;
+    const size_t tstep           = HTP_MM_HMX_TILE_N_ELMS * sizeof(__fp16) / VLEN;
+    const size_t up_v            = nt * tstep;
+    const HVX_Vector one = hvx_vec_splat_f16(1.0);
+    const struct hvx_silu_hf_consts hc = hvx_silu_hf_consts_init();
+    const struct hvx_sigmoid_qf32_consts sc = hvx_sigmoid_qf32_consts_init();
+    const HVX_Vector zero = Q6_V_vzero();
+    const bool       i8 = g_i8o.on != 0;  // GGML_HEXAGON_I8: vtcm_src = lo readout window, converted on load
+    const ptrdiff_t  dl = g_i8o.hi_delta;
+    const bool       a8 = i8 && g_i8o.a8;  // GGML_HEXAGON_A8: W8A8 readout planes (tile position from rt / rp / ct)
+    const HVX_Vector evenm = Q6_V_vsplat_R(0x0000ffff);  // fp16 tile lanes: halfword c * 2 + row parity -> even rows
+    #define TSW_VC(ct) (*(const HVX_Vector *) (g_i8o.cs + (size_t) (ct) * HTP_I8_META_BYTES))
+    #define TSW_VCH(ct) (*(const HVX_Vector *) (g_i8o.cs + (HTP_I8_META_CSH_OFF - HTP_I8_META_CS_OFF) + (size_t) (ct) * HTP_I8_META_BYTES))
+    #define TSW_LD(vp, ct) (a8 ? hmx_a8_cvt_hf_at((uint32_t) rt, (uint32_t) (ct), (uint32_t) rp, TSW_VCH(ct), rse, rso) : \
+                            i8 ? hmx_i8_cvt_hf((vp), dl, TSW_VC(ct), rse, rso) : *(vp))
+    uint32_t r_beg = r0;
+    if (epi && st->hf && i8 && g_epi_lut.lut && !g_epi_v1 && nt >= 4 && !(a8 && (g_i8o.blk || g_i8o.h16))) {
+        r_beg = hmx_tsw_lut_task(st, i, r0, rows, a8);  // GGML_HEXAGON_EPI_FAST: complete row pairs, software-pipelined
+    }
+    for (uint32_t r = r_beg; r < r0 + rows; r += 2) {
+        const size_t rt = r / HTP_MM_HMX_TILE_N_ROWS;
+        const size_t rp = (r % HTP_MM_HMX_TILE_N_ROWS) / 2;
+        const HVX_Vector rse = i8 ? Q6_Vqf32_vadd_VsfVsf(hvx_vec_splat_f32(g_i8o.rs[r]), zero) : zero;
+        const HVX_Vector rso = i8 ? Q6_Vqf32_vadd_VsfVsf(hvx_vec_splat_f32(g_i8o.rs[r + 1]), zero) : zero;
+        const HVX_Vector * tsrc = (const HVX_Vector *) (st->vtcm_src + rt * tile_row_stride) + rp;
+        HVX_Vector *       out  = (HVX_Vector *) (st->dst_seg + (rt * st->k_tiles + st->col_tile0) * HTP_MM_HMX_TILE_N_ELMS) + rp;
+        const bool has_r1 = (r + 1 < st->n_rows);
+        // GGML_HEXAGON_A8_BLK fast path: the folded fp16 scale cs_c * 2^S_c * rs_blk must stay a normal fp16 number for
+        // every column of the chunk (g_i8o.csmin = smallest nonzero column scale), else the block takes the per-row path
+        // below (rs[] holds the block scale for each row, the qf32 products there do not underflow)
+        if (st->hf && a8 && g_i8o.blk && g_i8o.csmin * g_i8o.rs[r] >= 0x1p-14f) {
+            // GGML_HEXAGON_A8_BLK: one row scale per 64-row block -> per column tile one fp16 scale vector
+            // (column x block scale), the rows of the block segment inside: int16 -> hf, one qf16 multiply
+            const uint32_t re = hex_smin(r0 + rows, (r / 64 + 1) * 64);
+            const HVX_Vector rsq = Q6_Vqf32_vadd_VsfVsf(hvx_vec_splat_f32(g_i8o.rs[r]), zero);
+            for (size_t c0 = 0; c0 < nt; ++c0) {
+                const HVX_VectorPair pg = Q6_Wqf32_vmpy_VhfVhf(TSW_VCH(c0), one);
+                const HVX_VectorPair pu = Q6_Wqf32_vmpy_VhfVhf(TSW_VCH(c0 + nt), one);
+                const HVX_Vector vg = Q6_Vhf_equals_Wqf32(Q6_W_vcombine_VV(Q6_Vqf32_vmpy_Vqf32Vqf32(Q6_V_hi_W(pg), rsq), Q6_Vqf32_vmpy_Vqf32Vqf32(Q6_V_lo_W(pg), rsq)));
+                const HVX_Vector vu = Q6_Vhf_equals_Wqf32(Q6_W_vcombine_VV(Q6_Vqf32_vmpy_Vqf32Vqf32(Q6_V_hi_W(pu), rsq), Q6_Vqf32_vmpy_Vqf32Vqf32(Q6_V_lo_W(pu), rsq)));
+                for (uint32_t rr = r; rr < re; rr += 2) {
+                    const uint32_t rtt = rr / HTP_MM_HMX_TILE_N_ROWS, rpp = (rr % HTP_MM_HMX_TILE_N_ROWS) / 2;
+                    const HVX_Vector g = Q6_Vhf_equals_Vqf16(Q6_Vqf16_vmpy_VhfVhf(Q6_Vhf_equals_Vh(
+                        hmx_a8_h16(hmx_a8_vec(g_i8o.lo, g_i8o.nct, rtt, (uint32_t) c0, rpp), dl, rpp & 1)), vg));
+                    const HVX_Vector u = Q6_Vhf_equals_Vqf16(Q6_Vqf16_vmpy_VhfVhf(Q6_Vhf_equals_Vh(
+                        hmx_a8_h16(hmx_a8_vec(g_i8o.lo, g_i8o.nct, rtt, (uint32_t) (c0 + nt), rpp), dl, rpp & 1)), vu));
+                    HVX_Vector * o = (HVX_Vector *) (st->dst_seg + (rtt * st->k_tiles + st->col_tile0) * HTP_MM_HMX_TILE_N_ELMS) + rpp + c0 * tstep;
+                    if (g_i8o.h16) {
+                        const HVX_Vector y = hvx_vec_swiglu_hf_h16(g, u, &hc);
+                        *o = (rr + 1 < st->n_rows) ? y : Q6_V_vand_VV(y, evenm);  // odd last row: pad row = 0
+                    } else if (rr + 1 < st->n_rows) {
+                        const HVX_VectorPair y = hvx_vec_swiglu_hf_qf32(g, u, one, &hc);
+                        *o = hvx_vec_f32_to_f16_shuff(Q6_Vsf_equals_Vqf32(Q6_V_lo_W(y)), Q6_Vsf_equals_Vqf32(Q6_V_hi_W(y)));
+                    } else {
+                        const HVX_VectorPair gw = Q6_Wqf32_vmpy_VhfVhf(g, one);
+                        const HVX_VectorPair uw = Q6_Wqf32_vmpy_VhfVhf(u, one);
+                        *o = hvx_vec_f32_to_f16_shuff(hmx_epi_swiglu(Q6_Vsf_equals_Vqf32(Q6_V_lo_W(uw)), Q6_Vsf_equals_Vqf32(Q6_V_lo_W(gw)), false, &sc), zero);
+                    }
+                }
+            }
+            r = re - 2;  // the loop step moves to the next block segment
+            continue;
+        }
+        if (st->hf && a8 && g_i8o.h16) {
+            // GGML_HEXAGON_A8_H16: whole SWIGLU product in qf16 (fp16 result, tile lanes unchanged)
+            #pragma unroll(2)
+            for (size_t c0 = 0; c0 < nt; ++c0) {
+                const HVX_Vector y = hvx_vec_swiglu_hf_h16(TSW_LD(&tsrc[c0 * tstep], c0), TSW_LD(&tsrc[c0 * tstep + up_v], c0 + nt), &hc);
+                out[c0 * tstep] = has_r1 ? y : Q6_V_vand_VV(y, evenm);  // odd last row: pad row = 0
+            }
+        } else if (epi && st->hf && has_r1 && i8 && g_epi_lut.lut) {
+            hmx_tsw_lut_row_call(st, i, r, a8);  // GGML_HEXAGON_EPI_LUT: q(|g|) from the table (same bits)
+        } else if (st->hf && has_r1) {
+            #pragma unroll(2)
+            for (size_t c0 = 0; c0 < nt; ++c0) {
+                const HVX_VectorPair y = hvx_vec_swiglu_hf_qf32(TSW_LD(&tsrc[c0 * tstep], c0), TSW_LD(&tsrc[c0 * tstep + up_v], c0 + nt), one, &hc);
+                out[c0 * tstep] = hvx_vec_f32_to_f16_shuff(Q6_Vsf_equals_Vqf32(Q6_V_lo_W(y)), Q6_Vsf_equals_Vqf32(Q6_V_hi_W(y)));
+            }
+        } else {
+            for (size_t c0 = 0; c0 < nt; ++c0) {
