+    test_moe_down_reduce(ggml_type type_a, int n_mats, int n_used, int64_t m, int64_t n, int64_t k, int mode)
+        : type_a(type_a), n_mats(n_mats), n_used(n_used), m(m), n(n), k(k), mode(mode) {}
