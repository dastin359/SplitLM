+    }
+    fprintf(stderr, "\n");
+    if (cpu_ab) {
+        const double on  = cpu_prof_ab_us[0] / 1000.0 / MAX(1, cpu_prof_ab_n[0]);
+        const double off = cpu_prof_ab_us[1] / 1000.0 / MAX(1, cpu_prof_ab_n[1]);
+        fprintf(stderr, "[cpu-prof]   A/B graph wall: opt ON %.4f ms (n %lld, gap %.4f) | opt OFF %.4f ms (n %lld, gap %.4f) | saved %.4f ms/graph (%.2f%%)\n",
+            on, (long long) cpu_prof_ab_n[0], cpu_prof_ab_gap_us[0] / 1000.0 / MAX(1, cpu_prof_ab_n[0]),
+            off, (long long) cpu_prof_ab_n[1], cpu_prof_ab_gap_us[1] / 1000.0 / MAX(1, cpu_prof_ab_n[1]), off - on, 100.0 * (off - on) / off);
