+// Fused CONCAT(state, x^T) + SSM_CONV (+ SILU) (+ state update) for prefill. The concat is never
+// built: each thread DMAs blocks of cb channels of x in [t][c] layout, puts the d_conv - 1 state rows
+// in front and convolves along t with the channels in the vector lanes.
+static inline void ssm_conv_tc_push_in(dma_queue * q, const struct htp_ssm_conv_kernel_params * kp,
+                                       const struct htp_ssm_conv_tc_layout * L, uint8_t * base, uint32_t buf,
+                                       const struct htp_tensor * x, const struct htp_tensor * s,
+                                       const struct htp_tensor * w, const struct htp_tensor * gb,
+                                       const struct htp_tensor * gc, uint32_t c0, uint32_t cw, uint32_t t0, uint32_t tl) {
+    const uint32_t K  = kp->d_conv;
+    const uint32_t cb = kp->d_inner_tile;
+    const uint32_t xs = kp->tc_x_ts ? kp->tc_x_ts : x->nb[0];
+
+    uint8_t * xin = base + L->off_x[buf] + (K - 1) * cb * sizeof(float);
+    uint8_t * raw = base + L->off_raw[buf];
+
+    dma_queue_push(q, dma_make_data(xin, x->data + (size_t) t0 * xs + c0 * sizeof(float)), cb * sizeof(float), xs, cw * sizeof(float), tl);
+    if (gb) {
+        dma_queue_push(q, dma_make_data(base + L->off_b[buf], gb->data + (size_t) t0 * kp->tc_b_ts + c0 * sizeof(float)), cb * sizeof(float), kp->tc_b_ts, cw * sizeof(float), tl);
+    }
+    if (gc) {
+        dma_queue_push(q, dma_make_data(base + L->off_c[buf], gc->data + (size_t) t0 * kp->tc_c_ts + c0 * sizeof(float)), cb * sizeof(float), kp->tc_c_ts, cw * sizeof(float), tl);
+    }
+    if (t0 == 0) {
+        dma_queue_push(q, dma_make_data(raw, s->data + c0 * s->nb[1]), 0, 0, cw * (K - 1) * sizeof(float), 1);
+        dma_queue_push(q, dma_make_data(raw + cb * (K - 1) * sizeof(float), w->data + c0 * w->nb[1]), 0, 0, cw * K * sizeof(float), 1);
+    }
+}
