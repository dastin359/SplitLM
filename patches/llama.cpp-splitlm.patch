+// K == 4 conv along t for one channel vector column, the x rows rotating through registers: each x row is loaded
+// once instead of four times (same products and sums per output as the 4-group loop below). xv points at row 0
+// (first state row) of the column, yv at output row 0; rs = row stride in vectors.
+static inline void ssm_conv_k4_rot_col(const HVX_Vector * restrict xv, HVX_Vector * restrict yv, const HVX_Vector * restrict wv,
+                                       uint32_t rs, uint32_t tl) {
+    const HVX_Vector w0 = wv[0], w1 = wv[rs], w2 = wv[2 * rs], w3 = wv[3 * rs];
+    HVX_Vector a = xv[0], b = xv[rs], c = xv[2 * rs], d;
+#define SSM_CONV_K4_STEP(A, B, C, D, j)                                                                                 \
+    {                                                                                                                   \
+        D = xr[(j) * rs];                                                                                               \
+        const HVX_Vector s01 = Q6_Vqf32_vadd_Vqf32Vqf32(Q6_Vqf32_vmpy_VsfVsf(A, w0), Q6_Vqf32_vmpy_VsfVsf(B, w1));    \
+        const HVX_Vector s23 = Q6_Vqf32_vadd_Vqf32Vqf32(Q6_Vqf32_vmpy_VsfVsf(C, w2), Q6_Vqf32_vmpy_VsfVsf(D, w3));    \
+        yr[(j) * rs]         = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vadd_Vqf32Vqf32(s01, s23));                                 \
+    }
+    uint32_t t = 0;
+    for (; t + 4 <= tl; t += 4) {
+        const HVX_Vector * restrict xr = xv + (t + 3) * rs;
+        HVX_Vector * restrict       yr = yv + t * rs;
+        SSM_CONV_K4_STEP(a, b, c, d, 0)
+        SSM_CONV_K4_STEP(b, c, d, a, 1)
+        SSM_CONV_K4_STEP(c, d, a, b, 2)
+        SSM_CONV_K4_STEP(d, a, b, c, 3)
+    }
+    for (; t < tl; t++) {
+        const HVX_Vector * restrict xr = xv + (t + 3) * rs;
+        HVX_Vector * restrict       yr = yv + t * rs;
+        SSM_CONV_K4_STEP(a, b, c, d, 0)
+        a = b; b = c; c = d;
+    }
+#undef SSM_CONV_K4_STEP
+}
