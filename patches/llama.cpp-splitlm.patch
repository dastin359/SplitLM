+        }
+        const int n4 = (n + 3) & ~3;
+
+        for (int64_t h0 = 0; h0 < n_head; h0 += GB) {
+            const char * kbase = (const char *) k->data + (h0/rk2)*k->nb[2];
+            const char * vbase = (const char *) v->data + (h0/rv2)*v->nb[2];
+            const __fp16 * Qg  = Q16 + h0*DK;
+
+            // scores; meanwhile prefetch this block's V rows (used right after) and the next block's K rows
+            float s0[GB], s1[GB];
+            int t = 0;
+            for (; t + 1 < n; t += 2) {
+                ggml_fa_dec_prefetch_row(vbase + (size_t) idx[t]*nbv1,     DV*sizeof(ggml_fp16_t), 3);
+                ggml_fa_dec_prefetch_row(vbase + (size_t) idx[t + 1]*nbv1, DV*sizeof(ggml_fp16_t), 3);
+                if (b1 + t + 1 < bn) {
+                    ggml_fa_dec_prefetch_row(kbase + (b1 + t)*nbk1,     DK*sizeof(ggml_fp16_t), 2);
+                    ggml_fa_dec_prefetch_row(kbase + (b1 + t + 1)*nbk1, DK*sizeof(ggml_fp16_t), 2);
+                }
+                ggml_fa_dec_dot2<GB>((const __fp16 *) (kbase + (size_t) idx[t]*nbk1), (const __fp16 *) (kbase + (size_t) idx[t + 1]*nbk1), Qg, DK, s0, s1);
+                for (int j = 0; j < GB; j++) {
+                    sc[j*FA_DEC_BKV + t]     = s0[j];
+                    sc[j*FA_DEC_BKV + t + 1] = s1[j];
+                }
+            }
+            if (t < n) {
+                ggml_fa_dec_dot1<GB>((const __fp16 *) (kbase + (size_t) idx[t]*nbk1), Qg, DK, s0);
