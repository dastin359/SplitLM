+        uint32_t n_chunks = (blk_rows + 63) / 64;
+        while (n_chunks > 1) {
+            const uint32_t c0 = (n_chunks - 1) * 64;
+            const uint32_t nb = (hex_smin(blk_rows, c0 + 64) - c0) * sizeof(__fp16);
+            if (fa_mask_range_any_unmasked(rows + (size_t) (kv_start + c0) * sizeof(__fp16), row_stride, n_rows_q, nb)) {
+                break;
+            }
+            --n_chunks;
+        }
+        n_rows = hex_smin(blk_rows, n_chunks * 64);
+    }
+    *last_rows = n_rows;
+    return b;
+}
