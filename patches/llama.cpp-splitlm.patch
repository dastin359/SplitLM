+// Plain shared weights run the regular CPU kernels on the borrowed data. Repacked ones keep the owner's
+// tensor_traits in ->extra, so they go through the same repack kernels the owner uses.
+class extra_buffer_type : ggml::cpu::extra_buffer_type {
+    bool supports_op(ggml_backend_dev_t, const struct ggml_tensor * op) override {
+        bool any = false;
+        for (int i = 0; i < GGML_MAX_SRC; i++) {
+            const ggml_tensor * s = op->src[i];
+            if (!s) {
+                continue;
+            }
+            if (shared_is(s)) {
+                if (!s->data) {
+                    return false; // buffer-type probing on a weight with no data: only take tensors routed here by overrides
+                }
+                any = true;
+                if (s->extra) {
+                    const ggml_tensor * src1 = op->src[1];
+                    if (i != 0 || op->op != GGML_OP_MUL_MAT || s->ne[2] != 1 || s->ne[3] != 1 || src1->type != GGML_TYPE_F32) {
+                        return false;
+                    }
+                }
+            } else if (s->buffer && !ggml_backend_buft_is_host(s->buffer->buft)) {
+                return false;
+            }
+        }
+        return any;
+    }
+
+    ggml::cpu::tensor_traits * get_tensor_traits(const struct ggml_tensor * op) override {
+        if (op->op == GGML_OP_MUL_MAT && shared_is(op->src[0]) && op->src[0]->extra) {
+            return (ggml::cpu::tensor_traits *) op->src[0]->extra;
+        }
+        return nullptr;
+    }
+};
