+extern uint32_t htp_fa_mscan_gen;  // flash-attn-ops.c: validity generation of the FA mask-scan result cache
+extern uint32_t htp_fa_mscan_ggen; // flash-attn-ops.c: graph-scope generation of the same cache (MSCAN_GRAPH)
