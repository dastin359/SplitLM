+// build_moe_ffn router weights: top-k selection, GET_ROWS of the selected probabilities, normalized by their clamped sum
+struct test_moe_router_w : public test_argsort_top_k_sel {
+    using test_argsort_top_k_sel::test_argsort_top_k_sel;
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "MOE_ROUTER_W";
+    }
+
+    // distinct positive values per row (like sigmoid router probabilities)
+    void initialize_tensors(ggml_context * ctx) override {
+        std::random_device rd;
+        std::default_random_engine rng(rd());
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != nullptr; t = ggml_get_next_tensor(ctx, t)) {
+            if (t->type != GGML_TYPE_F32) {
+                continue;
+            }
+            const int64_t nr = ggml_nrows(t);
+            std::vector<float> data(t->ne[0] * nr);
+            std::vector<int> perm(t->ne[0]);
+            for (int64_t r = 0; r < nr; r++) {
+                std::iota(perm.begin(), perm.end(), 0);
+                std::shuffle(perm.begin(), perm.end(), rng);
+                for (int64_t c = 0; c < t->ne[0]; c++) {
+                    data[r * t->ne[0] + c] = (float) (perm[c] + 1) / (float) t->ne[0];
+                }
+            }
+            ggml_backend_tensor_set(t, data.data(), 0, ggml_nbytes(t));
+        }
+    }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * probs = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_expert, n_tokens);
+        ggml_set_name(probs, "probs");
+        ggml_tensor * sel = ggml_argsort_top_k(ctx, probs, n_expert_used);
+        ggml_tensor * w = ggml_get_rows(ctx, ggml_reshape_3d(ctx, probs, 1, n_expert, n_tokens), sel);
+        w = ggml_reshape_2d(ctx, w, n_expert_used, n_tokens);
+        ggml_tensor * sum = ggml_clamp(ctx, ggml_sum_rows(ctx, w), 6.103515625e-5f, INFINITY);
+        // distinct values per row: a wrong id or order changes the weights
+        ggml_tensor * out = ggml_div(ctx, w, sum);
+        ggml_set_name(out, "out");
+        return out;
+    }
+};
