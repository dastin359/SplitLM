diff --git a/ggml/src/ggml-hexagon/htp/hmx-a8-core.h b/ggml/src/ggml-hexagon/htp/hmx-a8-core.h
new file mode 100644
index 0000000..f3da4e2
--- /dev/null
+++ b/ggml/src/ggml-hexagon/htp/hmx-a8-core.h
@@ -0,0 +1,105 @@
+// GGML_HEXAGON_A8: W8A8 integer HMX path, HVX building blocks (self-contained: also used by the v73 sim test
+// wt/r9-a8-tools/sim/ta8k.c)
+//
+// Numerics (verified in hexagon-sim v73, wt/r9-a8-tools/sim/tb8.c / ta8k.c):
+//   activations: per row symmetric int8, s8 = round(x * s_r) with s_r = 127 / amax_r rounded to fp16, stored as
+//                uint8 = s8 + 128 in the HMX 8-bit activation layout ("crouton": 64 rows x 32 k, byte
+//                (r / 4) * 128 + k * 4 + r % 4). One 64-row block is written over the fp16 tiles of its first
+//                32-row tile row (tile (2q, t) -> crouton (q, t)), so the k blocks of a 64-row block stay contiguous
+//                for the :deep activation load.
+//   weights:     the per-output-channel int8 tiles of GGML_HEXAGON_I8 (weight.b layout, unchanged).
+//   accumulate:  activation.ub x weight.b at 64 rows per block (2x the useful rows of the W8A16 16x8 mode); the
+//                zero point is removed exactly by the bias word -128 * colsum (in accumulator units in this mode).
+//   readout:     non-saturating .ub readouts wrap: byte = floor((acc + bias) / 2^(24 - exp)) mod 256. Two of them
+//                (exp 24 - S_c with :retain, then exp 16 - S_c) give the 16-bit value floor((acc + 2^(S_c-1)) / 2^S_c)
+//                exactly in two's complement, where S_c per column is the smallest shift with
+//                127 * sum|w8_c| < 32767 * 2^S_c, so it can never wrap (|acc| <= 127 * sum|w8_c|).
+//                Plane 0 (low bytes) of block (q, c) goes to the fp16 output tile (2q, c), plane 1 to (2q + 1, c).
+//   output:      y = int16 * cs_c * rs_r, cs_c = weight scale * 2^S_c (host), rs_r = 1 / s_r.
+#pragma once
+
+#include <stdint.h>
+#include <stddef.h>
+#include <hexagon_types.h>
+#include <hexagon_protos.h>
+
+// two fp16 row-pair vectors of a 32-row tile (rows 4j, 4j+1 and 4j+2, 4j+3; halfword k * 2 + r % 2) and their
+// per-row-pair fp16 scale vectors -> one crouton vector (rows 4j..4j+3, byte k * 4 + r % 4)
+// rounding: the hf -> h conversion (and qf16 -> hf) truncate toward zero, and v73 has no IEEE HVX conversions, so the
+// scale vectors hold 2 * s and t = trunc(2 x s); round(x s) (half away from zero) = (t + 1 - [t < 0]) >> 1, plus the
+// 128 offset: (t - [t < 0] + 256 + 1) >> 1 = vavg_rnd(t - [t < 0], 256) (c256 = splat 256)
+static inline HVX_Vector hmx_a8_round_half(HVX_Vector t, HVX_Vector c256) {
+    return Q6_Vh_vavg_VhVh_rnd(Q6_Vh_vsub_VhVh(t, Q6_Vuh_vlsr_VuhR(t, 15)), c256);
+}
+static inline HVX_Vector hmx_a8_pack(HVX_Vector x0, HVX_Vector x1, HVX_Vector s0, HVX_Vector s1, HVX_Vector c256) {
+    const HVX_Vector q0 = hmx_a8_round_half(Q6_Vh_equals_Vhf(Q6_Vhf_equals_Vqf16(Q6_Vqf16_vmpy_VhfVhf(x0, s0))), c256);
+    const HVX_Vector q1 = hmx_a8_round_half(Q6_Vh_equals_Vhf(Q6_Vhf_equals_Vqf16(Q6_Vqf16_vmpy_VhfVhf(x1, s1))), c256);
+    return Q6_Vh_vshuff_Vh(Q6_Vub_vpack_VhVh_sat(q1, q0));
+}
+
+// same with a second scale factor (rows whose 127 / amax does not fit one fp16 factor)
+static inline HVX_Vector hmx_a8_pack2(HVX_Vector x0, HVX_Vector x1, HVX_Vector s0, HVX_Vector s1, HVX_Vector t0,
+                                      HVX_Vector t1, HVX_Vector c256) {
+    x0 = Q6_Vhf_equals_Vqf16(Q6_Vqf16_vmpy_VhfVhf(x0, t0));
+    x1 = Q6_Vhf_equals_Vqf16(Q6_Vqf16_vmpy_VhfVhf(x1, t1));
+    return hmx_a8_pack(x0, x1, s0, s1, c256);
+}
+
+// one k tile of a 64-row block, in place: src0 = fp16 tile (2q, t) (overwritten by the crouton), src1 = tile (2q+1, t)
+// sw[p] = fp16 scale pair of row pair p of the block (p = 0..31: [s_2p, s_2p+1]); tw = second factors or NULL.
+// Crouton vector j (< 8) reads vectors 2j, 2j+1 of tile (2q, t) and overwrites its vector j, which crouton j / 2 has
+// already read, so the sequential order is safe without a copy (the pointers alias: the compiler keeps the order).
+static inline void hmx_a8_quant_tile(HVX_Vector * src0, const HVX_Vector * src1, const uint32_t * sw, const uint32_t * tw,
+                                     HVX_Vector c256) {
+    if (!tw) {
+        for (int j = 0; j < 8; ++j)
+            src0[j] = hmx_a8_pack(src0[2 * j], src0[2 * j + 1], Q6_V_vsplat_R(sw[2 * j]), Q6_V_vsplat_R(sw[2 * j + 1]), c256);
+        for (int j = 0; j < 8; ++j)
+            src0[8 + j] = hmx_a8_pack(src1[2 * j], src1[2 * j + 1], Q6_V_vsplat_R(sw[16 + 2 * j]), Q6_V_vsplat_R(sw[17 + 2 * j]), c256);
+    } else {
+        for (int j = 0; j < 8; ++j)
+            src0[j] = hmx_a8_pack2(src0[2 * j], src0[2 * j + 1], Q6_V_vsplat_R(sw[2 * j]), Q6_V_vsplat_R(sw[2 * j + 1]),
+                                   Q6_V_vsplat_R(tw[2 * j]), Q6_V_vsplat_R(tw[2 * j + 1]), c256);
+        for (int j = 0; j < 8; ++j)
+            src0[8 + j] = hmx_a8_pack2(src1[2 * j], src1[2 * j + 1], Q6_V_vsplat_R(sw[16 + 2 * j]), Q6_V_vsplat_R(sw[17 + 2 * j]),
+                                       Q6_V_vsplat_R(tw[16 + 2 * j]), Q6_V_vsplat_R(tw[17 + 2 * j]), c256);
+    }
+}
+
+// readout -> int32 words of one fp16 output row pair: p0 = plane-0 vector holding the pair (rows 4j..4j+3 of the
+// 64-row block, byte c * 4 + r % 4), plane 1 at p0 + d1; odd = 1 for the second pair of the 4 rows.
+// lo of the result = even row (32 columns), hi = odd row.
+static inline HVX_VectorPair hmx_a8_words(const HVX_Vector * p0, ptrdiff_t d1, uint32_t odd) {
+    const HVX_Vector P0 = *p0;
+    const HVX_Vector P1 = *(const HVX_Vector *) ((const uint8_t *) p0 + d1);
+    const HVX_VectorPair W = Q6_W_vdeal_VVR(P1, P0, -2);  // lo: even halfwords of P0 | of P1; hi: odd halfwords
+    const HVX_Vector Z = odd ? Q6_V_hi_W(W) : Q6_V_lo_W(W);
+    return Q6_Ww_vsxt_Vh(Q6_Vb_vshuff_Vb(Z));             // halfword i = lo byte i | hi byte i << 8, sign-extended
+}
+
+// same, as int16 values in fp16 tile lane order (halfword c * 2 + row parity)
+static inline HVX_Vector hmx_a8_h16(const HVX_Vector * p0, ptrdiff_t d1, uint32_t odd) {
+    const HVX_Vector P0 = *p0;
+    const HVX_Vector P1 = *(const HVX_Vector *) ((const uint8_t *) p0 + d1);
+    const HVX_VectorPair W = Q6_W_vdeal_VVR(P1, P0, -2);
+    return Q6_Vb_vshuff_Vb(odd ? Q6_V_hi_W(W) : Q6_V_lo_W(W));
+}
+
+// int16 values -> qf32 even / odd row values: hf(int16) * column scales vch (fp16, lane c * 2 + p = cs_c, HTP_I8_META_CSH_OFF)
+// in one widening multiply, then the row scales rse / rso (qf32). int16 -> fp16 keeps 11 significant bits.
+static inline HVX_VectorPair hmx_a8_cvt_qf32_h(HVX_Vector h, HVX_Vector vch, HVX_Vector rse, HVX_Vector rso) {
+    const HVX_VectorPair p = Q6_Wqf32_vmpy_VhfVhf(Q6_Vhf_equals_Vh(h), vch);
+    return Q6_W_vcombine_VV(Q6_Vqf32_vmpy_Vqf32Vqf32(Q6_V_hi_W(p), rso), Q6_Vqf32_vmpy_Vqf32Vqf32(Q6_V_lo_W(p), rse));
+}
+
+// plane-0 vector of fp16 output tile (rt, ct), row pair rp, in a chunk of nct column tiles starting at lo
+static inline const HVX_Vector * hmx_a8_vec(const uint8_t * lo, uint32_t nct, uint32_t rt, uint32_t ct, uint32_t rp) {
+    return (const HVX_Vector *) (lo + ((size_t) ((rt & ~1u) * nct + ct)) * 2048 + ((rt & 1) * 8 + (rp >> 1)) * 128);
+}
+
+// int32 words -> qf32 even / odd row values scaled by the column scales vc and the row scales rse / rso (qf32)
+static inline HVX_VectorPair hmx_a8_cvt_qf32(HVX_VectorPair w, HVX_Vector vc, HVX_Vector rse, HVX_Vector rso) {
+    const HVX_Vector pe = Q6_Vqf32_vmpy_Vqf32Vqf32(Q6_Vqf32_vmpy_VsfVsf(Q6_Vsf_equals_Vw(Q6_V_lo_W(w)), vc), rse);
+    const HVX_Vector po = Q6_Vqf32_vmpy_Vqf32Vqf32(Q6_Vqf32_vmpy_VsfVsf(Q6_Vsf_equals_Vw(Q6_V_hi_W(w)), vc), rso);
+    return Q6_W_vcombine_VV(po, pe);
+}
