+// keep the consumer thread polling between jobs (no futex sleep/wake per job); calls nest
+static inline void hmx_queue_spin_begin(hmx_queue_t q) {
+    atomic_fetch_add(&q->spin, 1);
+}
+
+// spin_begin + wake the consumer if it sleeps on the futex (it then polls until the matching spin_end)
+static inline void hmx_queue_spin_begin_wake(hmx_queue_t q) {
+    atomic_fetch_add(&q->spin, 1);
+    atomic_fetch_add(&q->seqn, 1);  // a new seqn: the consumer leaves its futex wait, finds no work and polls (spin > 0)
+    if (atomic_load(&q->sleeping)) {
+        qurt_futex_wake(&q->seqn, 1);
+    }
+}
+
+static inline void hmx_queue_spin_end(hmx_queue_t q) {
+    atomic_fetch_sub(&q->spin, 1);
+}
+
 static inline void hmx_queue_suspend(hmx_queue_t q) {
