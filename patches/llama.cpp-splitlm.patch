+            b0 = Q6_V_vmux_QVV(q_keep0, hvx_vec_add_f16_f16(v_s0, v_mask0_scaled), v_neg_inf);
+        }
+        my_row_buf0[ci] = b0;
+        v_s_rowmax0     = Q6_Vhf_vmax_VhfVhf(v_s_rowmax0, b0);
+
+        if (m_mode == 2) {
+            // row r+1 is padding: the separate path masks it with v_mask1 = -inf, i.e. q_keep1 is all false
+            my_row_buf1[ci] = v_neg_inf;
+            continue;
+        }
+
+        HVX_VectorPred q_keep1;
+        HVX_Vector     v_mask1_scaled;
+        if (m_mode == 0) {
+            q_keep1        = q_keep0;
+            v_mask1_scaled = v_mask0_scaled;
+        } else {
+            const HVX_Vector v_mask1 = *(const HVX_Vector *) (m_row1 + c);
+            q_keep1        = Q6_Q_and_QQ(Q6_Q_vcmp_gt_VhfVhf(v_mask1, v_threshold), q_tail_keep);
+            v_mask1_scaled = hvx_vec_mul_f16_f16(v_mask1, v_log2e);
+        }
+        HVX_Vector b1;
+        if (has_alibi) {
+            b1 = Q6_V_vmux_QVV(q_keep1, hvx_vec_add_f16_f16(v_s1, hvx_vec_mul_f16_f16(v_mask1_scaled, v_slope1)), v_neg_inf);
+        } else {
+            b1 = Q6_V_vmux_QVV(q_keep1, hvx_vec_add_f16_f16(v_s1, v_mask1_scaled), v_neg_inf);
+        }
+        my_row_buf1[ci] = b1;
+        v_s_rowmax1     = Q6_Vhf_vmax_VhfVhf(v_s_rowmax1, b1);
+    }
+
+    *rowmax0_out = v_s_rowmax0;
+    *rowmax1_out = v_s_rowmax1;
+}
+
+// exp2 of the HMX softmax P values: hvx_vec_exp2_f16 with a degree-4 polynomial for 2^f instead of the
+// degree-6 Taylor one (8 instead of 12 qf16 ops per vector). Coefficients are a relative-error minimax fit
+// over f in [-0.5, 1] (covers the range reduction below for either rounding of the hf->h conversion),
+// quantized to fp16 one at a time: max relative error 5.4e-5 vs 1.5e-4 for the fp16 Taylor coefficients.
+static inline __attribute__((always_inline)) HVX_Vector fa_exp2_f16(HVX_Vector x_v) {
+    const HVX_Vector zero_v    = Q6_V_vzero();
+    const HVX_Vector half_hf_v = Q6_Vh_vsplat_R(0x3800);  // fp16 0.5
+
+    x_v = Q6_Vhf_vmax_VhfVhf(hvx_vec_splat_f16(-24.0f), x_v);
+
+    HVX_Vector x_minus_half = Q6_Vhf_equals_Vqf16(Q6_Vqf16_vsub_VhfVhf(x_v, half_hf_v));
+    HVX_Vector k_v          = Q6_Vh_equals_Vhf(x_minus_half);
+    HVX_Vector f_v          = Q6_Vhf_equals_Vh(k_v);
+    HVX_Vector x_qf16       = Q6_Vqf16_vsub_VhfVhf(x_v, f_v);
+
+    HVX_Vector y = Q6_Vqf16_vmpy_Vqf16Vhf(x_qf16, Q6_Vh_vsplat_R(0x212a));  // c4 * x
+    y            = Q6_Vqf16_vadd_Vqf16Vhf(y, Q6_Vh_vsplat_R(0x2b46));        // + c3
+    y            = Q6_Vqf16_vmpy_Vqf16Vqf16(y, x_qf16);
+    y            = Q6_Vqf16_vadd_Vqf16Vhf(y, Q6_Vh_vsplat_R(0x33af));        // + c2
+    y            = Q6_Vqf16_vmpy_Vqf16Vqf16(y, x_qf16);
+    y            = Q6_Vqf16_vadd_Vqf16Vhf(y, Q6_Vh_vsplat_R(0x398b));        // + c1
+    y            = Q6_Vqf16_vmpy_Vqf16Vqf16(y, x_qf16);
+    y            = Q6_Vqf16_vadd_Vqf16Vhf(y, Q6_Vh_vsplat_R(0x3c00));        // + 1.0
+
+    y                          = Q6_Vhf_equals_Vqf16(y);
+    HVX_Vector y_exp           = Q6_Vuh_vlsr_VuhR(Q6_Vh_vasl_VhR(y, 1), 11);
+    y_exp                      = Q6_Vh_vadd_VhVh(k_v, y_exp);
+    HVX_VectorPred q_underflow = Q6_Q_vcmp_gt_VhVh(zero_v, y_exp);
+    y                          = Q6_Vh_vaslacc_VhVhR(y, k_v, 10);
+    return Q6_V_vmux_QVV(q_underflow, zero_v, y);
+}
+
+// exp2(S - m) for an integer row reference m (F10). k_S = round(S) and f = S - k_S come straight from the S
+// values (exact: S is fp16 and k_S is an integer), so the S - m subtraction, its qf16 -> hf conversion and the
+// -0.5 shift of fa_exp2_f16 disappear; the integer part k = k_S - m is applied to the exponent bits. Because
+// m >= max(S) and round(S) <= ceil(S) <= m, k <= 0 and f is in [-0.5, 0.5] (hf -> h rounds to nearest).
+// Range: S is clamped to <= 16384 and m to [-32768, 16384] (fa_ceil_int_ref), so scores above 16384 (logits above
+// ~11356) saturate instead of overflowing the exponent, and k is a saturating int16 subtraction, so it cannot wrap.
+// Masked scores are written as -32768 (exact in fp16 and int16): a fully masked row (S = m = -32768) gives
+// k = f = 0, i.e. P = 1 as in fa_exp2_f16; any other masked entry has k <= -13 unless the row max is below
+// -32755. Unmasked scores below -32768 only matter in a row whose max is below that too. Results with
+// k < -13 are flushed to 0; since m can be up to 1 above the true row max, that is about 2^-12.5 .. 2^-13.5
+// relative to it (fa_exp2_f16 flushed below ~2^-15).
+// k = -14 would need fp16 subnormal results for f < 0. Not bit-identical to fa_exp2_f16: greedy outputs can
+// differ at rounding level (e.g. Qwen3.5-2B at ub 512), perplexity does not move.
+// 2^f: degree-3 relative minimax fit over [-0.5, 0.5] with fp16 coefficients (best fp16 neighbours of the real
+// fit; max relative error 1.3e-4, below half an fp16 ulp). f is exact here, so unlike F9g no extrapolation can
+// occur; the softmax is bound by the qf16 arithmetic, so each dropped multiply-add pair is ~9% of its time.
+static inline __attribute__((always_inline)) HVX_Vector fa_exp2_int_f16(HVX_Vector s_v, HVX_Vector m_h) {
+    s_v                  = Q6_Vhf_vmin_VhfVhf(s_v, Q6_Vh_vsplat_R(0x7400));  // fp16 16384
+    const HVX_Vector k_s = Q6_Vh_equals_Vhf(s_v);
+    const HVX_Vector f_v = Q6_Vqf16_vsub_VhfVhf(s_v, Q6_Vhf_equals_Vh(k_s));
+    const HVX_Vector k_v = Q6_Vh_vsub_VhVh_sat(k_s, m_h);
+
+    HVX_Vector y = Q6_Vqf16_vmpy_Vqf16Vhf(f_v, Q6_Vh_vsplat_R(0x2b08));  // c3 * f
+    y            = Q6_Vqf16_vadd_Vqf16Vhf(y, Q6_Vh_vsplat_R(0x33c1));     // + c2
+    y            = Q6_Vqf16_vmpy_Vqf16Vqf16(y, f_v);
+    y            = Q6_Vqf16_vadd_Vqf16Vhf(y, Q6_Vh_vsplat_R(0x398c));     // + c1
+    y            = Q6_Vqf16_vmpy_Vqf16Vqf16(y, f_v);
+    y            = Q6_Vqf16_vadd_Vqf16Vhf(y, Q6_Vh_vsplat_R(0x3c00));     // + 1.0
+    y            = Q6_Vhf_equals_Vqf16(y);
+
+    const HVX_VectorPred q_under = Q6_Q_vcmp_gt_VhVh(Q6_Vh_vsplat_R(-13), k_v);
+    y = Q6_Vh_vaslacc_VhVhR(y, k_v, 10);
+    return Q6_V_vmux_QVV(q_under, Q6_V_vzero(), y);
+}
+
+// fa_exp2_int_f16 for the IL softmax with compile-time options (FA_IL_OPT_*):
+//  split: the hf -> h conversion (vconv, Q6_Vh_equals_Vhf) TRUNCATES toward zero on v73 (checked in hexagon-sim:
+//         1.7 -> 1, -1.7 -> -1, 0.5 -> 0), so f = S - k_s is in (-1, 0] for S < 0 and [0, 1) for S >= 0, not in
+//         [-0.5, 0.5]. fa_exp2_int_f16's degree-3 fit for [-0.5, 0.5] then has relative errors up to 1.2e-2 (f near -1)
+//         and 4.7e-3 (f near 1). With split, k_s = trunc(S) - 1 for S < 0 (three ALU ops: vcmp, vmux, saturating
+//         vsub; no VS op), so f = S - k_s is in [0, 1] (1 for negative integers), with fits over [0, 1]: degree 3 ->
+//         max relative error 1.0e-4, degree 2 -> 2.1e-3. k <= 0 still holds (k_s <= trunc(S) <= ceil(max S) = m) and
+//         y is in [1, 2], so the k >= -13 lanes remain normal fp16 numbers.
+//  deg2:  degree-2 polynomial (one qf16 add and one qf16 multiply fewer); only used with split.
+//  clamp = false: the caller guarantees S <= 16384 (FA_IL_OPT_CCHK: one check per 64 rows instead of a vmin per vector).
+//  mpyi:  2^k applied as y + k * 1024 with an integer multiply (VX) and add (VA) instead of vaslacc (VS):
+//         bit-identical (lanes with k < -13, where k * 1024 could wrap, are zeroed either way).
+// On v73 the HVX "VS" resource (vconv conversions, qf16/qf32 add/sub, shifts incl. vaslacc, vlut16, vshuff/vdeal)
+// issues one op per packet and is the limit of this softmax (8 VS ops per S vector plus 1.5 for the row sums in the
+// base version); the multiply (VX) and ALU (VA) resources have room, so every VS op moved or removed counts.
+static inline __attribute__((always_inline)) HVX_Vector fa_exp2_int_f16_x(HVX_Vector s_v, HVX_Vector m_h, const bool clamp,
+                                                                          const bool split, const bool deg2, const bool mpyi,
+                                                                          const bool safe) {
+    if (clamp) {
+        s_v = Q6_Vhf_vmin_VhfVhf(s_v, Q6_Vh_vsplat_R(0x7400));  // fp16 16384
+    }
+    HVX_Vector k_s = Q6_Vh_equals_Vhf(s_v);
+    if (split) {
+        // floor(S) (minus one more for negative integers): trunc(S) - 1 for S < 0, saturating at -32768.
+        // At S <= -2048 fp16 S is an even integer and trunc(S) - 1 is odd, not representable in fp16 (f would round
+        // to 0 or 2, P off by up to 2x). Such lanes give P != 0 only when the row reference m <= -2036 (k = S - 1 - m
+        // >= -13). The caller passes safe for row pairs whose reference may be that low; then the decrement is
+        // limited to -2048 < S < 0 by one unsigned compare on the fp16 bits (bits in [0x8001, 0xe7ff] <=>
+        // bits - 0x8001 <= 0x67fe; one ALU op more), and trunc is exact (f = 0) at S <= -2048. Identical to the
+        // plain test for every S > -2048.
+        HVX_VectorPred q_neg;
+        if (safe) {
+            q_neg = Q6_Q_vcmp_gt_VuhVuh(Q6_Vh_vsplat_R(0x67ff), Q6_Vh_vsub_VhVh(s_v, Q6_Vh_vsplat_R((int16_t) 0x8001)));
+        } else {
+            q_neg = Q6_Q_vcmp_gt_VhfVhf(Q6_V_vzero(), s_v);
+        }
+        k_s = Q6_Vh_vsub_VhVh_sat(k_s, Q6_V_vmux_QVV(q_neg, Q6_Vh_vsplat_R(1), Q6_V_vzero()));
+    }
+    const HVX_Vector f_v = Q6_Vqf16_vsub_VhfVhf(s_v, Q6_Vhf_equals_Vh(k_s));
+    const HVX_Vector k_v = Q6_Vh_vsub_VhVh_sat(k_s, m_h);
+
+    HVX_Vector y;
+    if (split) {  // fits over [0, 1]
+        if (deg2) {
+            y = Q6_Vqf16_vmpy_Vqf16Vhf(f_v, Q6_Vh_vsplat_R(0x3547));  // c2 * f
+            y = Q6_Vqf16_vadd_Vqf16Vhf(y, Q6_Vh_vsplat_R(0x3954));     // + c1
+        } else {
+            y = Q6_Vqf16_vmpy_Vqf16Vhf(f_v, Q6_Vh_vsplat_R(0x2cf1));  // c3 * f
+            y = Q6_Vqf16_vadd_Vqf16Vhf(y, Q6_Vh_vsplat_R(0x3346));     // + c2
+            y = Q6_Vqf16_vmpy_Vqf16Vqf16(y, f_v);
+            y = Q6_Vqf16_vadd_Vqf16Vhf(y, Q6_Vh_vsplat_R(0x3990));     // + c1
+        }
+    } else {
+        y = Q6_Vqf16_vmpy_Vqf16Vhf(f_v, Q6_Vh_vsplat_R(0x2b08));  // c3 * f
+        y = Q6_Vqf16_vadd_Vqf16Vhf(y, Q6_Vh_vsplat_R(0x33c1));     // + c2
+        y = Q6_Vqf16_vmpy_Vqf16Vqf16(y, f_v);
+        y = Q6_Vqf16_vadd_Vqf16Vhf(y, Q6_Vh_vsplat_R(0x398c));     // + c1
+    }
+    y = Q6_Vqf16_vmpy_Vqf16Vqf16(y, f_v);
+    y = Q6_Vqf16_vadd_Vqf16Vhf(y, Q6_Vh_vsplat_R(0x3c00));         // + 1.0
+    y = Q6_Vhf_equals_Vqf16(y);
+
+    const HVX_VectorPred q_under = Q6_Q_vcmp_gt_VhVh(Q6_Vh_vsplat_R(-13), k_v);
+    if (mpyi) {
+        y = Q6_Vh_vadd_VhVh(y, Q6_Vh_vmpyi_VhVh(k_v, Q6_Vh_vsplat_R(1024)));
+    } else {
+        y = Q6_Vh_vaslacc_VhVhR(y, k_v, 10);
+    }
+    return Q6_V_vmux_QVV(q_under, Q6_V_vzero(), y);
+}
+
+#define FA_IL_OPT_DEG2  1  // floor-based degree-2 exp2 polynomial (implies split)
+#define FA_IL_OPT_MPYI  2  // 2^k via integer multiply + add instead of vaslacc (bit-identical, one VS op less)
+#define FA_IL_OPT_CCHK  4  // S <= 16384 checked once per 64 rows (S clamped in place when needed) instead of per vector
+#define FA_IL_OPT_SPLIT 8  // floor-based range reduction (f in [0, 1]) with a degree-3 polynomial
+
+// pass 2 of the IL softmax for the row pair whose S/P vectors start at sv/pv: P = exp2(S - m) and (unless hmx_l)
+// the row sums inserted into lanes j, j + 1 of *rs0 / *rs1.
+static inline __attribute__((always_inline)) void fa_il_pass2(HVX_Vector * sv, HVX_Vector * pv, size_t n_chunks, HVX_Vector v_mh,
+                                                               uint32_t r_vec_off, HVX_Vector * rs0, HVX_Vector * rs1,
+                                                               const bool hmx_l, const bool clamp, const int opt, const bool safe) {
+    const bool       deg2     = (opt & FA_IL_OPT_DEG2) != 0;
+    const bool       split    = (opt & (FA_IL_OPT_SPLIT | FA_IL_OPT_DEG2)) != 0;
+    const bool       mpyi     = (opt & FA_IL_OPT_MPYI) != 0;
+    const HVX_Vector v_one_hf = hvx_vec_splat_f16(1.0);
+    HVX_Vector       v_acc0   = Q6_V_vzero();
+    HVX_Vector       v_acc1   = Q6_V_vzero();
+    size_t           ci       = 0;
+    // four chunks per iteration: eight independent exp2 chains let the qf16 multiplies and adds pair up
+    for (; ci + 3 < n_chunks; ci += 4) {
+        HVX_Vector p[8];
+#pragma unroll
+        for (int k = 0; k < 8; ++k) {
+            p[k] = fa_exp2_int_f16_x(sv[ci * 32 + k * 16], v_mh, clamp, split, deg2, mpyi, safe);
+        }
+#pragma unroll
+        for (int k = 0; k < 8; ++k) {
+            pv[ci * 32 + k * 16] = p[k];
+        }
+        if (!hmx_l) {
+            const HVX_VectorPair vp0 = Q6_Wqf32_vmpy_Vqf16Vhf(Q6_Vqf16_vadd_VhfVhf(p[0], p[1]), v_one_hf);
+            const HVX_VectorPair vp1 = Q6_Wqf32_vmpy_Vqf16Vhf(Q6_Vqf16_vadd_VhfVhf(p[2], p[3]), v_one_hf);
+            const HVX_VectorPair vp2 = Q6_Wqf32_vmpy_Vqf16Vhf(Q6_Vqf16_vadd_VhfVhf(p[4], p[5]), v_one_hf);
+            const HVX_VectorPair vp3 = Q6_Wqf32_vmpy_Vqf16Vhf(Q6_Vqf16_vadd_VhfVhf(p[6], p[7]), v_one_hf);
+            v_acc0 = Q6_Vqf32_vadd_Vqf32Vqf32(v_acc0, Q6_Vqf32_vadd_Vqf32Vqf32(Q6_Vqf32_vadd_Vqf32Vqf32(Q6_V_lo_W(vp0), Q6_V_lo_W(vp1)),
+                                                                               Q6_Vqf32_vadd_Vqf32Vqf32(Q6_V_lo_W(vp2), Q6_V_lo_W(vp3))));
+            v_acc1 = Q6_Vqf32_vadd_Vqf32Vqf32(v_acc1, Q6_Vqf32_vadd_Vqf32Vqf32(Q6_Vqf32_vadd_Vqf32Vqf32(Q6_V_hi_W(vp0), Q6_V_hi_W(vp1)),
+                                                                               Q6_Vqf32_vadd_Vqf32Vqf32(Q6_V_hi_W(vp2), Q6_V_hi_W(vp3))));
+        }
+    }
+    for (; ci + 1 < n_chunks; ci += 2) {
+        const HVX_Vector pa = fa_exp2_int_f16_x(sv[ci * 32], v_mh, clamp, split, deg2, mpyi, safe);
+        const HVX_Vector pb = fa_exp2_int_f16_x(sv[ci * 32 + 16], v_mh, clamp, split, deg2, mpyi, safe);
+        const HVX_Vector pc = fa_exp2_int_f16_x(sv[ci * 32 + 32], v_mh, clamp, split, deg2, mpyi, safe);
+        const HVX_Vector pd = fa_exp2_int_f16_x(sv[ci * 32 + 48], v_mh, clamp, split, deg2, mpyi, safe);
+        pv[ci * 32]      = pa;
+        pv[ci * 32 + 16] = pb;
+        pv[ci * 32 + 32] = pc;
+        pv[ci * 32 + 48] = pd;
+        if (!hmx_l) {
+            const HVX_VectorPair vp0 = Q6_Wqf32_vmpy_Vqf16Vhf(Q6_Vqf16_vadd_VhfVhf(pa, pb), v_one_hf);
+            const HVX_VectorPair vp1 = Q6_Wqf32_vmpy_Vqf16Vhf(Q6_Vqf16_vadd_VhfVhf(pc, pd), v_one_hf);
+            v_acc0 = Q6_Vqf32_vadd_Vqf32Vqf32(v_acc0, Q6_Vqf32_vadd_Vqf32Vqf32(Q6_V_lo_W(vp0), Q6_V_lo_W(vp1)));
+            v_acc1 = Q6_Vqf32_vadd_Vqf32Vqf32(v_acc1, Q6_Vqf32_vadd_Vqf32Vqf32(Q6_V_hi_W(vp0), Q6_V_hi_W(vp1)));
+        }
+    }
+    for (; ci < n_chunks; ++ci) {
+        const HVX_Vector pa = fa_exp2_int_f16_x(sv[ci * 32], v_mh, clamp, split, deg2, mpyi, safe);
+        const HVX_Vector pb = fa_exp2_int_f16_x(sv[ci * 32 + 16], v_mh, clamp, split, deg2, mpyi, safe);
+        pv[ci * 32]      = pa;
+        pv[ci * 32 + 16] = pb;
+        if (!hmx_l) {
+            const HVX_VectorPair vp = Q6_Wqf32_vmpy_Vqf16Vhf(Q6_Vqf16_vadd_VhfVhf(pa, pb), v_one_hf);
+            v_acc0 = Q6_Vqf32_vadd_Vqf32Vqf32(v_acc0, Q6_V_lo_W(vp));
+            v_acc1 = Q6_Vqf32_vadd_Vqf32Vqf32(v_acc1, Q6_V_hi_W(vp));
+        }
+    }
+
+    // both rows' sums with one tree: deal the two accumulators into [row r pairs | row r + 1 pairs], then
+    // rotate-add within 16 lanes: lane 0 ends with row r's sum, lane 16 with row r + 1's
+    if (!hmx_l) {
+        const HVX_VectorPair vp_d = Q6_W_vdeal_VVR(v_acc1, v_acc0, -4);
+        HVX_Vector           t    = Q6_Vqf32_vadd_Vqf32Vqf32(Q6_V_lo_W(vp_d), Q6_V_hi_W(vp_d));
+        for (uint32_t w = 32; w >= 4; w >>= 1) {
+            t = Q6_Vqf32_vadd_Vqf32Vqf32(t, Q6_V_vror_VR(t, w));
+        }
+        t = Q6_Vsf_equals_Vqf32(t);
+        const uint32_t       j     = r_vec_off & 31;
+        const HVX_Vector     v_s0  = Q6_V_vror_VR(t, (128 - 4 * j) & 127);              // lane j <- row r
+        const HVX_Vector     v_s1  = Q6_V_vror_VR(t, (128 - 4 * (j + 1) + 64) & 127);   // lane j + 1 <- row r + 1
+        const HVX_VectorPred p_lo  = Q6_Q_vsetq_R(j * 4);
+        const HVX_VectorPred p_mid = Q6_Q_vsetq_R((j + 1) * 4);
+        const HVX_VectorPred p_hi  = Q6_Q_vsetq2_R((j + 2) * 4);
+        const HVX_VectorPred q_l0  = Q6_Q_and_QQn(p_mid, p_lo);
+        const HVX_VectorPred q_l1  = Q6_Q_and_QQn(p_hi, p_mid);
+        if (r_vec_off < 32) {
+            *rs0 = Q6_V_vmux_QVV(q_l1, v_s1, Q6_V_vmux_QVV(q_l0, v_s0, *rs0));
+        } else {
+            *rs1 = Q6_V_vmux_QVV(q_l1, v_s1, Q6_V_vmux_QVV(q_l0, v_s0, *rs1));
+        }
+    }
+}
+
+// Integer row reference for fa_exp2_int_f16: m_int = ceil(clamp(m, -32768, 16384)) as int16 lanes (*m_h) and as
+// fp16 (return value, used as the row max m for the online-softmax recurrence; any m >= max(S) is valid there).
+// The upper clamp matches the S clamp of fa_exp2_int_f16, so k <= 0 also for rows whose max is above 16384.
+static inline __attribute__((always_inline)) HVX_Vector fa_ceil_int_ref(HVX_Vector m_hf, HVX_Vector * m_h) {
