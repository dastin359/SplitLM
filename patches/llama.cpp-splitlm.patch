+// every finite fp16 value (63488 patterns, both signs, subnormals included) as f32, repeated to fill n values
+static std::vector<float> fp16_finite_values_cyclic(size_t n) {
+    std::vector<float> all;
+    all.reserve(63488);
+    for (uint32_t p = 0; p < 65536; p++) {
+        if (((p >> 10) & 31) == 31) {
+            continue; // inf / nan
+        }
+        all.push_back(ggml_fp16_to_fp32((ggml_fp16_t) p));
+    }
+    std::vector<float> out(n);
+    for (size_t i = 0; i < n; i++) {
+        out[i] = all[i % all.size()];
+    }
+    return out;
+}
