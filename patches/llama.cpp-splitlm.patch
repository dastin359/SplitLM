+        }
+    }
+    if (n_rows == 32) {
+        for (uint32_t j = 0; j < k; ++j) {
+            ((HVX_Vector *) w_out)[j] = ((const HVX_Vector *) wb)[j];
+        }
+    } else {
+        for (uint32_t q = 0; q < n_rows * k; ++q) {
+            w_out[q] = wb[q];
+        }
+    }
+}
