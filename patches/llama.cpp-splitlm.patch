+            if (rem) hvx_vec_store_a((void *) &vdst[2 * i + 1], rem * sizeof(float), y1);
+        } else {
+            hvx_vec_store_a((void *) &vdst[2 * i], rem * sizeof(float), y0);
+        }
+    }
+}
+
+// hvx_sigmul_f32_hf_aa with four 64-lane pairs per iteration and all loads ahead of the stores (same math per
+// element, bit-identical; the tail goes through hvx_sigmul_f32_hf_aa)
+static inline void hvx_sigmul_f32_hf_aa4(uint8_t * restrict dst, const uint8_t * restrict g, const uint8_t * restrict u, uint32_t n) {
+    const struct hvx_silu_hf_consts c = hvx_silu_hf_consts_init();
+    const HVX_Vector one_hf  = hvx_vec_splat_f16((_Float16) 1.0f);
+    const HVX_Vector one_f32 = hvx_vec_splat_f32(1.0f);
+    const HVX_Vector m1      = Q6_V_vsplat_R(-1);
+
+    HVX_Vector * restrict vdst     = (HVX_Vector *) dst;
+    const HVX_Vector * restrict vg = (const HVX_Vector *) g;
+    const HVX_Vector * restrict vu = (const HVX_Vector *) u;
+
+    const uint32_t nq = n / (8 * VLEN_FP32);
+    for (uint32_t i = 0; i < nq; i++) {
+        HVX_Vector x[8], uu[8], y[8];
+        #pragma unroll
+        for (int j = 0; j < 8; j++) {
+            x[j]  = vg[8 * i + j];
+            uu[j] = vu[8 * i + j];
+        }
+        #pragma unroll
+        for (int j = 0; j < 4; j++) {
+            hvx_vec_sigmoid2_f32_hf(x[2 * j], x[2 * j + 1], &y[2 * j], &y[2 * j + 1], &c, one_hf, one_f32, m1);
+        }
+        #pragma unroll
+        for (int j = 0; j < 8; j++) {
+            vdst[8 * i + j] = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(y[j], uu[j]));
+        }
+    }
+    const uint32_t done = nq * 8 * VLEN_FP32;
+    if (done < n) {
+        hvx_sigmul_f32_hf_aa(dst + done * sizeof(float), g + done * sizeof(float), u + done * sizeof(float), n - done);
+    }
+}
+
+// dst = sigmoid(g) * u with the f32 sigmoid of the standalone SIGMOID op (all 128-byte aligned)
+static inline void hvx_sigmul_f32_aa(uint8_t * restrict dst, const uint8_t * restrict g, const uint8_t * restrict u, uint32_t n) {
+    const HVX_Vector one     = hvx_vec_splat_f32(1.f);
+    const HVX_Vector max_exp = hvx_vec_splat_f32(87.f);
+    const HVX_Vector min_exp = hvx_vec_splat_f32(-87.f);
+
+    HVX_Vector * restrict vdst     = (HVX_Vector *) dst;
+    const HVX_Vector * restrict vg = (const HVX_Vector *) g;
+    const HVX_Vector * restrict vu = (const HVX_Vector *) u;
+
+    const uint32_t nvec = n / VLEN_FP32;
+    const uint32_t nloe = n % VLEN_FP32;
+
+    uint32_t i = 0;
+    _Pragma("unroll(4)")
+    for (; i < nvec; i++) {
+        const HVX_Vector s = hvx_vec_fast_sigmoid_f32_guard(vg[i], one, max_exp, min_exp);
+        vdst[i] = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(vu[i], s));
+    }
+    if (nloe) {
+        const HVX_Vector s = hvx_vec_fast_sigmoid_f32_guard(vg[i], one, max_exp, min_exp);
+        hvx_vec_store_a((void *) &vdst[i], nloe * sizeof(float), Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(vu[i], s)));
+    }
+}
+
+// u = silu(g) * u in place (u and g 128-byte aligned, distinct): fp16 exp math and rounding as
+// hvx_swiglu_f32_hf_aa. u is read and written through one pointer (restrict holds: no other pointer
+// reaches its data), g must not overlap u.
+static inline void hvx_swiglu_f32_hf_inplace(uint8_t * restrict u, const uint8_t * restrict g, uint32_t n) {
+    const struct hvx_silu_hf_consts c = hvx_silu_hf_consts_init();
+
+    HVX_Vector * restrict vu       = (HVX_Vector *) u;
+    const HVX_Vector * restrict vg = (const HVX_Vector *) g;
+
+    const uint32_t npair = n / (2 * VLEN_FP32);
+    uint32_t       rem   = n % (2 * VLEN_FP32);
+
+    uint32_t i = 0;
+    _Pragma("unroll(2)")
+    for (; i < npair; i++) {
+        HVX_Vector y0, y1;
+        hvx_vec_silu2_f32_hf(vg[2 * i], vg[2 * i + 1], &y0, &y1, &c);
+        const HVX_Vector u0 = vu[2 * i];
+        const HVX_Vector u1 = vu[2 * i + 1];
+        vu[2 * i]     = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(y0, u0));
+        vu[2 * i + 1] = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(y1, u1));
+    }
+    if (rem) {
+        const HVX_Vector x0 = vg[2 * i];
+        const HVX_Vector x1 = rem > VLEN_FP32 ? vg[2 * i + 1] : c.zero;
+        const HVX_Vector u0 = vu[2 * i];
+        const HVX_Vector u1 = rem > VLEN_FP32 ? vu[2 * i + 1] : c.zero;
+        HVX_Vector y0, y1;
+        hvx_vec_silu2_f32_hf(x0, x1, &y0, &y1, &c);
+        y0 = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(y0, u0));
+        y1 = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(y1, u1));
+        if (rem >= VLEN_FP32) {
+            vu[2 * i] = y0;
+            rem -= VLEN_FP32;
+            if (rem) hvx_vec_store_a((void *) &vu[2 * i + 1], rem * sizeof(float), y1);
+        } else {
+            hvx_vec_store_a((void *) &vu[2 * i], rem * sizeof(float), y0);
+        }
+    }
+}
+
+// u = g * sigmoid(g) * u in place with the qf32 sigmoid (same math as hvx_swiglu_f32_qf32_aa; u through one
+// pointer, g must not overlap u)
+static inline void hvx_swiglu_f32_qf32_inplace(uint8_t * restrict u, const uint8_t * restrict g, uint32_t n) {
+    const struct hvx_sigmoid_qf32_consts c = hvx_sigmoid_qf32_consts_init();
+
+    HVX_Vector * restrict vu       = (HVX_Vector *) u;
+    const HVX_Vector * restrict vg = (const HVX_Vector *) g;
+
+    const uint32_t nvec = n / VLEN_FP32;
+    const uint32_t nloe = n % VLEN_FP32;
+
+    uint32_t i = 0;
+    _Pragma("unroll(4)")
+    for (; i < nvec; i++) {
+        const HVX_Vector x = vg[i];
+        vu[i] = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_Vqf32Vqf32(Q6_Vqf32_vmpy_VsfVsf(x, vu[i]), hvx_vec_sigmoid_qf32(x, &c)));
+    }
+    if (nloe) {
+        const HVX_Vector x = vg[i];
+        const HVX_Vector y = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_Vqf32Vqf32(Q6_Vqf32_vmpy_VsfVsf(x, vu[i]), hvx_vec_sigmoid_qf32(x, &c)));
+        hvx_vec_store_a((void *) &vu[i], nloe * sizeof(float), y);
+    }
+}
+
 #endif /* HVX_SIGMOID_H */
