+            t->op == GGML_OP_UNARY ? ggml_unary_op_name(ggml_get_unary_op(t)) : t->op == GGML_OP_GLU ? ggml_glu_op_name(ggml_get_glu_op(t)) : ggml_op_name(t->op),
+            t->name, (long long) t->ne[0], (long long) t->ne[1], (long long) t->ne[2], (long long) t->ne[3], ggml_type_name(t->type),
+            (long long) ggml_nrows(t), cpu_node_t0_only(t) ? 1 : 0,
+            t->src[0] ? t->src[0]->name : "-", t->src[1] ? t->src[1]->name : "-");
+    }
+}
