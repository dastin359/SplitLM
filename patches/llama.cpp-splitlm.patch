+// int8 tiles + meta (htp/hmx-i8-fmt.h) from the ggml-layout source data: w8 = round(w / cs), cs = max|w_row| / 127
+static void ggml_hexagon_make_i8(struct ggml_tensor * t, const void * data) {
+    const int64_t k = t->ne[0], n = t->ne[1];
+    const int64_t ne1p = hex_round_up(n, 32), nkt = k / 32;
+    const size_t  row_bytes = ggml_row_size(t->type, k);
+    uint8_t * i8 = (uint8_t *) t->data + htp_i8_offset(htp_tiled_row_size(t->type, k), ne1p);
+    uint8_t * meta = i8 + (size_t) ne1p * k;
+    const auto * tr = ggml_get_type_traits(t->type);
+    auto work = [&](int64_t g0, int64_t g1) {
+        std::vector<float> row(k);
+        std::vector<int8_t> q(k);
+        for (int64_t g = g0; g < g1; ++g) {
+            uint8_t * tiles = i8 + (size_t) g * nkt * 1024;
+            uint32_t * lo = (uint32_t *) (meta + (size_t) g * HTP_I8_META_BYTES);
+            uint32_t * hi = lo + 64;
+            float * cs = (float *) (meta + (size_t) g * HTP_I8_META_BYTES + HTP_I8_META_CS_OFF);
+            for (int c = 0; c < 32; ++c) {
+                const int64_t r = g * 32 + c;
+                float s = 0.0f;
+                int32_t colsum = 0;
+                if (r < n) {
+                    tr->to_float((const char *) data + r * row_bytes, row.data(), k);
+                    float amax = 0.0f;
+                    for (int64_t i = 0; i < k; ++i) amax = std::max(amax, std::fabs(row[i]));
+                    s = amax / 127.0f;
+                    const float is = s > 0.0f ? 1.0f / s : 0.0f;
+                    for (int64_t i = 0; i < k; ++i) {
+                        int v = (int) std::nearbyint(row[i] * is);
+                        v = std::min(127, std::max(-127, v));
+                        q[i] = (int8_t) v;
+                        colsum += v;
+                    }
+                } else {
+                    std::fill(q.begin(), q.end(), (int8_t) 0);
+                }
+                for (int64_t i = 0; i < k; ++i) {
+                    const int64_t tk = i / 32, kk = i % 32;
+                    tiles[tk * 1024 + (kk / 4) * 128 + c * 4 + (kk % 4)] = (uint8_t) q[i];
+                }
+                lo[c]      = (uint32_t) HTP_I8_EXP_LO << 10;
+                lo[c + 32] = (uint32_t) (-128 * colsum);
+                hi[c]      = (uint32_t) HTP_I8_EXP_HI << 10;
+                hi[c + 32] = (uint32_t) (-128 * colsum);
+                cs[c]      = s * 256.0f;   // readout returns floor(acc / 256)
+            }
+        }
+    };
+    const int64_t ng = ne1p / 32;
+    const int nth = (int) std::min<int64_t>(8, std::max<int64_t>(1, ng / 4));
+    std::vector<std::thread> th;
+    for (int i = 0; i < nth; ++i) {
+        th.emplace_back(work, ng * i / nth, ng * (i + 1) / nth);
+    }
+    for (auto & x : th) x.join();
+}
