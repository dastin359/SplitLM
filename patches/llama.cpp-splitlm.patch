+template <bool Q5>
+static void ggml_gemv_bi_q45_K_8x8_q8_K(int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nc) {
+    using blk_t = typename std::conditional<Q5, block_q5_Kx8, block_q4_Kx8>::type;
+    const int nb = n / QK_K;
+    const uint8x16_t m4b  = vdupq_n_u8(0x0f);
+    const uint8x16_t mone = vdupq_n_u8(1);
+    const uint8x16_t mtwo = vdupq_n_u8(2);
+    const block_q8_K * GGML_RESTRICT q8_ptr = (const block_q8_K *) vy;
+    for (int x = 0; x < nc / 8; x++) {
+        const blk_t * GGML_RESTRICT q_ptr = (const blk_t *) vx + (x * nb);
+        float32x4_t acc_f32[2] = { vdupq_n_f32(0), vdupq_n_f32(0) };
+        for (int b = 0; b < nb; b++) {
+            const blk_t * blk = q_ptr + b;
+            const int16x8_t bsums = vpaddq_s16(vld1q_s16(q8_ptr[b].bsums), vld1q_s16(q8_ptr[b].bsums + 8));
+            int16_t bsums_arr[8];
+            vst1q_s16(bsums_arr, bsums);
+
+            uint8x16_t qh[4][4];
+            if constexpr (Q5) {
+                for (int cp = 0; cp < 4; cp++) {
+                    for (int k = 0; k < 4; k++) {
+                        qh[cp][k] = vld1q_u8(blk->qh + 16 * cp + 64 * k);
+                    }
+                }
+            }
+            int32x4_t isum[2] = { vdupq_n_s32(0), vdupq_n_s32(0) };
+            int32x4_t bias[2] = { vdupq_n_s32(0), vdupq_n_s32(0) };
+            for (int sb = 0; sb < QK_K / 64; sb++) {
+                int16x8_t mins[2], scales[2];
+                for (int i = 0; i < 2; i++) {
+                    int8_t aux[8];
+                    decode_q_Kx8_6bit_scales(&blk->scales[sb * 24 + i * 12], &mins[i], aux);
+                    scales[i] = vmovl_s8(vld1_s8(aux));
+                }
+                const int8_t * q8_base = q8_ptr[b].qs + sb * 64;
+                int8x16_t q8_qs[8];
+                for (int i = 0; i < 8; i++) {
+                    q8_qs[i] = (int8x16_t) vld1q_dup_s64((const int64_t *) (q8_base + i * 8));
+                }
+                const uint8_t * qs_base = blk->qs + sb * QK_K;
+                int32x4_t acc_lo[4], acc_hi[4];
+                for (int cp = 0; cp < 4; cp++) {
+                    int32x4_t lo = vdupq_n_s32(0), hi = vdupq_n_s32(0);
+                    for (int k = 0; k < 4; k++) {
+                        const uint8x16_t qs = vld1q_u8(qs_base + 16 * cp + 64 * k);
+                        uint8x16_t l, h;
+                        if constexpr (Q5) {
+                            const uint8x16_t hb_lo = vandq_u8(qh[cp][k], mone);
+                            const uint8x16_t hb_hi = vshlq_n_u8(vandq_u8(qh[cp][k], mtwo), 3);
+                            qh[cp][k] = vshrq_n_u8(qh[cp][k], 2);
+                            l = vsliq_n_u8(vandq_u8(qs, m4b), hb_lo, 4);
+                            h = vorrq_u8(vshrq_n_u8(qs, 4), hb_hi);
+                        } else {
+                            l = vandq_u8(qs, m4b);
+                            h = vshrq_n_u8(qs, 4);
+                        }
+                        lo = vdotq_s32(lo, vreinterpretq_s8_u8(l), q8_qs[k]);
+                        hi = vdotq_s32(hi, vreinterpretq_s8_u8(h), q8_qs[k + 4]);
+                    }
+                    acc_lo[cp] = lo;
+                    acc_hi[cp] = hi;
+                }
+                const int16x4_t bs_lo = vdup_n_s16(bsums_arr[2 * sb + 0]);
+                const int16x4_t bs_hi = vdup_n_s16(bsums_arr[2 * sb + 1]);
+                for (int i = 0; i < 2; i++) {
+                    const int16x4_t sc_lo = i == 0 ? vget_low_s16(scales[0]) : vget_high_s16(scales[0]);
+                    const int16x4_t sc_hi = i == 0 ? vget_low_s16(scales[1]) : vget_high_s16(scales[1]);
+                    const int16x4_t mn_lo = i == 0 ? vget_low_s16(mins[0]) : vget_high_s16(mins[0]);
+                    const int16x4_t mn_hi = i == 0 ? vget_low_s16(mins[1]) : vget_high_s16(mins[1]);
+                    isum[i] = vmlaq_s32(isum[i], vmovl_s16(sc_lo), vpaddq_s32(acc_lo[2 * i], acc_lo[2 * i + 1]));
+                    isum[i] = vmlaq_s32(isum[i], vmovl_s16(sc_hi), vpaddq_s32(acc_hi[2 * i], acc_hi[2 * i + 1]));
+                    bias[i] = vmlal_s16(bias[i], bs_lo, mn_lo);
+                    bias[i] = vmlal_s16(bias[i], bs_hi, mn_hi);
+                }
+            }
+            // the gemm's per-super-block float update, same intrinsics, same order
+            const float32x4_t q8_d = vdupq_n_f32(q8_ptr[b].d);
+            for (int j = 0; j < 2; j++) {
+                const float32x4_t q_dmin = vcvt_f32_f16(vld1_f16((const __fp16 *) (blk->dmin + j * 4)));
+                float32x4_t       dmins  = vmulq_f32(q_dmin, q8_d);
+                const float32x4_t q_d    = vcvt_f32_f16(vld1_f16((const __fp16 *) (blk->d + j * 4)));
+                float32x4_t       scale  = vmulq_f32(q_d, q8_d);
+                // -ffp-model=fast would otherwise reassociate cvt(bias)*(dmin*d8) into (cvt(bias)*d8)*dmin; the gemm
+                // multiplies the scales first and fuses the product into fmls/fmla
+                __asm__ volatile("" : "+w"(dmins), "+w"(scale));
+                acc_f32[j] = vmlsq_f32(acc_f32[j], vcvtq_f32_s32(bias[j]), dmins);
+                acc_f32[j] = vmlaq_f32(acc_f32[j], vcvtq_f32_s32(isum[j]), scale);
+            }
+        }
+        vst1q_f32(s + x * 8, acc_f32[0]);
+        vst1q_f32(s + x * 8 + 4, acc_f32[1]);
+    }
+}
+
+void ggml_gemv_bi_q4_K_8x8_q8_K(int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nc) {
+    ggml_gemv_bi_q45_K_8x8_q8_K<false>(n, s, vx, vy, nc);
+}
+
+void ggml_gemv_bi_q5_K_8x8_q8_K(int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nc) {
+    ggml_gemv_bi_q45_K_8x8_q8_K<true>(n, s, vx, vy, nc);
+}
+
+// Q6_K: the integer core of the r9-dec GEMV v2 (unsigned 6-bit weights, the -32 offset folded in through the bsums),
+// whose per-super-block integer sum equals the gemm's signed sum exactly; the float update is the gemm's vmlaq_f32
+void ggml_gemv_bi_q6_K_8x8_q8_K(int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nc) {
+    const int nb = n / QK_K;
+    const uint8x16_t m4b = vdupq_n_u8(0x0f), mask_lo = vdupq_n_u8(0x03), mask_hi = vdupq_n_u8(0x30);
+    const block_q8_K * GGML_RESTRICT q8_ptr = (const block_q8_K *) vy;
+    for (int x = 0; x < nc / 8; x++) {
+        const block_q6_Kx8 * q6_ptr = (const block_q6_Kx8 *) vx + (x * nb);
+        float32x4_t acc_f32_0 = vdupq_n_f32(0), acc_f32_1 = vdupq_n_f32(0);
+        for (int b = 0; b < nb; b++) {
+            const block_q6_Kx8 * blk = q6_ptr + b;
+            int32x4_t bias_lo = vdupq_n_s32(0), bias_hi = vdupq_n_s32(0);
+            for (int i = 0; i < 16; i += 4) {
+                const int16x4_t bs = vld1_s16(q8_ptr[b].bsums + i);
+                const int16x8_t s0 = vmovl_s8(vld1_s8(blk->scales + (i + 0) * 8));
+                const int16x8_t s1 = vmovl_s8(vld1_s8(blk->scales + (i + 1) * 8));
+                const int16x8_t s2 = vmovl_s8(vld1_s8(blk->scales + (i + 2) * 8));
+                const int16x8_t s3 = vmovl_s8(vld1_s8(blk->scales + (i + 3) * 8));
+                bias_lo = vmlal_lane_s16(bias_lo, vget_low_s16(s0), bs, 0); bias_hi = vmlal_lane_s16(bias_hi, vget_high_s16(s0), bs, 0);
+                bias_lo = vmlal_lane_s16(bias_lo, vget_low_s16(s1), bs, 1); bias_hi = vmlal_lane_s16(bias_hi, vget_high_s16(s1), bs, 1);
+                bias_lo = vmlal_lane_s16(bias_lo, vget_low_s16(s2), bs, 2); bias_hi = vmlal_lane_s16(bias_hi, vget_high_s16(s2), bs, 2);
+                bias_lo = vmlal_lane_s16(bias_lo, vget_low_s16(s3), bs, 3); bias_hi = vmlal_lane_s16(bias_hi, vget_high_s16(s3), bs, 3);
+            }
+            bias_lo = vshlq_n_s32(bias_lo, 5); bias_hi = vshlq_n_s32(bias_hi, 5);
+            int32x4_t acc4[4] = { vdupq_n_s32(0), vdupq_n_s32(0), vdupq_n_s32(0), vdupq_n_s32(0) };
+            for (int half = 0; half < 2; half++) {
+                const uint8_t * ql_base = blk->ql + half * 512;
+                const uint8_t * qh_base = blk->qh + half * 256;
+                for (int sb = 0; sb < 4; sb++) {
+                    const int8_t * q8l = q8_ptr[b].qs + half * 128 + sb * 16;
+                    const int8x16_t q8_l0 = (int8x16_t) vld1q_dup_s64((const int64_t *) q8l);
+                    const int8x16_t q8_l1 = (int8x16_t) vld1q_dup_s64((const int64_t *) (q8l + 8));
+                    const int8x16_t q8_h0 = (int8x16_t) vld1q_dup_s64((const int64_t *) (q8l + 64));
+                    const int8x16_t q8_h1 = (int8x16_t) vld1q_dup_s64((const int64_t *) (q8l + 72));
+                    const int ql_off = sb * 128, qh_off = ql_off & 255;
+                    const uint8x16x4_t ql0 = vld1q_u8_x4(ql_base + ql_off);
+                    const uint8x16x4_t ql1 = vld1q_u8_x4(ql_base + ql_off + 64);
+                    uint8x16x4_t qh0 = vld1q_u8_x4(qh_base + qh_off);
+                    uint8x16x4_t qh1 = vld1q_u8_x4(qh_base + qh_off + 64);
+                    if (sb > 1) {
+                        for (int i = 0; i < 4; i++) { qh0.val[i] = vshrq_n_u8(qh0.val[i], 2); qh1.val[i] = vshrq_n_u8(qh1.val[i], 2); }
+                    }
+                    const int16x8_t scl = vmovl_s8(vld1_s8(blk->scales + (half * 8 + sb) * 8));
+                    const int16x8_t sch = vmovl_s8(vld1_s8(blk->scales + (half * 8 + sb + 4) * 8));
+                    const int16x8_t zl0 = vzip1q_s16(scl, scl), zl1 = vzip2q_s16(scl, scl);
+                    const int16x8_t zh0 = vzip1q_s16(sch, sch), zh1 = vzip2q_s16(sch, sch);
+                    const int32x4_t sl[4] = { vmovl_s16(vget_low_s16(zl0)), vmovl_high_s16(zl0), vmovl_s16(vget_low_s16(zl1)), vmovl_high_s16(zl1) };
+                    const int32x4_t sh[4] = { vmovl_s16(vget_low_s16(zh0)), vmovl_high_s16(zh0), vmovl_s16(vget_low_s16(zh1)), vmovl_high_s16(zh1) };
+                    for (int cp = 0; cp < 4; cp++) {
+                        const uint8x16_t l0 = ql0.val[cp], l1 = ql1.val[cp], h0 = qh0.val[cp], h1 = qh1.val[cp];
+                        const int8x16_t q6_l0 = vreinterpretq_s8_u8(vsliq_n_u8(vandq_u8(l0, m4b), vandq_u8(h0, mask_lo), 4));
+                        const int8x16_t q6_l1 = vreinterpretq_s8_u8(vsliq_n_u8(vandq_u8(l1, m4b), vandq_u8(h1, mask_lo), 4));
+                        const int8x16_t q6_h0 = vreinterpretq_s8_u8(vorrq_u8(vshrq_n_u8(l0, 4), vandq_u8(h0, mask_hi)));
+                        const int8x16_t q6_h1 = vreinterpretq_s8_u8(vorrq_u8(vshrq_n_u8(l1, 4), vandq_u8(h1, mask_hi)));
+                        int32x4_t al = vdotq_s32(vdupq_n_s32(0), q6_l0, q8_l0); al = vdotq_s32(al, q6_l1, q8_l1);
+                        int32x4_t ah = vdotq_s32(vdupq_n_s32(0), q6_h0, q8_h0); ah = vdotq_s32(ah, q6_h1, q8_h1);
+                        acc4[cp] = vmlaq_s32(acc4[cp], al, sl[cp]);
+                        acc4[cp] = vmlaq_s32(acc4[cp], ah, sh[cp]);
+                    }
+                }
+            }
+            const int32x4_t isum0 = vsubq_s32(vpaddq_s32(acc4[0], acc4[1]), bias_lo);
+            const int32x4_t isum1 = vsubq_s32(vpaddq_s32(acc4[2], acc4[3]), bias_hi);
+            const float32x4_t q8_d   = vdupq_n_f32(q8_ptr[b].d);
+            float32x4_t       scale0 = vmulq_f32(vcvt_f32_f16(vld1_f16((const __fp16 *) blk->d)), q8_d);
+            float32x4_t       scale1 = vmulq_f32(vcvt_f32_f16(vld1_f16((const __fp16 *) blk->d + 4)), q8_d);
+            __asm__ volatile("" : "+w"(scale0), "+w"(scale1)); // keep d*d8 as one product (see above)
+            acc_f32_0 = vmlaq_f32(acc_f32_0, vcvtq_f32_s32(isum0), scale0);
+            acc_f32_1 = vmlaq_f32(acc_f32_1, vcvtq_f32_s32(isum1), scale1);
+        }
+        vst1q_f32(s + x * 8, acc_f32_0); vst1q_f32(s + x * 8 + 4, acc_f32_1);
+    }
+}
+#endif
