+                const float32x4_t vm = vdupq_n_f32(Mnew);
+                float32x4_t vsum = vdupq_n_f32(0.0f);
+                for (int i = 0; i < n4; i += 4) {
+                    const float32x4_t p = ggml_v_expf(vsubq_f32(vld1q_f32(s + i), vm));
+                    vst1q_f32(s + i, p);
+                    vsum = vaddq_f32(vsum, p);
+                }
