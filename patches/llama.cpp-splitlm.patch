+// trilane: per-op profile on thread 0 (GGML_CPU_PROF=N prints cumulative stats every N graphs)
+static int     cpu_prof_every = 0;
+static int64_t cpu_prof_graphs = 0;
+static int64_t cpu_prof_count[GGML_OP_COUNT];
+static int64_t cpu_prof_work_us[GGML_OP_COUNT];
+static int64_t cpu_prof_wait_us[GGML_OP_COUNT];
+
+// matmul shapes: weight bytes streamed vs time, to see which kernels fall short of DRAM bandwidth
+struct cpu_prof_mm { int type, op; int64_t ne0, ne1, n, us_work, us_wait; double bytes; };
+static struct cpu_prof_mm cpu_prof_mms[64];
+static int cpu_prof_n_mm = 0;
+
+// trilane: before a thread waits at a barrier, start streaming its first chunk of the next single-token matmul's
+// weights (GGML_PF_NEXT_KB = KiB per thread, 0 = off; GGML_REPACK_CHUNKS must match repack.cpp's chunking)
+static int cpu_pf_next_kb = 0;
+static int cpu_pf_chunks  = 4;
+
+static void cpu_prefetch_next_weights(const struct ggml_cgraph * cgraph, int node_n, int ith, int nth, int * pf_done) {
+    for (int j = node_n + 1; j < cgraph->n_nodes && j <= node_n + 16; j++) {
+        const struct ggml_tensor * t = cgraph->nodes[j];
+        if (t->op == GGML_OP_MUL_MAT_ID) {
+            return; // expert rows depend on routing not known yet
+        }
+        if (t->op != GGML_OP_MUL_MAT) {
+            continue;
+        }
+        if (j == *pf_done || ggml_nrows(t->src[1]) != 1 || !ggml_is_quantized(t->src[0]->type)) {
+            return;
+        }
+        *pf_done = j;
+        const struct ggml_tensor * w = t->src[0];
+        const int64_t nr0 = ggml_nrows(w);
+        const int64_t dr  = (nr0 + (int64_t) nth * cpu_pf_chunks - 1) / ((int64_t) nth * cpu_pf_chunks);
+        const int64_t r0  = MIN(nr0, dr * ith);
+        const size_t  nb  = MIN((size_t) (MIN(nr0, r0 + dr) - r0) * w->nb[1], (size_t) cpu_pf_next_kb * 1024);
+        const char *  p   = (const char *) w->data + r0 * w->nb[1];
+        for (size_t off = 0; off < nb; off += 64) {
+            __builtin_prefetch(p + off, 0, 2);
+        }
+        return;
+    }
+}
+
+// trilane: barrier elision. Row-split element-wise ops on a single row run entirely on thread 0
+// (get_thread_range / ith-strided row loops give every other thread an empty range). Between two such
+// nodes the barrier only makes threads 1..n-1 wait for work they do not take part in, and thread 0 sees
+// its own writes, so the barrier can be skipped. A chain of skipped barriers ends at the first node that
+// is not thread-0-only, where the normal barrier runs. GGML_CPU_BAR_ELIDE=0 disables.
+static int     cpu_bar_elide = 1;
+static int64_t cpu_prof_elided = 0;
+
+static bool cpu_node_t0_only(const struct ggml_tensor * t) {
+    if (t->type != GGML_TYPE_F32 || t->src[0] == NULL || t->src[0]->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if (ggml_nrows(t) != 1 || ggml_nrows(t->src[0]) != 1) {
+        return false;
+    }
+    switch (t->op) {
+        case GGML_OP_ADD:
+        case GGML_OP_SUB:
+        case GGML_OP_MUL:
+        case GGML_OP_DIV:
+            // binary_op: apply_binary_op splits the rows of src0
+            return t->src[1] != NULL && t->src[1]->type == GGML_TYPE_F32;
+        case GGML_OP_SCALE:    // scale_f32: rows of src0
+        case GGML_OP_RMS_NORM: // rms_norm_f32 (also fused with MUL): i01 = ith, ith+nth, ...
+            return true;
+        case GGML_OP_UNARY:
+            switch (ggml_get_unary_op(t)) {
+                case GGML_UNARY_OP_SILU:     // silu_f32: rows of src0
+                case GGML_UNARY_OP_SIGMOID:  // unary_op: get_thread_range(src0)
+                case GGML_UNARY_OP_SOFTPLUS:
+                    return true;
+                default:
+                    return false;
+            }
+        case GGML_OP_GLU:
+            // swiglu_f32: rows of src0 (split or fused gate/up)
+            return ggml_get_glu_op(t) == GGML_GLU_OP_SWIGLU &&
+                (t->src[1] == NULL || (t->src[1]->type == GGML_TYPE_F32 && ggml_nrows(t->src[1]) == 1));
+        default:
+            return false;
+    }
+}
+
+// index of the next node the compute loop will execute after node_n (same skip rules as the loop)
+static int cpu_next_compute_node(const struct ggml_cgraph * cgraph, int node_n) {
+    int j = node_n + 1;
+    while (j < cgraph->n_nodes &&
+           (ggml_op_is_empty(cgraph->nodes[j]->op) || (cgraph->nodes[j]->flags & GGML_TENSOR_FLAG_COMPUTE) == 0)) {
+        j++;
+    }
+    return j;
+}
+
+static void cpu_prof_mm_add(const struct ggml_tensor * node, int64_t us_work, int64_t us_wait) {
+    const struct ggml_tensor * w = node->src[0];
+    double bytes = (double) ggml_nbytes(w);
+    if (node->op == GGML_OP_MUL_MAT_ID) {
+        const struct ggml_tensor * ids = node->src[2];
+        const int64_t used = ids->ne[0] * ids->ne[1];
+        bytes = (double) w->nb[2] * (double) MIN(w->ne[2], used); // upper bound on experts touched
+    }
+    int k = 0;
+    for (; k < cpu_prof_n_mm; k++) {
+        struct cpu_prof_mm * m = &cpu_prof_mms[k];
+        if (m->type == (int) w->type && m->op == (int) node->op && m->ne0 == w->ne[0] && m->ne1 == w->ne[1]) break;
+    }
+    if (k == cpu_prof_n_mm) {
+        if (k == 64) return;
+        cpu_prof_mms[k] = (struct cpu_prof_mm) { (int) w->type, (int) node->op, w->ne[0], w->ne[1], 0, 0, 0, 0 };
+        cpu_prof_n_mm++;
+    }
+    cpu_prof_mms[k].n++;
+    cpu_prof_mms[k].us_work += us_work;
+    cpu_prof_mms[k].us_wait += us_wait;
+    cpu_prof_mms[k].bytes   += bytes;
+}
+
+static void cpu_prof_dump(void) {
+    int64_t tot_work = 0, tot_wait = 0, tot_n = 0;
+    for (int i = 0; i < GGML_OP_COUNT; i++) { tot_work += cpu_prof_work_us[i]; tot_wait += cpu_prof_wait_us[i]; tot_n += cpu_prof_count[i]; }
+    if (cpu_prof_graphs == 0 || tot_n == 0) return;
+    fprintf(stderr, "[cpu-prof] graphs %lld | per graph: nodes %.0f, work %.3f ms, barrier-wait %.3f ms (%.1f%%), avg wait/node %.2f us, elided barriers %.1f\n",
+        (long long) cpu_prof_graphs, (double) tot_n / cpu_prof_graphs, tot_work / 1000.0 / cpu_prof_graphs, tot_wait / 1000.0 / cpu_prof_graphs,
+        100.0 * tot_wait / (double) (tot_work + tot_wait), (double) tot_wait / tot_n, (double) cpu_prof_elided / cpu_prof_graphs);
+    for (int k = 0; k < 12; k++) {
+        int best = -1;
+        for (int i = 0; i < GGML_OP_COUNT; i++) {
+            if (cpu_prof_count[i] > 0 && (best < 0 || cpu_prof_work_us[i] + cpu_prof_wait_us[i] > cpu_prof_work_us[best] + cpu_prof_wait_us[best])) best = i;
+        }
+        if (best < 0) break;
+        fprintf(stderr, "[cpu-prof]   %-18s n/graph %6.1f  work %7.3f ms  wait %7.3f ms\n", ggml_op_name((enum ggml_op) best),
+            (double) cpu_prof_count[best] / cpu_prof_graphs, cpu_prof_work_us[best] / 1000.0 / cpu_prof_graphs, cpu_prof_wait_us[best] / 1000.0 / cpu_prof_graphs);
+        cpu_prof_count[best] = -cpu_prof_count[best]; // mark printed
+    }
+    for (int i = 0; i < GGML_OP_COUNT; i++) if (cpu_prof_count[i] < 0) cpu_prof_count[i] = -cpu_prof_count[i];
+    double mm_bytes = 0, mm_us = 0;
+    for (int k = 0; k < cpu_prof_n_mm; k++) {
+        const struct cpu_prof_mm * m = &cpu_prof_mms[k];
+        mm_bytes += m->bytes; mm_us += (double) (m->us_work + m->us_wait);
+        fprintf(stderr, "[cpu-prof]   mm %-6s %-5s %6lld x %-6lld n/graph %5.1f  %7.3f ms/graph (wait %5.3f)  %6.2f MB/graph  %6.1f GB/s\n",
+            m->op == GGML_OP_MUL_MAT_ID ? "mm_id" : "mm", ggml_type_name((enum ggml_type) m->type), (long long) m->ne0, (long long) m->ne1,
+            (double) m->n / cpu_prof_graphs, (m->us_work + m->us_wait) / 1000.0 / cpu_prof_graphs, m->us_wait / 1000.0 / cpu_prof_graphs,
+            m->bytes / 1e6 / cpu_prof_graphs, m->bytes / 1e3 / (double) MAX(1, m->us_work + m->us_wait));
+    }
+    if (mm_us > 0) {
+        fprintf(stderr, "[cpu-prof]   matmul total %.3f ms/graph, %.1f MB/graph, %.1f GB/s; whole graph %.1f GB/s\n",
+            mm_us / 1000.0 / cpu_prof_graphs, mm_bytes / 1e6 / cpu_prof_graphs, mm_bytes / 1e3 / mm_us, mm_bytes / 1e3 / (double) (tot_work + tot_wait));
+    }
+}
