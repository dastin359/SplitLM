+// ---- GGML_HEXAGON_NORM_EPI (HTP_MM_PARAM_NORM_EPI) -------------------------------------------------------------
+// The tiled RMS_NORM+MUL that reads this MUL_MAT+ADD's output runs inside the matmul: once an m-block's rows are all
+// stored, they are normalized in 32-row slices (one tile row) between the HMX jobs of the next m-block, where the HVX
+// threads idle while HMX computes. Same arithmetic as the norm op's tiled_fused pass (bit-identical tiles); the rows
+// are read back with HVX loads (this op's own cached stores) and the tiles stored with HVX stores (the consumer's
+// DMA reads them after the usual dirty-range flush of this op's dsts).
+#define HTP_NEPI_MAX_NE0 8192
+static float g_nepi_w[HTP_NEPI_MAX_NE0] __attribute__((aligned(128)));
+
+typedef struct {
+    struct htp_context * ctx;
+    const float *        src;     // matmul dst rows (f32)
+    uint32_t             stride;  // in floats
+    __fp16 *             tiles;   // dsts[1]
+    uint32_t             ne0;
+    uint32_t             m;       // valid rows
+    uint32_t             m_pad;   // rows rounded up to 32 (the pad rows of the last tile row are zero)
+    HVX_Vector           inv_n_v, eps_v;
+    uint32_t             done;    // rows [0, done) are in the tiles
+    uint32_t             ready;   // rows [0, ready) are final in src
+    uint32_t             r0, r1;  // current slice
+} htp_nepi_t;
+
+static htp_nepi_t * g_nepi = NULL;  // set by hmx_mm_op_matmul for the op being run (main thread only)
+
+static void htp_nepi_worker(unsigned int n, unsigned int i, void * data) {
+    const htp_nepi_t * e = (const htp_nepi_t *) data;
+    struct htp_thread_trace * tr = &e->ctx->trace[i];
+    htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_COMP, e->r0);
+    const uint32_t k_tiles = e->ne0 / 32;
+    const HVX_Vector * restrict vw = (const HVX_Vector *) g_nepi_w;
+    for (uint32_t r = e->r0 + 2 * i; r < e->r1; r += 2 * n) {
+        const bool v0 = r < e->m, v1 = r + 1 < e->m;
+        const HVX_Vector * row0 = (const HVX_Vector *) (e->src + (size_t) r * e->stride);
+        const HVX_Vector * row1 = (const HVX_Vector *) (e->src + (size_t) (r + 1) * e->stride);
+        if (r + 2 * n + 1 < e->m) {
+            hex_l2fetch(e->src + (size_t) (r + 2 * n) * e->stride, e->ne0 * sizeof(float), e->stride * sizeof(float), 2);
+        }
+        HVX_Vector * restrict tbase = (HVX_Vector *) (e->tiles + (size_t) (r / 32) * k_tiles * 1024) + (r % 32) / 2;
+        if (v0 && v1) {
+            HVX_Vector s0, s1;
+            hvx_rms_row_scale2_f32(row0, row1, (int) k_tiles, e->inv_n_v, e->eps_v, &s0, &s1);
+            #pragma unroll(4)
+            for (uint32_t c = 0; c < k_tiles; c++) {
+                const HVX_Vector a = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(row0[c], s0)), vw[c]));
+                const HVX_Vector b = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(row1[c], s1)), vw[c]));
+                tbase[c * 16] = hvx_vec_f32_to_f16_shuff(a, b);
+            }
+        } else if (v0) {
+            const HVX_Vector s0 = hvx_rms_row_scale_f32(row0, (int) k_tiles, e->inv_n_v, e->eps_v);
+            for (uint32_t c = 0; c < k_tiles; c++) {
+                const HVX_Vector a = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(row0[c], s0)), vw[c]));
+                tbase[c * 16] = hvx_vec_f32_to_f16_shuff(a, Q6_V_vzero());
+            }
+        } else {
+            for (uint32_t c = 0; c < k_tiles; c++) {
+                tbase[c * 16] = hvx_vec_f32_to_f16_shuff(Q6_V_vzero(), Q6_V_vzero());
+            }
+        }
+    }
+    htp_trace_event_stop(tr, HTP_TRACE_EVT_HVX_COMP, e->r0);
+}
+
+// normalize up to max_rows (whole 32-row tile rows; the last tile row also when it is partial) of the ready rows
+static inline void htp_nepi_run(htp_nepi_t * e, uint32_t max_rows) {
+    uint32_t avail = (e->ready >= e->m ? e->m_pad : (e->ready & ~31u));
+    if (avail <= e->done || max_rows == 0) return;
+    uint32_t rows = hex_smin(avail - e->done, hex_align_up(max_rows, 32));
+    e->r0 = e->done;
+    e->r1 = e->done + rows;
+    worker_pool_run_func(e->ctx->worker_pool, htp_nepi_worker, e, e->ctx->n_threads);
+    e->done = e->r1;
+}
+
+// one step between HMX jobs: spread the pending rows over the remaining steps of the current m-block
+static inline void htp_nepi_step(uint32_t steps_left) {
+    htp_nepi_t * e = g_nepi;
+    if (!e) return;
+    const uint32_t avail = (e->ready >= e->m ? e->m_pad : (e->ready & ~31u));
+    if (avail <= e->done) return;
+    const uint32_t pend = avail - e->done;
+    htp_nepi_run(e, (pend + (steps_left ? steps_left : 1) - 1) / (steps_left ? steps_left : 1));
+}
+
+static inline void htp_nepi_ready(uint32_t rows) {
+    if (g_nepi && rows > g_nepi->ready) g_nepi->ready = rows;
+}
+
+static inline void htp_nepi_flush(void) {
+    htp_nepi_t * e = g_nepi;
+    if (!e) return;
+    e->ready = e->m;
+    htp_nepi_run(e, e->m_pad);
+    e->ctx->norm_epi_done = (uint64_t) (uintptr_t) e->tiles;
+}
+
+static void hmx_tiled_swiglu_threaded(struct htp_context * ctx, __fp16 * dst_seg, const __fp16 * vtcm_src, uint32_t n_rows,
+                                      uint32_t n_cols, uint32_t col_tile0, uint32_t k_tiles, bool hf, int n_threads);
+
+// ---- GGML_HEXAGON_MM_XB (host; HTP_OPFLAG_MM_XB_OFF = the per-m-block loops) ---------------------------------------------
+// Pipelined fp16 HMX loops with fp16 activation tiles in (HTP_MM_ACT_TILED_IN): one weight pipeline over all (m-block,
+// weight, n-chunk) jobs, and the m-block boundary overlapped with HMX work. The last job of a block and the first job of
+// the next one run as row-group sub-jobs (same output tiles, same per-tile accumulation, so the same bits): once a sub-job
+// of the last job is done, its rows of the activation buffer are refilled with the next block's tile rows (one DMA per
+// group) and each sub-job of the first job starts once its group has arrived; the first block's activations arrive in
+// groups too. Odd blocks run their chunks in reverse (snake), so the first job of a block reuses the weight chunk the
+// previous block ended with (one weight DMA + dequant less per boundary), and the two widest chunks sit at the block
+// ends. The last store of a block runs behind the first job of the next. The int loops (GGML_HEXAGON_I8 / A8, not
+// A8_BLK) quantize each activation group as it arrives, with one row-scale buffer per block parity.
+// Everything on the main thread's DMA chain goes through xb_push / xb_wait (pops in push order up to a sequence number).
+#define HMX_XB_MAX_RG 8
+#define HMX_XB_MAX_JPB 256
+
+typedef struct hmx_xb_s hmx_xb_t;
+
+typedef struct {
+    size_t   mr, n_rows;   // m-block
+    uint32_t b;            // m-block index
+    uint32_t p, i;         // weight, chunk of that weight
+    size_t   nc, n_cols;   // weight columns (kind 1: gate columns of the pair)
+    uint32_t dq_cols;      // columns dequantized / computed (kind 1: 2 * n_cols)
+} hmx_xb_job_t;
+
+struct hmx_xb_s {
+    struct htp_context * ctx;
+    dma_queue *          dma;
+    uint8_t              kind;  // 0: 2D (one weight), 1: MUL_MAT_NX paired SWIGLU (gate + up chunk per job), 2: MUL_MAT_NX weights in turn
+    size_t               m_start, mr_end, mc, nchunk;
+    uint32_t             jpb, n_jobs;
+    uint32_t             n_w;
+    uint32_t             cnt[HTP_OP_MAX_OUTPUTS];  // chunks per weight
+    size_t               wn[HTP_OP_MAX_OUTPUTS];   // columns per weight
+    dma_addr_t           wdata[HTP_OP_MAX_OUTPUTS];
+    size_t               wstride[HTP_OP_MAX_OUTPUTS];
+    int                  k, n_threads, weight_type, n_k_tiles, n_weight_tiles;
+    size_t               row_stride;
+    struct fastdiv_values n_k_tiles_div;
+    tiled_dequant_task_fn_t dq_fn;
+    bool                 is_tiled;
+    uint32_t             dma_dst_stride, dma_width_bytes, tile_size;
+    void *               raw[4];
+    void *               wbuf[4];
+    __fp16 *             obuf[2];
+    __fp16 *             act;
+    __fp16 *             scales;
+    dma_addr_t           act_addr;  // fp16 tile rows in DDR (tile row t at t * k * 32 halves)
+    uint32_t             groups;    // max row-group sub-jobs per boundary job
+    bool                 spin;
+    bool                 snake;     // odd blocks run their chunks in reverse: a block starts with the chunk the previous one ended with
+    bool                 head;      // the first block's activations arrive in row groups too (job 0 starts on the first group)
+    bool                 perm_on;   // chunk order within a block: the two widest chunks at the ends (pos -> canonical chunk)
+    uint16_t             perm[HMX_XB_MAX_JPB];
+    uint32_t             dq_push, dq_pop;
+    // GGML_HEXAGON_I8 / A8 integer loop: int8 weight + meta slots, hi readout windows, row scales per block parity
+    bool                 i8, a8, h16;
+    int8_t *             w8[4];
+    uint8_t *            m8[4];
+    __fp16 *             hi[2];
+    float *              rs[2];
+    dma_addr_t           wi8[HTP_OP_MAX_OUTPUTS], mi8[HTP_OP_MAX_OUTPUTS];
+    // store
+    uint32_t             out_split;
+    // kind 0
+    float *              dst;
+    int                  dst_stride, dst_cols;
+    const float *        bias_base;
+    uint32_t             src2_stride;
+    float *              stage;
+    dma_addr_t           src2_addr;
+    uint32_t             seq_s;
+    bool                 nepi;
+    // kind 1
+    float *              pdst;
+    size_t               pdst_stride;
+    int                  pdst_cols;
+    size_t               pn;
+    bool                 f16_out, hf;
+    uint32_t             epi_pair_id;
+    // kind 2
+    const struct htp_ops_context * octx;
+    const struct htp_mm_kernel_params * kparams;
+    bool                 epi_swiglu;
+};
+
+static inline uint32_t xb_push(hmx_xb_t * X) { return X->dq_push++; }
+
+// The pop sequence counting (xb_wait, hmx_queue_pop per sub-job) needs every push to land. hmx_xb_run keeps at most
+// ~2 * HMX_XB_MAX_RG + 2 HMX sub-jobs and ~24 main-chain DMA descriptors in flight; hmx_xb_queues_ok (checked at the
+// XB entry, else the per-block loops run) requires much more free room than that. A full HMX queue drains on its own
+// (the HMX worker advances idx_read), so a failed HMX push is simply retried.
+#define HMX_XB_DMA_MIN_FREE 64
+#define HMX_XB_HMX_MIN_FREE (2 * HMX_XB_MAX_RG + 8)
+
+static inline bool hmx_xb_queues_ok(const struct htp_context * ctx, dma_queue * dma) {
+    return dma_queue_capacity(dma) - dma_queue_depth(dma) >= HMX_XB_DMA_MIN_FREE &&
+           hmx_queue_capacity(ctx->hmx_queue) - 1 - ((atomic_load(&ctx->hmx_queue->idx_write) - ctx->hmx_queue->idx_pop) & ctx->hmx_queue->idx_mask) >=
+               HMX_XB_HMX_MIN_FREE;  // entries not yet popped (a push may not reuse them)
+}
+
+static inline void hmx_xb_hmx_push(hmx_xb_t * X, struct hmx_queue_desc d) {
+    while (__builtin_expect(!hmx_queue_push(X->ctx->hmx_queue, d), 0)) hex_pause();
+}
+
+static inline void xb_wait(hmx_xb_t * X, uint32_t seq) {
+    while (X->dq_pop <= seq) {
+        dma_queue_pop(X->dma);
+        X->dq_pop++;
+    }
+}
+
+// canonical chunk c of a block (weights in turn, chunks in order) -> weight, chunk of that weight
+static inline void hmx_xb_chunk(const hmx_xb_t * X, uint32_t c, uint32_t * p_out, uint32_t * i_out) {
+    uint32_t p = 0;
+    if (X->kind == 2) {
+        while (c >= X->cnt[p]) { c -= X->cnt[p]; p++; }
+    }
+    *p_out = p;
+    *i_out = c;
+}
+
+static inline void hmx_xb_job(const hmx_xb_t * X, uint32_t j, hmx_xb_job_t * J) {
+    const uint32_t b   = j / X->jpb;
+    const uint32_t r   = j - b * X->jpb;
+    const uint32_t pos = (X->snake && (b & 1)) ? X->jpb - 1 - r : r;
+    uint32_t       p, i;
+    hmx_xb_chunk(X, X->perm_on ? X->perm[pos] : pos, &p, &i);
+    J->mr      = X->m_start + (size_t) b * X->mc;
+    J->n_rows  = hex_smin(X->mr_end - J->mr, X->mc);
+    J->b       = b;
+    J->p       = p;
+    J->i       = i;
+    J->nc      = (size_t) i * X->nchunk;
+    J->n_cols  = hex_smin(X->wn[p] - J->nc, X->nchunk);
+    J->dq_cols = (uint32_t) (X->kind == 1 ? 2 * J->n_cols : J->n_cols);
+}
+
+// weight slot of job j: with the snake order the first job of a block reuses the previous job's weight chunk
+static inline uint32_t hmx_xb_slot(const hmx_xb_t * X, uint32_t j) {
+    return X->snake ? j - j / X->jpb : j;
+}
+
+static inline bool hmx_xb_reuse(const hmx_xb_t * X, uint32_t j) {
+    return X->snake && j > 0 && (j % X->jpb) == 0;
+}
+
+// the first job using weight slot s
+static inline uint32_t hmx_xb_slot_job(const hmx_xb_t * X, uint32_t s) {
+    if (!X->snake || s < X->jpb) return s;
+    if (X->jpb == 1) return 0;  // one chunk per block: every block reuses slot 0
+    // blocks b >= 1 add jpb - 1 new slots each (their first job reuses the previous slot)
+    const uint32_t q = (s - X->jpb) / (X->jpb - 1), r = (s - X->jpb) % (X->jpb - 1);
+    return (q + 1) * X->jpb + 1 + r;
+}
+
+static void hmx_xb_plan_order(hmx_xb_t * X) {
+    const uint32_t jpb = X->jpb;
+    X->perm_on = false;
+    if (X->kind == 2 && X->epi_swiglu) { X->snake = false; return; }  // up chunks read the gate chunks stored before them
+    if (jpb > HMX_XB_MAX_JPB || jpb < 2) return;
+    // the two widest chunks at the ends: a boundary job is one of them
+    uint32_t e0 = 0, e1 = 1;
+    size_t   w0 = 0, w1 = 0;
+    for (uint32_t c = 0; c < jpb; c++) {
+        uint32_t p, i;
+        hmx_xb_chunk(X, c, &p, &i);
+        const size_t w = hex_smin(X->wn[p] - (size_t) i * X->nchunk, X->nchunk);
+        if (w > w0) { e1 = e0; w1 = w0; e0 = c; w0 = w; }
+        else if (w > w1) { e1 = c; w1 = w; }
+    }
+    uint32_t p0, i0, pl, il;
+    hmx_xb_chunk(X, 0, &p0, &i0);
+    hmx_xb_chunk(X, jpb - 1, &pl, &il);
+    const size_t wf = hex_smin(X->wn[p0] - (size_t) i0 * X->nchunk, X->nchunk);
+    const size_t wl = hex_smin(X->wn[pl] - (size_t) il * X->nchunk, X->nchunk);
+    if (wf >= w1 && wl >= w1) return;  // the ends are already the widest
+    if (e0 > e1) { const uint32_t t = e0; e0 = e1; e1 = t; }
+    uint32_t n = 0;
+    X->perm[n++] = (uint16_t) e0;
+    for (uint32_t c = 0; c < jpb; c++) {
+        if (c != e0 && c != e1) X->perm[n++] = (uint16_t) c;
+    }
+    X->perm[n++] = (uint16_t) e1;
+    X->perm_on = true;
+}
+
+// DMA the weight chunk(s) of weight slot s (first used by job j); returns the sequence number of the last descriptor
+static uint32_t hmx_xb_push_w(hmx_xb_t * X, uint32_t s) {
+    hmx_xb_job_t J;
+    hmx_xb_job(X, hmx_xb_slot_job(X, s), &J);
+    if (X->i8) {
+        if (X->kind == 1) {
+            hmx_i8_push_pair(X->dma, X->w8[s % 4], X->m8[s % 4], X->wi8[0], X->mi8[0], X->wi8[1], X->mi8[1], (uint32_t) X->k, J.nc, J.n_cols);
+            X->dq_push += 3;
+            return xb_push(X);
+        }
+        hmx_i8_push_cols(X->dma, X->w8[s % 4], X->m8[s % 4], X->wi8[J.p], X->mi8[J.p], (uint32_t) X->k, J.nc, J.n_cols);
+        X->dq_push += 1;
+        return xb_push(X);
+    }
+    void *         raw = X->raw[s % 4];
+    const uint32_t h   = X->is_tiled ? hmx_ceil_div((uint32_t) J.n_cols, 32) * X->n_weight_tiles : (uint32_t) J.n_cols;
+    const uint32_t ss  = X->is_tiled ? X->tile_size : (uint32_t) X->wstride[J.p];
+    if (X->kind == 1) {
+        dma_queue_push(X->dma, dma_make_data(raw, X->wdata[0] + J.nc * X->wstride[0]), X->dma_dst_stride, ss, X->dma_width_bytes, h);
+        xb_push(X);
+        dma_queue_push(X->dma, dma_make_data((uint8_t *) raw + (size_t) h * X->dma_dst_stride, X->wdata[1] + J.nc * X->wstride[1]),
+                       X->dma_dst_stride, ss, X->dma_width_bytes, h);
+        return xb_push(X);
+    }
+    dma_queue_push(X->dma, dma_make_data(raw, X->wdata[J.p] + J.nc * X->wstride[J.p]), X->dma_dst_stride, ss, X->dma_width_bytes, h);
+    return xb_push(X);
+}
+
+static inline void hmx_xb_dequant(hmx_xb_t * X, uint32_t s, const hmx_xb_job_t * J) {
+    if (X->i8) return;  // int8 weights go to HMX as they are
+    dequantize_tiled_weight_chunk_to_fp16_tiles(X->ctx, X->wbuf[s % 4], X->raw[s % 4], (int) J->dq_cols, X->k, X->row_stride,
+                                                X->weight_type, X->n_k_tiles, X->n_k_tiles_div, X->dq_fn, X->n_threads);
+}
+
+static uint32_t hmx_xb_push_act(hmx_xb_t * X, __fp16 * dst, size_t tile_row, uint32_t n_tile_rows) {
+    const size_t trb = (size_t) X->k * HTP_MM_HMX_TILE_N_ROWS * sizeof(__fp16);
+    dma_queue_push(X->dma, dma_make_data(dst, X->act_addr + tile_row * trb), 0, 0, (size_t) n_tile_rows * trb, 1);
+    return xb_push(X);
+}
+
+// int loop: tile rows [t0, t1) of block b's activations arrived -> int16 / int8 in place, row scales of those rows
+static inline void hmx_xb_act_quant(hmx_xb_t * X, const hmx_xb_job_t * J, uint32_t t0, uint32_t t1) {
+    if (!X->i8) return;
+    const size_t   rt_el = (size_t) (X->k / 32) * HTP_MM_HMX_TILE_N_ELMS;
+    const uint32_t r0    = t0 * HTP_MM_HMX_TILE_N_ROWS;
+    const uint32_t r1    = (uint32_t) hex_smin((size_t) t1 * HTP_MM_HMX_TILE_N_ROWS, J->n_rows);
+    float *        rs    = X->rs[J->b % 2] + r0;
+    if (X->a8) {
+        hmx_a8_act_quant_threaded(X->ctx, X->act + (size_t) t0 * rt_el, rs, r1 - r0, (uint32_t) X->k / 32, (uint32_t) X->n_threads);
+    } else {
+        hmx_i8_act_quant_threaded(X->ctx, X->act + (size_t) t0 * rt_el, rs, r1 - r0, (uint32_t) X->k / 32, (uint32_t) X->n_threads);
+    }
+}
