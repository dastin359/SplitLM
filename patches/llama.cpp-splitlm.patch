+
+// MOE_REDUCE: dst[:, t] = (src2[:, t] +) ((w0 x0 + w1 x1) + w2 x2) + ...   with x_e = src0[:, e, t], w_e = src1[0, e, t]
+// One pass over the expert outputs for the MUL by the router weights, the ADD chain over the experts and an
+// optional residual ADD, in the same order of multiplies and adds as the ops it replaces. The result is not bitwise
+// identical to the separate MUL/ADD ops (it rounds within the noise of a ubatch-size change; greedy text can drift
+// after some tokens). GGML_HEXAGON_MOE_REDUCE=0 restores the separate ops.
+// Each thread streams blocks of tokens through VTCM on its own DMA queue, two blocks in flight.
+#define MOE_REDUCE_MAX_E   16
+#define MOE_REDUCE_MAX_BLK 8
+
+typedef struct {
+    const struct htp_tensor * x;
+    const struct htp_tensor * w;
+    const struct htp_tensor * r;
+    const struct htp_tensor * d;
+    const struct htp_tensor * nd;           // optional normalized copy of d (rms_norm(d) * nw)
+    const float *             nw;           // norm weight row in VTCM
+    float                     eps;
+    struct htp_context *      ctx;
+    uint32_t                  n_tok;
+    uint32_t                  tok_per_task;
+    uint32_t                  blk;          // tokens per block
+    size_t                    thread_bytes; // VTCM per thread
+    bool                      x_f16;        // HTP_MOE_PARAM_X_F16: x rows are fp16 in the first half of each f32 row slot
+    bool                      qacc;         // HTP_MOE_PARAM_QACC: qf32 products and sums, one rounding at the end
+    bool                      f16_chain;    // x_f16, 4 experts: the qf32 chain of the f32 branch (bit-identical); else
+                                            // every op rounded (HTP_MOE_PARAM_X_F16 = 2, the round-5 numerics)
+    bool                      ntiled;       // HTP_MOE_PARAM_NORM = 2: nd is stored as fp16 HMX activation tiles
+    bool                      sched;        // HTP_MOE_PARAM_SCHED: the 4-expert fp16 chain loop without the residual branch
+} moe_reduce_ctx_t;
+
+// bytes of one expert row of x in VTCM (packed)
+static inline size_t moe_reduce_x_row(const moe_reduce_ctx_t * st) {
+    return (size_t) st->d->ne[0] * (st->x_f16 ? sizeof(__fp16) : sizeof(float));
+}
+
+static inline bool moe_reduce_x_flat(const moe_reduce_ctx_t * st) {
+    const size_t row = (size_t) st->d->ne[0] * sizeof(float);
+    return st->x->nb[1] == row && st->x->nb[2] == st->x->ne[1] * row;
+}
+
+static void moe_reduce_push_reads(const moe_reduce_ctx_t * st, dma_queue * q, uint8_t * xv, uint8_t * rv, uint32_t t, uint32_t nt) {
+    const uint32_t n   = st->d->ne[0];
+    const uint32_t n_e = st->x->ne[1];
+    const size_t   row = (size_t) n * sizeof(float);
+    const size_t   xr  = moe_reduce_x_row(st);
+    const struct htp_tensor * x = st->x;
+    if (moe_reduce_x_flat(st)) {
+        dma_queue_push(q, dma_make_data(xv, x->data + (size_t) t * x->nb[2]), xr, row, xr, (size_t) nt * n_e);
+    } else {
+        for (uint32_t k = 0; k < nt; ++k) {
+            dma_queue_push(q, dma_make_data(xv + (size_t) k * n_e * xr, x->data + (size_t) (t + k) * x->nb[2]), xr, x->nb[1], xr, n_e);
+        }
+    }
+    if (st->r) {
+        dma_queue_push(q, dma_make_data(rv, st->r->data + (size_t) t * st->r->nb[1]), row, st->r->nb[1], row, nt);
+    }
+}
+
+// Rounding barrier: hexagon-clang may fold an sf conversion into the following qf32 op (it does so in the straight-
+// line form of a 4-expert sum, see the n_e == 4 branch), which skips that rounding. The f32 and fp16 hand-offs are
+// bit-identical only while both run exactly the same roundings, so every rounding the per-op loops rely on goes
+// through this empty asm: the value has to exist as a rounded sf vector whatever the compiler does around it.
+static inline HVX_Vector moe_keep(HVX_Vector r) {
+    __asm__("" : "+v"(r));
+    return r;
+}
+
+static inline HVX_Vector moe_mul_f32(HVX_Vector a, HVX_Vector b) {
+    return moe_keep(hvx_vec_mul_f32_f32(a, b));
+}
+
+static inline HVX_Vector moe_add_f32(HVX_Vector a, HVX_Vector b) {
+    return moe_keep(hvx_vec_add_f32_f32(a, b));
+}
+
+static void moe_reduce_worker(unsigned int nth, unsigned int ith, void * data) {
+    (void) nth;
+    const moe_reduce_ctx_t * st = (const moe_reduce_ctx_t *) data;
+    const uint32_t t0 = ith * st->tok_per_task;
+    const uint32_t t1 = MIN(t0 + st->tok_per_task, st->n_tok);
+    if (t0 >= t1) return;
+
+    const uint32_t n    = st->d->ne[0];
+    const uint32_t n_e  = st->x->ne[1];
+    const uint32_t nvec = n / VLEN_FP32;  // n % VLEN_FP32 == 0
+    const size_t   row  = (size_t) n * sizeof(float);
+    const uint32_t blk  = st->blk;
+    const bool     has_r = st->r != NULL;
+
+    // per slot: x block, residual block, output block (+ normalized output block)
+    const bool   has_n   = st->nd != NULL;
+    const size_t xr      = moe_reduce_x_row(st);
+    const size_t x_bytes = (size_t) blk * n_e * xr;
+    const size_t r_bytes = (size_t) blk * row;
+    // ntiled: no f32 norm rows, the fp16 tiles (half a f32 row per row) take their place
+    const size_t slot    = x_bytes + (st->ntiled ? 2 * r_bytes + r_bytes / 2 : (has_n ? 3 : 2) * r_bytes);
+    const HVX_Vector inv_n_v   = hvx_vec_inverse_f32(hvx_vec_splat_f32((float) n));
+    const HVX_Vector epsilon_v = hvx_vec_splat_f32(st->eps);
+    uint8_t * base = st->ctx->vtcm_base + (size_t) ith * st->thread_bytes;
+    dma_queue * q = st->ctx->dma[ith];
+    struct htp_thread_trace * tr = &st->ctx->trace[ith];
+
+    const uint32_t n_tok = t1 - t0;
+    const uint32_t n_blk = (n_tok + blk - 1) / blk;
+#define MOE_BLK_N(b) MIN(blk, n_tok - (b) * blk)
+#define MOE_N_READS(nt) ((moe_reduce_x_flat(st) ? 1u : (nt)) + (has_r ? 1u : 0u))
+
+    for (uint32_t b = 0; b < n_blk && b < 2; ++b) {
+        uint8_t * s = base + (size_t) b * slot;
+        moe_reduce_push_reads(st, q, s, s + x_bytes, t0 + b * blk, MOE_BLK_N(b));
+    }
+
+    for (uint32_t b = 0; b < n_blk; ++b) {
+        uint8_t * s  = base + (size_t) (b & 1) * slot;
+        uint8_t * xv = s;
+        uint8_t * rv = s + x_bytes;
+        uint8_t * ov = s + x_bytes + r_bytes;
+        const uint32_t tb = t0 + b * blk;
+        const uint32_t nt = MOE_BLK_N(b);
+
+        uint8_t * nv = ov + r_bytes;
+        uint8_t * tv = nv;  // ntiled: the block's fp16 tile vectors, [k tile][row pair]
+
+        // FIFO: [write(b - 2) (+ normalized write)], reads(b)
+        if (b >= 2) {
+            dma_queue_pop(q);
+            if (has_n) {
+                dma_queue_pop(q);
+            }
+        }
+        for (uint32_t k = MOE_N_READS(nt); k > 0; --k) {
+            dma_queue_pop(q);
+        }
+
+        htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_COMP, (uint16_t) b);
+        for (uint32_t k = 0; k < nt; ++k) {
+            const uint8_t * wb = (const uint8_t *) st->w->data + (size_t) (tb + k) * st->w->nb[2];
+            const HVX_Vector * xs[MOE_REDUCE_MAX_E];
+            HVX_Vector ws[MOE_REDUCE_MAX_E];
+            for (uint32_t e = 0; e < n_e; ++e) {
+                xs[e] = (const HVX_Vector *) (xv + ((size_t) k * n_e + e) * xr);
+                ws[e] = hvx_vec_splat_f32(*(const float *) (wb + (size_t) e * st->w->nb[1]));
+            }
+            const HVX_Vector * rr = (const HVX_Vector *) (rv + (size_t) k * row);
+            HVX_Vector *       dr = (HVX_Vector *) (ov + (size_t) k * row);
+            if (st->qacc && st->x_f16) {
+                // HTP_MOE_PARAM_QACC: products and sums stay in qf32, one rounding to f32 at the end (fp16 x widened
+                // exactly to qf32, lanes in even / odd order as below)
+                const HVX_Vector one = hvx_vec_splat_f16(1.0);
+                HVX_Vector wq[MOE_REDUCE_MAX_E];
+                for (uint32_t e = 0; e < n_e; ++e) {
+                    wq[e] = Q6_Vqf32_vadd_VsfVsf(ws[e], Q6_V_vzero());
+                }
+                for (uint32_t v = 0; v < nvec / 2; ++v) {
+                    HVX_VectorPair p = Q6_Wqf32_vmpy_VhfVhf(xs[0][v], one);
+                    HVX_Vector s0 = Q6_Vqf32_vmpy_Vqf32Vqf32(Q6_V_lo_W(p), wq[0]);
+                    HVX_Vector s1 = Q6_Vqf32_vmpy_Vqf32Vqf32(Q6_V_hi_W(p), wq[0]);
+                    for (uint32_t e = 1; e < n_e; ++e) {
+                        p  = Q6_Wqf32_vmpy_VhfVhf(xs[e][v], one);
+                        s0 = Q6_Vqf32_vadd_Vqf32Vqf32(s0, Q6_Vqf32_vmpy_Vqf32Vqf32(Q6_V_lo_W(p), wq[e]));
+                        s1 = Q6_Vqf32_vadd_Vqf32Vqf32(s1, Q6_Vqf32_vmpy_Vqf32Vqf32(Q6_V_hi_W(p), wq[e]));
+                    }
+                    if (has_r) {
+                        const HVX_VectorPair rd = Q6_W_vdeal_VVR(rr[2 * v + 1], rr[2 * v], -4);
+                        s0 = Q6_Vqf32_vadd_Vqf32Vsf(s0, Q6_V_lo_W(rd));
+                        s1 = Q6_Vqf32_vadd_Vqf32Vsf(s1, Q6_V_hi_W(rd));
+                    }
+                    const HVX_VectorPair o = Q6_W_vshuff_VVR(Q6_Vsf_equals_Vqf32(s1), Q6_Vsf_equals_Vqf32(s0), -4);
+                    dr[2 * v]     = Q6_V_lo_W(o);
+                    dr[2 * v + 1] = Q6_V_hi_W(o);
+                }
+            } else if (st->qacc) {
+                #pragma unroll(2)
+                for (uint32_t v = 0; v < nvec; ++v) {
+                    HVX_Vector s0 = Q6_Vqf32_vmpy_VsfVsf(xs[0][v], ws[0]);
+                    for (uint32_t e = 1; e < n_e; ++e) {
+                        s0 = Q6_Vqf32_vadd_Vqf32Vqf32(s0, Q6_Vqf32_vmpy_VsfVsf(xs[e][v], ws[e]));
+                    }
+                    if (has_r) {
+                        s0 = Q6_Vqf32_vadd_Vqf32Vsf(s0, rr[v]);
+                    }
+                    dr[v] = Q6_Vsf_equals_Vqf32(s0);
+                }
+            } else if (st->x_f16 && n_e == 4 && st->f16_chain && st->sched) {
+                // HTP_MOE_PARAM_SCHED: the loop below with restrict pointers and without the residual test inside the
+                // loop body (it split every iteration into three basic blocks, so the tail conversions / stores of one
+                // iteration never shared packets with the next one's loads and multiplies); same operations per vector
+                const HVX_Vector one = hvx_vec_splat_f16(1.0);
+                const HVX_Vector * restrict x0 = xs[0];
+                const HVX_Vector * restrict x1 = xs[1];
+                const HVX_Vector * restrict x2 = xs[2];
+                const HVX_Vector * restrict x3 = xs[3];
+                const HVX_Vector * restrict rp = rr;
+                HVX_Vector * restrict       dp = dr;
+                const HVX_Vector w0 = ws[0], w1 = ws[1], w2 = ws[2], w3 = ws[3];
+#define MOE_F16_CHAIN_SUM(v, s0, s1) do {                                                                \
+        const HVX_VectorPair p0_ = Q6_Wqf32_vmpy_VhfVhf(x0[(v)], one);                                    \
+        const HVX_VectorPair p1_ = Q6_Wqf32_vmpy_VhfVhf(x1[(v)], one);                                    \
+        const HVX_VectorPair p2_ = Q6_Wqf32_vmpy_VhfVhf(x2[(v)], one);                                    \
+        const HVX_VectorPair p3_ = Q6_Wqf32_vmpy_VhfVhf(x3[(v)], one);                                    \
+        s0 = Q6_Vqf32_vmpy_VsfVsf(Q6_Vsf_equals_Vqf32(Q6_V_lo_W(p0_)), w0);                               \
+        s1 = Q6_Vqf32_vmpy_VsfVsf(Q6_Vsf_equals_Vqf32(Q6_V_hi_W(p0_)), w0);                               \
+        s0 = Q6_Vqf32_vadd_Vqf32Vqf32(s0, Q6_Vqf32_vmpy_VsfVsf(Q6_Vsf_equals_Vqf32(Q6_V_lo_W(p1_)), w1)); \
+        s1 = Q6_Vqf32_vadd_Vqf32Vqf32(s1, Q6_Vqf32_vmpy_VsfVsf(Q6_Vsf_equals_Vqf32(Q6_V_hi_W(p1_)), w1)); \
+        s0 = Q6_Vqf32_vadd_Vqf32Vqf32(s0, Q6_Vqf32_vmpy_VsfVsf(Q6_Vsf_equals_Vqf32(Q6_V_lo_W(p2_)), w2)); \
+        s1 = Q6_Vqf32_vadd_Vqf32Vqf32(s1, Q6_Vqf32_vmpy_VsfVsf(Q6_Vsf_equals_Vqf32(Q6_V_hi_W(p2_)), w2)); \
+        s0 = Q6_Vqf32_vadd_Vqf32Vqf32(s0, Q6_Vqf32_vmpy_VsfVsf(Q6_Vsf_equals_Vqf32(Q6_V_lo_W(p3_)), w3)); \
+        s1 = Q6_Vqf32_vadd_Vqf32Vqf32(s1, Q6_Vqf32_vmpy_VsfVsf(Q6_Vsf_equals_Vqf32(Q6_V_hi_W(p3_)), w3)); \
+    } while (0)
+                if (has_r) {
+                    #pragma unroll(2)
+                    for (uint32_t v = 0; v < nvec / 2; ++v) {
+                        HVX_Vector s0, s1;
+                        MOE_F16_CHAIN_SUM(v, s0, s1);
+                        const HVX_VectorPair rd = Q6_W_vdeal_VVR(rp[2 * v + 1], rp[2 * v], -4);
+                        s0 = Q6_Vqf32_vadd_Vqf32Vsf(s0, Q6_V_lo_W(rd));
+                        s1 = Q6_Vqf32_vadd_Vqf32Vsf(s1, Q6_V_hi_W(rd));
+                        const HVX_VectorPair o = Q6_W_vshuff_VVR(Q6_Vsf_equals_Vqf32(s1), Q6_Vsf_equals_Vqf32(s0), -4);
+                        dp[2 * v]     = Q6_V_lo_W(o);
+                        dp[2 * v + 1] = Q6_V_hi_W(o);
+                    }
+                } else {
+                    #pragma unroll(2)
+                    for (uint32_t v = 0; v < nvec / 2; ++v) {
+                        HVX_Vector s0, s1;
+                        MOE_F16_CHAIN_SUM(v, s0, s1);
+                        const HVX_VectorPair o = Q6_W_vshuff_VVR(Q6_Vsf_equals_Vqf32(s1), Q6_Vsf_equals_Vqf32(s0), -4);
+                        dp[2 * v]     = Q6_V_lo_W(o);
+                        dp[2 * v + 1] = Q6_V_hi_W(o);
+                    }
+                }
+#undef MOE_F16_CHAIN_SUM
+            } else if (st->x_f16 && n_e == 4 && st->f16_chain) {
+                // fp16 rows, 4 experts: each vector widens exactly (as the f32 scatter of the producer did) to the
+                // even / odd elements of 64 columns, then the same qf32 chain as the f32 branch below (bit-identical
+                // results); the sums run on that lane order and are re-interleaved once
+                const HVX_Vector one = hvx_vec_splat_f16(1.0);
+                for (uint32_t v = 0; v < nvec / 2; ++v) {
+                    HVX_Vector a[4], b[4];
+                    for (uint32_t e = 0; e < 4; ++e) {
+                        const HVX_VectorPair p = Q6_Wqf32_vmpy_VhfVhf(xs[e][v], one);
+                        // no moe_keep on this exact widening: the barrier here cost ~1.5% of LFM prefill (worse
+                        // scheduling). Folding it would turn the next vmpy into qf32 x qf32 and break the bit-exact
+                        // match, which GGML_TEST_SEED + GGML_TEST_HASH runs of MOE_DOWN_REDUCE (F16=0 vs 1) detect
+                        a[e] = Q6_Vsf_equals_Vqf32(Q6_V_lo_W(p));
+                        b[e] = Q6_Vsf_equals_Vqf32(Q6_V_hi_W(p));
+                    }
+                    HVX_Vector s0 = Q6_Vqf32_vmpy_VsfVsf(a[0], ws[0]);
+                    HVX_Vector s1 = Q6_Vqf32_vmpy_VsfVsf(b[0], ws[0]);
+                    for (uint32_t e = 1; e < 4; ++e) {
+                        s0 = Q6_Vqf32_vadd_Vqf32Vqf32(s0, Q6_Vqf32_vmpy_VsfVsf(a[e], ws[e]));
+                        s1 = Q6_Vqf32_vadd_Vqf32Vqf32(s1, Q6_Vqf32_vmpy_VsfVsf(b[e], ws[e]));
+                    }
+                    if (has_r) {
+                        const HVX_VectorPair rd = Q6_W_vdeal_VVR(rr[2 * v + 1], rr[2 * v], -4);
+                        s0 = Q6_Vqf32_vadd_Vqf32Vsf(s0, Q6_V_lo_W(rd));
+                        s1 = Q6_Vqf32_vadd_Vqf32Vsf(s1, Q6_V_hi_W(rd));
+                    }
+                    const HVX_VectorPair o = Q6_W_vshuff_VVR(Q6_Vsf_equals_Vqf32(s1), Q6_Vsf_equals_Vqf32(s0), -4);
+                    dr[2 * v]     = Q6_V_lo_W(o);
+                    dr[2 * v + 1] = Q6_V_hi_W(o);
+                }
+            } else if (st->x_f16) {
+                // fp16 rows (n % 64 == 0): each vector widens exactly (as the f32 scatter of the producer did) to the
+                // even / odd elements of 64 columns; the sums run on that lane order and are re-interleaved once.
+                // Every product and sum is rounded to f32 (moe_keep), as in the generic f32 loop below (n_e != 4).
+                const HVX_Vector one = hvx_vec_splat_f16(1.0);
+                #define MOE_X16(e, v, lo_, hi_) do { const HVX_VectorPair p_ = Q6_Wqf32_vmpy_VhfVhf(xs[(e)][(v)], one); lo_ = moe_keep(Q6_Vsf_equals_Vqf32(Q6_V_lo_W(p_))); hi_ = moe_keep(Q6_Vsf_equals_Vqf32(Q6_V_hi_W(p_))); } while (0)
+                for (uint32_t v = 0; v < nvec / 2; ++v) {
+                    HVX_Vector a0, a1, b0, b1;
+                    MOE_X16(0, v, a0, a1);
+                    HVX_Vector s0 = moe_mul_f32(a0, ws[0]);
+                    HVX_Vector s1 = moe_mul_f32(a1, ws[0]);
+                    for (uint32_t e = 1; e < n_e; ++e) {
+                        MOE_X16(e, v, b0, b1);
+                        s0 = moe_add_f32(s0, moe_mul_f32(b0, ws[e]));
+                        s1 = moe_add_f32(s1, moe_mul_f32(b1, ws[e]));
+                    }
+                    if (has_r) {
+                        const HVX_VectorPair rd = Q6_W_vdeal_VVR(rr[2 * v + 1], rr[2 * v], -4);
+                        s0 = moe_add_f32(Q6_V_lo_W(rd), s0);
+                        s1 = moe_add_f32(Q6_V_hi_W(rd), s1);
+                    }
+                    const HVX_VectorPair o = Q6_W_vshuff_VVR(s1, s0, -4);
+                    dr[2 * v]     = Q6_V_lo_W(o);
+                    dr[2 * v + 1] = Q6_V_hi_W(o);
+                }
+                #undef MOE_X16
+            } else if (n_e == 4) {
+                // qf32 products and sums, one rounding at the end: written out, this is the code hexagon-clang
+                // generated for the per-op rounded form of this straight-line sum (it folds each sf conversion into
+                // the next qf32 add), so results do not depend on that optimization; the fp16 branch above matches it
+                #pragma unroll(2)
+                for (uint32_t v = 0; v < nvec; ++v) {
+                    HVX_Vector s0 = Q6_Vqf32_vmpy_VsfVsf(xs[0][v], ws[0]);
+                    s0 = Q6_Vqf32_vadd_Vqf32Vqf32(s0, Q6_Vqf32_vmpy_VsfVsf(xs[1][v], ws[1]));
+                    s0 = Q6_Vqf32_vadd_Vqf32Vqf32(s0, Q6_Vqf32_vmpy_VsfVsf(xs[2][v], ws[2]));
+                    s0 = Q6_Vqf32_vadd_Vqf32Vqf32(s0, Q6_Vqf32_vmpy_VsfVsf(xs[3][v], ws[3]));
+                    if (has_r) {
+                        s0 = Q6_Vqf32_vadd_Vqf32Vsf(s0, rr[v]);
+                    }
+                    dr[v] = Q6_Vsf_equals_Vqf32(s0);
+                }
+            } else {
+                for (uint32_t v = 0; v < nvec; ++v) {
+                    HVX_Vector s0 = moe_mul_f32(xs[0][v], ws[0]);
+                    for (uint32_t e = 1; e < n_e; ++e) {
+                        s0 = moe_add_f32(s0, moe_mul_f32(xs[e][v], ws[e]));
+                    }
+                    dr[v] = has_r ? moe_add_f32(rr[v], s0) : s0;
+                }
+            }
+            if (has_n && !st->ntiled) {
+                // same kernel as the RMS_NORM+MUL op on these rows
+                hvx_fast_rms_norm_mul_f32((const uint8_t *) dr, (const uint8_t *) st->nw, nv + (size_t) k * row, n, inv_n_v, epsilon_v);
+            }
+        }
+        const uint32_t npair = nt / 2;  // ntiled: nt is even (blocks of an even size, token ranges of whole tile rows)
+        if (st->ntiled) {
+            // norm and fp16 tile conversion in one pass per row pair (row pair p of k tile c): the per-row scale and
+            // per-element arithmetic of hvx_fast_rms_norm_mul_f32, then the conversion a 2D HMX matmul's activation
+            // prep runs on f32 rows (as the norm op's tiled_fused pass; bit-identical tiles)
+            HVX_Vector * restrict tvv = (HVX_Vector *) tv;
+            const HVX_Vector * restrict vw = (const HVX_Vector *) st->nw;
+            for (uint32_t p = 0; p < npair; ++p) {
+                const HVX_Vector * row0 = (const HVX_Vector *) (ov + (size_t) (2 * p) * row);
+                const HVX_Vector * row1 = (const HVX_Vector *) (ov + (size_t) (2 * p + 1) * row);
+                HVX_Vector s0, s1;
+                hvx_rms_row_scale2_f32(row0, row1, (int) nvec, inv_n_v, epsilon_v, &s0, &s1);
+                if (st->sched) {
+                    // HTP_MOE_PARAM_SCHED: two columns per step, each stage written for both, restrict rows (hexagon-clang
+                    // kept the unrolled columns of the loop below in sequence: 37 packets per 4 columns on v73, this one
+                    // ~13 per 2); the same operations per column
+                    const HVX_Vector * restrict r0p = row0;
+                    const HVX_Vector * restrict r1p = row1;
+                    uint32_t c = 0;
+                    for (; c + 2 <= nvec; c += 2) {
+                        const HVX_Vector m0 = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(r0p[c], s0));
+                        const HVX_Vector m1 = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(r1p[c], s1));
+                        const HVX_Vector m2 = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(r0p[c + 1], s0));
+                        const HVX_Vector m3 = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(r1p[c + 1], s1));
+                        const HVX_Vector a0 = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(m0, vw[c]));
+                        const HVX_Vector b0 = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(m1, vw[c]));
+                        const HVX_Vector a1 = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(m2, vw[c + 1]));
+                        const HVX_Vector b1 = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(m3, vw[c + 1]));
+                        tvv[(size_t) c * npair + p]       = hvx_vec_f32_to_f16_shuff(a0, b0);
+                        tvv[(size_t) (c + 1) * npair + p] = hvx_vec_f32_to_f16_shuff(a1, b1);
+                    }
+                    for (; c < nvec; ++c) {
+                        const HVX_Vector a = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(r0p[c], s0)), vw[c]));
+                        const HVX_Vector b = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(r1p[c], s1)), vw[c]));
+                        tvv[(size_t) c * npair + p] = hvx_vec_f32_to_f16_shuff(a, b);
+                    }
+                    continue;
+                }
+                #pragma unroll(4)
+                for (uint32_t c = 0; c < nvec; ++c) {
+                    const HVX_Vector a = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(row0[c], s0)), vw[c]));
+                    const HVX_Vector b = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(row1[c], s1)), vw[c]));
+                    tvv[(size_t) c * npair + p] = hvx_vec_f32_to_f16_shuff(a, b);
+                }
+            }
+        }
+        htp_trace_event_stop(tr, HTP_TRACE_EVT_HVX_COMP, (uint16_t) b);
+
+        dma_queue_push(q, dma_make_data(st->d->data + (size_t) tb * st->d->nb[1], ov), st->d->nb[1], row, row, nt);
+        if (st->ntiled) {
+            // rows tb .. tb + nt of tile row tb / 32: npair vectors at vector (tb % 32) / 2 of each 2 KB k tile
+            const uint64_t td = st->nd->data + (size_t) (tb / 32) * nvec * 2048 + (size_t) ((tb % 32) / 2) * 128;
+            dma_queue_push(q, dma_make_data(td, tv), 2048, (size_t) npair * 128, (size_t) npair * 128, nvec);
+        } else if (has_n) {
+            dma_queue_push(q, dma_make_data(st->nd->data + (size_t) tb * st->nd->nb[1], nv), st->nd->nb[1], row, row, nt);
+        }
+        if (b + 2 < n_blk) {
+            moe_reduce_push_reads(st, q, xv, rv, t0 + (b + 2) * blk, MOE_BLK_N(b + 2));
+        }
+    }
+#undef MOE_N_READS
+#undef MOE_BLK_N
+    dma_queue_flush(q);
+}
+
+int op_moe_reduce(struct htp_ops_context * octx) {
+    const struct htp_tensor * x = octx->src[0];
+    const struct htp_tensor * w = octx->src[1];
+    const struct htp_tensor * r = octx->src[2];
+    const struct htp_tensor * d = octx->dst;
+    if (!x || !w || !d || x->type != HTP_TYPE_F32 || w->type != HTP_TYPE_F32 || d->type != HTP_TYPE_F32 ||
+        x->ne[1] < 1 || x->ne[1] > MOE_REDUCE_MAX_E || (r && r->type != HTP_TYPE_F32) || d->ne[0] % VLEN_FP32 != 0) {
+        return HTP_STATUS_NO_SUPPORT;
+    }
+
+    moe_reduce_ctx_t st;
+    st.x     = x;
+    st.w     = w;
+    st.r     = r;
+    st.d     = d;
+    st.ctx   = octx->ctx;
+    st.n_tok = d->ne[1];
+    st.nd    = NULL;
+    st.nw    = NULL;
+    st.eps   = 0.0f;
+    st.x_f16 = octx->op_params[HTP_MOE_PARAM_X_F16] == 1 || octx->op_params[HTP_MOE_PARAM_X_F16] == 2;
+    st.f16_chain = octx->op_params[HTP_MOE_PARAM_X_F16] == 1;
+    st.sched = octx->op_params[HTP_MOE_PARAM_SCHED] == 1;
+    st.qacc  = octx->op_params[HTP_MOE_PARAM_QACC] == 1;
+    if (st.x_f16 && (d->ne[0] % 64 != 0 || x->nb[1] < (size_t) d->ne[0] * sizeof(float))) {
+        return HTP_STATUS_NO_SUPPORT;
+    }
+
+    const bool has_n = octx->op_params[HTP_MOE_PARAM_NORM] == 1 || octx->op_params[HTP_MOE_PARAM_NORM] == 2;
+    st.ntiled = octx->op_params[HTP_MOE_PARAM_NORM] == 2;
+    if (st.ntiled && (d->ne[0] % 32 != 0 || d->ne[1] % 32 != 0 || d->ne[0] / 32 > 65535)) {
+        return HTP_STATUS_NO_SUPPORT;
+    }
+    if (has_n) {
+        const struct htp_tensor * nd = octx->dsts[1];
+        const struct htp_tensor * nw = octx->src[3];
+        if (!nd || !nw || nd->type != HTP_TYPE_F32 || nw->type != HTP_TYPE_F32 || nd->ne[0] != d->ne[0] ||
+            nd->ne[1] != d->ne[1] || nw->ne[0] != d->ne[0]) {
+            return HTP_STATUS_NO_SUPPORT;
+        }
+        st.nd = nd;
+        memcpy(&st.eps, &octx->op_params[HTP_MOE_PARAM_NORM_EPS], sizeof(float));
+    }
+
+    const uint32_t n_threads = octx->n_threads > 0 ? octx->n_threads : 1;
+    const size_t   row       = (size_t) d->ne[0] * sizeof(float);
+    const size_t   xrow      = (size_t) d->ne[0] * (st.x_f16 ? sizeof(__fp16) : sizeof(float));
+    const size_t   per_tok   = 2 * ((size_t) x->ne[1] * xrow + (st.ntiled ? 2 * row + row / 2 : (has_n ? 3 : 2) * row));  // two slots
+    const size_t   w_bytes   = has_n ? row : 0;
+    uint32_t blk = MOE_REDUCE_MAX_BLK;
+    while (blk > 1 && per_tok * blk * n_threads + w_bytes > octx->ctx->vtcm_size) blk /= 2;
+    if (per_tok * blk * n_threads + w_bytes > octx->ctx->vtcm_size || (st.ntiled && blk < 2)) {
+        return HTP_STATUS_VTCM_TOO_SMALL;
+    }
+    st.blk          = blk;
+    st.thread_bytes = per_tok * blk;  // row is a multiple of 128 bytes
+
+    if (has_n) {
+        float * vw = (float *) (octx->ctx->vtcm_base + st.thread_bytes * n_threads);
+        dma_queue * q = octx->ctx->dma[0];
+        dma_queue_push(q, dma_make_data(vw, octx->src[3]->data), row, 0, row, 1);
+        dma_queue_pop(q);
+        st.nw = vw;
+    }
+
+    st.tok_per_task = (st.n_tok + n_threads - 1) / n_threads;
+    if (st.ntiled) {
+        st.tok_per_task = (st.tok_per_task + 31) & ~31u;  // whole tile rows per thread (blocks never straddle a thread)
+    }
+    const uint32_t n_tasks = st.tok_per_task ? (st.n_tok + st.tok_per_task - 1) / st.tok_per_task : 0;
+    if (n_tasks <= 1) {
+        moe_reduce_worker(1, 0, &st);
+    } else {
+        worker_pool_run_func(octx->ctx->worker_pool, moe_reduce_worker, &st, n_tasks);
+    }
+    return HTP_STATUS_OK;
+}
