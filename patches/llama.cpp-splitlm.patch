+        HVX_Vector vq = Q6_V_vzero();
+        for (int group = 3; group >= 0; --group) {
+            vq = Q6_V_vmux_QVV(first4, Q6_V_vror_VR(hvx_vmem(tile + group * VLEN), 4 * row), Q6_V_vror_VR(vq, VLEN - 4));
