+                const uint32_t       b_tile = col_half * 2 + j / 16;
+                HVX_Vector * tr = (HVX_Vector *) (kT_row + (b_tile * 2 + c0) * HMX_FP16_TILE_N_ELMS) + j % 16;
+                HVX_Vector * tc = (HVX_Vector *) (k_col + (c0 * n_sv + b_tile) * HMX_FP16_TILE_N_ELMS) + j % 16;
