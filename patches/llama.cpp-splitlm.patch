+// LFM2-style FFN input: a MUL_MAT+ADD residual, its RMS_NORM+MUL read by a 2D matmul (the router) and, through a
+// reshape, by the expert gate/up MUL_MAT_IDs (fixed expert ids). On HTP the norm stores fp16 tiles + fp16 rows
+// (GGML_HEXAGON_NORM_ROWS16), and the producing matmul may store both itself (GGML_HEXAGON_NORM_EPI_R16)
+struct test_moe_ffn_norm : public test_case {
+    const int64_t n_embd, n_tokens, n_ff;
+
+    test_moe_ffn_norm(int64_t n_embd, int64_t n_tokens, int64_t n_ff) : n_embd(n_embd), n_tokens(n_tokens), n_ff(n_ff) {}
+
+    std::string vars() override {
+        return VARS_TO_STR3(n_embd, n_tokens, n_ff);
+    }
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "MOE_FFN_NORM";
+    }
+
+    // fp16 activations on HTP vs q8_0 activations on the CPU
+    double max_nmse_err() override { return 5e-3; }
+
+    bool run_whole_graph() override { return true; }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        const int64_t n_expert = 8, n_used = 2;
+        ggml_tensor * x     = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_embd, n_tokens);
+        ggml_tensor * resid = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_embd, n_tokens);
+        ggml_tensor * wo    = ggml_new_tensor_2d(ctx, GGML_TYPE_Q4_0, n_embd, n_embd);
+        ggml_tensor * nw    = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, n_embd);
+        ggml_tensor * wr    = ggml_new_tensor_2d(ctx, GGML_TYPE_Q4_0, n_embd, n_embd);
+        ggml_tensor * gate  = ggml_new_tensor_3d(ctx, GGML_TYPE_Q4_0, n_embd, n_ff, n_expert);
+        ggml_tensor * up    = ggml_new_tensor_3d(ctx, GGML_TYPE_Q4_0, n_embd, n_ff, n_expert);
+        ggml_tensor * ids_a = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, n_expert, n_tokens);
+        ggml_tensor * ids   = ggml_view_2d(ctx, ids_a, n_used, n_tokens, ids_a->nb[1], 0);
+
+        ggml_tensor * l  = ggml_add(ctx, ggml_mul_mat(ctx, wo, x), resid);
+        ggml_tensor * h  = ggml_mul(ctx, ggml_rms_norm(ctx, l, 1e-5f), nw);
+        ggml_tensor * r  = ggml_mul_mat(ctx, wr, h);
+        ggml_tensor * h3 = ggml_reshape_3d(ctx, h, n_embd, 1, n_tokens);
+        ggml_tensor * a  = ggml_swiglu_split(ctx, ggml_mul_mat_id(ctx, gate, h3, ids), ggml_mul_mat_id(ctx, up, h3, ids));
+        // [n_ff, n_used, n_tokens]: sum over the selected experts, then fold into n_embd columns next to the router output
+        ggml_tensor * s = nullptr;
+        for (int64_t e = 0; e < n_used; ++e) {
+            ggml_tensor * v = ggml_view_2d(ctx, a, n_ff, n_tokens, a->nb[2], e * a->nb[1]);
+            s = s ? ggml_add(ctx, s, v) : v;
+        }
+        ggml_tensor * out = ggml_add(ctx, ggml_view_2d(ctx, r, n_ff, n_tokens, r->nb[1], 0), s);
+        ggml_set_name(out, "out");
+        return out;
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        init_mul_mat_id_tensors(ctx, 8);
+    }
+};
