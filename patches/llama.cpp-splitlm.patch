+typedef union {
+    hmx_matmul_job_t f;
+    hmx_i8_job_t     q;
+} hmx_xb_hjob_t;
+
+// HMX sub-job of job j over activation tile rows [t0, t1)
+static inline void hmx_xb_submit(hmx_xb_t * X, hmx_xb_hjob_t * hj, uint32_t j, uint32_t s, uint32_t nct, uint32_t t0, uint32_t t1) {
+    const uint32_t ndt   = (uint32_t) X->k / HTP_MM_HMX_TILE_N_ROWS;
+    const size_t   rt_el = (size_t) ndt * HTP_MM_HMX_TILE_N_ELMS;
+    const size_t   oo    = (size_t) t0 * nct * HTP_MM_HMX_TILE_N_ELMS;
+    if (X->i8) {
+        hmx_i8_job_t * Q = &hj->q;
+        Q->out_lo = X->obuf[j % 2] + oo; Q->out_hi = X->hi[j % 2] + oo; Q->act = X->act + (size_t) t0 * rt_el;
+        Q->wt = X->w8[s % 4]; Q->meta = X->m8[s % 4];
+        Q->n_row_tiles = t1 - t0; Q->n_col_tiles = nct; Q->n_dot_tiles = ndt;
+        hmx_xb_hmx_push(X, hmx_queue_make_desc(X->a8 ? hmx_a8_worker_fn : hmx_i8_worker_fn, Q));
+        return;
+    }
+    hmx_matmul_job_init(&hj->f, X->obuf[j % 2] + oo, X->act + (size_t) t0 * rt_el, (const __fp16 *) X->wbuf[s % 4], X->scales, t1 - t0, nct, ndt);
+    hmx_xb_hmx_push(X, hmx_queue_make_desc(hmx_matmul_worker_fn, &hj->f));
+}
+
+static void hmx_xb_run(hmx_xb_t * X) {
+    struct htp_context * ctx     = X->ctx;
+    const uint32_t       n_jobs  = X->n_jobs;
+    const uint32_t       ndt     = (uint32_t) X->k / HTP_MM_HMX_TILE_N_ROWS;
+    const size_t         rt_el   = (size_t) ndt * HTP_MM_HMX_TILE_N_ELMS;  // fp16 elements of one activation tile row
+    const uint32_t       nrt_mc  = (uint32_t) hmx_ceil_div(X->mc, HTP_MM_HMX_TILE_N_ROWS);
+    const uint32_t       ng      = (uint32_t) hex_smin(hex_smax(X->groups, 1u), (uint32_t) HMX_XB_MAX_RG);
+    uint32_t             G       = hmx_ceil_div(nrt_mc, ng);  // tile rows per row group
+    if (X->a8 && (G & 1)) G++;                               // W8A8 jobs work in 64-row units
+    const uint32_t       n_slots = hmx_xb_slot(X, n_jobs - 1) + 1;
+
+    hmx_xb_hjob_t slots[2][HMX_XB_MAX_RG];
+    uint32_t      nsub[2]  = { 0, 0 };
+    uint32_t      seqW[4]  = { 0 };
+    uint32_t      seqA[HMX_XB_MAX_RG] = { 0 };
+
+    X->dq_push = X->dq_pop = 0;
+    hmx_xb_job_t J0;
+    hmx_xb_job(X, 0, &J0);
+    seqW[0] = hmx_xb_push_w(X, 0);
+    const uint32_t nrt0     = (uint32_t) hmx_ceil_div(J0.n_rows, HTP_MM_HMX_TILE_N_ROWS);
+    uint32_t       seq_act0 = 0;
+    if (X->head) {
+        for (uint32_t t0 = 0, g = 0; t0 < nrt0; t0 += G, g++) {
+            seqA[g] = hmx_xb_push_act(X, X->act + (size_t) t0 * rt_el, J0.mr / HTP_MM_HMX_TILE_N_ROWS + t0, (uint32_t) hex_smin(G, nrt0 - t0));
+        }
+        if (X->spin) hmx_queue_spin_begin(ctx->hmx_queue);
+    } else {
+        seq_act0 = hmx_xb_push_act(X, X->act, J0.mr / HTP_MM_HMX_TILE_N_ROWS, nrt0);
+    }
+    if (n_slots > 1) seqW[1] = hmx_xb_push_w(X, 1);
+    if (X->stage) hmx_xb_push_stage(X, 0);
+
+    bool     prepped = false;  // (no snake) job j's weights were dequantized at the block boundary
+    uint32_t defer_s = 0;      // weight slot whose DMA waits until the boundary's activation DMAs are queued (0 = none)
+    for (uint32_t j = 0; j < n_jobs; ++j) {
+        hmx_xb_job_t J;
+        hmx_xb_job(X, j, &J);
+        const uint32_t r        = j % X->jpb;
+        const bool     split_in = r == 0 && (j > 0 || X->head);         // first job of a block: groups arrive one by one
+        const bool     last     = r == X->jpb - 1 && j + 1 < n_jobs;    // last job of a block with a next block
+        const uint32_t sj       = hmx_xb_slot(X, j);
+        if (!prepped && !hmx_xb_reuse(X, j)) {
+            xb_wait(X, seqW[sj % 4]);
+            hmx_xb_dequant(X, sj, &J);
+            if (sj + 2 < n_slots) {
+                if (last && X->snake) defer_s = sj + 2;  // after the activation refill
+                else seqW[(sj + 2) % 4] = hmx_xb_push_w(X, sj + 2);
+            }
+        }
+        if (j == 0 && !X->head) {
+            xb_wait(X, seq_act0);
+            hmx_xb_act_quant(X, &J0, 0, nrt0);
+        }
+        prepped = false;
+
+        // C_j: one job, or row-group sub-jobs at a block boundary
+        const uint32_t nrt  = (uint32_t) hmx_ceil_div(J.n_rows, HTP_MM_HMX_TILE_N_ROWS);
+        const uint32_t nct  = hmx_ceil_div(J.dq_cols, HTP_MM_HMX_TILE_N_COLS);
+        const uint32_t step = (split_in || last) ? G : nrt;
+        uint32_t       ns   = 0;
+        for (uint32_t t0 = 0; t0 < nrt; t0 += step) {
+            const uint32_t t1 = (uint32_t) hex_smin(t0 + step, nrt);
+            if (split_in) {
+                xb_wait(X, seqA[ns]);
+                hmx_xb_act_quant(X, &J, t0, t1);
+            }
+            hmx_xb_submit(X, &slots[j % 2][ns], j, sj, nct, t0, t1);
+            ns++;
+        }
+        nsub[j % 2] = ns;
+        if (split_in && X->spin) hmx_queue_spin_end(ctx->hmx_queue);
+
+        // D_{j-1} (the last job of the previous block was popped at the boundary)
+        if (j > 0) {
+            if (r != 0) {
+                for (uint32_t s = 0; s < nsub[(j - 1) % 2]; s++) hmx_queue_pop(ctx->hmx_queue);
+            }
+            hmx_xb_store(X, j - 1, X->obuf[(j - 1) % 2]);
+        }
+
+        if (last) {
+            // HMX runs C_j: (no snake) prepare the next block's first chunk, then refill the activation rows group by group
+            const uint32_t F = j + 1;
+            hmx_xb_job_t   JF;
+            hmx_xb_job(X, F, &JF);
+            if (X->spin) hmx_queue_spin_begin(ctx->hmx_queue);
+            if (!hmx_xb_reuse(X, F)) {
+                const uint32_t sf = hmx_xb_slot(X, F);
+                xb_wait(X, seqW[sf % 4]);
+                hmx_xb_dequant(X, sf, &JF);
+                if (sf + 2 < n_slots) defer_s = sf + 2;
+                prepped = true;
+            }
+            const uint32_t nrtF = (uint32_t) hmx_ceil_div(JF.n_rows, HTP_MM_HMX_TILE_N_ROWS);  // <= nrt (only the last block is short)
+            for (uint32_t s = 0; s < nsub[j % 2]; s++) {
+                hmx_queue_pop(ctx->hmx_queue);  // sub-job s of C_j: its rows are free
+                const uint32_t t0 = s * G, t1 = (uint32_t) hex_smin(t0 + G, nrtF);
+                if (t0 < t1) seqA[s] = hmx_xb_push_act(X, X->act + (size_t) t0 * rt_el, JF.mr / HTP_MM_HMX_TILE_N_ROWS + t0, t1 - t0);
+            }
+            if (defer_s) {
+                seqW[defer_s % 4] = hmx_xb_push_w(X, defer_s);
+                defer_s = 0;
+            }
+        }
+    }
+    for (uint32_t s = 0; s < nsub[(n_jobs - 1) % 2]; s++) hmx_queue_pop(ctx->hmx_queue);
+    hmx_xb_store(X, n_jobs - 1, X->obuf[(n_jobs - 1) % 2]);
+}
+
+static inline void hmx_xb_knobs(const struct htp_context * ctx, hmx_xb_t * X) {
+    const uint32_t kn = (ctx->op_flags >> HTP_OPFLAG_MM_XB_KNOB_SHIFT) & 0xf;
+    // W8A8: the per-group activation quantization runs in 64-row units over the HVX threads -> two big groups (2B pp4096
+    // 2899 vs 2753 t/s with 8); fp16 / W8A16: 8 groups
+    X->groups = (kn & 7) ? (kn & 7) : (X->a8 ? 2 : HMX_XB_MAX_RG);
+    X->spin   = !(kn & 8);
+    X->snake  = !(ctx->op_flags & HTP_OPFLAG_MM_XB_NOSNAKE);
+    X->head   = !(ctx->op_flags & HTP_OPFLAG_MM_XB_NOHEAD);
+    hmx_xb_plan_order(X);
+}
+
+// GGML_HEXAGON_I8 / A8 int loop of the cross-block pipeline: the weight slots, readout windows and row scales of the
+// int8 plan (the second row-scale buffer sits after the meta slots of the first raw area, like the first one in the
+// second raw area: hmx_i8_plan reserves the same bytes in both)
+static inline void hmx_xb_set_i8(hmx_xb_t * X, const hmx_i8_plan_t * P8, bool a8) {
+    X->i8 = true;
+    X->a8 = a8;
+    X->mc = P8->mc;
+    for (int s = 0; s < 4; s++) { X->w8[s] = P8->w[s]; X->m8[s] = P8->meta[s]; }
+    X->hi[0] = P8->hi[0];
+    X->hi[1] = P8->hi[1];
+    X->rs[0] = P8->row_scale;
+    X->rs[1] = (float *) (P8->meta[2] + (P8->meta[2] - P8->meta[0]));
+}
