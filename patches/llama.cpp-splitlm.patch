+// HTP_MMID_STREAM_ACT_TILED fallback: copy whole HMX activation tile rows (already in the layout the HMX job
+// reads) from the producer's expert-sorted fp16 block into VTCM, split over the HVX threads.
+struct hmx_mmid_tiled_copy_state {
+    HVX_Vector *       dst;
+    const HVX_Vector * src;
+    size_t             n_vecs;
+    unsigned int       n_tasks;
+    struct htp_thread_trace * traces;
+};
+
+static void hmx_mmid_tiled_copy_worker_fn(unsigned int n, unsigned int i, void * data) {
+    const struct hmx_mmid_tiled_copy_state * st = (const struct hmx_mmid_tiled_copy_state *) data;
+    struct htp_thread_trace * tr = &st->traces[i];
+    htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_A_PREP, i);
+    const size_t per = (st->n_vecs + st->n_tasks - 1) / st->n_tasks;
+    const size_t v0  = (size_t) i * per;
+    const size_t v1  = v0 + per < st->n_vecs ? v0 + per : st->n_vecs;
+    for (size_t v = v0; v < v1; ++v) {
+        st->dst[v] = st->src[v];
+    }
+    htp_trace_event_stop(tr, HTP_TRACE_EVT_HVX_A_PREP, i);
+    (void) n;
+}
