+static bool ggml_hexagon_tensor_used_only_by(const ggml_cgraph * graph, int from, const ggml_tensor * t, int user) {
+    if (t->flags & GGML_TENSOR_FLAG_OUTPUT) return false;
+    for (int j = from; j < graph->n_nodes; j++) {
+        const ggml_tensor * n = graph->nodes[j];
+        for (int s = 0; s < GGML_MAX_SRC; s++) {
+            const ggml_tensor * src = n->src[s];
+            if (src && (src == t || src->view_src == t) && j != user) {
+                if (n->view_src == t && ggml_op_is_empty(n->op)) continue; // the view node itself
+                return false;
+            }
+        }
+    }
+    return true;
