+static inline HVX_Vector hvx_vec_sigmoid_qf32(HVX_Vector x, const struct hvx_sigmoid_qf32_consts * c) {
+    const HVX_Vector xc  = Q6_Vsf_vmin_VsfVsf(Q6_Vsf_vmax_VsfVsf(x, c->lo), c->hi);
+    const HVX_Vector v_q = Q6_Vqf32_vmpy_VsfVsf(xc, c->k);
+    const HVX_Vector v   = Q6_Vsf_equals_Vqf32(v_q);
