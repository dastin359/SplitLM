+        HVX_Vector m = Q6_Vh_vsplat_R(-1);
+        for (uint32_t c = 0; c < nct; ++c) {
+            const HVX_Vector v = *(const HVX_Vector *) (meta + (size_t) c * HTP_I8_META_BYTES + HTP_I8_META_CSH_OFF);
