+        }
+        uint32_t r = 0;
+        if (nvec == 4) {
+            for (; r + 4 <= nr; r += 4) {
+                const HVX_Vector * xa = (const HVX_Vector *) (x + (r0 + r + 0) * S_v);
+                const HVX_Vector * xb = (const HVX_Vector *) (x + (r0 + r + 1) * S_v);
+                const HVX_Vector * xc = (const HVX_Vector *) (x + (r0 + r + 2) * S_v);
+                const HVX_Vector * xd = (const HVX_Vector *) (x + (r0 + r + 3) * S_v);
