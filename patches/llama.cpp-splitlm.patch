+        const uint8_t * row = args->rows + (size_t) r * args->row_stride;
+        if (!args->zc) {
+            lu = hex_smax(lu, fa_mask_row_unmasked_end(row, args->nek1, 0, false));
+            continue;
+        }
+        if (args->want_lu) {
+            // the whole row is read: stream this thread's next two rows into L2 while scanning this one (a new
+            // l2fetch replaces the running one, so there are no per-row fetches below)
