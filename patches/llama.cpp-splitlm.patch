+// returns the state plane the ubatch states are viewed in (0 = the cache cells themselves), or -1 if they must be gathered.
+// trilane r9: after a speculative rollback every state of a single-sequence step comes from the same snapshot plane
+// (s_copy = plane * size + head + i); build_rs then views that plane instead of gathering a copy (one 151 MB copy
+// per rolled-back step on Qwen3.8-27B). LLAMA_RS_NO_PLANE=1 restores the gather for planes > 0.
+static int32_t llm_graph_rs_ident_plane(const llama_memory_recurrent_context * mctx) {
+    static const bool no_ident = getenv("LLAMA_RS_NO_IDENT") != nullptr;
+    static const bool no_plane = getenv("LLAMA_RS_NO_PLANE") != nullptr;
+    if (no_ident) {
+        return -1;
+    }
+    const uint32_t head = mctx->get_head();
+    const uint32_t n_rs = mctx->get_n_rs();
+    const int64_t  size = mctx->get_size();
+    int64_t plane = -1;
+    for (uint32_t i = 0; i < n_rs; ++i) {
+        // peek: s_copy() would consume a pending rollback index before set_input reads it
+        const int64_t c = mctx->s_copy_peek(i) - (int64_t) (head + i);
+        if (c < 0 || c % size != 0 || (plane >= 0 && c / size != plane)) {
+            return -1;
+        }
+        plane = c / size;
+    }
+    if (plane < 0) {
+        return -1;
+    }
+    // a rollback plane holds the ubatch states only; extra states (n_rs > 1) and a cell to clear need the gather
+    if (plane > 0 && (no_plane || n_rs != 1 || mctx->get_rs_z() >= 0)) {
+        return -1;
+    }
+    return (int32_t) plane;
+}
