+            #pragma unroll
+            for (int j = 0; j < 4; j++) {
+                // as hvx_vec_silu2_f32_hf: fp16 of the pair (lanes shuffled), a = |h|
+                const HVX_Vector hh = Q6_Vhf_equals_Wqf32(Q6_W_vcombine_VV(Q6_Vqf32_vadd_VsfVsf(zb[j], c.zero), Q6_Vqf32_vadd_VsfVsf(za[j], c.zero)));
