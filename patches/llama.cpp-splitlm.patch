+#include <vector>
+
+#if defined(__ARM_NEON)
+#include <arm_neon.h>
+#endif
+
+// Hexagon Q4_0 tile (see ggml-hexagon/htp-repack.cpp): 32 rows x 32 k, byte cp*32+row holds
+// q[row][2cp] | q[row][2cp+1] << 4 (raw nibbles, value = (q - 8) * d), then 32 fp16 row scales at byte 512.
+// Tiles are ordered row-band major then k, so with ne0 and ne1 multiples of 32 the band offsets equal flat Q4_0 offsets.
+static constexpr int    HT_ROWS  = 32;
+static constexpr size_t HT_BYTES = 576;
+
+static ggml_backend_cpu_htptile_resolver_t g_resolver      = nullptr;
+static void *                              g_resolver_user = nullptr;
+
+void ggml_backend_cpu_htptile_set_resolver(ggml_backend_cpu_htptile_resolver_t fn, void * user) {
+    g_resolver      = fn;
+    g_resolver_user = user;
+}
+
+// 2-D weights (MUL_MAT) or 3-D expert stacks (MUL_MAT_ID)
+static bool htptile_shape_ok(const ggml_tensor * t) {
+    return t->type == GGML_TYPE_Q4_0 && t->ne[3] == 1 && t->ne[0] % 32 == 0 && t->ne[1] % HT_ROWS == 0 && ggml_is_contiguous(t);
+}
+
+// y[r] = sum_k w[r][k] * x[k] for one 32-row band over n_kt k-tiles
+static void htptile_band_ref(const uint8_t * band, const block_q8_0 * x, int n_kt, float * y) {
+    float acc[HT_ROWS] = { 0 };
+    for (int kt = 0; kt < n_kt; kt++) {
+        const uint8_t *   tile = band + kt * HT_BYTES;
+        const ggml_half * sc   = (const ggml_half *) (tile + 512);
+        const float       dx   = GGML_CPU_FP16_TO_FP32(x[kt].d);
+        for (int r = 0; r < HT_ROWS; r++) {
+            int sum = 0;
+            for (int cp = 0; cp < 16; cp++) {
+                const uint8_t v = tile[cp * 32 + r];
+                sum += ((int) (v & 0x0F) - 8) * x[kt].qs[2 * cp] + ((int) (v >> 4) - 8) * x[kt].qs[2 * cp + 1];
+            }
+            acc[r] += sum * GGML_CPU_FP16_TO_FP32(sc[r]) * dx;
+        }
+    }
+    memcpy(y, acc, sizeof(acc));
+}
+
+// trilane r7: Q4_0 "row-quad" tile layout, written by the Hexagon repack when GGML_HEXAGON_Q4_TL=1 (the default; 0 = the
+// column-pair-major layout above). The same bytes, but 128-byte group g holds column pairs 4g..4g+3 row by row:
+// byte g*128 + row*4 + c = q[row][8g+2c] | q[row][8g+2c+1] << 4. A 16-byte load gives 4 rows x 4 column pairs, so the
+// kernels below need no byte transposes. Both libraries read the same variable, so they always agree on the layout.
+static bool htptile_tl() {
+    static const bool v = [] { const char * e = getenv("GGML_HEXAGON_Q4_TL"); return !(e && atoi(e) == 0); }();
+    return v;
+}
+
+static void htptile_band_ref_tl(const uint8_t * band, const block_q8_0 * x, int n_kt, float * y) {
+    float acc[HT_ROWS] = { 0 };
+    for (int kt = 0; kt < n_kt; kt++) {
+        const uint8_t *   tile = band + kt * HT_BYTES;
+        const ggml_half * sc   = (const ggml_half *) (tile + 512);
+        const float       dx   = GGML_CPU_FP16_TO_FP32(x[kt].d);
+        for (int r = 0; r < HT_ROWS; r++) {
+            int sum = 0;
+            for (int cp = 0; cp < 16; cp++) {
+                const uint8_t v = tile[(cp / 4) * 128 + r * 4 + cp % 4];
+                sum += ((int) (v & 0x0F) - 8) * x[kt].qs[2 * cp] + ((int) (v >> 4) - 8) * x[kt].qs[2 * cp + 1];
+            }
+            acc[r] += sum * GGML_CPU_FP16_TO_FP32(sc[r]) * dx;
+        }
+    }
+    memcpy(y, acc, sizeof(acc));
+}
+
+#if defined(__ARM_NEON) && defined(__ARM_FEATURE_DOTPROD)
+// Zip the transposed nibbles back into per-row groups of 4 consecutive k, then SDOT against broadcast activations.
+// xsum: precomputed per-block activation sums (nullptr: summed here); pf: software prefetch distance in bytes (0 = off)
+static void htptile_band_neon(const uint8_t * band, const block_q8_0 * x, const int32_t * xsum, int n_kt, float * y, int pf = 0) {
+    float32x4_t facc[8];
+    for (int i = 0; i < 8; i++) facc[i] = vdupq_n_f32(0.0f);
+    const uint8x16_t m4 = vdupq_n_u8(0x0F);
+
+    for (int kt = 0; kt < n_kt; kt++) {
+        const uint8_t * tile = band + kt * HT_BYTES;
+        const int8_t *  xq   = x[kt].qs;
+        if (pf) {
+            for (int l = 0; l < (int) HT_BYTES; l += 64) __builtin_prefetch(tile + pf + l, 0, 0);
+        }
+
+        int32_t sx = 0;
+        if (xsum) {
+            sx = xsum[kt];
+        } else {
+            for (int k = 0; k < 32; k++) sx += xq[k];
+        }
+
+        for (int h = 0; h < 2; h++) {
+            int32x4_t acc[4] = { vdupq_n_s32(0), vdupq_n_s32(0), vdupq_n_s32(0), vdupq_n_s32(0) };
+            for (int j = 0; j < 8; j++) {
+                const uint8x16_t v0 = vld1q_u8(tile + (2 * j + 0) * 32 + h * 16); // k = 4j, 4j+1
+                const uint8x16_t v1 = vld1q_u8(tile + (2 * j + 1) * 32 + h * 16); // k = 4j+2, 4j+3
+                const uint8x16_t l0 = vandq_u8(v0, m4), h0 = vshrq_n_u8(v0, 4);
+                const uint8x16_t l1 = vandq_u8(v1, m4), h1 = vshrq_n_u8(v1, 4);
+                const uint16x8_t a = vreinterpretq_u16_u8(vzip1q_u8(l0, h0)); // rows 0-7:  k0 k1
+                const uint16x8_t b = vreinterpretq_u16_u8(vzip2q_u8(l0, h0)); // rows 8-15: k0 k1
+                const uint16x8_t c = vreinterpretq_u16_u8(vzip1q_u8(l1, h1)); // rows 0-7:  k2 k3
+                const uint16x8_t d = vreinterpretq_u16_u8(vzip2q_u8(l1, h1)); // rows 8-15: k2 k3
+                int32_t xg;
+                memcpy(&xg, xq + 4 * j, 4);
+                const int8x16_t xb = vreinterpretq_s8_s32(vdupq_n_s32(xg));
+                acc[0] = vdotq_s32(acc[0], vreinterpretq_s8_u16(vzip1q_u16(a, c)), xb); // rows 0-3
+                acc[1] = vdotq_s32(acc[1], vreinterpretq_s8_u16(vzip2q_u16(a, c)), xb); // rows 4-7
+                acc[2] = vdotq_s32(acc[2], vreinterpretq_s8_u16(vzip1q_u16(b, d)), xb); // rows 8-11
+                acc[3] = vdotq_s32(acc[3], vreinterpretq_s8_u16(vzip2q_u16(b, d)), xb); // rows 12-15
+            }
+            const float       dx  = GGML_CPU_FP16_TO_FP32(x[kt].d);
+            const int32x4_t   off = vdupq_n_s32(8 * sx);
+            const float16_t * sc  = (const float16_t *) (tile + 512) + h * 16;
+            for (int g = 0; g < 4; g++) {
+                const float32x4_t s = vmulq_n_f32(vcvt_f32_f16(vld1_f16(sc + 4 * g)), dx);
+                facc[h * 4 + g] = vfmaq_f32(facc[h * 4 + g], vcvtq_f32_s32(vsubq_s32(acc[g], off)), s);
+            }
+        }
+    }
+    for (int i = 0; i < 8; i++) vst1q_f32(y + 4 * i, facc[i]);
+}
+
+// htptile_band_neon for NT tokens at once: each band's nibbles are unpacked and zipped once and reused by every
+// token, so a speculative verification batch costs about one pass over the weights instead of NT.
+// Per token the integer and float operation order is the same as the single-token kernel, so results are identical.
+template <int NT>
+static void htptile_band_neon_multi(const uint8_t * band, const block_q8_0 * const * x, const int32_t * const * xsum, int n_kt, float * const * y) {
+    float32x4_t facc[NT][8];
+    for (int t = 0; t < NT; t++) for (int i = 0; i < 8; i++) facc[t][i] = vdupq_n_f32(0.0f);
+    const uint8x16_t m4 = vdupq_n_u8(0x0F);
+
+    for (int kt = 0; kt < n_kt; kt++) {
+        const uint8_t * tile = band + kt * HT_BYTES;
+        for (int h = 0; h < 2; h++) {
+            int32x4_t acc[NT][4];
+            for (int t = 0; t < NT; t++) for (int g = 0; g < 4; g++) acc[t][g] = vdupq_n_s32(0);
+            for (int j = 0; j < 8; j++) {
+                const uint8x16_t v0 = vld1q_u8(tile + (2 * j + 0) * 32 + h * 16);
+                const uint8x16_t v1 = vld1q_u8(tile + (2 * j + 1) * 32 + h * 16);
+                const uint8x16_t l0 = vandq_u8(v0, m4), h0 = vshrq_n_u8(v0, 4);
+                const uint8x16_t l1 = vandq_u8(v1, m4), h1 = vshrq_n_u8(v1, 4);
+                const uint16x8_t a = vreinterpretq_u16_u8(vzip1q_u8(l0, h0));
+                const uint16x8_t b = vreinterpretq_u16_u8(vzip2q_u8(l0, h0));
+                const uint16x8_t c = vreinterpretq_u16_u8(vzip1q_u8(l1, h1));
+                const uint16x8_t d = vreinterpretq_u16_u8(vzip2q_u8(l1, h1));
+                const int8x16_t w0 = vreinterpretq_s8_u16(vzip1q_u16(a, c));
+                const int8x16_t w1 = vreinterpretq_s8_u16(vzip2q_u16(a, c));
+                const int8x16_t w2 = vreinterpretq_s8_u16(vzip1q_u16(b, d));
+                const int8x16_t w3 = vreinterpretq_s8_u16(vzip2q_u16(b, d));
+                for (int t = 0; t < NT; t++) {
+                    int32_t xg;
+                    memcpy(&xg, x[t][kt].qs + 4 * j, 4);
+                    const int8x16_t xb = vreinterpretq_s8_s32(vdupq_n_s32(xg));
+                    acc[t][0] = vdotq_s32(acc[t][0], w0, xb);
+                    acc[t][1] = vdotq_s32(acc[t][1], w1, xb);
+                    acc[t][2] = vdotq_s32(acc[t][2], w2, xb);
+                    acc[t][3] = vdotq_s32(acc[t][3], w3, xb);
+                }
+            }
+            const float16_t * sc = (const float16_t *) (tile + 512) + h * 16;
+            for (int t = 0; t < NT; t++) {
+                const float     dx  = GGML_CPU_FP16_TO_FP32(x[t][kt].d);
+                const int32x4_t off = vdupq_n_s32(8 * xsum[t][kt]);
+                for (int g = 0; g < 4; g++) {
+                    const float32x4_t s = vmulq_n_f32(vcvt_f32_f16(vld1_f16(sc + 4 * g)), dx);
+                    facc[t][h * 4 + g] = vfmaq_f32(facc[t][h * 4 + g], vcvtq_f32_s32(vsubq_s32(acc[t][g], off)), s);
+                }
+            }
+        }
+    }
+    for (int t = 0; t < NT; t++) for (int i = 0; i < 8; i++) vst1q_f32(y[t] + 4 * i, facc[t][i]);
+}
+#endif
+
+// int32 sum of each q8_0 block's quants (the -8 nibble offset term), for kernels that take precomputed sums
+static void htptile_block_sums(const block_q8_0 * xb, int32_t * xsum, int n_kt) {
+    for (int kt = 0; kt < n_kt; kt++) {
+        int32_t s = 0;
+        for (int k = 0; k < 32; k++) s += xb[kt].qs[k];
+        xsum[kt] = s;
+    }
+}
+
+#if defined(__ARM_NEON) && defined(__ARM_FEATURE_MATMUL_INT8)
+#define HTPTILE_I8MM 1
+// Activation blocks for this kernel are pre-permuted per group of 8 k: [k0 k2 k4 k6 k1 k3 k5 k7].
+// Transposing 4 column-pair bytes per row puts the even k in the low nibbles and the odd k in the high ones,
+// so USDOT(byte & 0x0F, even x) + USDOT(byte & 0xF0, odd x) / 16 needs no nibble shuffles.
+// X2: activations in the htptile_prep_x2 layout (lanes of odd k move from 1, 3 to 2, 3 and of the second even group to 1)
+template <bool X2 = false>
+static void htptile_band_i8mm(const uint8_t * band, const block_q8_0 * x, const int32_t * xsum, int n_kt, float * y) {
+    float32x4_t facc[8];
+    for (int i = 0; i < 8; i++) facc[i] = vdupq_n_f32(0.0f);
+    const uint8x16_t mlo = vdupq_n_u8(0x0F);
+    const uint8x16_t mhi = vdupq_n_u8(0xF0);
+
+    for (int kt = 0; kt < n_kt; kt++) {
+        const uint8_t * tile = band + kt * HT_BYTES;
+        const int8x16_t xa = vld1q_s8(x[kt].qs);
+        const int8x16_t xb = vld1q_s8(x[kt].qs + 16);
+
+        for (int h = 0; h < 2; h++) {
+            int32x4_t lo[4], hi[4];
+            for (int i = 0; i < 4; i++) { lo[i] = vdupq_n_s32(0); hi[i] = vdupq_n_s32(0); }
+
+#define HTPTILE_GROUP(m, XV, LLO, LHI)                                                                      \
+            {                                                                                               \
+                const uint8_t * p = tile + (4 * (m)) * 32 + h * 16;                                         \
+                const uint8x16_t v0 = vld1q_u8(p), v1 = vld1q_u8(p + 32), v2 = vld1q_u8(p + 64), v3 = vld1q_u8(p + 96); \
+                const uint16x8_t t0 = vreinterpretq_u16_u8(vzip1q_u8(v0, v1));                              \
+                const uint16x8_t t1 = vreinterpretq_u16_u8(vzip2q_u8(v0, v1));                              \
+                const uint16x8_t t2 = vreinterpretq_u16_u8(vzip1q_u8(v2, v3));                              \
+                const uint16x8_t t3 = vreinterpretq_u16_u8(vzip2q_u8(v2, v3));                              \
+                const uint8x16_t w[4] = { vreinterpretq_u8_u16(vzip1q_u16(t0, t2)), vreinterpretq_u8_u16(vzip2q_u16(t0, t2)), \
+                                          vreinterpretq_u8_u16(vzip1q_u16(t1, t3)), vreinterpretq_u8_u16(vzip2q_u16(t1, t3)) }; \
+                for (int i = 0; i < 4; i++) {                                                               \
+                    lo[i] = vusdotq_laneq_s32(lo[i], vandq_u8(w[i], mlo), XV, LLO);                         \
+                    hi[i] = vusdotq_laneq_s32(hi[i], vandq_u8(w[i], mhi), XV, LHI);                         \
+                }                                                                                           \
+            }
+            if (X2) {
+                HTPTILE_GROUP(0, xa, 0, 2)
+                HTPTILE_GROUP(1, xa, 1, 3)
+                HTPTILE_GROUP(2, xb, 0, 2)
+                HTPTILE_GROUP(3, xb, 1, 3)
+            } else {
+                HTPTILE_GROUP(0, xa, 0, 1)
+                HTPTILE_GROUP(1, xa, 2, 3)
+                HTPTILE_GROUP(2, xb, 0, 1)
+                HTPTILE_GROUP(3, xb, 2, 3)
+            }
+#undef HTPTILE_GROUP
+
+            const float       dx  = GGML_CPU_FP16_TO_FP32(x[kt].d);
+            const int32x4_t   off = vdupq_n_s32(8 * xsum[kt]);
+            const float16_t * sc  = (const float16_t *) (tile + 512) + h * 16;
+            for (int g = 0; g < 4; g++) {
+                const int32x4_t   q = vsubq_s32(vaddq_s32(lo[g], vshrq_n_s32(hi[g], 4)), off);
+                const float32x4_t s = vmulq_n_f32(vcvt_f32_f16(vld1_f16(sc + 4 * g)), dx);
+                facc[h * 4 + g] = vfmaq_f32(facc[h * 4 + g], vcvtq_f32_s32(q), s);
+            }
+        }
+    }
+    for (int i = 0; i < 8; i++) vst1q_f32(y + 4 * i, facc[i]);
+}
+
+// htptile_band_i8mm for NT (2..4) tokens: USMMLA multiplies a 2-row x 8-k weight block by an 8-k x 2-token block of
+// (pre-permuted) activations, 32 MACs per instruction, and each band is transposed once for all tokens.
+// The integer sums and the float update per (row, token) are the same as in the single-token kernels.
+template <int NT>
+static void htptile_band_mmla(const uint8_t * band, const block_q8_0 * const * x, const int32_t * const * xsum, int n_kt, float * const * y) {
+    constexpr int TP = (NT + 1) / 2; // token pairs; an odd last token is paired with itself
+    int tok[2 * TP];
+    for (int i = 0; i < 2 * TP; i++) tok[i] = std::min(i, NT - 1);
+    // [half][row pair][token pair], lanes (r0,t0) (r0,t1) (r1,t0) (r1,t1)
+    float32x4_t facc[2][8][TP];
+    for (int h = 0; h < 2; h++) for (int rp = 0; rp < 8; rp++) for (int q = 0; q < TP; q++) facc[h][rp][q] = vdupq_n_f32(0.0f);
+    const uint8x16_t mlo = vdupq_n_u8(0x0F);
+
+    for (int kt = 0; kt < n_kt; kt++) {
+        const uint8_t * tile = band + kt * HT_BYTES;
+        int8x16_t   xb[4][TP];
+        float32x4_t dxv[TP];
+        int32x4_t   offv[TP];
+        for (int q = 0; q < TP; q++) {
+            const block_q8_0 * x0 = x[tok[2 * q]] + kt;
+            const block_q8_0 * x1 = x[tok[2 * q + 1]] + kt;
+            for (int m = 0; m < 4; m++) xb[m][q] = vcombine_s8(vld1_s8(x0->qs + 8 * m), vld1_s8(x1->qs + 8 * m));
+            const float d0 = GGML_CPU_FP16_TO_FP32(x0->d), d1 = GGML_CPU_FP16_TO_FP32(x1->d);
+            const float    dv[4] = { d0, d1, d0, d1 };
+            const int32_t  ov[4] = { 8 * xsum[tok[2 * q]][kt], 8 * xsum[tok[2 * q + 1]][kt], 8 * xsum[tok[2 * q]][kt], 8 * xsum[tok[2 * q + 1]][kt] };
+            dxv[q]  = vld1q_f32(dv);
+            offv[q] = vld1q_s32(ov);
+        }
+        for (int h = 0; h < 2; h++) {
+            int32x4_t acc[8][TP];
+            for (int rp = 0; rp < 8; rp++) for (int q = 0; q < TP; q++) acc[rp][q] = vdupq_n_s32(0);
+            for (int m = 0; m < 4; m++) {
+                const uint8_t * p = tile + (4 * m) * 32 + h * 16;
+                const uint8x16_t v0 = vld1q_u8(p), v1 = vld1q_u8(p + 32), v2 = vld1q_u8(p + 64), v3 = vld1q_u8(p + 96);
+                const uint16x8_t t0 = vreinterpretq_u16_u8(vzip1q_u8(v0, v1));
+                const uint16x8_t t1 = vreinterpretq_u16_u8(vzip2q_u8(v0, v1));
+                const uint16x8_t t2 = vreinterpretq_u16_u8(vzip1q_u8(v2, v3));
+                const uint16x8_t t3 = vreinterpretq_u16_u8(vzip2q_u8(v2, v3));
+                // rows 4i..4i+3, 4 bytes each: even k in the low nibbles, odd k in the high ones
+                const uint8x16_t w[4] = { vreinterpretq_u8_u16(vzip1q_u16(t0, t2)), vreinterpretq_u8_u16(vzip2q_u16(t0, t2)),
+                                          vreinterpretq_u8_u16(vzip1q_u16(t1, t3)), vreinterpretq_u8_u16(vzip2q_u16(t1, t3)) };
+                for (int i = 0; i < 4; i++) {
+                    const uint32x4_t lo = vreinterpretq_u32_u8(vandq_u8(w[i], mlo));
+                    const uint32x4_t hi = vreinterpretq_u32_u8(vshrq_n_u8(w[i], 4));
+                    // two rows of [k0 k2 k4 k6 k1 k3 k5 k7], the activation permutation of htptile_prep_x
+                    const uint8x16_t a0 = vreinterpretq_u8_u32(vzip1q_u32(lo, hi));
+                    const uint8x16_t a1 = vreinterpretq_u8_u32(vzip2q_u32(lo, hi));
+                    for (int q = 0; q < TP; q++) {
+                        acc[2 * i + 0][q] = vusmmlaq_s32(acc[2 * i + 0][q], a0, xb[m][q]);
+                        acc[2 * i + 1][q] = vusmmlaq_s32(acc[2 * i + 1][q], a1, xb[m][q]);
+                    }
+                }
+            }
+            const float16_t * sc = (const float16_t *) (tile + 512) + h * 16;
+            for (int g = 0; g < 4; g++) {
+                const float32x4_t s4 = vcvt_f32_f16(vld1_f16(sc + 4 * g)); // rows 4g..4g+3
+                const float32x4_t sp[2] = { vzip1q_f32(s4, s4), vzip2q_f32(s4, s4) }; // [s0 s0 s1 s1], [s2 s2 s3 s3]
+                for (int j = 0; j < 2; j++) {
+                    for (int q = 0; q < TP; q++) {
+                        float32x4_t & f = facc[h][2 * g + j][q];
+                        f = vfmaq_f32(f, vcvtq_f32_s32(vsubq_s32(acc[2 * g + j][q], offv[q])), vmulq_f32(sp[j], dxv[q]));
+                    }
+                }
+            }
+        }
+    }
+    for (int h = 0; h < 2; h++) {
+        for (int rp = 0; rp < 8; rp++) {
+            const int r = h * 16 + 2 * rp;
+            for (int q = 0; q < TP; q++) {
+                float v[4];
+                vst1q_f32(v, facc[h][rp][q]);
+                y[2 * q][r] = v[0];
+                y[2 * q][r + 1] = v[2];
+                if (2 * q + 1 < NT) {
+                    y[2 * q + 1][r] = v[1];
+                    y[2 * q + 1][r + 1] = v[3];
+                }
+            }
+        }
+    }
+}
+
+// [k0..k7] -> [k0 k2 k4 k6 k1 k3 k5 k7] in every group of 8, and per-block sums for the -8 offset
+static void htptile_prep_x(block_q8_0 * xb, int32_t * xsum, int n_kt) {
+    for (int kt = 0; kt < n_kt; kt++) {
+        int8_t tmp[32];
+        int32_t s = 0;
+        for (int m = 0; m < 4; m++) {
+            for (int i = 0; i < 4; i++) {
+                tmp[8 * m + i]     = xb[kt].qs[8 * m + 2 * i];
+                tmp[8 * m + 4 + i] = xb[kt].qs[8 * m + 2 * i + 1];
+            }
+        }
+        for (int k = 0; k < 32; k++) s += xb[kt].qs[k];
+        memcpy(xb[kt].qs, tmp, 32);
+        xsum[kt] = s;
+    }
+}
+
+// trilane r6 (GGML_HTPTILE_MMLA2, default 1): htptile_band_mmla with 8 column pairs transposed as whole bytes into 2-row x 8-cp operands, then (byte << 4) and (byte & 0xF0)
+// give 16x the even-k and odd-k nibbles: both go into the same integer accumulator (16x the sum), which starts at
+// -16 * 8 * xsum; the float update uses dx / 16. All of it is exact, so the result equals htptile_band_mmla bit for bit.
+// Activations per 32-k block: [even k of 0..15][odd k of 0..15][even k of 16..31][odd k of 16..31] (htptile_prep_x2).
+static void htptile_prep_x2(block_q8_0 * xb, int32_t * xsum, int n_kt) {
+    for (int kt = 0; kt < n_kt; kt++) {
+        int8_t tmp[32];
+        int32_t s = 0;
+        for (int g = 0; g < 2; g++) for (int i = 0; i < 8; i++) {
+            tmp[16 * g + i]     = xb[kt].qs[16 * g + 2 * i];
+            tmp[16 * g + 8 + i] = xb[kt].qs[16 * g + 2 * i + 1];
+        }
+        for (int k = 0; k < 32; k++) s += xb[kt].qs[k];
+        memcpy(xb[kt].qs, tmp, 32);
+        xsum[kt] = s;
+    }
+}
+template <int NT>
+static void htptile_band_mmla2(const uint8_t * band, const block_q8_0 * const * x, const int32_t * const * xsum, int n_kt, float * const * y, int pf) {
+    constexpr int TP = (NT + 1) / 2;
+    int tok[2 * TP];
+    for (int i = 0; i < 2 * TP; i++) tok[i] = std::min(i, NT - 1);
+    float32x4_t facc[2][8][TP];
+    for (int h = 0; h < 2; h++) for (int rp = 0; rp < 8; rp++) for (int q = 0; q < TP; q++) facc[h][rp][q] = vdupq_n_f32(0.0f);
+    const uint8x16_t mhi = vdupq_n_u8(0xF0);
+    for (int kt = 0; kt < n_kt; kt++) {
+        const uint8_t * tile = band + kt * HT_BYTES;
+        if (pf) { for (int l = 0; l < (int) HT_BYTES; l += 64) __builtin_prefetch(tile + pf + l, 0, 0); }
+        int8x16_t   xe[2][TP], xo[2][TP];   // [group][pair]
+        float32x4_t dxv[TP];
+        int32x4_t   offv[TP];
+        for (int q = 0; q < TP; q++) {
+            const block_q8_0 * x0 = x[tok[2 * q]] + kt;
+            const block_q8_0 * x1 = x[tok[2 * q + 1]] + kt;
+            for (int g = 0; g < 2; g++) {
+                xe[g][q] = vcombine_s8(vld1_s8(x0->qs + 16 * g), vld1_s8(x1->qs + 16 * g));
+                xo[g][q] = vcombine_s8(vld1_s8(x0->qs + 16 * g + 8), vld1_s8(x1->qs + 16 * g + 8));
+            }
+            const float d0 = GGML_CPU_FP16_TO_FP32(x0->d) * 0.0625f, d1 = GGML_CPU_FP16_TO_FP32(x1->d) * 0.0625f;
+            const float    dv[4] = { d0, d1, d0, d1 };
+            const int32_t o0 = -128 * xsum[tok[2 * q]][kt], o1 = -128 * xsum[tok[2 * q + 1]][kt];
+            const int32_t  ov[4] = { o0, o1, o0, o1 };
+            dxv[q]  = vld1q_f32(dv);
+            offv[q] = vld1q_s32(ov);
+        }
+        for (int h = 0; h < 2; h++) {
+            int32x4_t acc[8][TP];
+            for (int rp = 0; rp < 8; rp++) for (int q = 0; q < TP; q++) acc[rp][q] = offv[q];
+            for (int g = 0; g < 2; g++) {
+                const uint8_t * p = tile + (8 * g) * 32 + h * 16;
+                uint8x16_t v[8];
+                for (int c = 0; c < 8; c++) v[c] = vld1q_u8(p + 32 * c);
+                uint16x8_t z[8]; // [pair c/2][lo rows 0-7 | hi rows 8-15]
+                for (int c = 0; c < 4; c++) {
+                    z[2 * c]     = vreinterpretq_u16_u8(vzip1q_u8(v[2 * c], v[2 * c + 1]));
+                    z[2 * c + 1] = vreinterpretq_u16_u8(vzip2q_u8(v[2 * c], v[2 * c + 1]));
+                }
+                // 32-bit units of 4 cps: w[cpq][rq] for cp quad cpq (0: cp0-3, 1: cp4-7), row quad rq
+                uint32x4_t w[2][4];
+                for (int cq = 0; cq < 2; cq++) {
+                    const uint16x8_t a_lo = z[4 * cq + 0], a_hi = z[4 * cq + 1], b_lo = z[4 * cq + 2], b_hi = z[4 * cq + 3];
+                    w[cq][0] = vreinterpretq_u32_u16(vzip1q_u16(a_lo, b_lo)); // rows 0-3
+                    w[cq][1] = vreinterpretq_u32_u16(vzip2q_u16(a_lo, b_lo)); // rows 4-7
+                    w[cq][2] = vreinterpretq_u32_u16(vzip1q_u16(a_hi, b_hi)); // rows 8-11
+                    w[cq][3] = vreinterpretq_u32_u16(vzip2q_u16(a_hi, b_hi)); // rows 12-15
+                }
+                for (int rq = 0; rq < 4; rq++) {
+                    const uint8x16_t o0 = vreinterpretq_u8_u32(vzip1q_u32(w[0][rq], w[1][rq])); // rows 4rq, 4rq+1: 8 cps each
+                    const uint8x16_t o1 = vreinterpretq_u8_u32(vzip2q_u32(w[0][rq], w[1][rq])); // rows 4rq+2, 4rq+3
+                    const uint8x16_t l0 = vshlq_n_u8(o0, 4), h0 = vandq_u8(o0, mhi);
+                    const uint8x16_t l1 = vshlq_n_u8(o1, 4), h1 = vandq_u8(o1, mhi);
+                    for (int q = 0; q < TP; q++) {
+                        acc[2 * rq + 0][q] = vusmmlaq_s32(acc[2 * rq + 0][q], l0, xe[g][q]);
+                        acc[2 * rq + 0][q] = vusmmlaq_s32(acc[2 * rq + 0][q], h0, xo[g][q]);
+                        acc[2 * rq + 1][q] = vusmmlaq_s32(acc[2 * rq + 1][q], l1, xe[g][q]);
+                        acc[2 * rq + 1][q] = vusmmlaq_s32(acc[2 * rq + 1][q], h1, xo[g][q]);
+                    }
+                }
+            }
+            const float16_t * sc = (const float16_t *) (tile + 512) + h * 16;
+            for (int g4 = 0; g4 < 4; g4++) {
+                const float32x4_t s4 = vcvt_f32_f16(vld1_f16(sc + 4 * g4));
+                const float32x4_t sp[2] = { vzip1q_f32(s4, s4), vzip2q_f32(s4, s4) };
+                for (int j = 0; j < 2; j++) for (int q = 0; q < TP; q++) {
+                    float32x4_t & f = facc[h][2 * g4 + j][q];
+                    f = vfmaq_f32(f, vcvtq_f32_s32(acc[2 * g4 + j][q]), vmulq_f32(sp[j], dxv[q]));
+                }
+            }
+        }
+    }
+    for (int h = 0; h < 2; h++) for (int rp = 0; rp < 8; rp++) {
+        const int r = h * 16 + 2 * rp;
+        for (int q = 0; q < TP; q++) {
+            float v[4];
+            vst1q_f32(v, facc[h][rp][q]);
+            y[2 * q][r] = v[0]; y[2 * q][r + 1] = v[2];
+            if (2 * q + 1 < NT) { y[2 * q + 1][r] = v[1]; y[2 * q + 1][r + 1] = v[3]; }
+        }
+    }
+}
+#endif
+
+#if defined(__ARM_NEON) && defined(__ARM_FEATURE_DOTPROD)
+// trilane r7: single token over row-quad tiles (htptile_tl). Activations in the htptile_prep_x2 layout: lanes 0, 1 of
+// each 16-byte half hold the even k of column pairs 0-3 / 4-7, lanes 2, 3 the odd k. Per 16-byte load (rows 4i..4i+3,
+// 4 column pairs) the low nibbles SDOT with the even-k lane and the high nibbles with the odd-k lane. The integer sums
+// and the float update are those of htptile_band_neon, so the results are identical to it.
+static void htptile_band_tl1(const uint8_t * band, const block_q8_0 * x, const int32_t * xsum, int n_kt, float * y, int pf = 0) {
+    float32x4_t facc[8];
+    for (int i = 0; i < 8; i++) facc[i] = vdupq_n_f32(0.0f);
+    const uint8x16_t m4 = vdupq_n_u8(0x0F);
+
+    for (int kt = 0; kt < n_kt; kt++) {
+        const uint8_t * tile = band + kt * HT_BYTES;
+        if (pf) {
+            for (int l = 0; l < (int) HT_BYTES; l += 64) __builtin_prefetch(tile + pf + l, 0, 0);
+        }
+        const int8x16_t xa = vld1q_s8(x[kt].qs);
+        const int8x16_t xb = vld1q_s8(x[kt].qs + 16);
+        int32x4_t acc[8];
+        for (int i = 0; i < 8; i++) acc[i] = vdupq_n_s32(0);
+#define HTPTILE_TL_GROUP(g, XV, LE, LO)                                                                     \
+        for (int i = 0; i < 8; i++) {                                                                       \
+            const uint8x16_t v = vld1q_u8(tile + (g) * 128 + 16 * i);                                       \
+            acc[i] = vdotq_laneq_s32(acc[i], vreinterpretq_s8_u8(vandq_u8(v, m4)), XV, LE);                 \
+            acc[i] = vdotq_laneq_s32(acc[i], vreinterpretq_s8_u8(vshrq_n_u8(v, 4)), XV, LO);                \
+        }
+        HTPTILE_TL_GROUP(0, xa, 0, 2)
+        HTPTILE_TL_GROUP(1, xa, 1, 3)
+        HTPTILE_TL_GROUP(2, xb, 0, 2)
+        HTPTILE_TL_GROUP(3, xb, 1, 3)
+#undef HTPTILE_TL_GROUP
+        const float       dx  = GGML_CPU_FP16_TO_FP32(x[kt].d);
+        const int32x4_t   off = vdupq_n_s32(8 * xsum[kt]);
+        const float16_t * sc  = (const float16_t *) (tile + 512);
+        for (int g = 0; g < 8; g++) {
+            const float32x4_t s = vmulq_n_f32(vcvt_f32_f16(vld1_f16(sc + 4 * g)), dx);
+            facc[g] = vfmaq_f32(facc[g], vcvtq_f32_s32(vsubq_s32(acc[g], off)), s);
+        }
+    }
+    for (int i = 0; i < 8; i++) vst1q_f32(y + 4 * i, facc[i]);
+}
+#endif
+
+#if defined(HTPTILE_I8MM)
+// trilane r7: htptile_band_mmla2 over row-quad tiles: the 2-row x 8-column-pair USMMLA operands are one 32-bit zip of
+// two 16-byte loads (column pairs 8g..8g+3 and 8g+4..8g+7 of 4 rows) instead of three zip levels over 8 loads.
+// Same operands, integer sums and float updates as htptile_band_mmla2, so the results are identical to it.
+template <int NT>
+static void htptile_band_tl_mmla(const uint8_t * band, const block_q8_0 * const * x, const int32_t * const * xsum, int n_kt, float * const * y, int pf) {
+    constexpr int TP = (NT + 1) / 2;
+    int tok[2 * TP];
+    for (int i = 0; i < 2 * TP; i++) tok[i] = std::min(i, NT - 1);
+    float32x4_t facc[2][8][TP];
+    for (int h = 0; h < 2; h++) for (int rp = 0; rp < 8; rp++) for (int q = 0; q < TP; q++) facc[h][rp][q] = vdupq_n_f32(0.0f);
+    const uint8x16_t mhi = vdupq_n_u8(0xF0);
+    for (int kt = 0; kt < n_kt; kt++) {
+        const uint8_t * tile = band + kt * HT_BYTES;
+        if (pf) { for (int l = 0; l < (int) HT_BYTES; l += 64) __builtin_prefetch(tile + pf + l, 0, 0); }
+        int8x16_t   xe[2][TP], xo[2][TP];
+        float32x4_t dxv[TP];
+        int32x4_t   offv[TP];
+        for (int q = 0; q < TP; q++) {
+            const block_q8_0 * x0 = x[tok[2 * q]] + kt;
+            const block_q8_0 * x1 = x[tok[2 * q + 1]] + kt;
+            for (int g = 0; g < 2; g++) {
+                xe[g][q] = vcombine_s8(vld1_s8(x0->qs + 16 * g), vld1_s8(x1->qs + 16 * g));
+                xo[g][q] = vcombine_s8(vld1_s8(x0->qs + 16 * g + 8), vld1_s8(x1->qs + 16 * g + 8));
+            }
+            const float d0 = GGML_CPU_FP16_TO_FP32(x0->d) * 0.0625f, d1 = GGML_CPU_FP16_TO_FP32(x1->d) * 0.0625f;
+            const float    dv[4] = { d0, d1, d0, d1 };
+            const int32_t o0 = -128 * xsum[tok[2 * q]][kt], o1 = -128 * xsum[tok[2 * q + 1]][kt];
+            const int32_t  ov[4] = { o0, o1, o0, o1 };
+            dxv[q]  = vld1q_f32(dv);
+            offv[q] = vld1q_s32(ov);
+        }
+        for (int h = 0; h < 2; h++) {
+            int32x4_t acc[8][TP];
+            for (int rp = 0; rp < 8; rp++) for (int q = 0; q < TP; q++) acc[rp][q] = offv[q];
+            for (int g = 0; g < 2; g++) {
+                const uint8_t * p = tile + (2 * g) * 128 + h * 64;
+                for (int rq = 0; rq < 4; rq++) {
+                    const uint32x4_t a = vreinterpretq_u32_u8(vld1q_u8(p + 16 * rq));       // rows 4rq..4rq+3, cps 8g..8g+3
+                    const uint32x4_t b = vreinterpretq_u32_u8(vld1q_u8(p + 128 + 16 * rq)); // cps 8g+4..8g+7
+                    const uint8x16_t o0 = vreinterpretq_u8_u32(vzip1q_u32(a, b)); // rows 4rq, 4rq+1: 8 cps each
+                    const uint8x16_t o1 = vreinterpretq_u8_u32(vzip2q_u32(a, b)); // rows 4rq+2, 4rq+3
+                    const uint8x16_t l0 = vshlq_n_u8(o0, 4), h0 = vandq_u8(o0, mhi);
+                    const uint8x16_t l1 = vshlq_n_u8(o1, 4), h1 = vandq_u8(o1, mhi);
+                    for (int q = 0; q < TP; q++) {
+                        acc[2 * rq + 0][q] = vusmmlaq_s32(acc[2 * rq + 0][q], l0, xe[g][q]);
+                        acc[2 * rq + 0][q] = vusmmlaq_s32(acc[2 * rq + 0][q], h0, xo[g][q]);
+                        acc[2 * rq + 1][q] = vusmmlaq_s32(acc[2 * rq + 1][q], l1, xe[g][q]);
+                        acc[2 * rq + 1][q] = vusmmlaq_s32(acc[2 * rq + 1][q], h1, xo[g][q]);
+                    }
+                }
+            }
+            const float16_t * sc = (const float16_t *) (tile + 512) + h * 16;
+            for (int g4 = 0; g4 < 4; g4++) {
+                const float32x4_t s4 = vcvt_f32_f16(vld1_f16(sc + 4 * g4));
+                const float32x4_t sp[2] = { vzip1q_f32(s4, s4), vzip2q_f32(s4, s4) };
+                for (int j = 0; j < 2; j++) for (int q = 0; q < TP; q++) {
+                    float32x4_t & f = facc[h][2 * g4 + j][q];
+                    f = vfmaq_f32(f, vcvtq_f32_s32(acc[2 * g4 + j][q]), vmulq_f32(sp[j], dxv[q]));
+                }
+            }
+        }
+    }
+    for (int h = 0; h < 2; h++) for (int rp = 0; rp < 8; rp++) {
+        const int r = h * 16 + 2 * rp;
+        for (int q = 0; q < TP; q++) {
+            float v[4];
+            vst1q_f32(v, facc[h][rp][q]);
+            y[2 * q][r] = v[0]; y[2 * q][r + 1] = v[2];
+            if (2 * q + 1 < NT) { y[2 * q + 1][r] = v[1]; y[2 * q + 1][r + 1] = v[3]; }
+        }
+    }
+}
+#endif
+
+// MMLA: batches only (activations permuted as for USDOT); groups of 2-4 tokens use USMMLA, single tokens USDOT
+enum htptile_kernel { HTPTILE_REF, HTPTILE_DOT, HTPTILE_USDOT, HTPTILE_MMLA };
+
+static htptile_kernel htptile_pick_kernel() {
+    // dot is the default: the expert stream is bandwidth-bound, and usdot's fewer instructions measured no faster
+    const char * e = getenv("GGML_HTPTILE_KERNEL"); // ref | dot | usdot
+    if (getenv("GGML_HTPTILE_REF") || (e && strcmp(e, "ref") == 0)) return HTPTILE_REF;
+#if defined(HTPTILE_I8MM)
+    if (e && strcmp(e, "usdot") == 0) return HTPTILE_USDOT;
+#endif
+#if defined(__ARM_NEON) && defined(__ARM_FEATURE_DOTPROD)
+    return HTPTILE_DOT;
+#else
+    return HTPTILE_REF;
+#endif
+}
+
+// GGML_HTPTILE_MMLA2=0 restores the 4-column-pair batch kernel and its activation layout
+static bool htptile_mmla2() { static const bool v = !(getenv("GGML_HTPTILE_MMLA2") && atoi(getenv("GGML_HTPTILE_MMLA2")) == 0); return v; }
+static int  htptile_mpf() { static const int v = getenv("GGML_HTPTILE_MPF") ? atoi(getenv("GGML_HTPTILE_MPF")) : 0; return v; }
+
+static void htptile_band(htptile_kernel kern, const uint8_t * band, const block_q8_0 * x, const int32_t * xsum, int n_kt, float * y) {
+    if (htptile_tl()) {
+        // row-quad tiles: REF takes plain activations, every other kernel the htptile_prep_x2 ones
+#if defined(__ARM_NEON) && defined(__ARM_FEATURE_DOTPROD)
+        if (kern != HTPTILE_REF) { htptile_band_tl1(band, x, xsum, n_kt, y); return; }
+#endif
+        htptile_band_ref_tl(band, x, n_kt, y);
+        return;
+    }
+    switch (kern) {
+#if defined(HTPTILE_I8MM)
+        case HTPTILE_USDOT:
+        case HTPTILE_MMLA:  if (htptile_mmla2()) htptile_band_i8mm<true>(band, x, xsum, n_kt, y); else htptile_band_i8mm(band, x, xsum, n_kt, y); return;
+#endif
+#if defined(__ARM_NEON) && defined(__ARM_FEATURE_DOTPROD)
+        case HTPTILE_DOT: htptile_band_neon(band, x, nullptr, n_kt, y); return;
+#endif
+        default: htptile_band_ref(band, x, n_kt, y); return;
+    }
+    GGML_UNUSED(xsum);
+}
+
+// up to HT_MULTI tokens against one band; the dot kernel shares the unpack, other kernels run per token
+static constexpr int HT_MULTI = 4;
+static void htptile_band_multi(htptile_kernel kern, const uint8_t * band, const block_q8_0 * const * x, const int32_t * const * xsum,
+                               int n_kt, float * const * y, int nt) {
+#if defined(__ARM_NEON) && defined(__ARM_FEATURE_DOTPROD)
+    static const bool no_multi = getenv("GGML_HTPTILE_NO_MULTI") != nullptr;
+#if defined(HTPTILE_I8MM)
+    if (htptile_tl()) {
+        if (kern == HTPTILE_MMLA && !no_multi && nt > 1) {
+            switch (nt) {
+                case 2: htptile_band_tl_mmla<2>(band, x, xsum, n_kt, y, htptile_mpf()); return;
+                case 3: htptile_band_tl_mmla<3>(band, x, xsum, n_kt, y, htptile_mpf()); return;
+                case 4: htptile_band_tl_mmla<4>(band, x, xsum, n_kt, y, htptile_mpf()); return;
+                default: break;
+            }
+        }
+        for (int t = 0; t < nt; t++) htptile_band(kern, band, x[t], xsum[t], n_kt, y[t]);
+        return;
+    }
+#endif
+#if defined(HTPTILE_I8MM)
+    if (kern == HTPTILE_MMLA && !no_multi && nt > 1) {
+        if (htptile_mmla2()) {
+            switch (nt) {
+                case 2: htptile_band_mmla2<2>(band, x, xsum, n_kt, y, htptile_mpf()); return;
+                case 3: htptile_band_mmla2<3>(band, x, xsum, n_kt, y, htptile_mpf()); return;
+                case 4: htptile_band_mmla2<4>(band, x, xsum, n_kt, y, htptile_mpf()); return;
+                default: break;
+            }
+        }
+        switch (nt) {
+            case 2: htptile_band_mmla<2>(band, x, xsum, n_kt, y); return;
+            case 3: htptile_band_mmla<3>(band, x, xsum, n_kt, y); return;
+            case 4: htptile_band_mmla<4>(band, x, xsum, n_kt, y); return;
+            default: break;
+        }
+    }
+#endif
+    if (kern == HTPTILE_DOT && !no_multi && nt > 1 && !htptile_tl()) {
+        switch (nt) {
+            case 2: htptile_band_neon_multi<2>(band, x, xsum, n_kt, y); return;
+            case 3: htptile_band_neon_multi<3>(band, x, xsum, n_kt, y); return;
+            case 4: htptile_band_neon_multi<4>(band, x, xsum, n_kt, y); return;
+            default: break;
+        }
+    }
+#endif
+    for (int t = 0; t < nt; t++) htptile_band(kern, band, x[t], xsum[t], n_kt, y[t]);
+}
+
+// single-token (decode) loop and kernel selection, see the ne12 == 1 path of compute_forward
+// GGML_HTPTILE_DEC: 3 (default) dynamic chunks of GGML_HTPTILE_CHUNK (4) consecutive bands, precomputed block sums;
+// 2 one contiguous band range per thread; 1 interleaved bands with precomputed sums; 0 the original loop.
+static int htptile_dec_mode() { static const int v = getenv("GGML_HTPTILE_DEC") ? atoi(getenv("GGML_HTPTILE_DEC")) : 3; return v; }
+
+// trilane dc2: work buffer of the fused single-token MoE paths: [Q8_0 rows of the down input][their block sums]
+// [per thread: Q8_0 copy of the activation row + its block sums]
+static size_t htptile_moe_q8_bytes(int64_t n, int n_ids) {
+    return GGML_PAD((size_t) n_ids * ggml_row_size(GGML_TYPE_Q8_0, n), 64) + GGML_PAD((size_t) n_ids * (n / 32) * sizeof(int32_t), 64);
+}
+static size_t htptile_moe_own_bytes(int64_t n) {
+    return GGML_PAD(ggml_row_size(GGML_TYPE_Q8_0, n), 64) + GGML_PAD((size_t) (n / 32) * sizeof(int32_t), 64);
+}
+
+namespace ggml::cpu::htptile {
+
+class tensor_traits : public ggml::cpu::tensor_traits {
+    // q8_0 activation rows, then per-block int32 sums
+    bool work_size(int n_threads, const struct ggml_tensor * op, size_t & size) override {
+        const ggml_tensor * src1 = op->src[1];
+        const int64_t rows = src1->ne[1] * src1->ne[2];
+        size = ggml_row_size(GGML_TYPE_Q8_0, src1->ne[0]) * rows + sizeof(int32_t) * (src1->ne[0] / 32) * rows + 64;
+        static const bool fuse_env = [] {
+            const char * e = getenv("GGML_CPU_MOE_FUSE");
+            const char * d = getenv("GGML_CPU_DISABLE_FUSION");
+            return !(e && atoi(e) == 0) && !(d && atoi(d) == 1);
+        }();
+        if (op->op == GGML_OP_MUL_MAT_ID && src1->ne[2] == 1 && op->src[2]->ne[1] == 1 && fuse_env &&
+            ggml_cpu_htptile_moe_supported(op)) {
+            // fused single-token MoE paths (ggml_cpu_htptile_moe_*), as producer and as consumer of the Q8_0 rows;
+            // with the fusion switched off (GGML_HTPTILE_MOE_FUSE=0, GGML_CPU_MOE_FUSE=0) the old work size is kept
+            const int n_ids = (int) op->src[2]->ne[0];
+            const size_t q8 = std::max(htptile_moe_q8_bytes(op->ne[0], n_ids), htptile_moe_q8_bytes(src1->ne[0], n_ids));
+            size = std::max(size, q8 + (size_t) n_threads * htptile_moe_own_bytes(src1->ne[0]));
+        }
+        return true;
+    }
+
+    // MUL_MAT_ID: dst[N, n_used, n_tok] = experts[K, N, E][ids] x src1[K, ne11, n_tok]
+    // MUL_MAT:    dst[N, n_tok] = W[K, N] x src1[K, n_tok]  (treated as one expert, one slot)
+    bool compute_forward(struct ggml_compute_params * params, struct ggml_tensor * op) override {
+        if (op->op != GGML_OP_MUL_MAT_ID && op->op != GGML_OP_MUL_MAT) {
+            return false;
+        }
+        const bool is_id = op->op == GGML_OP_MUL_MAT_ID;
+        const ggml_tensor * src0 = op->src[0];
+        const ggml_tensor * src1 = op->src[1];
+        const ggml_tensor * ids  = is_id ? op->src[2] : nullptr;
+        const int ith = params->ith, nth = params->nth;
+
+        const int64_t K = src0->ne[0], N = src0->ne[1];
+        const int64_t ne11 = is_id ? src1->ne[1] : 1;
+        const int64_t ne12 = is_id ? src1->ne[2] : src1->ne[1];
+        const int64_t n_used = is_id ? ids->ne[0] : 1;
+        const size_t  rs = ggml_row_size(GGML_TYPE_Q8_0, K);
+        const int     n_kt = (int) (K / 32);
+        uint8_t * wq   = (uint8_t *) params->wdata;
+        int32_t * sums = (int32_t *) (wq + rs * ne11 * ne12);
+        static const htptile_kernel kern0 = htptile_pick_kernel();
+        htptile_kernel kern = kern0;
+#if defined(HTPTILE_I8MM)
+        // batches (speculative verification, prefill over aliased weights) take the i8mm matrix kernel
+        static const bool no_mmla = getenv("GGML_HTPTILE_NO_MMLA") != nullptr;
+        if (kern0 == HTPTILE_DOT && !no_mmla && ne12 > 1) {
+            kern = HTPTILE_MMLA;
+        }
+#endif
+
+        GGML_ASSERT(src1->nb[0] == sizeof(float));
+        // MUL_MAT keeps tokens on dim 1, MUL_MAT_ID on dim 2
+        const size_t nb_slot = is_id ? src1->nb[1] : 0;
+        const size_t nb_tok  = is_id ? src1->nb[2] : src1->nb[1];
+        for (int64_t r = ith; r < ne11 * ne12; r += nth) {
+            const int64_t i11 = r % ne11, i12 = r / ne11;
+            quantize_row_q8_0((const float *) ((const char *) src1->data + i11 * nb_slot + i12 * nb_tok), wq + r * rs, K);
+            if (htptile_tl() && kern != HTPTILE_REF) {
+                htptile_prep_x2((block_q8_0 *) (wq + r * rs), sums + r * n_kt, n_kt);
+            } else
+#if defined(HTPTILE_I8MM)
+            if (kern == HTPTILE_USDOT || kern == HTPTILE_MMLA) {
+                if (htptile_mmla2()) htptile_prep_x2((block_q8_0 *) (wq + r * rs), sums + r * n_kt, n_kt);
+                else                 htptile_prep_x((block_q8_0 *) (wq + r * rs), sums + r * n_kt, n_kt);
+            } else
+#endif
+            {
+                htptile_block_sums((const block_q8_0 *) (wq + r * rs), sums + r * n_kt, n_kt);
+            }
+        }
+        if (ith == 0) {
+            ggml_threadpool_chunk_set(params->threadpool, nth); // dynamic band chunks (GGML_HTPTILE_DEC=3)
+        }
+        ggml_barrier(params->threadpool);
+
+        const int64_t n_bands = N / HT_ROWS;
+        const block_q8_0 * xs[HT_MULTI];
+        const int32_t *    ss[HT_MULTI];
+        float *            ys[HT_MULTI];
+        // trilane r6: GGML_HTPTILE_DENSE (default 1): dense single tokens take the decode loop below (dynamic chunks,
+        // precomputed sums) and dense batches hand out dynamic chunks of bands; 0 restores the interleaved band loop
+        static const int dense_mode = getenv("GGML_HTPTILE_DENSE") ? atoi(getenv("GGML_HTPTILE_DENSE")) : 1;
+        if (!is_id && (ne12 > 1 || dense_mode == 0)) {
+            // band-outer, tokens-inner: each 32-row band (~27 KB) stays in L1 while every token uses it,
+            // and tokens go through the band HT_MULTI at a time
+            static const int64_t dch0 = std::max(1, getenv("GGML_HTPTILE_DENSE_CHUNK") ? atoi(getenv("GGML_HTPTILE_DENSE_CHUNK")) : 2);
+            // trilane r7: GGML_HTPTILE_BATCH_KB (default 640): batch chunks of about this many weight bytes (at least
+            // 2 * nth chunks per op), so short-K bands (e.g. 5120 x 17408 gate/up: 92 KB per band) are handed out several
+            // at a time; 0 restores GGML_HTPTILE_DENSE_CHUNK bands per chunk. With GGML_HEXAGON_Q4_TL=0 the default is 0,
+            // so that one switch restores the whole round-6 CPU path (set GGML_HTPTILE_BATCH_KB to combine them)
+            static const int64_t bkb = getenv("GGML_HTPTILE_BATCH_KB") ? atoi(getenv("GGML_HTPTILE_BATCH_KB"))
+                                                                      : (htptile_tl() ? 640 : 0);
+            const int64_t dch = bkb > 0 ? std::max<int64_t>(1, std::min<int64_t>(bkb * 1024 / (n_kt * (int64_t) HT_BYTES), n_bands / (2 * nth)))
+                                        : dch0;
+            const bool dyn = dense_mode != 0;
+            const int64_t n_ch = dyn ? (n_bands + dch - 1) / dch : n_bands;
+            for (int64_t c = ith; c < n_ch; c = dyn ? ggml_threadpool_chunk_add(params->threadpool, 1) : c + nth)
+            for (int64_t band = dyn ? c * dch : c; band < (dyn ? std::min(n_bands, (c + 1) * dch) : c + 1); band++) {
+                const uint8_t * w = (const uint8_t *) src0->data + band * HT_ROWS * src0->nb[1];
+                for (int64_t t0 = 0; t0 < ne12; t0 += HT_MULTI) {
+                    const int nt = (int) std::min<int64_t>(HT_MULTI, ne12 - t0);
+                    for (int i = 0; i < nt; i++) {
+                        xs[i] = (const block_q8_0 *) (wq + (t0 + i) * rs);
+                        ss[i] = sums + (t0 + i) * n_kt;
+                        ys[i] = (float *) ((char *) op->data + (t0 + i) * op->nb[1]) + band * HT_ROWS;
+                    }
+                    htptile_band_multi(kern, w, xs, ss, n_kt, ys, nt);
+                }
+            }
+            return true;
+        }
+        if (ne12 > 1) {
+            // batches (prefill, speculative verification): group (token, slot) pairs by expert so each expert band
+            // is unpacked once per HT_MULTI tokens that route to it
+            const int64_t n_exp = src0->ne[2];
+            thread_local std::vector<int32_t> cnt, start, pairs;
+            cnt.assign(n_exp + 1, 0);
+            for (int64_t t = 0; t < ne12; t++) {
+                for (int64_t s = 0; s < n_used; s++) {
+                    const int32_t e = *(const int32_t *) ((const char *) ids->data + s * ids->nb[0] + t * ids->nb[1]);
+                    cnt[e + 1]++;
+                }
+            }
+            start.assign(n_exp + 1, 0);
+            for (int64_t e = 0; e < n_exp; e++) start[e + 1] = start[e] + cnt[e + 1];
+            pairs.assign(ne12 * n_used, 0);
+            std::vector<int32_t> fill(start.begin(), start.end() - 1);
+            for (int64_t t = 0; t < ne12; t++) {
+                for (int64_t s = 0; s < n_used; s++) {
+                    const int32_t e = *(const int32_t *) ((const char *) ids->data + s * ids->nb[0] + t * ids->nb[1]);
+                    pairs[fill[e]++] = (int32_t) (t * n_used + s);
+                }
+            }
+            const int64_t n_items_e = n_exp * n_bands;
+            for (int64_t it = ith; it < n_items_e; it += nth) {
+                const int64_t e = it / n_bands, band = it % n_bands;
+                const int32_t p0 = start[e], p1 = start[e + 1];
+                if (p0 == p1) continue;
+                const uint8_t * w = (const uint8_t *) src0->data + e * src0->nb[2] + band * HT_ROWS * src0->nb[1];
+                for (int32_t p = p0; p < p1; p += HT_MULTI) {
+                    const int nt = std::min<int32_t>(HT_MULTI, p1 - p);
+                    for (int i = 0; i < nt; i++) {
+                        const int64_t t = pairs[p + i] / n_used, s = pairs[p + i] % n_used;
+                        const int64_t row = (s % ne11) + t * ne11;
+                        xs[i] = (const block_q8_0 *) (wq + row * rs);
+                        ss[i] = sums + row * n_kt;
+                        ys[i] = (float *) ((char *) op->data + s * op->nb[1] + t * op->nb[2]) + band * HT_ROWS;
+                    }
+                    htptile_band_multi(kern, w, xs, ss, n_kt, ys, nt);
+                }
+            }
+            return true;
+        }
+        const int64_t n_items = ne12 * n_used * n_bands;
+#if defined(__ARM_NEON) && defined(__ARM_FEATURE_DOTPROD)
+        // GGML_HTPTILE_DEC=0 restores the original single-token loop (interleaved bands, sums recomputed per tile)
+        const int dec_mode = htptile_dec_mode();
+        static const int dec_pf   = getenv("GGML_HTPTILE_PF") ? atoi(getenv("GGML_HTPTILE_PF")) : 0;
+        static const int dec_ch   = std::max(1, getenv("GGML_HTPTILE_CHUNK") ? atoi(getenv("GGML_HTPTILE_CHUNK")) : 4);
+        if (dec_mode > 0 && (kern == HTPTILE_DOT || kern == HTPTILE_USDOT)) {
+            auto item = [&](int64_t it) {
+                const int64_t band = it % n_bands;
+                const int64_t s    = (it / n_bands) % n_used;
+                const int64_t t    = it / (n_bands * n_used);
+                const int32_t e    = is_id ? *(const int32_t *) ((const char *) ids->data + s * ids->nb[0] + t * ids->nb[1]) : 0;
+                const uint8_t * w  = (const uint8_t *) src0->data + e * src0->nb[2] + band * HT_ROWS * src0->nb[1];
+                const int64_t row = (s % ne11) + t * ne11;
+                float * y = is_id ? (float *) ((char *) op->data + s * op->nb[1] + t * op->nb[2]) + band * HT_ROWS
+                                  : (float *) ((char *) op->data + t * op->nb[1]) + band * HT_ROWS;
+                if (htptile_tl()) {
+                    htptile_band_tl1(w, (const block_q8_0 *) (wq + row * rs), sums + row * n_kt, n_kt, y, dec_pf);
+                } else if (kern == HTPTILE_DOT) {
+                    htptile_band_neon(w, (const block_q8_0 *) (wq + row * rs), sums + row * n_kt, n_kt, y, dec_pf);
+                } else {
+                    htptile_band(kern, w, (const block_q8_0 *) (wq + row * rs), sums + row * n_kt, n_kt, y);
+                }
+            };
+            if (dec_mode == 1) {
+                // interleaved bands as before, precomputed sums (+ optional prefetch)
+                for (int64_t it = ith; it < n_items; it += nth) item(it);
+            } else if (dec_mode == 2) {
+                // one contiguous range of bands per thread
+                const int64_t i0 = n_items * ith / nth, i1 = n_items * (ith + 1) / nth;
+                for (int64_t it = i0; it < i1; it++) item(it);
+            } else {
+                // dynamic chunks of dec_ch consecutive bands (the counter was armed before the barrier)
+                const int64_t ch = dec_ch;
+                const int64_t n_ch = (n_items + ch - 1) / ch;
+                for (int64_t c = ith; c < n_ch; c = ggml_threadpool_chunk_add(params->threadpool, 1)) {
+                    const int64_t i1 = std::min<int64_t>(n_items, (c + 1) * ch);
+                    for (int64_t it = c * ch; it < i1; it++) item(it);
+                }
+            }
+            return true;
+        }
+#endif
+        for (int64_t it = ith; it < n_items; it += nth) {
+            const int64_t band = it % n_bands;
+            const int64_t s    = (it / n_bands) % n_used;
+            const int64_t t    = it / (n_bands * n_used);
+            const int32_t e    = is_id ? *(const int32_t *) ((const char *) ids->data + s * ids->nb[0] + t * ids->nb[1]) : 0;
+            const uint8_t * w  = (const uint8_t *) src0->data + e * src0->nb[2] + band * HT_ROWS * src0->nb[1];
+            const int64_t row = (s % ne11) + t * ne11;
+            const block_q8_0 * xq = (const block_q8_0 *) (wq + row * rs);
+            float * y = is_id ? (float *) ((char *) op->data + s * op->nb[1] + t * op->nb[2]) + band * HT_ROWS
+                              : (float *) ((char *) op->data + t * op->nb[1]) + band * HT_ROWS;
+            htptile_band(kern, w, xq, sums + row * n_kt, n_kt, y);
+        }
+        return true;
+    }
+};
+
+static tensor_traits g_traits;
+
+class extra_buffer_type : ggml::cpu::extra_buffer_type {
+    bool supports_op(ggml_backend_dev_t, const struct ggml_tensor * op) override {
+        if ((op->op != GGML_OP_MUL_MAT_ID && op->op != GGML_OP_MUL_MAT) || !g_resolver) {
+            return false;
+        }
+        const ggml_tensor * src0 = op->src[0];
+        const ggml_tensor * src1 = op->src[1];
+        if (!src0->buffer || src0->buffer->buft != ggml_backend_cpu_htptile_buffer_type() || !htptile_shape_ok(src0)) {
+            return false;
+        }
+        if (src1->buffer && !ggml_backend_buft_is_host(src1->buffer->buft)) {
+            return false;
+        }
+        if (op->op == GGML_OP_MUL_MAT && (src0->ne[2] != 1 || src1->ne[2] != 1 || src1->ne[3] != 1 || src1->nb[0] != sizeof(float))) {
+            return false; // plain 2-D weight x token rows only
+        }
+        return src1->type == GGML_TYPE_F32 && op->type == GGML_TYPE_F32;
+    }
+
+    ggml::cpu::tensor_traits * get_tensor_traits(const struct ggml_tensor * op) override {
+        if ((op->op == GGML_OP_MUL_MAT_ID || op->op == GGML_OP_MUL_MAT) && op->src[0]->buffer &&
+            op->src[0]->buffer->buft == ggml_backend_cpu_htptile_buffer_type()) {
+            return &g_traits;
+        }
+        return nullptr;
+    }
+};
