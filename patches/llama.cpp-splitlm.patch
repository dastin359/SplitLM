+// hvx_sigmul_f32_hf_aa with four 64-lane pairs per iteration and all loads ahead of the stores (same math per
+// element, bit-identical; the tail goes through hvx_sigmul_f32_hf_aa)
+static inline void hvx_sigmul_f32_hf_aa4(uint8_t * restrict dst, const uint8_t * restrict g, const uint8_t * restrict u, uint32_t n) {
+    const struct hvx_silu_hf_consts c = hvx_silu_hf_consts_init();
+    const HVX_Vector one_hf  = hvx_vec_splat_f16((_Float16) 1.0f);
+    const HVX_Vector one_f32 = hvx_vec_splat_f32(1.0f);
+    const HVX_Vector m1      = Q6_V_vsplat_R(-1);
+
+    HVX_Vector * restrict vdst     = (HVX_Vector *) dst;
+    const HVX_Vector * restrict vg = (const HVX_Vector *) g;
+    const HVX_Vector * restrict vu = (const HVX_Vector *) u;
+
+    const uint32_t nq = n / (8 * VLEN_FP32);
+    for (uint32_t i = 0; i < nq; i++) {
+        HVX_Vector x[8], uu[8], y[8];
+        #pragma unroll
+        for (int j = 0; j < 8; j++) {
+            x[j]  = vg[8 * i + j];
+            uu[j] = vu[8 * i + j];
+        }
+        #pragma unroll
+        for (int j = 0; j < 4; j++) {
+            hvx_vec_sigmoid2_f32_hf(x[2 * j], x[2 * j + 1], &y[2 * j], &y[2 * j + 1], &c, one_hf, one_f32, m1);
+        }
+        #pragma unroll
+        for (int j = 0; j < 8; j++) {
+            vdst[8 * i + j] = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(y[j], uu[j]));
+        }
+    }
+    const uint32_t done = nq * 8 * VLEN_FP32;
+    if (done < n) {
+        hvx_sigmul_f32_hf_aa(dst + done * sizeof(float), g + done * sizeof(float), u + done * sizeof(float), n - done);
+    }
+}
