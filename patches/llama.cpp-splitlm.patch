+// ---- activation: fp16 tiles -> offset int16 tiles in place, per-row power-of-two scale ----
+typedef struct {
+    __fp16 * act;          // n_row_tiles x n_k_tiles fp16 tiles
+    float *  row_scale;    // out: 2^-e per row
+    uint32_t n_rows;       // valid rows (rows above are padding: quantized too, never stored)
+    uint32_t n_k_tiles;
+    uint32_t n_pairs;      // row pairs to process (ceil(n_rows_padded / 2))
+    struct htp_thread_trace * traces;
+} hmx_i8_act_state_t;
+
+// one unit = 8 row pairs (half a 32-row tile row): the max pass reads the 8 contiguous vectors of every k tile into
+// 8 independent accumulators; the per-row exponent / fp16 scale factors are computed in HVX (no per-row scalar math)
+#define HMX_I8_AQ_PAIRS 8
+static void hmx_i8_act_worker(unsigned int n, unsigned int i, void * data) {
+    const hmx_i8_act_state_t * st = (const hmx_i8_act_state_t *) data;
+    struct htp_thread_trace * tr = &st->traces[i];
+    htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_A_QUANT, 0);
+    const uint32_t n_units = st->n_pairs / HMX_I8_AQ_PAIRS;
+    const uint32_t per = (n_units + n - 1) / n;
+    const uint32_t u0 = i * per;
+    const uint32_t u1 = u0 + per < n_units ? u0 + per : n_units;
+    const HVX_Vector absm = Q6_Vh_vsplat_R(0x7fff);
+    const HVX_Vector sgn  = Q6_Vh_vsplat_R(0x8000);
+    const HVX_Vector c1f  = Q6_Vh_vsplat_R(0x1f);
+    const HVX_Vector c29  = Q6_Vh_vsplat_R(29);
+    const HVX_Vector c15  = Q6_Vh_vsplat_R(15);
+    const HVX_Vector zero = Q6_V_vzero();
+    const size_t tv = 2048 / VLEN;  // vectors per tile
+    const uint32_t nkt = st->n_k_tiles;
+    for (uint32_t u = u0; u < u1; ++u) {
+        const uint32_t rt = u / 2, v0 = (u % 2) * HMX_I8_AQ_PAIRS;
+        HVX_Vector * base = (HVX_Vector *) st->act + (size_t) rt * nkt * tv + v0;
+        HVX_Vector m[HMX_I8_AQ_PAIRS];
+        for (int j = 0; j < HMX_I8_AQ_PAIRS; ++j) m[j] = zero;
+        for (uint32_t t = 0; t < nkt; ++t) {
+            const HVX_Vector * src = base + t * tv;
+            for (int j = 0; j < HMX_I8_AQ_PAIRS; ++j) m[j] = Q6_Vh_vmax_VhVh(m[j], Q6_V_vand_VV(src[j], absm));
+        }
+        HVX_Vector vs1[HMX_I8_AQ_PAIRS], vs2[HMX_I8_AQ_PAIRS];
+        HVX_Vector bor = zero;
+        for (int j = 0; j < HMX_I8_AQ_PAIRS; ++j) {
+            HVX_Vector x = m[j];
+            // all-reduce over the 32 words, even (row 2p) and odd (row 2p+1) halfwords apart
+            x = Q6_Vh_vmax_VhVh(x, Q6_V_vror_VR(x, 64));
+            x = Q6_Vh_vmax_VhVh(x, Q6_V_vror_VR(x, 32));
+            x = Q6_Vh_vmax_VhVh(x, Q6_V_vror_VR(x, 16));
+            x = Q6_Vh_vmax_VhVh(x, Q6_V_vror_VR(x, 8));
+            x = Q6_Vh_vmax_VhVh(x, Q6_V_vror_VR(x, 4));
+            // fp16 exponent field E -> e = 29 - E (amax * 2^e in [2^14, 2^15)); E = 31 (inf/nan) -> e = 0
+            const HVX_Vector E  = Q6_V_vand_VV(Q6_Vuh_vlsr_VuhR(x, 10), c1f);
+            const HVX_Vector e  = Q6_V_vmux_QVV(Q6_Q_vcmp_eq_VhVh(E, c1f), zero, Q6_Vh_vsub_VhVh(c29, E));
+            const HVX_Vector a  = Q6_Vh_vmin_VhVh(e, c15);                      // first factor 2^a, a <= 15
+            const HVX_Vector b  = Q6_Vh_vmax_VhVh(Q6_Vh_vsub_VhVh(e, c15), zero); // second factor 2^b for tiny rows
+            vs1[j] = Q6_Vh_vasl_VhR(Q6_Vh_vadd_VhVh(a, c15), 10);
+            vs2[j] = Q6_Vh_vasl_VhR(Q6_Vh_vadd_VhVh(b, c15), 10);
+            bor = Q6_V_vor_VV(bor, b);
+            const uint32_t w2 = (uint32_t) Q6_R_vextract_VR(e, 0);
+            const int32_t  e0 = (int16_t) (w2 & 0xffff), e1 = (int16_t) (w2 >> 16);
+            union { uint32_t u; float f; } r0 = { (uint32_t) (127 - e0) << 23 }, r1 = { (uint32_t) (127 - e1) << 23 };
+            const uint32_t row = rt * 32 + 2 * (v0 + j);
+            st->row_scale[row]     = r0.f;   // 2^-e
+            st->row_scale[row + 1] = r1.f;
+        }
+        const bool two = Q6_R_vextract_VR(bor, 0) != 0;
+        for (int j = 0; j < HMX_I8_AQ_PAIRS; ++j) {
+            HVX_Vector * restrict p = base + j;
+            const HVX_Vector s1 = vs1[j];
+            if (!two) {
+                #pragma unroll(4)
+                for (uint32_t t = 0; t < nkt; ++t) {
+                    const HVX_Vector x = Q6_Vhf_equals_Vqf16(Q6_Vqf16_vmpy_VhfVhf(p[t * tv], s1));
+                    p[t * tv] = Q6_V_vxor_VV(Q6_Vh_equals_Vhf(x), sgn);
+                }
+            } else {
+                const HVX_Vector s2 = vs2[j];
+                for (uint32_t t = 0; t < nkt; ++t) {
+                    HVX_Vector x = Q6_Vhf_equals_Vqf16(Q6_Vqf16_vmpy_VhfVhf(p[t * tv], s1));
+                    x = Q6_Vhf_equals_Vqf16(Q6_Vqf16_vmpy_VhfVhf(x, s2));
+                    p[t * tv] = Q6_V_vxor_VV(Q6_Vh_equals_Vhf(x), sgn);
+                }
+            }
+        }
+    }
+    htp_trace_event_stop(tr, HTP_TRACE_EVT_HVX_A_QUANT, 0);
+}
+
+static void hmx_i8_act_quant_threaded(struct htp_context * ctx, __fp16 * act, float * row_scale, uint32_t n_rows,
+                                      uint32_t n_k_tiles, uint32_t n_threads) {
+    hmx_i8_act_state_t st = {
+        .act = act, .row_scale = row_scale, .n_rows = n_rows, .n_k_tiles = n_k_tiles,
+        .n_pairs = ((n_rows + 31) / 32) * 16, .traces = ctx->trace,
+    };
+    uint32_t nt = n_threads;
+    if (nt > st.n_pairs / HMX_I8_AQ_PAIRS) nt = st.n_pairs / HMX_I8_AQ_PAIRS;
+    if (nt <= 1) {
+        hmx_i8_act_worker(1, 0, &st);
+    } else {
+        worker_pool_run_func(ctx->worker_pool, hmx_i8_act_worker, &st, nt);
+    }
+}
+
+// ---- output: two int windows -> fp16 tiles (in place over the lo window) ----
+typedef struct {
+    __fp16 *        out_lo;
+    const __fp16 *  out_hi;
+    const uint8_t * meta;
+    const float *   row_scale;
+    uint32_t        n_row_tiles;
+    uint32_t        n_col_tiles;
+    struct htp_thread_trace * traces;
+} hmx_i8_out_state_t;
+
+static void hmx_i8_out_worker(unsigned int n, unsigned int i, void * data) {
+    const hmx_i8_out_state_t * st = (const hmx_i8_out_state_t *) data;
+    struct htp_thread_trace * tr = &st->traces[i];
+    htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_W_PREP, 0);
+    const uint32_t n_pairs = st->n_row_tiles * 16;
+    const uint32_t per = (n_pairs + n - 1) / n;
+    const uint32_t p0 = i * per;
+    const uint32_t p1 = p0 + per < n_pairs ? p0 + per : n_pairs;
+    const HVX_Vector zero = Q6_V_vzero();
+    const size_t tv = 2048 / VLEN;
+    for (uint32_t p = p0; p < p1; ++p) {
+        const uint32_t rt = p / 16, v = p % 16;
+        const HVX_Vector rse = Q6_Vqf32_vadd_VsfVsf(hvx_vec_splat_f32(st->row_scale[2 * p]), zero);
+        const HVX_Vector rso = Q6_Vqf32_vadd_VsfVsf(hvx_vec_splat_f32(st->row_scale[2 * p + 1]), zero);
+        HVX_Vector * restrict       lo = (HVX_Vector *) st->out_lo + (size_t) rt * st->n_col_tiles * tv + v;
+        const HVX_Vector * restrict hi = (const HVX_Vector *) st->out_hi + (size_t) rt * st->n_col_tiles * tv + v;
+        const uint8_t * restrict    cs = st->meta + HTP_I8_META_CS_OFF;
+        #pragma unroll(4)
+        for (uint32_t c = 0; c < st->n_col_tiles; ++c) {
+            const HVX_Vector vl = lo[c * tv];
+            const HVX_Vector vh = hi[c * tv];
+            const HVX_Vector vc = *(const HVX_Vector *) (cs + (size_t) c * HTP_I8_META_BYTES);
+            const HVX_Vector fe = Q6_Vsf_equals_Vw(Q6_Vh_vshuffe_VhVh(vh, vl));
+            const HVX_Vector fo = Q6_Vsf_equals_Vw(Q6_Vh_vshuffo_VhVh(vh, vl));
+            const HVX_Vector pe = Q6_Vqf32_vmpy_Vqf32Vqf32(Q6_Vqf32_vmpy_VsfVsf(fe, vc), rse);
+            const HVX_Vector po = Q6_Vqf32_vmpy_Vqf32Vqf32(Q6_Vqf32_vmpy_VsfVsf(fo, vc), rso);
+            lo[c * tv] = Q6_Vhf_equals_Wqf32(Q6_W_vcombine_VV(po, pe));
+        }
+    }
+    htp_trace_event_stop(tr, HTP_TRACE_EVT_HVX_W_PREP, 0);
+}
+
+static void hmx_i8_out_convert_threaded(struct htp_context * ctx, __fp16 * out_lo, const __fp16 * out_hi, const uint8_t * meta,
+                                        const float * row_scale, uint32_t n_row_tiles, uint32_t n_col_tiles, uint32_t n_threads) {
+    hmx_i8_out_state_t st = {
+        .out_lo = out_lo, .out_hi = out_hi, .meta = meta, .row_scale = row_scale,
+        .n_row_tiles = n_row_tiles, .n_col_tiles = n_col_tiles, .traces = ctx->trace,
+    };
+    uint32_t nt = n_threads;
+    if (nt > n_row_tiles * 16) nt = n_row_tiles * 16;
+    if (nt <= 1) {
+        hmx_i8_out_worker(1, 0, &st);
+    } else {
+        worker_pool_run_func(ctx->worker_pool, hmx_i8_out_worker, &st, nt);
+    }
+}
+
+// ---- VTCM plan inside the unchanged 2D layout (planned for the original weight type) ----
+//   weights: 4 slots of nc * k bytes = the two dequant scratch buffers split in halves
+//   hi window + 4 meta slots: the two raw (quantized) weight buffers, which the int path does not use
+//   row scales: after the meta slots in the second raw buffer
+typedef struct {
+    int8_t *  w[4];
+    uint8_t * meta[4];
+    __fp16 *  hi[2];
+    float *   row_scale;
+    uint32_t  mc;           // rows per m-block (multiple of 32), 0 = does not fit
+} hmx_i8_plan_t;
+
+static inline void hmx_i8_plan(hmx_i8_plan_t * P, uint8_t * base, const struct htp_mm_hmx_vtcm_layout * L, uint32_t k, uint32_t nc,
+                               uint32_t m_chunk, bool pipeline) {
+    memset(P, 0, sizeof(*P));
+    if (!pipeline || (nc % 32) != 0 || (k % 32) != 0) return;
+    const size_t wbytes = (size_t) nc * k;
+    if (L->scratch_bytes[0] < 2 * wbytes || L->scratch_bytes[1] < 2 * wbytes) return;
+    const size_t mbytes = (size_t) (nc / 32) * HTP_I8_META_BYTES;
+    const size_t mbytes_al = (mbytes + 255) & ~(size_t) 255;
+    if (L->weight_area_bytes < 2 * mbytes_al + 32 * (size_t) nc * 2) return;
+    // per raw buffer: hi window (mc x nc fp16-sized) + 2 meta slots; raw1 also holds the mc row scales
+    size_t mc = (L->weight_area_bytes - 2 * mbytes_al - 128) / ((size_t) nc * 2 + 4);
+    mc = mc / 32 * 32;
+    if (mc > (size_t) m_chunk) mc = (size_t) m_chunk / 32 * 32;
+    if (mc < 32) return;
+    uint8_t * s0 = base + L->off_scratch[0];
+    uint8_t * s1 = base + L->off_scratch[1];
+    P->w[0] = (int8_t *) s0; P->w[1] = (int8_t *) s1; P->w[2] = (int8_t *) (s0 + wbytes); P->w[3] = (int8_t *) (s1 + wbytes);
+    uint8_t * r0 = base + L->off_weight[0];
+    uint8_t * r1 = base + L->off_weight[1];
+    const size_t hib = mc * nc * 2;
+    P->hi[0] = (__fp16 *) r0; P->hi[1] = (__fp16 *) r1;
+    P->meta[0] = r0 + hib; P->meta[1] = r1 + hib; P->meta[2] = r0 + hib + mbytes_al; P->meta[3] = r1 + hib + mbytes_al;
+    P->row_scale = (float *) (r1 + hib + 2 * mbytes_al);
+    P->mc = (uint32_t) mc;
+}
+
+// push the DMAs of columns [c0, c0 + n_cols) of one weight (int8 tiles + meta); 2 pushes
+static inline void hmx_i8_push_cols(dma_queue * q, int8_t * wdst, uint8_t * mdst, dma_addr_t w_i8, dma_addr_t meta_i8,
+                                    uint32_t k, size_t c0, size_t n_cols) {
+    const size_t g0 = c0 / 32, ng = (n_cols + 31) / 32;
+    const size_t wb = ng * (size_t) k * 32;
+    dma_queue_push(q, dma_make_data(wdst, w_i8 + g0 * (size_t) k * 32), 0, 0, wb, 1);
+    dma_queue_push(q, dma_make_data(mdst, meta_i8 + g0 * HTP_I8_META_BYTES), 0, 0, ng * HTP_I8_META_BYTES, 1);
+}
+
+// tiled fp16 activations of rows [mr, mr + n_rows) (whole 32-row tile rows) -> VTCM; 1 push
+static inline void hmx_i8_push_act(dma_queue * q, __fp16 * dst, dma_addr_t act, size_t mr, size_t n_rows, size_t k) {
+    dma_queue_push(q, dma_make_data(dst, act + (mr / HTP_MM_HMX_TILE_N_ROWS) * k * HTP_MM_HMX_TILE_N_ROWS * sizeof(__fp16)),
+                   0, 0, hex_align_up(n_rows, HTP_MM_HMX_TILE_N_ROWS) * k * sizeof(__fp16), 1);
+}
+
+// SWIGLU pair: gate columns [pc, pc + hc) then the same up columns, back to back in one slot; 4 pushes
+static inline void hmx_i8_push_pair(dma_queue * q, int8_t * wdst, uint8_t * mdst, dma_addr_t g_i8, dma_addr_t g_m8,
+                                    dma_addr_t u_i8, dma_addr_t u_m8, uint32_t k, size_t pc, size_t hc) {
+    const size_t gb = (hc + 31) / 32;
+    hmx_i8_push_cols(q, wdst, mdst, g_i8, g_m8, k, pc, hc);
+    hmx_i8_push_cols(q, wdst + gb * 32 * (size_t) k, mdst + gb * HTP_I8_META_BYTES, u_i8, u_m8, k, pc, hc);
+}
+
+// fused output conversion: the next output store reads the two windows directly (hmx-i8-cvt.h); clear g_i8o.on after it
+static inline void hmx_i8_out_begin(__fp16 * lo, __fp16 * hi, const uint8_t * meta, const float * rs, uint32_t nct) {
+    g_i8o.lo       = (const uint8_t *) lo;
+    g_i8o.hi_delta = (const uint8_t *) hi - (const uint8_t *) lo;
+    g_i8o.cs       = meta + HTP_I8_META_CS_OFF;
+    g_i8o.rs       = rs;
+    g_i8o.nct      = nct;
+    g_i8o.on       = 1;
+}
