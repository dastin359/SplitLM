+static inline size_t hmx_mmid_stream_vtcm_size(size_t mc, size_t nc, size_t w_col_bytes, size_t vec_dot_size, size_t fixed) {
+    return fixed + 2 * hex_align_up(nc * w_col_bytes, HTP_MM_HMX_TILE_SIZE) +
