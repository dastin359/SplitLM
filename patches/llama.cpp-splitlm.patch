+                                                                      const bool has_mask, const bool is_g1, const bool hmx_l,
+                                                                      const int opt) {
+    const bool cchk = (opt & FA_IL_OPT_CCHK) != 0;
+    fa_softmax_args_t *     args  = (fa_softmax_args_t *) data;
+    struct hmx_fa_context * factx = args->factx;
+
+    const size_t n_rows_g      = args->n_rows_g;
+    const size_t kv_rows       = args->kv_rows;
+    const size_t Bc            = args->Bc;
+    const size_t G             = args->G;
+    const size_t n_row_vec_cnt = hmx_ceil_div(n_rows_g, 64);
+    const size_t n_chunks      = hmx_ceil_div(kv_rows, 64);
+
+    size_t vec_start = 0;
+    size_t vec_end   = n_row_vec_cnt;
+    if (n > 1) {
+        const size_t vecs_per_t = fastdiv(n_row_vec_cnt + n - 1, &args->thread_div);
+        vec_start = i * vecs_per_t;
+        vec_end   = hex_smin(vec_start + vecs_per_t, n_row_vec_cnt);
+    }
+    if (vec_start >= n_row_vec_cnt) {
+        return;
+    }
+
+    struct htp_thread_trace * tr = &factx->octx->ctx->trace[i];
+    htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_FA_SFM, (uint16_t) (args->q_start * G + vec_start * 64));
+
+    const HVX_Vector     v_neg_inf   = Q6_Vh_vsplat_R(0xf800);  // masked score: fp16 -32768 (see fa_exp2_int_f16)
+    const HVX_Vector     v_threshold = Q6_Vh_vsplat_R(0xcc00);  // fp16 -16.0
+    const HVX_Vector     v_log2e     = hvx_vec_splat_f16(EXP_LOG2E_F);
+    const HVX_Vector     v_one_hf    = hvx_vec_splat_f16(1.0);
+    const HVX_VectorPred q_even      = Q6_Q_vand_VR(Q6_V_vsplat_R(0x00000101), 0x01010101);  // fp16 lanes of row r
+
+    for (size_t r_vec_idx = vec_start; r_vec_idx < vec_end; ++r_vec_idx) {
+        HVX_Vector rowmax_acc_v = v_neg_inf;
+        HVX_Vector m_prev_v0    = factx->vtcm_m_vec[r_vec_idx * 2 + 0];
+        HVX_Vector m_prev_v1    = factx->vtcm_m_vec[r_vec_idx * 2 + 1];
+        // m_prev of the 64 rows as fp16 in row order: the word at lane pair (r, r + 1) splats to the interleaved m
+        const HVX_Vector m_prev_hf = hvx_vec_f32_to_f16(m_prev_v0, m_prev_v1);
+        // row sums in f32 (rows 0..31 / 32..63 of this row vector)
+        HVX_Vector v_rowsum_acc_f32_0 = Q6_V_vzero();
+        HVX_Vector v_rowsum_acc_f32_1 = Q6_V_vzero();
+        uint8_t    n_lu_rp[32];  // per row pair: chunks to process (ZTAIL)
+
+        for (uint32_t r_vec_off = 0; r_vec_off < 64; r_vec_off += 2) {
+            const uint32_t r = r_vec_idx * 64 + r_vec_off;
+            if (r >= hex_align_up(n_rows_g, 2)) {
+                break;
+            }
+            const uint32_t r0 = r / HMX_FP16_TILE_N_ROWS;
+            const uint32_t r1 = r % HMX_FP16_TILE_N_ROWS;
+
+            HVX_Vector * sv = ((HVX_Vector *) (factx->vtcm_s_tiles[args->buf_idx] + r0 * HMX_FP16_TILE_N_ROWS * Bc)) + r1 / 2;
+            HVX_Vector * pv = ((HVX_Vector *) (factx->vtcm_p_tiles[args->buf_idx] + r0 * HMX_FP16_TILE_N_ROWS * Bc)) + r1 / 2;
+
+            const bool has_r1 = (r + 1 < n_rows_g);
+
+            // mask rows of r and r + 1 (m_mode as in fa_sfm_decode_mask_rows: 0 shared, 1 separate, 2 no row r + 1)
+            const __fp16 * m_row0 = NULL;
+            const __fp16 * m_row1 = NULL;
+            int            m_mode = has_r1 ? 1 : 2;
+            uint32_t       n_zc   = (uint32_t) (kv_rows / 64);
+            if (has_mask) {
+                const size_t m_stride = args->mask_vtcm_row_stride;
+                size_t       qi0      = r;
+                size_t       qi1      = r + 1;
+                if (!is_g1) {
+                    qi0    = fastdiv(r + 0, &factx->div_G);
+                    m_row0 = args->mask_vtcm + qi0 * m_stride;
+                    if (has_r1) {
+                        qi1    = fastdiv(r + 1, &factx->div_G);
+                        m_row1 = args->mask_vtcm + qi1 * m_stride;
+                        m_mode = (qi1 == qi0) ? 0 : 1;
+                    }
+                } else {
+                    m_row0 = args->mask_vtcm + (size_t) r * m_stride;
+                    if (has_r1) {
+                        m_row1 = args->mask_vtcm + (size_t) (r + 1) * m_stride;
+                    }
+                }
+                n_zc = 0;
+                if (args->zc) {
+                    uint32_t z = args->zc[qi0];
+                    if (m_mode == 1) {
+                        z = hex_smin(z, (uint32_t) args->zc[qi1]);
+                    }
+                    const uint32_t kc0 = args->kv_start / 64;
+                    n_zc = z > kc0 ? hex_smin(z - kc0, (uint32_t) (kv_rows / 64)) : 0;
+                }
+            }
+            if (m_mode == 2) {
+                n_zc = 0;  // row r + 1 is padding: its lanes are masked in every chunk
+            }
+            // ZTAIL: chunks [n_lu, n_chunks) are masked in both rows (P = 0)
+            uint32_t n_lu = (uint32_t) n_chunks;
+            if (has_mask && args->lu) {
+                const size_t qi0 = is_g1 ? r : fastdiv(r, &factx->div_G);
+                uint32_t     l   = args->lu[qi0];
+                if (m_mode == 1) {
+                    l = hex_smax(l, (uint32_t) args->lu[is_g1 ? r + 1 : fastdiv(r + 1, &factx->div_G)]);
+                }
+                const uint32_t kc0 = args->kv_start / 64;
+                n_lu = l > kc0 ? hex_smin(l - kc0, (uint32_t) n_chunks) : 0;
+                n_zc = hex_smin(n_zc, n_lu);
+            }
+            n_lu_rp[r_vec_off / 2] = (uint8_t) hex_smin(n_lu, 255u);
+
+            // ---- pass 1: row max (masked chunks are written back in place) ----
+            HVX_Vector v_mx = v_neg_inf;
+            uint32_t   ci   = 0;
+            for (; ci < n_zc; ++ci) {
+                v_mx = Q6_Vhf_vmax_VhfVhf(v_mx, sv[ci * 32]);
+                v_mx = Q6_Vhf_vmax_VhfVhf(v_mx, sv[ci * 32 + 16]);
+            }
+            for (; ci < n_lu; ++ci) {
+                const size_t c  = (size_t) ci * 64;
+                const size_t ne = hex_smin(kv_rows - c, 64);
+                HVX_Vector   v_m0, v_m1;
+                if (has_mask) {
+                    v_m0 = *(const HVX_Vector *) (m_row0 + c);
+                    v_m1 = (m_mode == 0) ? v_m0 : (m_mode == 1) ? *(const HVX_Vector *) (m_row1 + c) : v_neg_inf;
+                } else {
+                    v_m0 = Q6_V_vzero();
+                    v_m1 = (m_mode == 2) ? v_neg_inf : Q6_V_vzero();
+                }
+                // scale once per mask row (row r + 1 shares row r's in the GQA case), then interleave
+                const HVX_Vector     v_ms0 = hvx_vec_mul_f16_f16(v_m0, v_log2e);
+                const HVX_Vector     v_ms1 = (m_mode == 1) ? hvx_vec_mul_f16_f16(v_m1, v_log2e) : (m_mode == 0) ? v_ms0 : v_neg_inf;
+                const HVX_VectorPair vp_m  = Q6_W_vshuff_VVR(v_m1, v_m0, -2);
+                const HVX_VectorPair vp_ms = Q6_W_vshuff_VVR(v_ms1, v_ms0, -2);
+                for (uint32_t h = 0; h < 2; ++h) {
+                    HVX_Vector * ps = sv + ci * 32 + h * 16;
+                    if (ne <= h * 32) {
+                        *ps = v_neg_inf;
+                        continue;
+                    }
+                    const HVX_Vector v_m    = h ? Q6_V_hi_W(vp_m) : Q6_V_lo_W(vp_m);
+                    HVX_VectorPred   q_keep = Q6_Q_vcmp_gt_VhfVhf(v_m, v_threshold);
+                    if (ne < (h + 1) * 32) {
+                        q_keep = Q6_Q_and_QQ(q_keep, Q6_Q_vsetq2_R((ne - h * 32) * 4));
+                    }
+                    const HVX_Vector v_ms   = h ? Q6_V_hi_W(vp_ms) : Q6_V_lo_W(vp_ms);
+                    const HVX_Vector b      = Q6_V_vmux_QVV(q_keep, hvx_vec_add_f16_f16(*ps, v_ms), v_neg_inf);
+                    *ps  = b;
+                    v_mx = Q6_Vhf_vmax_VhfVhf(v_mx, b);
+                }
+            }
+            // parity-preserving max tree: every even lane gets row r's max, every odd lane row r + 1's
+            for (uint32_t w = 4; w < 128; w <<= 1) {
+                v_mx = Q6_Vhf_vmax_VhfVhf(v_mx, Q6_V_vror_VR(v_mx, w));
+            }
+
+            // m_prev of rows r, r + 1 in the even / odd lanes (a padding row r + 1 uses 0, as fa_softmax_impl)
+            HVX_Vector v_m_prev = hvx_vec_repl_f32(Q6_V_vror_VR(m_prev_hf, r_vec_off * 2));
+            if (!has_r1) {
+                v_m_prev = Q6_V_vmux_QVV(q_even, v_m_prev, Q6_V_vzero());
+            }
+            HVX_Vector       v_mh;
+            const HVX_Vector v_dup_m = fa_ceil_int_ref(Q6_Vhf_vmax_VhfVhf(v_m_prev, v_mx), &v_mh);
+
+            // insert rows r, r + 1 (lanes r_vec_off, r_vec_off + 1 have the matching parity)
+            {
+                HVX_VectorPred p_start = Q6_Q_vsetq_R(r_vec_off * 2);
+                HVX_VectorPred p_end   = Q6_Q_vsetq2_R((r_vec_off + 2) * 2);
+                rowmax_acc_v           = Q6_V_vmux_QVV(Q6_Q_and_QQn(p_end, p_start), v_dup_m, rowmax_acc_v);
+            }
+
+            // ---- pass 2: P = exp2(S - m) and the row sums (even lanes -> row r, odd lanes -> row r + 1) ----
+            if (!cchk) {
+                fa_il_pass2(sv, pv, n_lu, v_mh, r_vec_off, &v_rowsum_acc_f32_0, &v_rowsum_acc_f32_1, hmx_l, true, opt, true);
+                for (size_t cz = n_lu; cz < n_chunks; ++cz) {
+                    pv[cz * 32]      = Q6_V_vzero();
+                    pv[cz * 32 + 16] = Q6_V_vzero();
+                }
+            }
+        }
+
+        if (cchk) {
+            // pass 2 for all row pairs of this vector after their pass 1: one check instead of a vmin per S vector.
+            // A row reference of 16384 (the clamp of fa_ceil_int_ref) means the row may hold scores above 16384:
+            // clamp this vector's S rows in place first (rare: logits above ~11356).
+            HVX_Vector t = rowmax_acc_v;
+            for (uint32_t w = 2; w < 128; w <<= 1) {
+                t = Q6_Vhf_vmax_VhfVhf(t, Q6_V_vror_VR(t, w));
+            }
+            union {
+                HVX_Vector v;
+                uint16_t   h[64];
+            } u;
+            u.v = Q6_Vh_equals_Vhf(t);
+            const uint32_t r_end = hex_smin(r_vec_idx * 64 + 64, hex_align_up(n_rows_g, 2));
+            // lowest row reference of this vector (unused lanes hold -inf): <= -2030 selects the safe floor test
+            // of fa_exp2_int_f16_x (rare: every logit of a row hugely negative)
+            HVX_Vector t_lo = rowmax_acc_v;
+            for (uint32_t w = 2; w < 128; w <<= 1) {
+                t_lo = Q6_Vhf_vmin_VhfVhf(t_lo, Q6_V_vror_VR(t_lo, w));
+            }
+            union {
+                HVX_Vector v;
+                uint16_t   h[64];
+            } u_lo;
+            u_lo.v = Q6_Vh_equals_Vhf(t_lo);
+            const bool low_ref = (int16_t) u_lo.h[0] <= -2030;
+            if ((int16_t) u.h[0] >= 16384) {
+                for (uint32_t r = r_vec_idx * 64; r < r_end; r += 2) {
+                    HVX_Vector * sv = ((HVX_Vector *) (factx->vtcm_s_tiles[args->buf_idx] + (r / HMX_FP16_TILE_N_ROWS) * HMX_FP16_TILE_N_ROWS * Bc)) +
+                                      (r % HMX_FP16_TILE_N_ROWS) / 2;
+                    for (size_t ci = 0; ci < n_chunks * 2; ++ci) {
+                        sv[ci * 16] = Q6_Vhf_vmin_VhfVhf(sv[ci * 16], Q6_Vh_vsplat_R(0x7400));
+                    }
+                }
+            }
+            for (uint32_t r = r_vec_idx * 64; r < r_end; r += 2) {
+                const uint32_t r_vec_off = r - r_vec_idx * 64;
+                const uint32_t r0        = r / HMX_FP16_TILE_N_ROWS;
+                const uint32_t r1        = r % HMX_FP16_TILE_N_ROWS;
+                HVX_Vector * sv = ((HVX_Vector *) (factx->vtcm_s_tiles[args->buf_idx] + r0 * HMX_FP16_TILE_N_ROWS * Bc)) + r1 / 2;
+                HVX_Vector * pv = ((HVX_Vector *) (factx->vtcm_p_tiles[args->buf_idx] + r0 * HMX_FP16_TILE_N_ROWS * Bc)) + r1 / 2;
+                // the rows' integer references (fa_ceil_int_ref) back from rowmax_acc_v: lanes r_vec_off, r_vec_off + 1
+                const HVX_Vector v_mh = Q6_Vh_equals_Vhf(hvx_vec_repl_f32(Q6_V_vror_VR(rowmax_acc_v, r_vec_off * 2)));
+                const uint32_t   n_lu = n_lu_rp[r_vec_off / 2];
+                if (low_ref) {
+                    fa_il_pass2(sv, pv, n_lu, v_mh, r_vec_off, &v_rowsum_acc_f32_0, &v_rowsum_acc_f32_1, hmx_l, false, opt, true);
+                } else {
+                    fa_il_pass2(sv, pv, n_lu, v_mh, r_vec_off, &v_rowsum_acc_f32_0, &v_rowsum_acc_f32_1, hmx_l, false, opt, false);
+                }
+                for (size_t cz = n_lu; cz < n_chunks; ++cz) {
+                    pv[cz * 32]      = Q6_V_vzero();
+                    pv[cz * 32 + 16] = Q6_V_vzero();
+                }
+            }
+        }
+
+        // Inline fa_ml_update_and_build_d for this vector (lock-free and in parallel)
+        HVX_VectorPair rowmax_acc_pair    = hvx_vec_f16_to_f32(rowmax_acc_v);
+        HVX_Vector     v_rowmax_acc_f32_0 = Q6_V_lo_W(rowmax_acc_pair);
+        HVX_Vector     v_rowmax_acc_f32_1 = Q6_V_hi_W(rowmax_acc_pair);
+
+        HVX_Vector v_m_curr0 = Q6_Vsf_vmax_VsfVsf(m_prev_v0, v_rowmax_acc_f32_0);
+        HVX_Vector v_m_curr1 = Q6_Vsf_vmax_VsfVsf(m_prev_v1, v_rowmax_acc_f32_1);
+
+        HVX_Vector v_m_diff0 = HVX_OP_SUB_F32(m_prev_v0, v_m_curr0);
+        HVX_Vector v_m_diff1 = HVX_OP_SUB_F32(m_prev_v1, v_m_curr1);
+
+        HVX_Vector v_m_diff_f16   = hvx_vec_f32_to_f16(v_m_diff0, v_m_diff1);
+        HVX_Vector exp_m_diff_f16 = hvx_vec_exp2_f16(v_m_diff_f16);
+
+        HVX_VectorPair exp_m_diff_pair = hvx_vec_f16_to_f32(exp_m_diff_f16);
+        HVX_Vector exp_m_diff0 = Q6_V_lo_W(exp_m_diff_pair);
+        HVX_Vector exp_m_diff1 = Q6_V_hi_W(exp_m_diff_pair);
+
+        factx->vtcm_m_vec[r_vec_idx * 2 + 0] = v_m_curr0;
+        factx->vtcm_m_vec[r_vec_idx * 2 + 1] = v_m_curr1;
+        if (!hmx_l) {
+            HVX_Vector l_prev_v0 = factx->vtcm_l_vec[r_vec_idx * 2 + 0];
+            HVX_Vector l_prev_v1 = factx->vtcm_l_vec[r_vec_idx * 2 + 1];
+            HVX_Vector v_l_curr0 = HVX_OP_ADD_F32(HVX_OP_MUL_F32(l_prev_v0, exp_m_diff0), v_rowsum_acc_f32_0);
+            HVX_Vector v_l_curr1 = HVX_OP_ADD_F32(HVX_OP_MUL_F32(l_prev_v1, exp_m_diff1), v_rowsum_acc_f32_1);
+            factx->vtcm_l_vec[r_vec_idx * 2 + 0] = v_l_curr0;
+            factx->vtcm_l_vec[r_vec_idx * 2 + 1] = v_l_curr1;
+        }
+
+        // Build diagonal tile D = diag(exp(m_diff))
+        const HVX_Vector     v_offsets = *(const HVX_Vector *) d_tile_scatter_offsets;
+        const HVX_VectorPred q_32_mask = Q6_Q_vsetq_R(32 * sizeof(__fp16));
+        HVX_Vector           v_exp_m_diff = exp_m_diff_f16;
+
+        __fp16 * const d_tiles_out = factx->vtcm_d_tiles[args->buf_idx];
+
+        size_t t0 = r_vec_idx * 2;
+        if (t0 < args->n_row_tiles) {
+            const HVX_Vector v_content = v_exp_m_diff;
+            __fp16 *         out_base  = d_tiles_out + t0 * HMX_FP16_TILE_N_ELMS;
+            Q6_vscatter_QRMVhV(q_32_mask, (size_t) out_base, HMX_FP16_TILE_SIZE - 1, v_offsets, v_content);
+        }
+
+        size_t t1 = r_vec_idx * 2 + 1;
+        if (t1 < args->n_row_tiles) {
+            const HVX_Vector v_content = Q6_V_vror_VR(v_exp_m_diff, 64);
+            __fp16 *         out_base  = d_tiles_out + t1 * HMX_FP16_TILE_N_ELMS;
+            Q6_vscatter_QRMVhV(q_32_mask, (size_t) out_base, HMX_FP16_TILE_SIZE - 1, v_offsets, v_content);
+        }
+    }
+    htp_trace_event_stop(tr, HTP_TRACE_EVT_HVX_FA_SFM, (uint16_t) (args->q_start * G + vec_start * 64));
+}
+
+#define FA_IL_THREAD(name, has_mask, is_g1, hmx_l, opt)                    \
+    static void name(unsigned int n, unsigned int i, void * data) {      \
+        fa_softmax_il_impl(n, i, data, has_mask, is_g1, hmx_l, opt);     \
+    }
+FA_IL_THREAD(fa_softmax_il_l0_o0_nomask, false, false, false, 0)
+FA_IL_THREAD(fa_softmax_il_l0_o0_mask_g1, true, true, false, 0)
+FA_IL_THREAD(fa_softmax_il_l0_o0_mask_gn, true, false, false, 0)
+FA_IL_THREAD(fa_softmax_il_l0_o6_nomask, false, false, false, 6)
+FA_IL_THREAD(fa_softmax_il_l0_o6_mask_g1, true, true, false, 6)
+FA_IL_THREAD(fa_softmax_il_l0_o6_mask_gn, true, false, false, 6)
+FA_IL_THREAD(fa_softmax_il_l0_o7_nomask, false, false, false, 7)
+FA_IL_THREAD(fa_softmax_il_l0_o7_mask_g1, true, true, false, 7)
+FA_IL_THREAD(fa_softmax_il_l0_o7_mask_gn, true, false, false, 7)
+FA_IL_THREAD(fa_softmax_il_l0_o14_nomask, false, false, false, 14)
+FA_IL_THREAD(fa_softmax_il_l0_o14_mask_g1, true, true, false, 14)
+FA_IL_THREAD(fa_softmax_il_l0_o14_mask_gn, true, false, false, 14)
+FA_IL_THREAD(fa_softmax_il_l1_o0_nomask, false, false, true, 0)
+FA_IL_THREAD(fa_softmax_il_l1_o0_mask_g1, true, true, true, 0)
+FA_IL_THREAD(fa_softmax_il_l1_o0_mask_gn, true, false, true, 0)
+FA_IL_THREAD(fa_softmax_il_l1_o6_nomask, false, false, true, 6)
+FA_IL_THREAD(fa_softmax_il_l1_o6_mask_g1, true, true, true, 6)
+FA_IL_THREAD(fa_softmax_il_l1_o6_mask_gn, true, false, true, 6)
+FA_IL_THREAD(fa_softmax_il_l1_o7_nomask, false, false, true, 7)
+FA_IL_THREAD(fa_softmax_il_l1_o7_mask_g1, true, true, true, 7)
+FA_IL_THREAD(fa_softmax_il_l1_o7_mask_gn, true, false, true, 7)
+FA_IL_THREAD(fa_softmax_il_l1_o14_nomask, false, false, true, 14)
+FA_IL_THREAD(fa_softmax_il_l1_o14_mask_g1, true, true, true, 14)
+FA_IL_THREAD(fa_softmax_il_l1_o14_mask_gn, true, false, true, 14)
+#undef FA_IL_THREAD
+// IL softmax variants: FA_IL_OPT_* combinations 0 (F10), 6, 7 (default), 14; [hmx_l * 4 + fa_il_opt_idx(opt)][nomask, mask_g1, mask_gn]
+static const worker_callback_t fa_softmax_il_fns[8][3] = {
+    { fa_softmax_il_l0_o0_nomask, fa_softmax_il_l0_o0_mask_g1, fa_softmax_il_l0_o0_mask_gn },
+    { fa_softmax_il_l0_o6_nomask, fa_softmax_il_l0_o6_mask_g1, fa_softmax_il_l0_o6_mask_gn },
+    { fa_softmax_il_l0_o7_nomask, fa_softmax_il_l0_o7_mask_g1, fa_softmax_il_l0_o7_mask_gn },
+    { fa_softmax_il_l0_o14_nomask, fa_softmax_il_l0_o14_mask_g1, fa_softmax_il_l0_o14_mask_gn },
+    { fa_softmax_il_l1_o0_nomask, fa_softmax_il_l1_o0_mask_g1, fa_softmax_il_l1_o0_mask_gn },
+    { fa_softmax_il_l1_o6_nomask, fa_softmax_il_l1_o6_mask_g1, fa_softmax_il_l1_o6_mask_gn },
+    { fa_softmax_il_l1_o7_nomask, fa_softmax_il_l1_o7_mask_g1, fa_softmax_il_l1_o7_mask_gn },
+    { fa_softmax_il_l1_o14_nomask, fa_softmax_il_l1_o14_mask_g1, fa_softmax_il_l1_o14_mask_gn },
+};
+static inline int fa_il_opt_idx(int opt) {
+    return opt == 6 ? 1 : opt == 7 ? 2 : opt == 14 ? 3 : 0;  // other combinations: the F10 path
