+static void transfer_output_chunk_swiglu_pair_col_chunk(
+    float *restrict dst,
+    const __fp16 *restrict vtcm_src,
+    uint32_t start_row,
+    uint32_t n_rows,
+    uint32_t c_len,
+    uint32_t total_n_cols,
+    uint32_t dst_stride,
+    uint32_t dst_cols
+) {
+    const size_t nt              = hmx_ceil_div(total_n_cols, HTP_MM_HMX_TILE_N_COLS);
+    const size_t tile_row_stride = 2 * nt * HTP_MM_HMX_TILE_N_ELMS;
+    const size_t up_off          = nt * HTP_MM_HMX_TILE_N_ELMS;
+
+    const HVX_Vector one = hvx_vec_splat_f16(1.0);
+    const struct hvx_sigmoid_qf32_consts sc = hvx_sigmoid_qf32_consts_init();
+
+    const size_t limit_c         = hex_smin(c_len, dst_cols);
+    const size_t limit_c_aligned = (limit_c & ~31);
+
+    for (size_t r = 0; r < n_rows; r += 2) {
+        const size_t r_idx0 = start_row + r;
+        const size_t r0 = r_idx0 / HTP_MM_HMX_TILE_N_ROWS;
+        const size_t r1 = (r_idx0 % HTP_MM_HMX_TILE_N_ROWS) / 2;  // index of the row pair within the tile
+        const __fp16 *row_base = vtcm_src + r0 * tile_row_stride;
+        float *out = dst + r * dst_stride;
+        const bool has_r1 = (r + 1 < n_rows);
+
+        #pragma unroll(2)
+        for (size_t c = 0; c < limit_c_aligned; c += HTP_MM_HMX_TILE_N_COLS) {
+            const __fp16 * tg = row_base + (c / HTP_MM_HMX_TILE_N_COLS) * HTP_MM_HMX_TILE_N_ELMS;
+            const HVX_VectorPair g = Q6_Wqf32_vmpy_VhfVhf(((const HVX_Vector *) tg)[r1], one);
+            const HVX_VectorPair u = Q6_Wqf32_vmpy_VhfVhf(((const HVX_Vector *) (tg + up_off))[r1], one);
+
+            hvx_vmemu(out + c) = hmx_epi_swiglu(Q6_Vsf_equals_Vqf32(Q6_V_lo_W(u)), Q6_Vsf_equals_Vqf32(Q6_V_lo_W(g)), false, &sc);
+            if (has_r1) {
+                hvx_vmemu(out + c + dst_stride) = hmx_epi_swiglu(Q6_Vsf_equals_Vqf32(Q6_V_hi_W(u)), Q6_Vsf_equals_Vqf32(Q6_V_hi_W(g)), false, &sc);
+            }
+        }
+
+        if (limit_c_aligned < limit_c) {
+            const size_t c = limit_c_aligned;
+            const __fp16 * tg = row_base + (c / HTP_MM_HMX_TILE_N_COLS) * HTP_MM_HMX_TILE_N_ELMS;
+            const HVX_VectorPair g = Q6_Wqf32_vmpy_VhfVhf(((const HVX_Vector *) tg)[r1], one);
+            const HVX_VectorPair u = Q6_Wqf32_vmpy_VhfVhf(((const HVX_Vector *) (tg + up_off))[r1], one);
+
+            hvx_vec_store_u(out + c, (limit_c - c) * sizeof(float),
+                            hmx_epi_swiglu(Q6_Vsf_equals_Vqf32(Q6_V_lo_W(u)), Q6_Vsf_equals_Vqf32(Q6_V_lo_W(g)), false, &sc));
+            if (has_r1) {
+                hvx_vec_store_u(out + c + dst_stride, (limit_c - c) * sizeof(float),
+                                hmx_epi_swiglu(Q6_Vsf_equals_Vqf32(Q6_V_hi_W(u)), Q6_Vsf_equals_Vqf32(Q6_V_hi_W(g)), false, &sc));
+            }
+        }
+    }
