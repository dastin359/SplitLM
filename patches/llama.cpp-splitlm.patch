+        o[2 * j + 1] = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vadd_Vqf32Vsf(Q6_V_hi_W(pq), Q6_Vsf_vmax_VsfVsf(x[2 * j + 1], cs->zero)));
