+// Modes 4 / 5 of transfer_output_chunk_scattered_swiglu_pair for the expert-sorted tiled layout
+// (HTP_MMID_STREAM_ACT_TILED): the products stay in HMX tile order (row pairs interleaved), so every output vector
+// is one aligned store into the activation tile of the consumer. dst_seg = tile row 0 of this M-chunk (k_tiles
+// tiles per tile row), the chunk covers tile columns [col_tile0, col_tile0 + n_cols / 32). Rows [vtcm_start_row,
+// vtcm_start_row + n_rows) of the chunk, whole row pairs (an odd last row's partner is padding, never read back
+// for a stored output).
+static void transfer_output_chunk_tiled_swiglu_pair(
+            __fp16 *restrict dst_seg,
+            const __fp16 *restrict vtcm_src,
+            uint32_t vtcm_start_row,
+            uint32_t n_rows,
+            uint32_t n_cols,
+            uint32_t col_tile0,
+            uint32_t k_tiles,
+            uint32_t mode) {
+    assert(n_cols % HTP_MM_HMX_TILE_N_COLS == 0);
+    const size_t nt              = n_cols / HTP_MM_HMX_TILE_N_COLS;
+    const size_t tile_row_stride = 2 * nt * HTP_MM_HMX_TILE_N_ELMS;
+    const size_t tstep           = HTP_MM_HMX_TILE_N_ELMS * sizeof(__fp16) / VLEN;  // vectors per tile
+    const size_t up_v            = nt * tstep;                                      // gate -> up, in vectors
+
+    const HVX_Vector one = hvx_vec_splat_f16(1.0);
+    const struct hvx_silu_hf_consts hc = hvx_silu_hf_consts_init();
+
+    for (size_t r = 0; r < n_rows; r += 2) {
+        const uint32_t lr = vtcm_start_row + r;
+        const size_t   r0 = lr / HTP_MM_HMX_TILE_N_ROWS;
+        const size_t   r1 = (lr % HTP_MM_HMX_TILE_N_ROWS) / 2;
+        const HVX_Vector * tsrc = (const HVX_Vector *) (vtcm_src + r0 * tile_row_stride) + r1;
+        HVX_Vector *       out  = (HVX_Vector *) (dst_seg + (r0 * k_tiles + col_tile0) * HTP_MM_HMX_TILE_N_ELMS) + r1;
+        if (mode == 4) {
+            #pragma unroll(2)
+            for (size_t c0 = 0; c0 < nt; ++c0) {
+                out[c0 * tstep] = Q6_Vhf_equals_Wqf32(hvx_vec_swiglu_hf_qf32(tsrc[c0 * tstep], tsrc[c0 * tstep + up_v], one, &hc));
+            }
+        } else {
+            #pragma unroll(2)
+            for (size_t c0 = 0; c0 < nt; ++c0) {
+                out[c0 * tstep] = hvx_vec_swiglu_hf_h16(tsrc[c0 * tstep], tsrc[c0 * tstep + up_v], &hc);
+            }
+        }
+    }
+}
