+// One past the last KV block that has a mask value > -16 in rows [q_start, q_start + n_rows_q) of the
+// (head-broadcast) mask. Never below 1: block 0 always runs.
+// *last_rows: the KV rows of that last block that must be processed. Trailing 64-column chunks of the block
+// that are fully masked in every row are dropped (their P is exactly 0, see the note above), so under a causal
+// mask the diagonal block stops at the last query row's position instead of running the full Bc columns.
+static __attribute__((noinline)) uint32_t fa_mask_kv_blk_end(const struct htp_tensor * mask,
+                                                             uint32_t                  q_start,
+                                                             uint32_t                  n_rows_q,
+                                                             uint32_t                  im3,
+                                                             uint32_t                  Bc,
+                                                             uint32_t                  nek1,
+                                                             uint32_t                  n_kv_blocks,
+                                                             bool                      trim_last,
+                                                             uint32_t *                last_rows) {
+    const size_t     row_stride = mask->nb[1];
+    const uint8_t *  rows       = (const uint8_t *) mask->data + (size_t) q_start * row_stride + (size_t) im3 * mask->nb[3];
+
+    uint32_t b = n_kv_blocks;
+    for (; b > 1; --b) {
+        const uint32_t  kv_start  = (b - 1) * Bc;
+        const uint32_t  row_bytes = hex_smin(Bc, nek1 - kv_start) * sizeof(__fp16);
+        if (fa_mask_range_any_unmasked(rows + (size_t) kv_start * sizeof(__fp16), row_stride, n_rows_q, row_bytes)) {
+            break;
+        }
+    }
+    if (b == 0) {
+        *last_rows = 0;
+        return 0;
+    }
+
+    const uint32_t kv_start = (b - 1) * Bc;
+    const uint32_t blk_rows = hex_smin(Bc, nek1 - kv_start);
+    uint32_t       n_rows   = blk_rows;
