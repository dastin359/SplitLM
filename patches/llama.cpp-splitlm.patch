+// down at node i: returns the index of the last ADD (> i) or -1; *weights_out = router weights [1, n_ids, 1]
+static int cpu_moe_down_match(const struct ggml_cgraph * cgraph, int i, const struct ggml_tensor ** weights_out) {
+    struct ggml_tensor * d = cgraph->nodes[i];
+    if (!cpu_moe_mmid_ok(cgraph, d, 1)) {
+        return -1;
+    }
+    const int n_ids = (int) d->src[2]->ne[0];
+    if (n_ids < 2) {
+        return -1;
+    }
+    const int im = cpu_next_node(cgraph, i);
+    if (im >= cgraph->n_nodes) {
+        return -1;
+    }
+    struct ggml_tensor * m = cgraph->nodes[im];
+    if (m->op != GGML_OP_MUL || m->src[0] != d || m->type != GGML_TYPE_F32 || !ggml_are_same_shape(m, d) || !ggml_is_contiguous(m) ||
+        (m->flags & GGML_TENSOR_FLAG_OUTPUT) || cpu_tensor_use_count(cgraph, m) != n_ids) {
+        return -1;
+    }
+    const struct ggml_tensor * w = m->src[1];
+    if (w->type != GGML_TYPE_F32 || w->ne[0] != 1 || w->ne[1] != n_ids || w->ne[2] != 1 || w->ne[3] != 1) {
+        return -1;
+    }
+    int j = im;
+    struct ggml_tensor * prev = NULL;
+    for (int k = 1; k < n_ids; k++) {
+        j = cpu_next_node(cgraph, j);
+        if (j >= cgraph->n_nodes) {
+            return -1;
+        }
+        struct ggml_tensor * a = cgraph->nodes[j];
+        if (a->op != GGML_OP_ADD || a->type != GGML_TYPE_F32 || !ggml_is_contiguous(a) || a->ne[0] != d->ne[0] || ggml_nrows(a) != 1) {
+            return -1;
+        }
+        const struct ggml_tensor * v1 = a->src[1];
+        if (v1->op != GGML_OP_VIEW || v1->view_src != m || v1->view_offs != (size_t) k * m->nb[1] || v1->ne[0] != d->ne[0] ||
+            ggml_nrows(v1) != 1 || cpu_tensor_use_count(cgraph, v1) != 1) {
+            return -1;
+        }
+        if (k == 1) {
+            const struct ggml_tensor * v0 = a->src[0];
+            if (v0->op != GGML_OP_VIEW || v0->view_src != m || v0->view_offs != 0 || v0->ne[0] != d->ne[0] || ggml_nrows(v0) != 1 ||
+                cpu_tensor_use_count(cgraph, v0) != 1) {
+                return -1;
+            }
+        } else if (a->src[0] != prev || cpu_tensor_use_count(cgraph, prev) != 1 || (prev->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+            return -1;
+        }
+        prev = a;
+    }
+    if (cpu_ranges_overlap(prev, w) || cpu_ranges_overlap(prev, d->src[2])) {
+        return -1;
+    }
+    *weights_out = w;
+    return j;
+}
+
+// the down at node i is fused only when the gate_up producing its input is fused (it reads gate_up's Q8_0 rows)
+static int cpu_moe_down_fusable(const struct ggml_cgraph * cgraph, int i, const struct ggml_tensor ** weights_out) {
+    const int last = cpu_moe_down_match(cgraph, i, weights_out);
+    if (last < 0) {
+        return -1;
+    }
+    const struct ggml_tensor * d = cgraph->nodes[i];
+    const int ig = cpu_prev_node(cgraph, i);
+    if (ig < 0 || cgraph->nodes[ig] != d->src[1]) {
+        return -1;
+    }
+    const int iy = cpu_prev_node(cgraph, ig);
+    const int ix = iy >= 0 ? cpu_prev_node(cgraph, iy) : -1;
+    struct ggml_tensor * up;
+    struct ggml_tensor * gate;
+    if (ix < 0 || cpu_moe_gate_up_match(cgraph, ix, &up, &gate) != ig || up->src[2] != d->src[2] ||
+        d->src[0]->ne[0] != up->src[0]->ne[1]) {
+        return -1;
+    }
+    // producer and consumer must use the same layout of the Q8_0 rows in wdata: the CPU_HTPTILE gate_up writes block
+    // sums the CPU_HTPTILE down reads, the repacked gate_up does not, so a mixed repack/CPU_HTPTILE pair stays unfused
+    if (ggml_cpu_htptile_moe_supported(d) != ggml_cpu_htptile_moe_supported(up)) {
+        return -1;
+    }
+    return last;
+}
+
+static int ggml_cpu_try_fuse_moe(const struct ggml_cgraph * cgraph, int node_n, const struct ggml_compute_params * params) {
+    struct ggml_tensor * up;
+    struct ggml_tensor * gate;
+    const int ig = cpu_moe_gate_up_match(cgraph, node_n, &up, &gate);
+    if (ig > node_n) {
+        const int id = cpu_next_node(cgraph, ig);
+        const struct ggml_tensor * w;
+        const bool q8 = id < cgraph->n_nodes && cpu_moe_down_fusable(cgraph, id, &w) > id;
+        if (ggml_cpu_htptile_moe_supported(up)) {
+            ggml_cpu_htptile_moe_gate_up(params, up, gate, cgraph->nodes[ig], q8 ? cgraph->nodes[id] : NULL);
+        } else {
+            ggml_cpu_repack_moe_gate_up(params, up, gate, cgraph->nodes[ig], q8 ? cgraph->nodes[id] : NULL);
+        }
+        return ig - node_n;
+    }
+    const struct ggml_tensor * w;
+    const int last = cpu_moe_down_fusable(cgraph, node_n, &w);
+    if (last > node_n) {
+        if (ggml_cpu_htptile_moe_supported(cgraph->nodes[node_n])) {
+            ggml_cpu_htptile_moe_down(params, cgraph->nodes[node_n], w, cgraph->nodes[last]);
+        } else {
+            ggml_cpu_repack_moe_down(params, cgraph->nodes[node_n], w, cgraph->nodes[last]);
+        }
+        return last - node_n;
+    }
+    return 0;
+}
 
