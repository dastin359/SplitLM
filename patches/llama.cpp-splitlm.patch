+    for (; ir + 8 <= num_rows; ir += 32) {
+        const uint32_t nr = MIN(32, num_rows - ir);
+        float scv[32] __attribute__((aligned(128)));
+        *(HVX_Vector *) scv = hvx_rms_norm_rows32_scales(src + ir * RB, RB, 4, nr, inv_n_v, epsilon_v, one_v);
+        for (uint32_t r = 0; r < nr; r += 2) {
+            const uint32_t nrr = MIN(2, nr - r);
+            const HVX_Vector * x = (const HVX_Vector *) (src + (ir + r) * RB);
+            const HVX_Vector * restrict g = (const HVX_Vector *) (z + (ir + r) * RB);
+            HVX_Vector * o = (HVX_Vector *) (dst + (ir + r) * RB);
+            const HVX_Vector k0 = hvx_vec_splat_f32(scv[r]);
+            const HVX_Vector k1 = hvx_vec_splat_f32(scv[nrr > 1 ? r + 1 : r]);
+            HVX_Vector gg[8], yy[8], s[8];
+            const uint32_t nv = nrr * 4;
+            #pragma unroll
+            for (int j = 0; j < 8; j++) {
+                gg[j] = j < (int) nv ? g[j] : c.zero;
+            }
+            #pragma unroll
+            for (int j = 0; j < 8; j++) {
+                const HVX_Vector xj = j < (int) nv ? x[j] : c.zero;
+                const HVX_Vector wj = (j & 3) == 0 ? w0 : (j & 3) == 1 ? w1 : (j & 3) == 2 ? w2 : w3;
+                const HVX_Vector t  = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(xj, j < 4 ? k0 : k1));
+                yy[j] = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(t, wj));
+            }
+            #pragma unroll
+            for (int j = 0; j < 4; j++) {
+                hvx_vec_silu2_f32_hf(gg[2 * j], gg[2 * j + 1], &s[2 * j], &s[2 * j + 1], &c);
+            }
+            #pragma unroll
+            for (int j = 0; j < 8; j++) {
+                if (j < (int) nv) {
+                    o[j] = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_VsfVsf(s[j], yy[j]));
+                }
+            }
+        }
+    }
+    // tail rows (< 8): the per-row norm of rms_norm_mul_f32, then the gate
+    for (; ir < num_rows; ir++) {
+        hvx_fast_rms_norm_mul_f32(src + ir * RB, w, dst + ir * RB, 128, inv_n_v, epsilon_v);
+        hvx_swiglu_f32_hf_inplace(dst + ir * RB, z + ir * RB, 128);
+    }
+}
