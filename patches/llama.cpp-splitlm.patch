+        mask->nb[1], n_rows_q, nek1 / 64, zc,
+    };
+    const uint32_t n = (factx->n_threads > 1 && n_rows_q >= 2 * factx->n_threads) ? factx->n_threads : 1;
+    if (n > 1) {
+        work_queue_run(factx->octx->ctx->work_queue, fa_zscan_thread, &args, n);
+    } else {
+        fa_zscan_thread(1, 0, &args);
+    }
