+static inline void transpose_nibbles_to_tile_tl(uint8_t * tile_dst, const uint8_t tile_quants[32][32]) {
+    for (int cp = 0; cp < 16; cp++) {
+        for (int row = 0; row < 32; row++) {
+            tile_dst[(cp / 4) * 128 + row * 4 + (cp % 4)] = (tile_quants[row][2 * cp + 1] << 4) | tile_quants[row][2 * cp];
+        }
+    }
