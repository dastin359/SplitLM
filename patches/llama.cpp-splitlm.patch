+// exp2 of the HMX softmax P values: hvx_vec_exp2_f16 with a degree-4 polynomial for 2^f instead of the
+// degree-6 Taylor one (8 instead of 12 qf16 ops per vector). Coefficients are a relative-error minimax fit
+// over f in [-0.5, 1] (covers the range reduction below for either rounding of the hf->h conversion),
+// quantized to fp16 one at a time: max relative error 5.4e-5 vs 1.5e-4 for the fp16 Taylor coefficients.
+static inline __attribute__((always_inline)) HVX_Vector fa_exp2_f16(HVX_Vector x_v) {
+    const HVX_Vector zero_v    = Q6_V_vzero();
+    const HVX_Vector half_hf_v = Q6_Vh_vsplat_R(0x3800);  // fp16 0.5
+
+    x_v = Q6_Vhf_vmax_VhfVhf(hvx_vec_splat_f16(-24.0f), x_v);
+
+    HVX_Vector x_minus_half = Q6_Vhf_equals_Vqf16(Q6_Vqf16_vsub_VhfVhf(x_v, half_hf_v));
+    HVX_Vector k_v          = Q6_Vh_equals_Vhf(x_minus_half);
+    HVX_Vector f_v          = Q6_Vhf_equals_Vh(k_v);
+    HVX_Vector x_qf16       = Q6_Vqf16_vsub_VhfVhf(x_v, f_v);
+
+    HVX_Vector y = Q6_Vqf16_vmpy_Vqf16Vhf(x_qf16, Q6_Vh_vsplat_R(0x212a));  // c4 * x
+    y            = Q6_Vqf16_vadd_Vqf16Vhf(y, Q6_Vh_vsplat_R(0x2b46));        // + c3
+    y            = Q6_Vqf16_vmpy_Vqf16Vqf16(y, x_qf16);
+    y            = Q6_Vqf16_vadd_Vqf16Vhf(y, Q6_Vh_vsplat_R(0x33af));        // + c2
+    y            = Q6_Vqf16_vmpy_Vqf16Vqf16(y, x_qf16);
+    y            = Q6_Vqf16_vadd_Vqf16Vhf(y, Q6_Vh_vsplat_R(0x398b));        // + c1
+    y            = Q6_Vqf16_vmpy_Vqf16Vqf16(y, x_qf16);
+    y            = Q6_Vqf16_vadd_Vqf16Vhf(y, Q6_Vh_vsplat_R(0x3c00));        // + 1.0
+
+    y                          = Q6_Vhf_equals_Vqf16(y);
+    HVX_Vector y_exp           = Q6_Vuh_vlsr_VuhR(Q6_Vh_vasl_VhR(y, 1), 11);
+    y_exp                      = Q6_Vh_vadd_VhVh(k_v, y_exp);
+    HVX_VectorPred q_underflow = Q6_Q_vcmp_gt_VhVh(zero_v, y_exp);
+    y                          = Q6_Vh_vaslacc_VhVhR(y, k_v, 10);
+    return Q6_V_vmux_QVV(q_underflow, zero_v, y);
+}
+
+// exp2(S - m) for an integer row reference m (F10). k_S = round(S) and f = S - k_S come straight from the S
+// values (exact: S is fp16 and k_S is an integer), so the S - m subtraction, its qf16 -> hf conversion and the
+// -0.5 shift of fa_exp2_f16 disappear; the integer part k = k_S - m is applied to the exponent bits. Because
+// m >= max(S) and round(S) <= ceil(S) <= m, k <= 0 and f is in [-0.5, 0.5] (hf -> h rounds to nearest).
+// Range: S is clamped to <= 16384 and m to [-32768, 16384] (fa_ceil_int_ref), so scores above 16384 (logits above
+// ~11356) saturate instead of overflowing the exponent, and k is a saturating int16 subtraction, so it cannot wrap.
+// Masked scores are written as -32768 (exact in fp16 and int16): a fully masked row (S = m = -32768) gives
+// k = f = 0, i.e. P = 1 as in fa_exp2_f16; any other masked entry has k <= -13 unless the row max is below
+// -32755. Unmasked scores below -32768 only matter in a row whose max is below that too. Results with
+// k < -13 are flushed to 0; since m can be up to 1 above the true row max, that is about 2^-12.5 .. 2^-13.5
+// relative to it (fa_exp2_f16 flushed below ~2^-15).
+// k = -14 would need fp16 subnormal results for f < 0. Not bit-identical to fa_exp2_f16: greedy outputs can
+// differ at rounding level (e.g. Qwen3.5-2B at ub 512), perplexity does not move.
+// 2^f: degree-3 relative minimax fit over [-0.5, 0.5] with fp16 coefficients (best fp16 neighbours of the real
+// fit; max relative error 1.3e-4, below half an fp16 ulp). f is exact here, so unlike F9g no extrapolation can
+// occur; the softmax is bound by the qf16 arithmetic, so each dropped multiply-add pair is ~9% of its time.
+static inline __attribute__((always_inline)) HVX_Vector fa_exp2_int_f16(HVX_Vector s_v, HVX_Vector m_h) {
+    s_v                  = Q6_Vhf_vmin_VhfVhf(s_v, Q6_Vh_vsplat_R(0x7400));  // fp16 16384
+    const HVX_Vector k_s = Q6_Vh_equals_Vhf(s_v);
+    const HVX_Vector f_v = Q6_Vqf16_vsub_VhfVhf(s_v, Q6_Vhf_equals_Vh(k_s));
+    const HVX_Vector k_v = Q6_Vh_vsub_VhVh_sat(k_s, m_h);
+
+    HVX_Vector y = Q6_Vqf16_vmpy_Vqf16Vhf(f_v, Q6_Vh_vsplat_R(0x2b08));  // c3 * f
+    y            = Q6_Vqf16_vadd_Vqf16Vhf(y, Q6_Vh_vsplat_R(0x33c1));     // + c2
+    y            = Q6_Vqf16_vmpy_Vqf16Vqf16(y, f_v);
+    y            = Q6_Vqf16_vadd_Vqf16Vhf(y, Q6_Vh_vsplat_R(0x398c));     // + c1
+    y            = Q6_Vqf16_vmpy_Vqf16Vqf16(y, f_v);
+    y            = Q6_Vqf16_vadd_Vqf16Vhf(y, Q6_Vh_vsplat_R(0x3c00));     // + 1.0
+    y            = Q6_Vhf_equals_Vqf16(y);
+
+    const HVX_VectorPred q_under = Q6_Q_vcmp_gt_VhVh(Q6_Vh_vsplat_R(-13), k_v);
+    y = Q6_Vh_vaslacc_VhVhR(y, k_v, 10);
+    return Q6_V_vmux_QVV(q_under, Q6_V_vzero(), y);
+}
+
+// Integer row reference for fa_exp2_int_f16: m_int = ceil(clamp(m, -32768, 16384)) as int16 lanes (*m_h) and as
+// fp16 (return value, used as the row max m for the online-softmax recurrence; any m >= max(S) is valid there).
+// The upper clamp matches the S clamp of fa_exp2_int_f16, so k <= 0 also for rows whose max is above 16384.
+static inline __attribute__((always_inline)) HVX_Vector fa_ceil_int_ref(HVX_Vector m_hf, HVX_Vector * m_h) {
+    m_hf               = Q6_Vhf_vmax_VhfVhf(m_hf, Q6_Vh_vsplat_R(0xf800));  // fp16 -32768
+    m_hf               = Q6_Vhf_vmin_VhfVhf(m_hf, Q6_Vh_vsplat_R(0x7400));  // fp16 16384
+    HVX_Vector     k   = Q6_Vh_equals_Vhf(m_hf);
+    HVX_VectorPred q_lt = Q6_Q_vcmp_gt_VhfVhf(m_hf, Q6_Vhf_equals_Vh(k));
+    k                  = Q6_V_vmux_QVV(q_lt, Q6_Vh_vadd_VhVh(k, Q6_Vh_vsplat_R(1)), k);
+    *m_h               = k;
+    return Q6_Vhf_equals_Vh(k);
+}
