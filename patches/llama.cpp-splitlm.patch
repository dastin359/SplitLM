+// returns the offset (from node_n) of the state CPY that can be fused into the GATED_DELTA_NET at node_n, or 0
+static int ggml_cpu_gdn_cpy_fusable(const struct ggml_cgraph * cgraph, int node_n) {
+    const struct ggml_tensor * gdn = cgraph->nodes[node_n];
+    if (gdn->type != GGML_TYPE_F32 || ggml_get_op_params_i32(gdn, 0) != 1 || !ggml_is_contiguous(gdn) ||
+        (gdn->flags & GGML_TENSOR_FLAG_OUTPUT) || gdn->view_src != NULL) {
+        return 0;
+    }
+    // uses of the GDN result: the attention-output view and the new-state view, nothing else
+    if (cpu_tensor_use_count(cgraph, gdn) != 2) {
+        return 0;
+    }
+    const struct ggml_tensor * v = gdn->src[2];
+    const struct ggml_tensor * st = gdn->src[5];
+    const size_t attn_bytes  = (size_t) v->ne[0] * v->ne[1] * v->ne[2] * v->ne[3] * sizeof(float);
+    const size_t state_bytes = (size_t) v->ne[0] * v->ne[0] * v->ne[1] * v->ne[3] * sizeof(float);
+    if (ggml_nbytes(gdn) != attn_bytes + state_bytes) {
+        return 0;
+    }
+
+    int nx = node_n + 1;
+    while (nx < cgraph->n_nodes && (ggml_op_is_empty(cgraph->nodes[nx]->op) || (cgraph->nodes[nx]->flags & GGML_TENSOR_FLAG_COMPUTE) == 0)) {
+        nx++;
+    }
+    if (nx >= cgraph->n_nodes) {
+        return 0;
+    }
+    const struct ggml_tensor * cpy = cgraph->nodes[nx];
+    const struct ggml_tensor * sv  = cpy->src[0];
+    if (cpy->op != GGML_OP_CPY || sv == NULL || sv->view_src != gdn || sv->view_offs != attn_bytes ||
+        sv->type != GGML_TYPE_F32 || cpy->type != GGML_TYPE_F32 || !ggml_is_contiguous(sv) || !ggml_is_contiguous(cpy) ||
+        ggml_nbytes(sv) != state_bytes || ggml_nbytes(cpy) != state_bytes || cpu_tensor_use_count(cgraph, sv) != 1 ||
+        (sv->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return 0;
+    }
+    // the other use must be a view inside the attention part (found near the GDN, before its consumer)
+    int n_other = 0;
+    for (int j = node_n + 1; j < cgraph->n_nodes && j <= nx + 16; j++) {
+        const struct ggml_tensor * t = cgraph->nodes[j];
+        if (j == nx || t == sv) {
+            continue;
+        }
+        for (int s = 0; s < GGML_MAX_SRC; s++) {
+            if (t->src[s] == gdn) {
+                if (t->op != GGML_OP_VIEW || t->view_src != gdn || t->view_offs + ggml_nbytes(t) > attn_bytes ||
+                    (t->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+                    return 0;
+                }
+                n_other++;
+            }
+        }
+    }
+    if (n_other != 1) {
+        return 0;
+    }
+    // the state may be updated in place (CPY destination == input state) or go to a disjoint buffer
+    const bool alias = cpy->data == st->data && ggml_is_contiguous(st) && ggml_nbytes(st) == state_bytes;
+    if (!alias) {
+        for (int s = 0; s < GGML_MAX_SRC; s++) {
+            if (gdn->src[s] && cpu_ranges_overlap(cpy, gdn->src[s])) {
+                return 0;
+            }
+        }
+    }
+    if (cpu_ranges_overlap(cpy, gdn)) {
+        return 0;
+    }
+    return nx - node_n;
+}
 
