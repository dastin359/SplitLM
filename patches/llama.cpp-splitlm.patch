+// Rows of 1, 2 or 4 whole vectors packed back to back (row stride = row bytes): one pass over the block with the
+// broadcast row held in registers instead of a call per row (GGML_HEXAGON_BIN_FLAT; the same vector op per element)
+#define DEFINE_COMPUTE_ROW_BCAST_FAST(NAME, HVX_FN, VOP, ES)                                                \
+static void compute_row_bcast_##NAME(                                                                       \
+    uint8_t * dst, const uint8_t * src0, const uint8_t * src1,                                              \
+    uint32_t n_rows, size_t dst_stride, size_t src0_stride, uint32_t ne00) {                                \
+    const uint32_t rb = ne00 * (ES);                                                                        \
+    if (g_bin_rb_fast && (rb == 128 || rb == 256 || rb == 512) && dst_stride == rb && src0_stride == rb) {  \
+        const HVX_Vector * restrict vs = (const HVX_Vector *) src0;                                         \
+        HVX_Vector * restrict       vd = (HVX_Vector *) dst;                                                \
+        const HVX_Vector *          vb = (const HVX_Vector *) src1;                                         \
+        if (rb == 128) {                                                                                    \
+            const HVX_Vector b0 = vb[0];                                                                    \
+            _Pragma("unroll(4)")                                                                            \
+            for (uint32_t r = 0; r < n_rows; r++) vd[r] = VOP(vs[r], b0);                                   \
+        } else if (rb == 256) {                                                                             \
+            const HVX_Vector b0 = vb[0], b1 = vb[1];                                                        \
+            _Pragma("unroll(2)")                                                                            \
+            for (uint32_t r = 0; r < n_rows; r++) {                                                         \
+                vd[2 * r]     = VOP(vs[2 * r], b0);                                                         \
+                vd[2 * r + 1] = VOP(vs[2 * r + 1], b1);                                                     \
+            }                                                                                               \
+        } else {                                                                                            \
+            const HVX_Vector b0 = vb[0], b1 = vb[1], b2 = vb[2], b3 = vb[3];                                \
+            for (uint32_t r = 0; r < n_rows; r++) {                                                         \
+                vd[4 * r]     = VOP(vs[4 * r], b0);                                                         \
+                vd[4 * r + 1] = VOP(vs[4 * r + 1], b1);                                                     \
+                vd[4 * r + 2] = VOP(vs[4 * r + 2], b2);                                                     \
+                vd[4 * r + 3] = VOP(vs[4 * r + 3], b3);                                                     \
+            }                                                                                               \
+        }                                                                                                   \
+        return;                                                                                             \
+    }                                                                                                       \
+    for (uint32_t r = 0; r < n_rows; r++) {                                                                 \
+        HVX_FN(dst + r * dst_stride, src0 + r * src0_stride, src1, ne00);                                   \
+    }                                                                                                       \
+}
+
+DEFINE_COMPUTE_ROW_BCAST_FAST(add_f32, hvx_add_f32_aaa, BIN_VOP_ADD_F32, 4)
+DEFINE_COMPUTE_ROW_BCAST_FAST(add_f16, hvx_add_f16_aaa, BIN_VOP_ADD_F16, 2)
