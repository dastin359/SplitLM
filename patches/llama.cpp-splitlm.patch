+static inline void hmx_mmid_pos_advance(struct hmx_mmid_pos * p, int n_w, int n_chunk_cnt, int m_chunk) {
+    if (++p->i < n_chunk_cnt) return;
+    p->i = 0;
+    if (++p->w < n_w) return;
+    p->w = 0;
+    p->mr += m_chunk;
+    if (p->mr < p->m_end) return;
