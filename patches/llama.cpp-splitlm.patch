+        ggml_tensor * c = ggml_view_2d(ctx, bcx, d_inner, n_t, bcx->nb[1], 1 * d_inner * es);
+        ggml_tensor * x = ggml_view_2d(ctx, bcx, d_inner, n_t, bcx->nb[1], 2 * d_inner * es);
+
+        ggml_tensor * bx      = ggml_transpose(ctx, ggml_mul(ctx, b, x));
+        ggml_tensor * conv_in = ggml_concat(ctx, state, bx, 0);
+
+        ggml_tensor * last = ggml_view_2d(ctx, conv_in, d_conv - 1, d_inner, conv_in->nb[1], n_t * ggml_element_size(conv_in));
+        ggml_tensor * upd  = ggml_reshape_1d(ctx, ggml_cpy(ctx, last, st), (d_conv - 1) * d_inner);
+
+        ggml_tensor * y = ggml_mul(ctx, c, ggml_ssm_conv(ctx, conv_in, w));
+        y = ggml_reshape_1d(ctx, y, d_inner * n_t);
+
+        ggml_tensor * out = ggml_concat(ctx, upd, y, 0);
+        ggml_set_name(out, "out");
+        return out;
+    }
+};
