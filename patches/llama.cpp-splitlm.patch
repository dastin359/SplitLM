+                // stage 2 (-8): blocks of 4
+                const HVX_VectorPair b0 = Q6_W_vshuff_VVR(Q6_V_lo_W(a23), Q6_V_lo_W(a01), -8);
+                const HVX_VectorPair b1 = Q6_W_vshuff_VVR(Q6_V_hi_W(a23), Q6_V_hi_W(a01), -8);
+                const HVX_VectorPair b2 = Q6_W_vshuff_VVR(Q6_V_lo_W(a67), Q6_V_lo_W(a45), -8);
+                const HVX_VectorPair b3 = Q6_W_vshuff_VVR(Q6_V_hi_W(a67), Q6_V_hi_W(a45), -8);
