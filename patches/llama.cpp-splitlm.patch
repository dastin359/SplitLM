+// GGML_HEXAGON_I8: 2D tiled quantized weights get a per-output-channel int8 copy appended to their tiled data
+static bool ggml_hexagon_i8_eligible(const struct ggml_tensor * t) {
+    if (opt_i8 <= 0 || !htp_is_tiled_weight_tensor(t) || !ggml_is_quantized(t->type)) return false;
+    if (t->ne[2] != 1 || t->ne[3] != 1 || (t->ne[0] % 32) != 0) return false;
+    if (opt_i8 != 2 && strncmp(t->name, "blk.", 4) != 0) return false;
+    // 1 (default selection): only the weights whose matmuls get faster on the int path (2B trace, wt/r8-i8-progress.md):
+    // FFN gate/up/down and the GDN in_proj pair (attn_qkv + attn_gate); the k = n = 2048 output projections (ssm_out,
+    // attn_output), the attention q/k/v group and the n = 32 ssm_alpha/beta are faster on the fp16 path
+    if (opt_i8 == 1 && !strstr(t->name, ".ffn_") && !strstr(t->name, ".attn_qkv.") && !strstr(t->name, ".attn_gate.")) return false;
+    if (!ggml_get_type_traits(t->type)->to_float) return false;
+    const int64_t ne0 = hex_round_up(t->ne[0], 32), ne1 = hex_round_up(t->ne[1], 32);
+    return htp_tiled_row_size(t->type, ne0) * ne1 >= ggml_nbytes(t);
+}
