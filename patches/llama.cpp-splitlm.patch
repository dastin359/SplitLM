+// --- Streamed expert kernel (single device) ---
+//
+// One flat item stream over the whole op: (expert, M-chunk, weight, N-chunk). Two raw weight buffers, two
+// fp16 weight buffers, two activation buffers and two output buffers, with async HMX:
+//   item j: wait DMA(j) -> pop HMX(j - 2) -> one HVX step [scatter(j - 2) | gather of a new expert / M-chunk |
+//           dequant(j)] -> DMA(j + 2) into the raw buffer just freed -> push HMX(j)
+// HMX always has the previous item queued while HVX runs the step, across expert boundaries.
+// Arithmetic is unchanged: every output tile is still one HMX job over the full k with the same dequant.
+
+// experts with rows, in order
+struct hmx_mmid_pos {
+    const uint32_t * row_counts;
+    uint32_t         n_as;
+    uint32_t         next_a;  // next expert to examine
+    bool             valid;
+    int              a;       // current expert
+    int              cne1;    // its rows
+    int              m_end;   // its rows padded to 32
+    int              mr;      // current M-chunk start
+    int              w;       // current weight
+    int              i;       // current N-chunk
+};
+
+static inline void hmx_mmid_pos_next_expert(struct hmx_mmid_pos * p) {
+    p->valid = false;
+    while (p->next_a < p->n_as) {
+        const uint32_t a = p->next_a++;
+        const uint32_t c = p->row_counts[a];
+        if (c > 0) {
+            p->valid = true;
+            p->a     = (int) a;
+            p->cne1  = (int) c;
+            p->m_end = hex_align_up((int) c, 32);
+            break;
+        }
+    }
+    p->mr = 0;
+    p->w  = 0;
+    p->i  = 0;
+}
+
+static inline void hmx_mmid_pos_init(struct hmx_mmid_pos * p, const uint32_t * row_counts, uint32_t n_as) {
+    p->row_counts = row_counts;
+    p->n_as       = n_as;
+    p->next_a     = 0;
+    hmx_mmid_pos_next_expert(p);
+}
+
+static inline void hmx_mmid_pos_advance(struct hmx_mmid_pos * p, int n_w, int n_chunk_cnt, int m_chunk) {
+    if (++p->i < n_chunk_cnt) return;
+    p->i = 0;
+    if (++p->w < n_w) return;
+    p->w = 0;
+    p->mr += m_chunk;
+    if (p->mr < p->m_end) return;
+    hmx_mmid_pos_next_expert(p);
+}
+
+// next M-chunk (segment) after the one p points at (p at the start of a segment)
+static inline void hmx_mmid_pos_next_seg(struct hmx_mmid_pos * p, int m_chunk) {
+    p->w = 0;
+    p->i = 0;
+    p->mr += m_chunk;
+    if (p->mr < p->m_end) return;
+    hmx_mmid_pos_next_expert(p);
+}
+
+#define HMX_MMID_TILED_MAX_AS 128
+
+// HTP_MMID_STREAM_ACT_TILED layout: first row of every expert (offs[a], a < n_as). Returns false when the layout plus
+// the flag word does not fit into the tensor (bytes) or the op does not qualify; producer and consumer see the same
+// counts, so they always agree.
+static bool hmx_mmid_tiled_layout(const uint32_t * row_counts, uint32_t n_as, uint32_t k, size_t bytes, uint32_t * offs) {
+    if (n_as > HMX_MMID_TILED_MAX_AS || k % 64 != 0 || bytes < HMX_MMID_TILED_FLAG_BYTES) return false;
+    uint64_t rows = 0;
+    for (uint32_t a = 0; a < n_as; ++a) {
+        offs[a] = (uint32_t) rows;
+        rows += (row_counts[a] + 31) & ~31u;
+    }
+    return rows * k * sizeof(__fp16) <= bytes - HMX_MMID_TILED_FLAG_BYTES;
+}
+
+static inline volatile uint32_t * hmx_mmid_tiled_flag(uint64_t data, size_t bytes) {
+    return (volatile uint32_t *) ((uint8_t *) (uintptr_t) data + bytes - HMX_MMID_TILED_FLAG_BYTES);
+}
+
+// The gather threads write whole 32-row tiles from their first row on, so the last ones can write up to 31 rows
+// past the M-chunk. The synchronous kernel lets that spill into its idle output area; here the next buffer is
+// live (the other activation buffer or a pending output), so each activation buffer gets one spare tile row.
+#define HMX_MMID_ACT_SLACK_ROWS 32
+
+static inline size_t hmx_mmid_stream_vtcm_size(size_t mc, size_t nc, size_t w_col_bytes, size_t vec_dot_size, size_t fixed) {
+    return fixed + 2 * hex_align_up(nc * w_col_bytes, HTP_MM_HMX_TILE_SIZE) +
+           2 * hex_align_up(nc * vec_dot_size, HTP_MM_HMX_TILE_SIZE) +
+           2 * hex_align_up((mc + HMX_MMID_ACT_SLACK_ROWS) * vec_dot_size, HTP_MM_HMX_TILE_SIZE) +
+           2 * hex_align_up(mc * nc * sizeof(__fp16), HTP_MM_HMX_TILE_SIZE) + 256;
+}
+
+// (M-chunk, N-chunk) for the whole op. HVX dequant is the bottleneck, so the estimate counts dequant work
+// (repeated for every M-chunk of an expert) plus a fixed cost per item (thread dispatch, HMX job).
+static int hmx_mmid_stream_plan(size_t budget, const uint32_t * row_counts, uint32_t n_as, int n_w, int k, int n,
+                                int nc_step, size_t w_col_bytes, size_t vec_dot_size, size_t fixed,
+                                size_t * mc_out, size_t * nc_out, size_t * used_out) {
+    int max_m = 0;
+    for (uint32_t a = 0; a < n_as; ++a) {
+        max_m = hex_smax(max_m, (int) row_counts[a]);
+    }
+    if (max_m == 0) return -1;
+    max_m = hex_align_up(max_m, 32);
+
+    const uint64_t dq_ps_per_elem = 22;        // ~2.2e-5 us per weight element (v73, Q4_0)
+    const uint64_t item_ps        = 10000000;  // ~10 us per item
+
+    uint64_t best_cost = UINT64_MAX;
+    size_t   best_mc = 0, best_nc = 0, best_used = 0;
+    for (int nc = n - n % nc_step; nc >= nc_step; nc -= nc_step) {
+        size_t mc = hex_align_down((size_t) max_m, 32);
+        while (mc >= 32 && hmx_mmid_stream_vtcm_size(mc, nc, w_col_bytes, vec_dot_size, fixed) > budget) {
+            mc -= 32;
+        }
+        if (mc < 32) continue;
+
+        // M-chunks over all experts in 32-row tiles (32-bit divisions only; the per-item factor is the same
+        // for every expert)
+        const uint32_t mt = (uint32_t) (mc / 32);
+        uint32_t m_chunks = 0;
+#pragma clang loop vectorize(disable) unroll(disable)
+        for (uint32_t a = 0; a < n_as; ++a) {
+            const uint32_t t = (row_counts[a] + 31) / 32;
+            m_chunks += (t + mt - 1) / mt;
+        }
+        const uint32_t n_chunks = (uint32_t) (n + nc - 1) / (uint32_t) nc;
+        const uint64_t cost = (uint64_t) m_chunks * (uint64_t) n_w * ((uint64_t) n * k * dq_ps_per_elem + (uint64_t) n_chunks * item_ps);
+        if (cost < best_cost || (cost == best_cost && mc * nc > best_mc * best_nc)) {
+            best_cost = cost;
+            best_mc   = mc;
+            best_nc   = nc;
+            best_used = hmx_mmid_stream_vtcm_size(mc, nc, w_col_bytes, vec_dot_size, fixed);
+        }
+    }
+    if (best_mc == 0) return -1;
+    *mc_out   = best_mc;
+    *nc_out   = best_nc;
+    *used_out = best_used;
+    return 0;
+}
+
+// HVX work of one pipeline step of the streamed expert kernel as one shared task list (one fork-join per item):
+// scatter of an older item, gather of a new expert / M-chunk and dequant of the next item. Tasks are taken
+// dynamically and interleaved by type, so memory-bound (gather, scatter) and VTCM-bound (dequant) tasks run
+// on different HVX threads at the same time.
+enum { HMX_MMID_T_GATHER = 0, HMX_MMID_T_SCATTER = 1, HMX_MMID_T_DEQUANT = 2 };
+
+#define HMX_MMID_MAX_TASKS 96
+#define HMX_MMID_DMA_PAIRS 4   // row pairs in flight per thread in the DMA gather
+#define HMX_MMID_MAX_G     24  // gather tasks: multiples of 32 rows (the tile padding stays inside the task)
+#define HMX_MMID_MAX_S     32  // scatter tasks: multiples of 16 rows
+#define HMX_MMID_MAX_D     32  // dequant tasks
+
+typedef struct {
+    struct htp_thread_trace       * traces;
+    atomic_uint                     next;
+    uint32_t                        n_tasks;
+    uint8_t                         type[HMX_MMID_MAX_TASKS];
+    uint8_t                         idx[HMX_MMID_MAX_TASKS];
+
+    // gather tasks of the DMA threads (1..n-1): own counter; thread 0 keeps its DMA queue for the weights
+    struct htp_context            * ctx;
+    atomic_uint                     g_next;
+    uint32_t                        n_g_dma;
+    float                         * dma_ring;        // per thread (index i - 1): 2 * HMX_MMID_DMA_PAIRS rows of k
+    bool                            act_f16;         // HTP_MMID_STREAM_ACT_F16: fp16 activation rows
+    size_t                          dma_ring_floats;
+
+    const struct mmid_row_mapping * matrix_rows;
+    uint32_t                        mapping_stride;
+
+    // gather: rows [g_mr, g_mr + g_n_rows) of expert g_a into g_dst
+    __fp16                        * g_dst;
+    const float                   * g_src;
+    uint32_t                        g_a, g_cne1, g_mr, g_n_rows, g_task_rows, k, k_valid, ne11;
+    struct fastdiv_values           ne11_div;
+    size_t                          nb11, nb12;
+
+    // scatter: rows [s_mr, s_mr + s_n_rows) of expert s_a from s_src
+    float                         * s_dst;
+    const __fp16                  * s_src;
+    uint32_t                        s_a, s_cne1, s_mr, s_n_rows, s_task_rows, s_n_cols;
+    size_t                          s_nb1, s_nb2;
+    bool                            s_aligned;  // HTP_MMID_STREAM_ALIGNED_OUT
+    uint32_t                        s_swiglu;   // paired gate/up SWIGLU scatter mode (0 = plain)
+    __fp16                        * s_tiled;    // HTP_MMID_STREAM_ACT_TILED producer: tile row 0 of this M-chunk (NULL = scatter)
+    uint32_t                        s_col_tile0, s_k_tiles;
+
+    // HTP_MMID_STREAM_ACT_TILED consumer: one block DMA per M-chunk on thread 1's queue
+    bool                            ab_pop;     // wait for the block DMA pushed in an earlier step
+    bool                            ab_sync;    // push + wait now (ab_sync_*)
+    bool                            ab_push;    // push now, wait in a later step (ab_push_*)
+    void                          * ab_sync_dst;
+    const void                    * ab_sync_src;
+    void                          * ab_push_dst;
+    const void                    * ab_push_src;
+    uint32_t                        ab_sync_bytes, ab_push_bytes;
+
+    // dequant
+    tiled_dequantize_state_t        dq;
+} hmx_mmid_hvx_step_t;
+
+// Gather of `rows` activation rows (fp32, DDR) into fp16 HMX tiles through this thread's DMA queue: the rows
+// are fetched HMX_MMID_DMA_PAIRS pairs ahead into a VTCM ring, so HVX converts from VTCM instead of waiting on
+// DDR loads. Same conversion and tile layout as transfer_activation_chunk_fp32_to_fp16_gathered(_flat); the
+// padding rows of the last tile are left as they are (their HMX output rows are never stored).
+static void hmx_mmid_gather_dma(dma_queue * q, float * ring, __fp16 * vtcm_dst, const float * src,
+                                uint32_t start_row, uint32_t vtcm_start_row, uint32_t rows, uint32_t k_block,
+                                const struct mmid_row_mapping * matrix_rows, uint32_t cur_a, uint32_t mapping_stride,
+                                uint32_t ne11, const struct fastdiv_values * ne11_div, size_t nb11, size_t nb12,
+                                uint32_t k_valid, bool act_f16) {
+    const struct mmid_row_mapping * map = matrix_rows + (size_t) cur_a * mapping_stride + start_row;
+    const uint32_t n_pairs   = (rows + 1) / 2;
+    const size_t   row_bytes = (size_t) k_valid * (act_f16 ? sizeof(__fp16) : sizeof(float));
+
+#define HMX_MMID_ROW_SRC(r) ((dma_addr_t) ((const uint8_t *) src + \
+        (ne11 > 1 ? fastmodulo(map[(r)].i1, ne11, ne11_div) : 0) * nb11 + (size_t) map[(r)].i2 * nb12))
+#define HMX_MMID_PUSH_PAIR(pp) do {                                                                      \
+        float * d0 = ring + (size_t) (2 * ((pp) % HMX_MMID_DMA_PAIRS)) * k_block;                        \
+        dma_queue_push(q, dma_make_data(d0, HMX_MMID_ROW_SRC(2 * (pp))), row_bytes, row_bytes, row_bytes, 1); \
+        if (2 * (pp) + 1 < rows) {                                                                       \
+            dma_queue_push(q, dma_make_data(d0 + k_block, HMX_MMID_ROW_SRC(2 * (pp) + 1)),               \
+                           row_bytes, row_bytes, row_bytes, 1);                                           \
+        }                                                                                                \
+    } while (0)
+
+    uint32_t pushed = 0;
+    for (; pushed < n_pairs && pushed < HMX_MMID_DMA_PAIRS; ++pushed) {
+        HMX_MMID_PUSH_PAIR(pushed);
+    }
+
+    for (uint32_t p = 0; p < n_pairs; ++p) {
+        const bool has1 = (2 * p + 1 < rows);
+        dma_queue_pop(q);
+        if (has1) dma_queue_pop(q);
+
+        const float * row0 = ring + (size_t) (2 * (p % HMX_MMID_DMA_PAIRS)) * k_block;
+        const float * row1 = row0 + k_block;
+
+        const uint32_t lr = vtcm_start_row + 2 * p;          // vtcm-local row
+        const uint32_t r0 = lr / HTP_MM_HMX_TILE_N_ROWS;     // tile row index
+        const uint32_t r1 = lr % HTP_MM_HMX_TILE_N_ROWS;     // intra-tile row idx
+        HVX_Vector * tile_row = (HVX_Vector *) (vtcm_dst + (size_t) r0 * (k_block / HTP_MM_HMX_TILE_N_COLS) * HTP_MM_HMX_TILE_N_ELMS);
+
+        if (act_f16) {
+            // fp16 rows (k_valid == k_block, a multiple of 64): interleave the row pair into two column tiles
+            const size_t tv = HTP_MM_HMX_TILE_N_ELMS * sizeof(__fp16) / VLEN;  // vectors per tile
+            const HVX_Vector * h0 = (const HVX_Vector *) row0;
+            const HVX_Vector * h1 = (const HVX_Vector *) row1;
+            for (uint32_t c = 0; c < k_block; c += 64) {
+                const HVX_Vector     v0 = h0[c / 64];
+                const HVX_Vector     v1 = has1 ? h1[c / 64] : Q6_V_vzero();
+                const HVX_VectorPair vp = Q6_W_vshuff_VVR(v1, v0, -2);
+                tile_row[(c / HTP_MM_HMX_TILE_N_COLS) * tv + r1 / 2]       = Q6_V_lo_W(vp);
+                tile_row[(c / HTP_MM_HMX_TILE_N_COLS + 1) * tv + r1 / 2]   = Q6_V_hi_W(vp);
+            }
+            if (pushed < n_pairs) {  // into the slot just converted
+                HMX_MMID_PUSH_PAIR(pushed);
+                ++pushed;
+            }
+            continue;
+        }
+
+        uint32_t c = 0;
+        for (; c + 32 <= k_valid; c += 32) {
+            HVX_Vector v0 = *(const HVX_Vector *) (row0 + c);
+            HVX_Vector v1 = has1 ? *(const HVX_Vector *) (row1 + c) : Q6_V_vzero();
+            tile_row[(c / HTP_MM_HMX_TILE_N_COLS) * (HTP_MM_HMX_TILE_N_ELMS * sizeof(__fp16) / VLEN) + r1 / 2] =
+                hvx_vec_f32_to_f16_shuff(v0, v1);
+        }
+        if (c < k_block) {
+            HVX_Vector v0 = *(const HVX_Vector *) (row0 + c);
+            HVX_Vector v1 = has1 ? *(const HVX_Vector *) (row1 + c) : Q6_V_vzero();
+            uint32_t rem = k_valid - c;
+            HVX_VectorPred mask = Q6_Q_vsetq2_R(rem > 0 ? rem * sizeof(float) : 0);
+            v0 = Q6_V_vmux_QVV(mask, v0, Q6_V_vzero());
+            v1 = Q6_V_vmux_QVV(mask, v1, Q6_V_vzero());
+            tile_row[(c / HTP_MM_HMX_TILE_N_COLS) * (HTP_MM_HMX_TILE_N_ELMS * sizeof(__fp16) / VLEN) + r1 / 2] =
+                hvx_vec_f32_to_f16_shuff(v0, v1);
+        }
+
+        if (pushed < n_pairs) {  // into the slot just converted
+            HMX_MMID_PUSH_PAIR(pushed);
+            ++pushed;
+        }
+    }
+#undef HMX_MMID_PUSH_PAIR
+#undef HMX_MMID_ROW_SRC
+}
+
+// contiguous DDR -> VTCM block (sizes multiples of 4 KB) as one 2D descriptor
+static inline void hmx_mmid_block_dma_push(dma_queue * q, void * dst, const void * src, uint32_t bytes) {
+    const uint32_t row = 4096;
+    dma_queue_push(q, dma_make_data(dst, src), row, row, row, bytes / row);
+}
+
+static void hmx_mmid_hvx_step_worker(unsigned int n, unsigned int i, void * data) {
+    (void) n;
+    hmx_mmid_hvx_step_t * st = (hmx_mmid_hvx_step_t *) data;
+    struct htp_thread_trace * tr = &st->traces[i];
+
+    if (i == 1 && (st->ab_pop || st->ab_sync || st->ab_push)) {
+        dma_queue * q = st->ctx->dma[1];
+        htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_A_PREP, 0);
+        if (st->ab_pop) {
+            dma_queue_pop(q);
+        }
+        if (st->ab_sync) {
+            hmx_mmid_block_dma_push(q, st->ab_sync_dst, st->ab_sync_src, st->ab_sync_bytes);
+            dma_queue_pop(q);
+        }
+        if (st->ab_push) {
+            hmx_mmid_block_dma_push(q, st->ab_push_dst, st->ab_push_src, st->ab_push_bytes);
+        }
+        htp_trace_event_stop(tr, HTP_TRACE_EVT_HVX_A_PREP, 0);
+    }
+
+    if (i > 0 && st->n_g_dma > 0) {
+        dma_queue * q    = st->ctx->dma[i];
+        float *     ring = st->dma_ring + (size_t) (i - 1) * st->dma_ring_floats;
+        for (;;) {
+            const uint32_t j = atomic_fetch_add(&st->g_next, 1);
+            if (j >= st->n_g_dma) break;
+            const uint32_t r0 = j * st->g_task_rows;
+            int rows = (int) st->g_cne1 - (int) (st->g_mr + r0);  // signed: hex_smin is unsigned
+            if (rows > (int) st->g_task_rows) rows = (int) st->g_task_rows;
+            if (rows <= 0) continue;
+            htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_A_PREP, j);
+            hmx_mmid_gather_dma(q, ring, st->g_dst, st->g_src, st->g_mr + r0, r0, (uint32_t) rows, st->k,
+                                st->matrix_rows, st->g_a, st->mapping_stride, st->ne11, &st->ne11_div,
+                                st->nb11, st->nb12, st->k_valid, st->act_f16);
+            htp_trace_event_stop(tr, HTP_TRACE_EVT_HVX_A_PREP, j);
+        }
+    }
+
+    for (;;) {
+        const uint32_t t = atomic_fetch_add(&st->next, 1);
+        if (t >= st->n_tasks) break;
+        const uint32_t j = st->idx[t];
+        switch (st->type[t]) {
+            case HMX_MMID_T_GATHER: {
+                const uint32_t r0 = j * st->g_task_rows;
+                int rows = (int) st->g_cne1 - (int) (st->g_mr + r0);  // signed: hex_smin is unsigned
+                if (rows > (int) st->g_task_rows) rows = (int) st->g_task_rows;
+                if (rows <= 0) break;
+                htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_A_PREP, j);
+                if (st->ne11 == 1) {
+                    transfer_activation_chunk_fp32_to_fp16_gathered_flat(
+                        st->g_dst, st->g_src, st->g_mr + r0, r0, (uint32_t) rows, st->k,
+                        st->matrix_rows, st->g_a, st->mapping_stride, st->nb12, st->g_cne1, st->k_valid);
+                } else {
+                    transfer_activation_chunk_fp32_to_fp16_gathered(
+                        st->g_dst, st->g_src, st->g_mr + r0, r0, (uint32_t) rows, st->k,
+                        st->matrix_rows, st->g_a, st->mapping_stride, st->ne11, &st->ne11_div,
+                        st->nb11, st->nb12, st->g_cne1, st->k_valid);
+                }
+                htp_trace_event_stop(tr, HTP_TRACE_EVT_HVX_A_PREP, j);
+                break;
+            }
+            case HMX_MMID_T_SCATTER: {
+                const uint32_t r0 = j * st->s_task_rows;
+                int rows = (int) st->s_n_rows - (int) r0;
+                if (rows > (int) st->s_task_rows) rows = (int) st->s_task_rows;
+                if (rows <= 0 || st->s_mr + r0 >= st->s_cne1) break;
+                htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_O_PROC, j);
+                if (st->s_tiled) {
+                    // valid rows only (the pair holding the last one is written whole)
+                    const uint32_t valid = st->s_cne1 - (st->s_mr + r0);
+                    transfer_output_chunk_tiled_swiglu_pair(
+                        st->s_tiled, st->s_src, r0, (uint32_t) rows < valid ? (uint32_t) rows : valid,
+                        st->s_n_cols, st->s_col_tile0, st->s_k_tiles, st->s_swiglu);
+                } else if (st->s_swiglu == HMX_MMID_SCATTER_F16) {
+                    transfer_output_chunk_f16_scattered(
+                        (__fp16 *) st->s_dst, st->s_src, st->s_mr + r0, r0, (uint32_t) rows, st->s_n_cols,
+                        st->matrix_rows, st->s_a, st->mapping_stride, st->s_nb1, st->s_nb2, st->s_cne1,
+                        st->s_aligned);
+                } else if (st->s_swiglu) {
+                    transfer_output_chunk_scattered_swiglu_pair(
+                        st->s_dst, st->s_src, st->s_mr + r0, r0, (uint32_t) rows, st->s_n_cols,
+                        st->matrix_rows, st->s_a, st->mapping_stride, st->s_nb1, st->s_nb2, st->s_cne1,
+                        st->s_aligned, st->s_swiglu);
+                } else {
+                    transfer_output_chunk_fp16_to_fp32_scattered(
+                        st->s_dst, st->s_src, st->s_mr + r0, r0, (uint32_t) rows, st->s_n_cols,
+                        st->matrix_rows, st->s_a, st->mapping_stride, st->s_nb1, st->s_nb2, st->s_cne1,
+                        st->s_aligned);
+                }
+                htp_trace_event_stop(tr, HTP_TRACE_EVT_HVX_O_PROC, j);
+                break;
+            }
+            default: {
+                const uint32_t start = j * st->dq.n_tiles_per_task;
+                const uint32_t end   = hex_smin(start + st->dq.n_tiles_per_task, st->dq.n_tot_tiles);
+                if (start >= end) break;
+                htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_W_DEQUANT, j);
+                st->dq.task_fn(&st->dq, start, end);
+                htp_trace_event_stop(tr, HTP_TRACE_EVT_HVX_W_DEQUANT, j);
+                break;
+            }
+        }
+    }
+}
+
+// task list: memory-bound tasks first and spread out, dequant tasks in between
+static void hmx_mmid_hvx_step_build(hmx_mmid_hvx_step_t * st, uint32_t n_g, uint32_t n_s, uint32_t n_d, bool dma_gather) {
+    st->n_g_dma = dma_gather ? n_g : 0;
+    atomic_store(&st->g_next, 0);
+    if (dma_gather) n_g = 0;
+    uint32_t g = 0, s = 0, d = 0, t = 0;
+    assert(n_g <= HMX_MMID_MAX_G && n_s <= HMX_MMID_MAX_S && n_d <= HMX_MMID_MAX_D);
+    while (g < n_g || s < n_s || d < n_d) {
+        if (g < n_g) { st->type[t] = HMX_MMID_T_GATHER;  st->idx[t++] = (uint8_t) g++; }
+        if (s < n_s) { st->type[t] = HMX_MMID_T_SCATTER; st->idx[t++] = (uint8_t) s++; }
+        if (d < n_d) { st->type[t] = HMX_MMID_T_DEQUANT; st->idx[t++] = (uint8_t) d++; }
+    }
+    st->n_tasks = t;
+    atomic_store(&st->next, 0);
+}
+
+// Returns 1 when the op cannot use the streamed kernel (nothing was done, use the per-expert kernel),
+// 0 on success, -1 on error.
+static int hmx_mm_id_stream_f32(struct htp_context *ctx,
+                                dma_queue *weight_dma,
+                                int n_w,
+                                float * const * dsts,
+                                const size_t * dst_nb1s,
+                                const size_t * dst_nb2s,
+                                const dma_addr_t * w_data,       // per weight: expert 0
+                                const size_t * w_nb2,            // per weight: expert stride
+                                const float *activation,
+                                int k, int n,
+                                int k_valid,
+                                int ne11,
+                                size_t act_nb1, size_t act_nb2,
+                                int weight_stride,
+                                int weight_type,
+                                int tile_size,
+                                int aligned_tile_size,
+                                const uint32_t * row_counts,
+                                uint32_t n_as,
+                                const struct mmid_row_mapping *matrix_rows,
+                                int mapping_stride,
+                                int n_threads,
+                                uint32_t flags,    // HTP_MMID_STREAM_* bits
+                                uint32_t swiglu,   // n_w == 2: dsts[0] = silu(W0 x) * (W1 x), 1 = qf32, 2 = fp16 sigmoid, 3 = all fp16,
+                                                   // 4 = 2 stored as fp16, 5 = 3 stored as fp16
+                                const uint32_t * tiled_offs) { // HTP_MMID_STREAM_ACT_TILED layout in use (hmx_mmid_tiled_layout,
+                                                   // NULL = none): swiglu >= 4 stores dsts[0] tiled, act_f16 loads tiled
+    struct htp_thread_trace * tr = &ctx->trace[0];
+
+    if (flags & HTP_MMID_STREAM_TEST_PER_EXPERT) return 1;
+    if ((flags & HTP_MMID_STREAM_TEST_TILED_FALLBACK) && tiled_offs != NULL && swiglu == 0) return 1;
+    if (n_w <= 0) return 1;
+    if (swiglu && n_w != 2) return 1;
+    if (k % 32 != 0 || n % 32 != 0) return 1;
+    if (!hex_is_aligned(activation, VLEN)) return 1;
+    for (int w = 0; w < n_w; ++w) {
+        if (!hex_is_aligned(dsts[w], VLEN)) return 1;
+    }
+
+    const size_t row_stride = htp_tensor_get_row_size(weight_type, k);
+    if (row_stride == 0) return 1;
+
+    const bool is_tiled = (tile_size > 0);
+    tiled_dequant_task_fn_t dequant_worker_fn = hmx_get_dequant_worker_fn(ctx, weight_type, is_tiled);
+    if (!dequant_worker_fn) return 1;  // HMX would read the raw buffers directly: per-expert kernel
+
+    htp_trace_event_start(tr, HTP_TRACE_EVT_INIT, 0);
+    const bool aligned_out = (flags & HTP_MMID_STREAM_ALIGNED_OUT) != 0;
+    const bool act_f16     = (flags & HTP_MMID_STREAM_ACT_F16) != 0;
+    // HTP_MMID_STREAM_OUT_F16: plain single-weight op, fp16 rows in the f32 row slots of dsts[0]
+    const bool out_f16     = (flags & HTP_MMID_STREAM_OUT_F16) != 0 && swiglu == 0 && n_w == 1;
+    const uint32_t scat_mode = out_f16 ? HMX_MMID_SCATTER_F16 : swiglu;
+    if (act_f16 && (n_threads <= 1 || !(flags & HTP_MMID_STREAM_DMA_GATHER) || k % 64 != 0 || k_valid != k ||
+                    act_nb1 % VLEN != 0 || act_nb2 % VLEN != 0)) {
+        htp_trace_event_stop(tr, HTP_TRACE_EVT_INIT, 0);
+        return 1;
+    }
+
+    const int n_k_tiles = k / HTP_MM_HMX_TILE_N_COLS;
+    const uint32_t n_weight_tiles = k / htp_tensor_get_tile_k(weight_type);
+    const struct fastdiv_values n_k_tiles_div = init_fastdiv_values(n_k_tiles);
+
+    const size_t vec_dot_size = k * sizeof(__fp16);
+
+    const uint32_t dma_dst_stride  = is_tiled ? aligned_tile_size : row_stride;
+    const uint32_t dma_src_stride  = is_tiled ? tile_size : weight_stride;
+    const uint32_t dma_width_bytes = is_tiled ? tile_size : row_stride;
+    const size_t   w_col_bytes     = is_tiled ? (size_t) (n_weight_tiles * aligned_tile_size) / 32 : row_stride;
+
+    // DMA gather rings for worker threads 1..n-1 (thread 0's DMA queue carries the weights)
+    // HTP_MMID_STREAM_ACT_TILED: producer side (tiled stores) and consumer side (block loads, no gather)
+    const bool   tiled_out       = tiled_offs != NULL && swiglu >= 4;
+    const bool   tiled_in        = tiled_offs != NULL && act_f16 && swiglu == 0;  // a SWIGLU producer's tiled_offs are its output's
+    if ((tiled_offs != NULL && !tiled_out && !tiled_in) || (tiled_out && !hex_is_aligned(dsts[0], VLEN))) {
+        htp_trace_event_stop(tr, HTP_TRACE_EVT_INIT, 0);
+        return 1;
+    }
+    const bool   dma_gather      = (n_threads > 1) && (flags & HTP_MMID_STREAM_DMA_GATHER) && !tiled_in;
+    const size_t dma_ring_floats = (size_t) 2 * HMX_MMID_DMA_PAIRS * k;
+    const size_t dma_ring_size   = dma_gather ? hex_align_up((size_t) (n_threads - 1) * dma_ring_floats * sizeof(float), HTP_MM_HMX_TILE_SIZE) : 0;
+
+    // SWIGLU pairing: one item = the same columns of both weights (gate then up) in one raw/fp16 weight buffer
+    // and one HMX job of 2 x hc columns, so the scatter combines the two halves in VTCM and writes only the
+    // SWIGLU output. Items then run over a single virtual weight of 2n columns, in chunks of 2 x 32 columns.
+    const int n_wi = swiglu ? 1 : n_w;  // weights in the item stream
+    size_t mc = 0, nc = 0, vtcm_used = 0;
+    if (hmx_mmid_stream_plan(ctx->vtcm_size, row_counts, n_as, n_wi, k, swiglu ? 2 * n : n, swiglu ? 64 : 32,
+                             w_col_bytes, vec_dot_size, dma_ring_size, &mc, &nc, &vtcm_used)) {
+        htp_trace_event_stop(tr, HTP_TRACE_EVT_INIT, 0);
+        return 1;
+    }
+
+    const size_t raw_size = hex_align_up(nc * w_col_bytes, HTP_MM_HMX_TILE_SIZE);
+    const size_t wf_size  = hex_align_up(nc * vec_dot_size, HTP_MM_HMX_TILE_SIZE);
+    const size_t act_size = hex_align_up((mc + HMX_MMID_ACT_SLACK_ROWS) * vec_dot_size, HTP_MM_HMX_TILE_SIZE);
+    const size_t out_size = hex_align_up(mc * nc * sizeof(__fp16), HTP_MM_HMX_TILE_SIZE);
+
+    uint8_t * vtcm_ptr = (uint8_t *) ctx->vtcm_base;
+    void *   raw_bufs[2];
+    __fp16 * wf_bufs[2];
+    __fp16 * act_bufs[2];
+    __fp16 * out_bufs[2];
+    for (int b = 0; b < 2; ++b) raw_bufs[b] = vtcm_seq_alloc(&vtcm_ptr, raw_size);
+    for (int b = 0; b < 2; ++b) wf_bufs[b]  = (__fp16 *) vtcm_seq_alloc(&vtcm_ptr, wf_size);
+    for (int b = 0; b < 2; ++b) act_bufs[b] = (__fp16 *) vtcm_seq_alloc(&vtcm_ptr, act_size);
+    for (int b = 0; b < 2; ++b) out_bufs[b] = (__fp16 *) vtcm_seq_alloc(&vtcm_ptr, out_size);
+    __fp16 * vtcm_scales = (__fp16 *) vtcm_seq_alloc(&vtcm_ptr, 256);
+    float *  dma_ring    = dma_gather ? (float *) vtcm_seq_alloc(&vtcm_ptr, dma_ring_size) : NULL;
+
+    if ((size_t) (vtcm_ptr - (uint8_t *) ctx->vtcm_base) > ctx->vtcm_size) {
+        htp_trace_event_stop(tr, HTP_TRACE_EVT_INIT, 0);
+        return 1;
+    }
+
+    hmx_init_column_scales(vtcm_scales, Q6_V_vsplat_R(0x3c00));
+
+    const size_t nc_w = swiglu ? nc / 2 : nc;  // columns of each weight per item
+    const int n_chunk_cnt = (n + (int) nc_w - 1) / (int) nc_w;
+
+    FARF(HIGH, "hmx-mm-id-stream: n_w %d k %d n %d mc %zu nc %zu vtcm %zu/%zu", n_w, k, n, mc, nc, vtcm_used, ctx->vtcm_size);
+
+    htp_trace_event_stop(tr, HTP_TRACE_EVT_INIT, 0);
+
+#define HMX_MMID_DMA_HEIGHT(cols) ((uint32_t) (is_tiled ? hmx_ceil_div((cols), 32) * n_weight_tiles : (cols)))
+#define HMX_MMID_DMA_PUSH(p, buf) do {                                                                          \
+        const size_t nc_d     = (size_t) (p).i * nc_w;                                                          \
+        const size_t n_cols_d = hex_smin((size_t) n - nc_d, nc_w);                                              \
+        const dma_addr_t src_d = w_data[(p).w] + (dma_addr_t) ((size_t) (p).a * w_nb2[(p).w] + nc_d * weight_stride); \
+        dma_queue_push(weight_dma, dma_make_data((buf), src_d), dma_dst_stride, dma_src_stride, dma_width_bytes,  \
+                       HMX_MMID_DMA_HEIGHT(n_cols_d));                                                          \
+        if (swiglu) {  /* the up columns right after the gate columns */                                        \
+            const dma_addr_t src_u = w_data[1] + (dma_addr_t) ((size_t) (p).a * w_nb2[1] + nc_d * weight_stride); \
+            dma_queue_push(weight_dma,                                                                          \
+                           dma_make_data((uint8_t *) (buf) + (size_t) HMX_MMID_DMA_HEIGHT(n_cols_d) * dma_dst_stride, src_u), \
+                           dma_dst_stride, dma_src_stride, dma_width_bytes, HMX_MMID_DMA_HEIGHT(n_cols_d));        \
+        }                                                                                                       \
+    } while (0)
+
+    struct hmx_mmid_pos cur, ahead;
+    hmx_mmid_pos_init(&cur, row_counts, n_as);
+    ahead = cur;
+
+    // prologue: weight chunks of items 0 and 1
+    for (int b = 0; b < 2 && ahead.valid; ++b) {
+        HMX_MMID_DMA_PUSH(ahead, raw_bufs[b]);
+        hmx_mmid_pos_advance(&ahead, n_wi, n_chunk_cnt, (int) mc);
+    }
+
+    hmx_mmid_hvx_step_t step;
+    step.traces          = ctx->trace;
+    step.ctx             = ctx;
+    step.dma_ring        = dma_ring;
+    step.dma_ring_floats = dma_ring_floats;
+    step.act_f16         = act_f16;
+    step.matrix_rows    = matrix_rows;
+    step.mapping_stride = (uint32_t) mapping_stride;
+    step.g_src          = activation;
+    step.k              = (uint32_t) k;
+    step.k_valid        = (uint32_t) k_valid;
+    step.ne11           = (uint32_t) ne11;
+    step.ne11_div       = ne11 > 1 ? init_fastdiv_values(ne11) : (struct fastdiv_values){ 0, 0 };
+    step.nb11           = act_nb1;
+    step.nb12           = act_nb2;
+    step.s_tiled        = NULL;
+    step.s_col_tile0    = 0;
+    step.s_k_tiles      = (uint32_t) n / 32;
+    step.ab_pop = step.ab_sync = step.ab_push = false;
+
+    tiled_dequantize_state_t * dq = &step.dq;
+    memset(dq, 0, sizeof(*dq));
+    dq->task_fn           = dequant_worker_fn;
+    dq->k_block           = k;
+    dq->row_stride        = row_stride;
+    dq->weight_type       = weight_type;
+    dq->n_k_tiles         = n_k_tiles;
+    dq->n_weight_tiles    = n_weight_tiles;
+    dq->n_k_tiles_div     = n_k_tiles_div;
+    dq->traces            = ctx->trace;
+    dq->ctx               = ctx;
+    dq->tile_size         = htp_tensor_get_tile_size(weight_type);
+    dq->aligned_tile_size = htp_tensor_get_tile_padded_size(weight_type);
+
+    // pending items for the scatter: [0] = item - 2, [1] = item - 1
+    struct hmx_mmid_out {
+        float * dst;
+        size_t  nb1, nb2;
+        int     a, cne1, mr, n_rows, n_cols, col0;
+    } pend[2];
+    int      n_pend = 0;
+    uint32_t item = 0;
+    uint32_t seg  = 0;
+    hmx_matmul_job_t job_slots[2];
+
+    // tiled_in: the block of segment s goes to act_bufs[s % 2] with one DMA on thread 1's queue, pushed as soon as
+    // that buffer is free (HMX done with segment s - 2) and waited for at the first item of segment s
+    int64_t act_last_item[2] = { -2, -2 };  // last item whose HMX job reads act_bufs[b]
+    int64_t ab_inflight      = -1;          // segment whose block DMA is in flight
+    struct hmx_mmid_pos nseg;               // the segment after the current one
+    nseg.valid = false;
+
+    const size_t act_row_bytes = (size_t) k * sizeof(__fp16);
+#define HMX_MMID_ACT_BLOCK_SRC(p) ((const uint8_t *) activation + (size_t) (tiled_offs[(p).a] + (uint32_t) (p).mr) * act_row_bytes)
+#define HMX_MMID_ACT_BLOCK_BYTES(p) ((uint32_t) (hex_smin((size_t) ((p).m_end - (p).mr), mc) * act_row_bytes))
+
+    // item j: pop DMA(j); pop HMX(j - 2); [scatter(j - 2) | gather(segment of j) | dequant(j)]; DMA(j + 2); push HMX(j)
+    while (cur.valid) {
+        const size_t n_rows = hex_smin((size_t) (cur.m_end - cur.mr), mc);
