+        const size_t r0 = r / HMX_FP16_TILE_N_ROWS;
+        const size_t r1 = r % HMX_FP16_TILE_N_ROWS;
+        if (r0 != cur_tile) {
+            inv16    = fa_tile_inv_l_f16((const HVX_Vector *) (o_tile_src + DVt * o_stride + r0 * HMX_FP16_TILE_N_ELMS));
