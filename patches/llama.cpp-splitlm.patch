+    // v = n + f, n integer, |f| <= 0.5
+    const HVX_Vector t   = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vadd_VsfVsf(v, c->mag));
+    const HVX_Vector n   = Q6_Vw_vsub_VwVw(t, c->mag);
+    const HVX_Vector f   = Q6_Vqf32_vsub_Vqf32Vqf32(v_q, Q6_Vqf32_vsub_VsfVsf(t, c->mag));
+    const HVX_Vector ff  = Q6_Vqf32_vmpy_Vqf32Vqf32(f, f);
+
+    // 4^f ~ (v1 + v2) / (v1 - v2)
+    const HVX_Vector v1 = Q6_Vqf32_vadd_Vqf32Vqf32(Q6_Vqf32_vmpy_Vqf32Vqf32(ff, c->c2), c->l2);
