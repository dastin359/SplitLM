+static inline void transfer_output_chunk_fp16_to_fp32_swiglu_col_chunk(
+    bool gate_is_acc,
+    float *restrict dst,
+    const float *restrict gate,
+    const __fp16 *restrict vtcm_src,
+    uint32_t start_row,
+    uint32_t n_rows,
