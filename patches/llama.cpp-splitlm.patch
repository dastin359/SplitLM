+// activations: fp16 tiles -> per-row int8 croutons in place (unit = one 64-row block, all k tiles)
+typedef struct {
+    __fp16 * act;
+    float *  row_scale;
+    uint32_t n_q;          // 64-row blocks
+    uint32_t n_k_tiles;
+    uint32_t n_rows;       // valid rows (the block max ignores the padding rows of the last block)
+    bool     blk;          // GGML_HEXAGON_A8_BLK: one scale per 64-row block (max of the row amax)
+    struct htp_thread_trace * traces;
+} hmx_a8_act_state_t;
+
+static bool g_a8_blk;  // set by the matmul ops before the activation quantization (one op at a time on the NPU)
+
+static inline uint32_t hmx_a8_hf_bits(float f) {
+    union { __fp16 h; uint16_t u; } x = { .h = (__fp16) f };
+    return x.u;
+}
+
+static void hmx_a8_act_worker(unsigned int n, unsigned int i, void * data) {
+    const hmx_a8_act_state_t * st = (const hmx_a8_act_state_t *) data;
+    struct htp_thread_trace * tr = &st->traces[i];
+    htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_A_QUANT, 0);
+    const uint32_t nkt = st->n_k_tiles;
+    const size_t   tv  = 2048 / VLEN;
+    const HVX_Vector absm = Q6_Vh_vsplat_R(0x7fff);
+    const HVX_Vector c256 = Q6_Vh_vsplat_R(256);
+    const HVX_Vector zero = Q6_V_vzero();
+    for (uint32_t q = i; q < st->n_q; q += n) {
+        HVX_Vector * t0 = (HVX_Vector *) st->act + (size_t) (2 * q) * nkt * tv;  // tile row 2q
+        HVX_Vector * t1 = t0 + (size_t) nkt * tv;                                // tile row 2q + 1
+        uint32_t sv[32], tvv[32];  // fp16 scale pairs per row pair (the worker stack is 16 KB: no vector arrays)
+        uint32_t amw[32];          // fp16 |x| max pairs per row pair
+        bool two = false;
+        for (int h = 0; h < 2; ++h) {
+            const HVX_Vector * src = h ? t1 : t0;
+            HVX_Vector m[16];
+            for (int j = 0; j < 16; ++j) m[j] = zero;
+            for (uint32_t t = 0; t < nkt; ++t) {
+                const HVX_Vector * s = src + t * tv;
+                for (int j = 0; j < 16; ++j) m[j] = Q6_Vh_vmax_VhVh(m[j], Q6_V_vand_VV(s[j], absm));
+            }
+            for (int j = 0; j < 16; ++j) {
+                HVX_Vector x = m[j];
+                x = Q6_Vh_vmax_VhVh(x, Q6_V_vror_VR(x, 64));
+                x = Q6_Vh_vmax_VhVh(x, Q6_V_vror_VR(x, 32));
+                x = Q6_Vh_vmax_VhVh(x, Q6_V_vror_VR(x, 16));
+                x = Q6_Vh_vmax_VhVh(x, Q6_V_vror_VR(x, 8));
+                x = Q6_Vh_vmax_VhVh(x, Q6_V_vror_VR(x, 4));
+                amw[h * 16 + j] = (uint32_t) Q6_R_vextract_VR(x, 0);
+            }
+        }
+        if (st->blk) {  // block max (fp16 bit patterns of non-negative values order like the values)
+            uint32_t mx = 0;
+            for (int j = 0; j < 32; ++j) {
+                const uint32_t r = q * 64 + (uint32_t) j * 2;
+                const uint32_t a = amw[j] & 0xffff, b = amw[j] >> 16;
+                if (r < st->n_rows && a > mx) mx = a;
+                if (r + 1 < st->n_rows && b > mx) mx = b;
+            }
+            for (int j = 0; j < 32; ++j) amw[j] = mx | (mx << 16);
+        }
+        for (int h = 0; h < 2; ++h) {
+            for (int j = 0; j < 16; ++j) {
+                const uint32_t w2 = amw[h * 16 + j];
+                uint32_t sb[2], tb[2];
+                for (int e = 0; e < 2; ++e) {
+                    union { uint16_t u; __fp16 h; } am = { .u = (uint16_t) (e ? w2 >> 16 : w2 & 0xffff) };
+                    const float a = (float) am.h;
+                    float s2 = 0.0f, t2 = 1.0f, rsv;
+                    if (a >= 0x1p-20f && a <= 65504.0f) {  // below 2^-20 the second factor would overflow fp16: row -> 0
