+    const HVX_Vector e2 = Q6_Vqf32_vsub_Vqf32Vqf32(c->two, Q6_Vqf32_vmpy_Vqf32Vqf32(r1, d_q));
+    const HVX_Vector r2 = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vmpy_Vqf32Vqf32(r1, e2));
