+static inline void transfer_output_chunk_fp16_to_fp32_swiglu_col_chunk(
+    bool gate_is_acc,
+    float *restrict dst,
+    const float *restrict gate,
+    const __fp16 *restrict vtcm_src,
+    uint32_t start_row,
+    uint32_t n_rows,
+    uint32_t c_len,
+    uint32_t total_n_cols,
+    uint32_t dst_stride,
+    uint32_t gate_stride,
+    uint32_t dst_cols
+) {
+    const size_t tile_row_stride = hmx_ceil_div(total_n_cols, HTP_MM_HMX_TILE_N_COLS) * HTP_MM_HMX_TILE_N_ELMS;
+
+    const HVX_Vector one = hvx_vec_splat_f16(1.0);
+    const struct hvx_sigmoid_qf32_consts sc = hvx_sigmoid_qf32_consts_init();
+
+    const size_t limit_c         = hex_smin(c_len, dst_cols);
+    const size_t limit_c_aligned = (limit_c & ~31);
+
+    hex_l2fetch(gate, limit_c * sizeof(float), gate_stride * sizeof(float), hex_smin(n_rows, HMX_EPI_PF_ROWS));
+
+    for (size_t r = 0; r < n_rows; r += 2) {
+        const size_t r_idx0 = start_row + r + 0;
+        const size_t r0 = r_idx0 / HTP_MM_HMX_TILE_N_ROWS;
+        const size_t r1 = (r_idx0 % HTP_MM_HMX_TILE_N_ROWS) / 2;  // index of the row pair within the tile
+        const __fp16 *row_base = vtcm_src + r0 * tile_row_stride;
+        float *output_row_base = dst + r * dst_stride;
+        const float *gate_row_base = gate + r * gate_stride;
+        const bool has_r1 = (r + 1 < n_rows);
+
+        hmx_epi_prefetch_rows(gate, r, n_rows, limit_c, gate_stride);
+
+        #pragma unroll(2)
+        for (size_t c = 0; c < limit_c_aligned; c += HTP_MM_HMX_TILE_N_COLS) {
+            const __fp16 *tile = row_base + (c / HTP_MM_HMX_TILE_N_COLS) * HTP_MM_HMX_TILE_N_ELMS;
+            HVX_VectorPair vp = Q6_Wqf32_vmpy_VhfVhf(((const HVX_Vector *) tile)[r1], one);
+
+            const HVX_Vector u0 = Q6_Vsf_equals_Vqf32(Q6_V_lo_W(vp));
+            const HVX_Vector g0 = hvx_vmemu(gate_row_base + c);
+            hvx_vmemu(output_row_base + c) = hmx_epi_swiglu(u0, g0, gate_is_acc, &sc);
+
+            if (has_r1) {
+                const HVX_Vector u1 = Q6_Vsf_equals_Vqf32(Q6_V_hi_W(vp));
+                const HVX_Vector g1 = hvx_vmemu(gate_row_base + c + gate_stride);
+                hvx_vmemu(output_row_base + c + dst_stride) = hmx_epi_swiglu(u1, g1, gate_is_acc, &sc);
+            }
+        }
+
+        if (limit_c_aligned < limit_c) {
+            const size_t c       = limit_c_aligned;
+            const size_t valid_c = limit_c - c;
+            const __fp16 *tile = row_base + (c / HTP_MM_HMX_TILE_N_COLS) * HTP_MM_HMX_TILE_N_ELMS;
+            HVX_VectorPair vp = Q6_Wqf32_vmpy_VhfVhf(((const HVX_Vector *) tile)[r1], one);
+
+            const HVX_Vector u0 = Q6_Vsf_equals_Vqf32(Q6_V_lo_W(vp));
+            const HVX_Vector g0 = hvx_vmemu(gate_row_base + c);
+            hvx_vec_store_u(output_row_base + c, valid_c * sizeof(float), hmx_epi_swiglu(u0, g0, gate_is_acc, &sc));
+
+            if (has_r1) {
+                const HVX_Vector u1 = Q6_Vsf_equals_Vqf32(Q6_V_hi_W(vp));
+                const HVX_Vector g1 = hvx_vmemu(gate_row_base + c + gate_stride);
+                hvx_vec_store_u(output_row_base + c + dst_stride, valid_c * sizeof(float), hmx_epi_swiglu(u1, g1, gate_is_acc, &sc));
+            }
+        }
+    }
