+// Leading all-zero mask chunks per query row (softmax fast path, see fa_sfm_decode_mask_rows)
+#define FA_ZC_MAX_ROWS 1024
+
+typedef struct {
+    const uint8_t * rows;        // mask row q_start (DDR)
+    size_t          row_stride;
+    uint32_t        n_rows;
+    uint32_t        n_full;      // full 64-column chunks in [0, nek1)
+    uint16_t *      zc;
+} fa_zscan_args_t;
+
+// 64 fp16 mask values at a (all inside the row). Only aligned lines that hold row bytes are touched.
+static inline HVX_Vector fa_mask_chunk_load(const uint8_t * a) {
+    if (((uint32_t) a & 127) == 0) {
+        return *(const HVX_Vector *) a;
+    }
+    const HVX_Vector * p = (const HVX_Vector *) ((uint32_t) a & ~127u);
+    return Q6_V_valign_VVR(p[1], p[0], (uint32_t) a);
+}
+
+static inline bool fa_vec_any_nonzero(HVX_Vector v) {
+    v = Q6_V_vor_VV(v, Q6_V_vror_VR(v, 64));
+    v = Q6_V_vor_VV(v, Q6_V_vror_VR(v, 32));
+    v = Q6_V_vor_VV(v, Q6_V_vror_VR(v, 16));
+    v = Q6_V_vor_VV(v, Q6_V_vror_VR(v, 8));
+    v = Q6_V_vor_VV(v, Q6_V_vror_VR(v, 4));
+    return hvx_vec_get_i32(v) != 0;
+}
+
+static void fa_zscan_thread(unsigned int n, unsigned int i, void * data) {
+    const fa_zscan_args_t * args = (const fa_zscan_args_t *) data;
+    uint32_t hint = 0;
+    for (uint32_t r = i; r < args->n_rows; r += n) {
+        const uint8_t * row = args->rows + (size_t) r * args->row_stride;
+        hex_l2fetch(row, hex_smin(hex_smin(hint + 4, args->n_full) * 128u, 0xff80u), (uint32_t) args->row_stride, 1);
+        uint32_t c = 0;
+        while (c + 4 <= args->n_full) {
+            const uint8_t * a = row + (size_t) c * 128;
+            HVX_Vector      v = Q6_V_vor_VV(fa_mask_chunk_load(a), fa_mask_chunk_load(a + 128));
+            v                 = Q6_V_vor_VV(v, Q6_V_vor_VV(fa_mask_chunk_load(a + 256), fa_mask_chunk_load(a + 384)));
+            if (fa_vec_any_nonzero(v)) {
+                break;
+            }
+            c += 4;
+        }
+        while (c < args->n_full && !fa_vec_any_nonzero(fa_mask_chunk_load(row + (size_t) c * 128))) {
+            ++c;
+        }
+        args->zc[r] = (uint16_t) hex_smin(c, 0xffffu);
+        hint        = c;
+    }
