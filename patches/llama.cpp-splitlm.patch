+// GGML_HEXAGON_GNORM_TILED: rms_norm_mul_gate_hf_fused_128 in place (dst == src: every row's loads precede its stores)
+static void rms_norm_mul_gate_hf_fused_128_ip(const uint8_t * src, const uint8_t * restrict w,
+                                           const uint8_t * restrict z, uint8_t * dst, uint32_t num_rows,
+                                           float epsilon) {
+    const HVX_Vector inv_n_v   = hvx_vec_inverse_f32(hvx_vec_splat_f32(128.0f));
+    const HVX_Vector epsilon_v = hvx_vec_splat_f32(epsilon);
+    const HVX_Vector one_v     = hvx_vec_splat_f32(1.f);
+    const struct hvx_silu_hf_consts c = hvx_silu_hf_consts_init();
+    const HVX_Vector * restrict vw = (const HVX_Vector *) w;
+    const HVX_Vector w0 = vw[0], w1 = vw[1], w2 = vw[2], w3 = vw[3];
+    const uint32_t RB = 128 * sizeof(float);
