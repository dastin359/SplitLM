+static const char * htptile_buft_get_name(ggml_backend_buffer_type_t) {
+    return "CPU_HTPTILE";
+}
+
+static ggml_backend_buffer_t htptile_buft_alloc_buffer(ggml_backend_buffer_type_t buft, size_t size) {
+    ggml_backend_buffer_t buffer = ggml_backend_buft_alloc_buffer(ggml_backend_cpu_buffer_type(), size > 0 ? size : 64);
+    if (!buffer) {
+        return nullptr;
+    }
+    buffer->buft              = buft;
+    buffer->iface.init_tensor = htptile_buffer_init_tensor;
+    buffer->iface.set_tensor  = htptile_buffer_set_tensor;
+    buffer->iface.get_tensor  = nullptr;
+    buffer->iface.cpy_tensor  = nullptr;
+    return buffer;
+}
+
+static size_t htptile_buft_get_alignment(ggml_backend_buffer_type_t) {
+    return 64;
+}
+
+// placeholder slot only; the real bytes live in the HTP0 model
+static size_t htptile_buft_get_alloc_size(ggml_backend_buffer_type_t, const struct ggml_tensor *) {
+    return 64;
+}
