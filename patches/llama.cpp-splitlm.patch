+// fp16-sigmoid SILU in place (dst may equal src): four 64-lane pairs per iteration, all loads before the stores so
+// the compiler can interleave the four independent chains (same math per element as hvx_silu_f32_hf_aa)
+static inline void ssm_conv_silu_hf_x4(uint8_t * dst, const uint8_t * src, uint32_t n) {
+    const struct hvx_silu_hf_consts cs = hvx_silu_hf_consts_init();
+    HVX_Vector *       vdst = (HVX_Vector *) dst;
+    const HVX_Vector * vsrc = (const HVX_Vector *) src;
+    const uint32_t     nq   = n / (8 * VLEN_FP32);
+    for (uint32_t i = 0; i < nq; i++) {
+        HVX_Vector x[8], y[8];
+        #pragma unroll
+        for (int j = 0; j < 8; j++) x[j] = vsrc[8 * i + j];
+        #pragma unroll
+        for (int j = 0; j < 4; j++) hvx_vec_silu2_f32_hf(x[2 * j], x[2 * j + 1], &y[2 * j], &y[2 * j + 1], &cs);
+        #pragma unroll
+        for (int j = 0; j < 8; j++) vdst[8 * i + j] = y[j];
+    }
+    const uint32_t done = nq * 8 * VLEN_FP32;
+    if (done < n) {
+        hvx_silu_f32_hf_aa(dst + done * sizeof(float), src + done * sizeof(float), n - done);
+    }
+}
