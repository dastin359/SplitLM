+// trilane r7: Q4_0 "row-quad" tile layout (GGML_HEXAGON_Q4_TL, default 1; 0 = the column-pair-major layout above).
+// Same bytes (q[row][2cp] | q[row][2cp+1] << 4), but each 128-byte group g holds column pairs 4g..4g+3 row by row:
+// byte g*128 + row*4 + c = column pair 4g + c of row. The DSP Q4_0 dequant then needs no byte shuffles, and the CPU's
+// 2-4-token i8mm kernel (CPU_HTPTILE) reads 4 rows x 4 column pairs per 16-byte load. IQ4_NL keeps the old layout.
+int htp_repack_q4_tl(void) {
+    static const int v = [] { const char * e = getenv("GGML_HEXAGON_Q4_TL"); return e ? atoi(e) : 1; }();
+    return v;
