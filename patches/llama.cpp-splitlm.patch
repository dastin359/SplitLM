 // GGML_OP_SSM_CONV + GGML_OP_ADD (channel-wise bias, optional) + GGML_OP_UNARY(SILU) (fused operation)
+// short-conv block of linear-attention layers: CONCAT(state, x^T) -> SSM_CONV (-> SILU) plus the CPY of the
+// last d_conv - 1 columns into the new state
+struct test_ssm_conv_block : public test_case {
+    const int64_t d_conv;
+    const int64_t d_inner;
+    const int64_t n_t;
+    const bool silu;
+    const bool cpy_first; // model order: the state CPY comes before the SSM_CONV
+
+    test_ssm_conv_block(int64_t d_conv, int64_t d_inner, int64_t n_t, bool silu, bool cpy_first)
+        : d_conv(d_conv), d_inner(d_inner), n_t(n_t), silu(silu), cpy_first(cpy_first) {}
+
+    std::string vars() override {
+        return VARS_TO_STR5(d_conv, d_inner, n_t, silu, cpy_first);
+    }
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "SSM_CONV_BLOCK";
+    }
+
+    bool run_whole_graph() override { return true; }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * state = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, d_conv - 1, d_inner);
+        ggml_tensor * x     = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, d_inner, n_t);
+        ggml_tensor * w     = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, d_conv, d_inner);
+        ggml_tensor * st    = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, (d_conv - 1) * d_inner);
+
+        ggml_tensor * conv_in = ggml_concat(ctx, state, ggml_transpose(ctx, x), 0);
+
+        ggml_tensor * last = ggml_view_2d(ctx, conv_in, d_conv - 1, d_inner, conv_in->nb[1], n_t * ggml_element_size(conv_in));
+        ggml_tensor * upd  = ggml_reshape_1d(ctx, ggml_cpy(ctx, last, st), (d_conv - 1) * d_inner);
+
+        ggml_tensor * y = ggml_ssm_conv(ctx, conv_in, w);
+        if (silu) {
+            y = ggml_silu(ctx, y);
+        }
+        y = ggml_reshape_1d(ctx, y, d_inner * n_t);
+
+        ggml_tensor * out = cpy_first ? ggml_concat(ctx, upd, y, 0) : ggml_concat(ctx, y, upd, 0);
+        ggml_set_name(out, "out");
+        return out;
+    }
+};
