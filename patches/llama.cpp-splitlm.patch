+static enum ggml_status shared_buffer_init_tensor(ggml_backend_buffer_t buffer, struct ggml_tensor * tensor) {
+    GGML_UNUSED(buffer);
+    if (tensor->view_src != nullptr) {
+        // a view of a borrowed weight (e.g. the row views of a pruned draft head): ggml_backend_view_init already
+        // pointed ->data into the parent's borrowed data; the layout (plain or repacked) is the parent's
+        tensor->extra = tensor->view_src->extra;
+        return GGML_STATUS_SUCCESS;
+    }
+    const ggml_tensor * src = g_shared_resolver ? g_shared_resolver(tensor->name, tensor, g_shared_resolver_user) : nullptr;
+    if (!src || !src->data || src->type != tensor->type || ggml_nbytes(src) != ggml_nbytes(tensor)) {
+        GGML_LOG_ERROR("%s: no shared CPU tensor for %s\n", __func__, tensor->name);
+        return GGML_STATUS_FAILED;
+    }
+    tensor->data  = src->data;
+    tensor->extra = src->extra;
+    return GGML_STATUS_SUCCESS;
+}
+
+static void shared_buffer_set_tensor(ggml_backend_buffer_t, struct ggml_tensor *, const void *, size_t, size_t) {
+    // the owner model already loaded (and possibly repacked) these weights
+}
+
+static const char * shared_buft_get_name(ggml_backend_buffer_type_t) {
+    return "CPU_SHARED";
+}
+
+static ggml_backend_buffer_t shared_buft_alloc_buffer(ggml_backend_buffer_type_t buft, size_t size) {
+    ggml_backend_buffer_t buffer = ggml_backend_buft_alloc_buffer(ggml_backend_cpu_buffer_type(), size > 0 ? size : 64);
+    if (!buffer) {
+        return nullptr;
+    }
+    buffer->buft              = buft;
+    buffer->iface.init_tensor = shared_buffer_init_tensor;
+    buffer->iface.set_tensor  = shared_buffer_set_tensor;
+    buffer->iface.get_tensor  = nullptr;
+    buffer->iface.cpy_tensor  = nullptr;
+    return buffer;
+}
+
+ggml_backend_buffer_type_t ggml_backend_cpu_shared_buffer_type(void) {
+    static struct ggml_backend_buffer_type buft = {
+        /* .iface    = */ {
+                           /* .get_name             = */ shared_buft_get_name,
+                           /* .alloc_buffer         = */ shared_buft_alloc_buffer,
+                           /* .alloc_buffer_n       = */ nullptr,
+                           /* .get_alignment        = */ htptile_buft_get_alignment,
+                           /* .get_max_size         = */ nullptr,
+                           /* .get_alloc_size       = */ htptile_buft_get_alloc_size,
+                           /* .get_alloc_size_n     = */ nullptr,
+                           /* .is_host              = */ nullptr,
+                           },
+        /* .device  = */ ggml_backend_reg_dev_get(ggml_backend_cpu_reg(), 0),
+        /* .context = */ new ggml::cpu::shared::extra_buffer_type(),
+    };
+    return &buft;
+}
+
+// ---- trilane dc2: fused single-token MoE on CPU_HTPTILE experts ----
+// Same fusion as the repacked-weight paths (repack.cpp moe_gate_up / moe_down, matched in ggml-cpu.c): gate+up+swiglu
+// in one op that also writes the down input as Q8_0 rows (+ block sums), then down + router weights + the ADD chain in
+// one op. Every value comes from the same kernels in the same order as the unfused tile path (band kernel, swiglu,
+// Q8_0 quantization of 32-element blocks, separately rounded MUL and ADD), so results are bit-identical.
+// Work items are 32-row bands, handed out GGML_HTPTILE_MOE_CHUNK (8) at a time without barriers (ggml_cpu_moe_claim).
+static int htptile_moe_pf() {
+    static const int v = getenv("GGML_HTPTILE_PF") ? atoi(getenv("GGML_HTPTILE_PF")) : 0;
+    return v;
+}
+static int htptile_moe_chunk() {
+    static const int v = std::max(1, getenv("GGML_HTPTILE_MOE_CHUNK") ? atoi(getenv("GGML_HTPTILE_MOE_CHUNK")) : 8);
+    return v;
+}
+
+extern "C" bool ggml_cpu_htptile_moe_supported(const struct ggml_tensor * mmid) {
+#if defined(__ARM_NEON) && defined(__ARM_FEATURE_DOTPROD)
+    static const bool on  = [] { const char * e = getenv("GGML_HTPTILE_MOE_FUSE"); return !(e && atoi(e) == 0); }();
+    static const bool dot = htptile_pick_kernel() == HTPTILE_DOT;
+    if (!on || !dot || mmid->op != GGML_OP_MUL_MAT_ID) {
+        return false;
+    }
+    const ggml_tensor * w = mmid->src[0];
+    return w->buffer && w->buffer->buft == ggml_backend_cpu_htptile_buffer_type() && htptile_shape_ok(w) && ggml_n_dims(w) == 3 &&
+           mmid->src[1]->type == GGML_TYPE_F32;
+#else
+    GGML_UNUSED(mmid);
+    return false;
+#endif
+}
+
+#if defined(__ARM_NEON) && defined(__ARM_FEATURE_DOTPROD)
+template <typename F>
+static void htptile_moe_items(const struct ggml_compute_params * params, int64_t n_items, F && f) {
+    const int ith = params->ith, nth = params->nth;
+    const int64_t ch = htptile_moe_chunk();
+    const int64_t n  = (n_items + ch - 1) / ch;
+    for (int64_t c = ith; c < n; ) {
+        const int64_t i1 = std::min(n_items, (c + 1) * ch);
+        for (int64_t it = c * ch; it < i1; it++) {
+            f(it);
+        }
+        c = (int64_t) nth + ggml_cpu_moe_claim(params->threadpool);
+    }
+    // total claims of all threads: one per chunk beyond the first nth, plus one failing claim per thread that ran one
+    ggml_cpu_moe_claim_end((int) (std::max<int64_t>(0, n - nth) + std::min<int64_t>(n, nth)));
+}
+
+static inline float htptile_moe_mul(float a, float b) { volatile float p = a * b; return p; }
+static inline float htptile_moe_add(float a, float b) { volatile float r = a + b; return r; }
+#endif
+
+extern "C" void ggml_cpu_htptile_moe_gate_up(const struct ggml_compute_params * params, const struct ggml_tensor * up,
+                                             const struct ggml_tensor * gate, struct ggml_tensor * glu, const struct ggml_tensor * down) {
+#if defined(__ARM_NEON) && defined(__ARM_FEATURE_DOTPROD)
+    const ggml_tensor * src1 = up->src[1];
+    const ggml_tensor * ids  = up->src[2];
+    const ggml_tensor * wu   = up->src[0];
+    const ggml_tensor * wg   = gate->src[0];
+    const int64_t K = wu->ne[0], N = wu->ne[1], n_as = wu->ne[2];
+    const int     n_ids   = (int) ids->ne[0];
+    const int     n_kt    = (int) (K / 32);
+    const int64_t n_bands = N / HT_ROWS;
+
+    char * wdata = (char *) params->wdata;
+    const size_t q8_row = ggml_row_size(GGML_TYPE_Q8_0, N);
+    GGML_ASSERT(params->wsize >= htptile_moe_q8_bytes(N, n_ids) + params->nth * htptile_moe_own_bytes(K));
+    char *    q8o = wdata;
+    int32_t * q8s = (int32_t *) (wdata + GGML_PAD((size_t) n_ids * q8_row, 64));
+    char *    own = wdata + htptile_moe_q8_bytes(N, n_ids) + params->ith * htptile_moe_own_bytes(K);
+    block_q8_0 * xq = (block_q8_0 *) own;
+    int32_t *    xs = (int32_t *) (own + GGML_PAD(ggml_row_size(GGML_TYPE_Q8_0, K), 64));
+    // every thread quantizes its own copy of the activation row: no barrier
+    quantize_row_q8_0((const float *) src1->data, xq, K);
+    const bool tl = htptile_tl();
+    if (tl) htptile_prep_x2(xq, xs, n_kt); else htptile_block_sums(xq, xs, n_kt);
+    auto band_fn = tl ? htptile_band_tl1 : htptile_band_neon;
+
+    htptile_moe_items(params, n_ids * n_bands, [&](int64_t it) {
+        const int64_t k = it / n_bands, band = it % n_bands;
+        const int32_t e = *(const int32_t *) ((const char *) ids->data + k * ids->nb[0]);
+        GGML_ASSERT(e >= 0 && e < n_as);
+        float g[HT_ROWS], u[HT_ROWS];
+        band_fn((const uint8_t *) wg->data + e * wg->nb[2] + band * HT_ROWS * wg->nb[1], xq, xs, n_kt, g, htptile_moe_pf());
+        band_fn((const uint8_t *) wu->data + e * wu->nb[2] + band * HT_ROWS * wu->nb[1], xq, xs, n_kt, u, htptile_moe_pf());
+        float * y = (float *) ((char *) glu->data + k * glu->nb[1]) + band * HT_ROWS;
+        ggml_vec_swiglu_f32(HT_ROWS, y, g, u);
+        if (down) {
+            block_q8_0 * b = (block_q8_0 *) (q8o + k * q8_row) + band;
+            quantize_row_q8_0(y, b, HT_ROWS);
+            if (tl) htptile_prep_x2(b, q8s + k * n_bands + band, 1); else htptile_block_sums(b, q8s + k * n_bands + band, 1);
+        }
+    });
+#else
+    GGML_UNUSED(params); GGML_UNUSED(up); GGML_UNUSED(gate); GGML_UNUSED(glu); GGML_UNUSED(down);
+    GGML_ABORT("htptile fused MoE needs dotprod");
+#endif
+}
+
+extern "C" void ggml_cpu_htptile_moe_down(const struct ggml_compute_params * params, const struct ggml_tensor * down,
+                                          const struct ggml_tensor * weights, struct ggml_tensor * out) {
+#if defined(__ARM_NEON) && defined(__ARM_FEATURE_DOTPROD)
+    const ggml_tensor * ids = down->src[2];
+    const ggml_tensor * wd  = down->src[0];
+    const int64_t K = wd->ne[0], N = wd->ne[1], n_as = wd->ne[2];
+    const int     n_ids   = (int) ids->ne[0];
+    const int     n_kt    = (int) (K / 32);
+    const int64_t n_bands = N / HT_ROWS;
+    const size_t  q8_row  = ggml_row_size(GGML_TYPE_Q8_0, K);
+    const char *    q8 = (const char *) params->wdata;
+    const int32_t * qs = (const int32_t *) ((const char *) params->wdata + GGML_PAD((size_t) n_ids * q8_row, 64));
+
+    int32_t e[64];
+    float   w[64];
+    GGML_ASSERT(n_ids <= 64);
+    for (int k = 0; k < n_ids; k++) {
+        e[k] = *(const int32_t *) ((const char *) ids->data + k * ids->nb[0]);
+        GGML_ASSERT(e[k] >= 0 && e[k] < n_as);
+        w[k] = *(const float *) ((const char *) weights->data + k * weights->nb[1]);
+    }
+    float * dst = (float *) out->data;
+    auto band_fn = htptile_tl() ? htptile_band_tl1 : htptile_band_neon;
+    htptile_moe_items(params, n_bands, [&](int64_t band) {
+        float acc[HT_ROWS], tmp[HT_ROWS];
+        for (int k = 0; k < n_ids; k++) {
+            band_fn((const uint8_t *) wd->data + e[k] * wd->nb[2] + band * HT_ROWS * wd->nb[1],
+                              (const block_q8_0 *) (q8 + k * q8_row), qs + k * n_kt, n_kt, k == 0 ? acc : tmp, htptile_moe_pf());
+            // unfused: MUL rounds each product, then ADD(ADD(ADD(p0, p1), p2), p3)
+            if (k == 0) {
+                for (int i = 0; i < HT_ROWS; i++) acc[i] = htptile_moe_mul(acc[i], w[0]);
+            } else {
+                for (int i = 0; i < HT_ROWS; i++) acc[i] = htptile_moe_add(acc[i], htptile_moe_mul(tmp[i], w[k]));
+            }
+        }
+        memcpy(dst + band * HT_ROWS, acc, sizeof(acc));
+    });
+#else
+    GGML_UNUSED(params); GGML_UNUSED(down); GGML_UNUSED(weights); GGML_UNUSED(out);
+    GGML_ABORT("htptile fused MoE needs dotprod");
+#endif
+}
