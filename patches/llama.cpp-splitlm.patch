+// MoE down projection (MUL_MAT_ID) whose output only feeds the expert reduce (MUL by the router weights + ADD chain,
+// optional residual ADD and the next RMS_NORM + MUL), as build_moe_ffn: backends may hand the expert outputs over in
+// a narrower type
+struct test_moe_down_reduce : public test_case {
+    const ggml_type type_a;
+    const int n_mats;
+    const int n_used;
+    const int64_t m;  // n_embd
+    const int64_t n;  // tokens
+    const int64_t k;  // n_ff
+    const int mode;   // 0 = reduce, 1 = + residual, 2 = + residual + rms_norm * w
+
+    std::string vars() override {
+        return VARS_TO_STR7(type_a, n_mats, n_used, m, n, k, mode);
+    }
+
+    double max_nmse_err() override {
+        return 5e-4;
+    }
+
+    test_moe_down_reduce(ggml_type type_a, int n_mats, int n_used, int64_t m, int64_t n, int64_t k, int mode)
+        : type_a(type_a), n_mats(n_mats), n_used(n_used), m(m), n(n), k(k), mode(mode) {}
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "MOE_DOWN_REDUCE";
+    }
+
+    bool run_whole_graph() override { return true; }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * as = ggml_new_tensor_3d(ctx, type_a, k, m, n_mats);
+        ggml_set_name(as, "as");
+        ggml_tensor * ids = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, n_mats, n);
+        ggml_set_name(ids, "ids");
+        if (n_used != n_mats) {
+            ids = ggml_view_2d(ctx, ids, n_used, n, ids->nb[1], 0);
+            ggml_set_name(ids, "view_of_ids");
+        }
+        ggml_tensor * b = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, k, n_used, n);
+        ggml_set_name(b, "b");
+        ggml_tensor * experts = ggml_mul_mat_id(ctx, as, b, ids);
+        ggml_set_name(experts, "experts");
+
+        ggml_tensor * weights = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 1, n_used, n);
+        ggml_set_name(weights, "weights");
+        ggml_tensor * weighted = ggml_mul(ctx, experts, weights);
+        ggml_set_name(weighted, "weighted_experts");
+
+        ggml_tensor * out = nullptr;
+        for (int e = 0; e < n_used; ++e) {
+            ggml_tensor * v = ggml_view_2d(ctx, weighted, m, n, weighted->nb[2], e * weighted->nb[1]);
+            out = out ? ggml_add(ctx, out, v) : v;
+        }
+        if (mode >= 1) {
+            ggml_tensor * r = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, m, n);
+            ggml_set_name(r, "resid");
+            out = ggml_add(ctx, out, r);
+            ggml_set_name(out, "moe_out");
+        }
+        if (mode >= 2) {
+            ggml_tensor * w = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, m);
+            ggml_set_name(w, "norm_w");
+            ggml_tensor * nrm = ggml_mul(ctx, ggml_rms_norm(ctx, out, 1e-5f), w);
+            ggml_set_name(nrm, "moe_norm");
+            out = ggml_add(ctx, out, nrm);  // both outputs are checked
+        }
+        return out;
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        init_mul_mat_id_tensors(ctx, n_mats);
+    }
+};
