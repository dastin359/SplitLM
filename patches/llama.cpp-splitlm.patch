+    if (!graph->use_counts || !graph->visited_hash_set.keys) return false;
+    const size_t h = ggml_hash_find(&graph->visited_hash_set, t);
+    if (h == GGML_HASHSET_FULL || !ggml_bitset_get(graph->visited_hash_set.used, h)) return false;
+    int32_t local = 0;
+    for (int j = 0; j < graph->n_nodes; j++) {
+        for (int s = 0; s < GGML_MAX_SRC; s++) {
+            if (graph->nodes[j]->src[s] == t) local++;
+        }
+    }
+    return local == graph->use_counts[h];
+}
+
+// ARGSORT (descending) whose only consumers are views of its first few columns, as ggml_argsort_top_k builds
+// for the MoE expert selection: returns how many leading columns are used (0 = the whole sort is needed)
+static int ggml_hexagon_argsort_used_cols(const ggml_cgraph * graph, int i) {
+    const ggml_tensor * as = graph->nodes[i];
+    if (as->op != GGML_OP_ARGSORT || (as->flags & GGML_TENSOR_FLAG_OUTPUT)) return 0;
+    if (ggml_get_op_params_i32(as, 0) != GGML_SORT_ORDER_DESC) return 0;
+    if (as->type != GGML_TYPE_I32 || as->nb[0] != sizeof(int32_t) || as->ne[2] != 1 || as->ne[3] != 1) return 0;
+    int64_t used = 0;
+    for (int j = i + 1; j < graph->n_nodes; j++) {
+        const ggml_tensor * n = graph->nodes[j];
+        for (int s = 0; s < GGML_MAX_SRC; s++) {
+            const ggml_tensor * t = n->src[s];
+            if (!t) continue;
+            if (t == as) {
+                if (ggml_op_is_empty(n->op) && n->view_src == as) continue;  // the view node itself
+                return 0;
+            }
+            if (t->view_src != as) continue;
+            if (ggml_op_is_empty(n->op) && n->view_src == as) continue;
+            if (!ggml_hexagon_uses_all_in_split(graph, t)) return 0;
+            const size_t off = (size_t) ((const uint8_t *) t->data - (const uint8_t *) as->data);
+            if (t->nb[0] != sizeof(int32_t) || t->nb[1] != as->nb[1] || t->ne[2] != 1 || t->ne[3] != 1 ||
+                (off % as->nb[1]) != 0 || (t->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+                return 0;
+            }
+            used = std::max(used, t->ne[0]);
+        }
+    }
+    if (used <= 0 || used >= as->ne[0] || !ggml_hexagon_uses_all_in_split(graph, as)) return 0;
+    return (int) used;
+}
+
+// MoE router weights after a top-k ARGSORT (build_moe_ffn with normalized weights):
+//   g = GET_ROWS(reshape(probs [E, T]) [1, E, T], view(argsort, k cols)) [1, k, T]
+//   s = SUM_ROWS(reshape(g) [k, T]); c = CLAMP(s); d = DIV(reshape(g) [k, T], c)
+// The top-k kernel gathers and normalizes the weights itself (d becomes its second output); g, s, c are skipped.
+struct ggml_hexagon_router_w {
+    int get_rows = -1, sum = -1, clamp = -1, div = -1;
+    const ggml_tensor * probs = nullptr; // [1, E, T] view the GET_ROWS reads
+};
+
+static bool ggml_hexagon_match_router_w(const ggml_cgraph * graph, int i, int k, ggml_hexagon_router_w & m) {
+    const ggml_tensor * as = graph->nodes[i];
+    const int64_t E = as->ne[0], T = as->ne[1];
+    // the non-empty nodes after the ARGSORT must be exactly GET_ROWS, SUM_ROWS, CLAMP, DIV
+    int idx[4] = { -1, -1, -1, -1 };
+    int n = 0;
+    for (int j = i + 1; j < graph->n_nodes && n < 4; j++) {
+        if (ggml_op_is_empty(graph->nodes[j]->op)) continue;
+        idx[n++] = j;
+    }
+    if (n < 4) return false;
+    const ggml_tensor * g = graph->nodes[idx[0]];
+    const ggml_tensor * s = graph->nodes[idx[1]];
+    const ggml_tensor * c = graph->nodes[idx[2]];
+    const ggml_tensor * d = graph->nodes[idx[3]];
+    if (g->op != GGML_OP_GET_ROWS || s->op != GGML_OP_SUM_ROWS || c->op != GGML_OP_CLAMP || d->op != GGML_OP_DIV) return false;
+
+    const ggml_tensor * pr  = g->src[0];
+    const ggml_tensor * ids = g->src[1];
+    if (!pr || !ids || pr->type != GGML_TYPE_F32 || g->type != GGML_TYPE_F32) return false;
+    if (ids->view_src != as || ids->data != as->data || ids->ne[0] != k || ids->ne[1] != T || ids->nb[1] != as->nb[1]) return false;
+    if (pr->ne[0] != 1 || pr->ne[1] != E || pr->ne[2] != T || pr->ne[3] != 1 || pr->nb[1] != sizeof(float) ||
+        pr->nb[2] < E * (int64_t) sizeof(float)) return false;
+    if (g->ne[0] != 1 || g->ne[1] != k || g->ne[2] != T || !ggml_is_contiguous(g)) return false;
+
+    // s and d read g through reshapes [k, T]; c clamps s; d divides by c
+    auto is_g = [&](const ggml_tensor * t) { return t && (t == g || (t->view_src == g && ggml_is_contiguous(t) && t->ne[0] == k && t->ne[1] == T)); };
+    if (!is_g(s->src[0]) || s->ne[0] != 1 || s->ne[1] != T || s->type != GGML_TYPE_F32) return false;
+    if (c->src[0] != s || c->type != GGML_TYPE_F32) return false;
+    if (!is_g(d->src[0]) || d->src[1] != c || d->type != GGML_TYPE_F32 || !ggml_is_contiguous(d) || d->ne[0] != k || d->ne[1] != T ||
+        d->ne[2] != 1 || d->ne[3] != 1) return false;
+
+    // g, s, c have no other users (also across splits)
+    for (const ggml_tensor * t : { g, s, c }) {
+        if (t->flags & GGML_TENSOR_FLAG_OUTPUT) return false;
+        if (!ggml_hexagon_uses_all_in_split(graph, t)) return false;
+    }
+    for (int j = i + 1; j < graph->n_nodes; j++) {
+        const ggml_tensor * nj = graph->nodes[j];
+        if (ggml_op_is_empty(nj->op)) continue;
+        for (int q = 0; q < GGML_MAX_SRC; q++) {
+            const ggml_tensor * t = nj->src[q];
+            if (!t) continue;
+            const ggml_tensor * b = t->view_src ? t->view_src : t;
+            if (b == g && j != idx[1] && j != idx[3]) return false;
+            if (b == s && j != idx[2]) return false;
+            if (b == c && j != idx[3]) return false;
+        }
+    }
+    for (int j = i + 1; j < graph->n_nodes; j++) {
+        const ggml_tensor * v = graph->nodes[j];
+        if (!ggml_op_is_empty(v->op) || !v->view_src) continue;
+        if ((v->view_src == g || v->view_src == s || v->view_src == c) && !ggml_hexagon_uses_all_in_split(graph, v)) return false;
+    }
+    // d is written at the ARGSORT, after the kernel has read all of its inputs (d may reuse their memory), but it
+    // must not alias the selected ids
+    if (ggml_hexagon_ranges_overlap(d, as)) return false;
+
+    m.get_rows = idx[0]; m.sum = idx[1]; m.clamp = idx[2]; m.div = idx[3];
+    m.probs = pr;
+    return true;
+}
+
+// Mirrors the DSP conditions of op_sort_common (argsort-ops.c) for the router weights: the block mode must be taken
+// (dr >= 8 rows per thread) and the two block slots of values + indices + probs plus the per-thread weight staging
+// must fit in VTCM. Otherwise the DSP would return NO_SUPPORT / VTCM_TOO_SMALL for the fused op.
+static bool ggml_hexagon_router_w_fits(const ggml_hexagon_session * sess, int64_t E, int64_t T, int k, int n_threads) {
+    if (n_threads <= 0 || k < 1 || k > 8) return false;
+    const size_t vtcm = sess->vtcm_size > 0 ? (size_t) sess->vtcm_size : (size_t) (8 * 1024 * 1024);
+    const uint32_t dr = (uint32_t) ((T + n_threads - 1) / n_threads);
+    if (dr < 8) return false;
+    uint32_t br = (uint32_t) (32768 / (2 * E * sizeof(float)));
+    const size_t per_row = 6 * (size_t) E * sizeof(float);
+    while (br > 1 && per_row * br * (size_t) n_threads > vtcm) br /= 2;
+    const uint32_t blk_rows = std::min(br, dr);
+    if (blk_rows <= 1) return false;
+    const size_t blk_slot = 3 * (size_t) blk_rows * E * sizeof(float);
+    const size_t wstage   = (((size_t) dr * k * sizeof(float)) + 127) & ~(size_t) 127;
+    return (2 * blk_slot + wstage) * (size_t) n_threads <= vtcm;
+}
+
+// MoE expert reduce (build_moe_ffn): weighted = MUL(experts [n, E, T], weights [1, E, T]); E views [n, T] of
+// weighted at expert offsets; out = ((v0 + v1) + v2) + ...; optionally out2 = ADD(residual, out). Runs as one
+// MOE_REDUCE op at the position of the MUL: everything in between must be the chain's own views and ADDs.
+struct ggml_hexagon_moe_reduce {
+    std::vector<int>    nodes;            // replaced nodes (ADDs)
+    int                 out   = -1;       // node producing the final result
+    const ggml_tensor * resid = nullptr;
+};
+
+static bool ggml_hexagon_match_moe_reduce(const ggml_cgraph * graph, int i, ggml_hexagon_moe_reduce & m) {
+    const ggml_tensor * mul = graph->nodes[i];
+    if (mul->op != GGML_OP_MUL || mul->type != GGML_TYPE_F32 || (mul->flags & GGML_TENSOR_FLAG_OUTPUT)) return false;
+    const ggml_tensor * x = mul->src[0];
+    const ggml_tensor * w = mul->src[1];
+    if (!x || !w || x->type != GGML_TYPE_F32 || w->type != GGML_TYPE_F32) return false;
+
+    const int64_t n = x->ne[0], E = x->ne[1], T = x->ne[2];
+    if (E < 2 || E > 16 || x->ne[3] != 1 || n < 32 || n % 32 != 0) return false;
+    if (w->ne[0] != 1 || w->ne[1] != E || w->ne[2] != T || w->ne[3] != 1) return false;
+    if (x->nb[0] != sizeof(float) || w->nb[0] != sizeof(float)) return false;
+    if (!ggml_are_same_shape(mul, x) || !ggml_is_contiguous(mul)) return false;
+
+    // the ADD chain over the views e = 0..E-1 of the product, with only those views in between
+    auto view_index = [&](const ggml_tensor * v) -> int {
+        if (!v || v->view_src != mul || !ggml_op_is_empty(v->op)) return -1;
+        if (v->ne[0] != n || v->ne[1] != T || v->ne[2] != 1 || v->ne[3] != 1) return -1;
+        if (v->nb[0] != sizeof(float) || v->nb[1] != mul->nb[2]) return -1;
+        const size_t off = (size_t) ((const uint8_t *) v->data - (const uint8_t *) mul->data);
+        if (off % mul->nb[1] != 0) return -1;
+        const int64_t e = (int64_t) (off / mul->nb[1]);
+        return e < E ? (int) e : -1;
+    };
+
+    m = {};
+    const ggml_tensor * acc = nullptr;
+    int n_terms = 0;
+    int j = i + 1;
+    for (; j < graph->n_nodes && n_terms < E; j++) {
+        const ggml_tensor * t = graph->nodes[j];
+        if (ggml_op_is_empty(t->op) && t->view_src == mul) {
+            if (view_index(t) < 0 || (t->flags & GGML_TENSOR_FLAG_OUTPUT)) return false;
+            continue;
+        }
+        if (t->op != GGML_OP_ADD || t->type != GGML_TYPE_F32 || (t->flags & GGML_TENSOR_FLAG_OUTPUT)) return false;
+        if (acc == nullptr) {
+            if (view_index(t->src[0]) != 0 || view_index(t->src[1]) != 1) return false;
+            n_terms = 2;
+        } else {
+            if (t->src[0] != acc || view_index(t->src[1]) != n_terms) return false;
+            n_terms++;
+        }
+        if (t->ne[0] != n || t->ne[1] != T || t->ne[2] != 1 || t->ne[3] != 1 || !ggml_is_contiguous_rows(t) ||
+            t->nb[0] != sizeof(float)) {
+            return false;
+        }
+        acc = t;
+        m.nodes.push_back(j);
+    }
+    if (n_terms != E || !acc) return false;
+    int last = j - 1;
+
+    // optional residual ADD shortly after the chain; the few nodes in between run after the fused op, so they
+    // must not touch its output or write its inputs
+    const ggml_tensor * out = acc;
+    std::vector<int> skipped;
+    for (int k = last + 1; k < graph->n_nodes && k <= last + 16 && skipped.size() <= 2; k++) {
+        const ggml_tensor * t = graph->nodes[k];
+        if (t->op == GGML_OP_ADD && t->type == GGML_TYPE_F32 && (t->src[0] == acc) != (t->src[1] == acc)) {
+            const ggml_tensor * r = t->src[0] == acc ? t->src[1] : t->src[0];
+            bool ok = r->type == GGML_TYPE_F32 && ggml_are_same_shape(r, acc) && r->nb[0] == sizeof(float) &&
+                      ggml_are_same_shape(t, acc) && t->nb[0] == sizeof(float) &&
+                      !(acc->flags & GGML_TENSOR_FLAG_OUTPUT) &&
+                      ggml_hexagon_tensor_used_only_by(graph, last + 1, acc, k);
+            for (int q : skipped) {
+                const ggml_tensor * u = graph->nodes[q];
+                if (!ok) break;
+                if (ggml_hexagon_ranges_overlap(u, t) || ggml_hexagon_ranges_overlap(u, x) ||
+                    ggml_hexagon_ranges_overlap(u, w) || ggml_hexagon_ranges_overlap(u, r)) {
+                    ok = false;
+                }
+                for (int si = 0; si < GGML_MAX_SRC && ok; si++) {
+                    if (u->src[si] && ggml_hexagon_ranges_overlap(u->src[si], t)) ok = false;
+                }
+            }
+            if (ok) {
+                m.resid = r;
+                m.nodes.push_back(k);
+                out = t;
+                last = k;
+            }
+            break;
+        }
+        if (ggml_op_is_empty(t->op)) continue;  // views, reshapes
+        if (t->op == GGML_OP_ADD) break;
+        skipped.push_back(k);
+    }
+
+    // intermediates: the product only feeds the chain (through its views), each partial sum only the next ADD
+    const ggml_tensor * fin = graph->nodes[last];
+    for (int k = i + 1; k < graph->n_nodes; k++) {
+        const ggml_tensor * t = graph->nodes[k];
+        const bool in_chain = std::find(m.nodes.begin(), m.nodes.end(), k) != m.nodes.end();
+        for (int s = 0; s < GGML_MAX_SRC; s++) {
+            const ggml_tensor * src = t->src[s];
+            if (!src) continue;
+            if ((src == mul || src->view_src == mul) && !in_chain && !(ggml_op_is_empty(t->op) && t->view_src == mul)) return false;
+            for (int q : m.nodes) {
+                const ggml_tensor * mid = graph->nodes[q];
+                if (mid == fin) continue;
+                if ((src == mid || src->view_src == mid) && !in_chain) return false;
+            }
+        }
+    }
+
+    // no consumer of the skipped intermediates in another scheduler split
+    if (!ggml_hexagon_uses_all_in_split(graph, mul)) return false;
+    for (int k = i + 1; k <= last; k++) {
+        const ggml_tensor * t = graph->nodes[k];
+        const bool is_mid = t != fin && std::find(m.nodes.begin(), m.nodes.end(), k) != m.nodes.end();
+        if ((is_mid || (ggml_op_is_empty(t->op) && t->view_src == mul)) && !ggml_hexagon_uses_all_in_split(graph, t)) {
+            return false;
+        }
+    }
+
+    // run at the MUL: the output must not overlap the inputs (except a residual updated in place)
+    if (ggml_hexagon_ranges_overlap(fin, x) || ggml_hexagon_ranges_overlap(fin, w)) return false;
+    if (m.resid && ggml_hexagon_ranges_overlap(fin, m.resid) &&
+        !(fin->data == m.resid->data && fin->nb[1] == m.resid->nb[1])) {
+        return false;
+    }
+    m.out = last;
+    return true;
+}
+
+// LFM2 short conv gates around a matched conv block (m.conv, m.cpy set, i = the CONCAT):
+//   x^T = TRANSPOSE(MUL(b, x)), CONCAT(state, x^T) -> the kernel reads b and x and multiplies them in VTCM
+//   y = MUL(c, SSM_CONV(...))                     -> the kernel multiplies by c before the store
+// Each gate is taken only when the intermediate (b * x, the conv output) has no other user, also across splits.
+static void ggml_hexagon_match_conv_gates(const ggml_cgraph * graph, int i, ggml_hexagon_conv_block & m) {
+    const ggml_tensor * cc   = graph->nodes[i];
+    const ggml_tensor * x    = cc->src[1];
+    const ggml_tensor * conv = graph->nodes[m.conv];
+    const int64_t       C    = conv->ne[0];
+    const int64_t       T    = conv->ne[1];
+
+    auto gate_src_ok = [&](const ggml_tensor * g) {
+        return g && g->type == GGML_TYPE_F32 && g->ne[0] == C && g->ne[1] == T && g->ne[2] == 1 && g->ne[3] == 1 &&
+               g->nb[0] == sizeof(float) && g->nb[1] >= C * (int64_t) sizeof(float);
+    };
+
+    if ((opt_conv_gate & 1) && x->op == GGML_OP_TRANSPOSE && x->src[0] && x->view_src == x->src[0]) {
+        const ggml_tensor * mb = x->src[0];
+        int mi = -1;
+        for (int j = i - 1; j >= 0; j--) {
+            if (graph->nodes[j] == mb) { mi = j; break; }
+        }
+        bool ok = mi >= 0 && mb->op == GGML_OP_MUL && mb->type == GGML_TYPE_F32 && ggml_is_contiguous(mb) &&
+                  mb->ne[0] == C && mb->ne[1] == T && mb->ne[2] == 1 && mb->ne[3] == 1 &&
+                  !(mb->flags & GGML_TENSOR_FLAG_OUTPUT) && !(x->flags & GGML_TENSOR_FLAG_OUTPUT) &&
+                  gate_src_ok(mb->src[0]) && gate_src_ok(mb->src[1]) &&
+                  ggml_hexagon_tensor_used_only_by(graph, mi, mb, i) &&
+                  ggml_hexagon_uses_all_in_split(graph, mb) && ggml_hexagon_uses_all_in_split(graph, x);
+        // b and x are read later, at the CONCAT: nothing in between may write them
+        for (int j = mi + 1; ok && j < i; j++) {
+            const ggml_tensor * n = graph->nodes[j];
+            if (ggml_op_is_empty(n->op)) continue;
+            if (ggml_hexagon_ranges_overlap(n, mb->src[0]) || ggml_hexagon_ranges_overlap(n, mb->src[1])) ok = false;
+        }
+        if (ok) {
+            m.mul_b = mi;
+            m.gb    = mb->src[0];
+            m.gx    = mb->src[1];
+        }
+    }
+
+    if ((opt_conv_gate & 2) && m.silu < 0 && !(conv->flags & GGML_TENSOR_FLAG_OUTPUT) &&
+        ggml_hexagon_uses_all_in_split(graph, conv)) {
+        int k = -1;
+        for (int j = m.conv + 1; j < graph->n_nodes && k != -2; j++) {
+            const ggml_tensor * n = graph->nodes[j];
+            for (int s = 0; s < GGML_MAX_SRC; s++) {
+                if (n->src[s] && (n->src[s] == conv || n->src[s]->view_src == conv)) {
+                    if (k == -1) k = j; else if (k != j) k = -2;
+                }
+            }
+        }
+        if (k > 0) {
+            const ggml_tensor * mc = graph->nodes[k];
+            const ggml_tensor * gc = mc->src[0] == conv ? mc->src[1] : (mc->src[1] == conv ? mc->src[0] : nullptr);
+            bool ok = mc->op == GGML_OP_MUL && mc->type == GGML_TYPE_F32 && ggml_is_contiguous(mc) &&
+                      !(mc->flags & GGML_TENSOR_FLAG_OUTPUT) && ggml_are_same_shape(mc, conv) && gc != conv &&
+                      gate_src_ok(gc) && ggml_hexagon_tensor_used_only_by(graph, m.conv, conv, k);
+            // c is read at the CONCAT: nothing up to the MUL may write it
+            for (int j = i + 1; ok && j < k; j++) {
+                const ggml_tensor * n = graph->nodes[j];
+                if (j == m.conv || j == m.cpy || ggml_op_is_empty(n->op)) continue;
+                if (ggml_hexagon_ranges_overlap(n, gc)) ok = false;
+            }
+            if (ok) {
+                m.mul_c = k;
+                m.gc    = gc;
+            }
+        }
+    }
+}
+
+static bool ggml_hexagon_match_conv_block(const ggml_cgraph * graph, int i, ggml_hexagon_conv_block & m) {
+    const ggml_tensor * cc = graph->nodes[i];
+    if (cc->op != GGML_OP_CONCAT || ggml_get_op_params_i32(cc, 0) != 0 || cc->type != GGML_TYPE_F32) return false;
+    if (cc->flags & GGML_TENSOR_FLAG_OUTPUT) return false;
+
+    const ggml_tensor * st = cc->src[0];
+    const ggml_tensor * x  = cc->src[1];
+    if (!st || !x || st->type != GGML_TYPE_F32 || x->type != GGML_TYPE_F32) return false;
+
+    const int64_t K1 = st->ne[0];
+    const int64_t C  = st->ne[1];
+    const int64_t T  = x->ne[0];
+    if (K1 < 1 || C % 32 != 0 || T < 32) return false;
+    if (st->ne[2] != 1 || st->ne[3] != 1 || x->ne[1] != C || x->ne[2] != 1 || x->ne[3] != 1) return false;
+    if (st->nb[0] != sizeof(float) || st->nb[1] != K1 * sizeof(float)) return false;
+    if (x->nb[1] != sizeof(float) || x->nb[0] < C * sizeof(float) || x->nb[0] % sizeof(float) != 0) return false;
+
+    // consumers: one SSM_CONV of the whole concat and at most one CPY of its last K-1 columns
+    m = {};
+    for (int j = i + 1; j < graph->n_nodes; j++) {
+        const ggml_tensor * n = graph->nodes[j];
+        for (int s = 0; s < GGML_MAX_SRC; s++) {
+            const ggml_tensor * src = n->src[s];
+            if (!src || (src != cc && src->view_src != cc)) continue;
+
+            if (n->op == GGML_OP_SSM_CONV && s == 0 && src == cc && m.conv < 0) {
+                m.conv = j;
+            } else if (n->op == GGML_OP_CPY && s == 0 && src->view_src == cc && m.cpy < 0 &&
+                       src->ne[0] == K1 && src->ne[1] == C && src->ne[2] == 1 && src->ne[3] == 1 &&
+                       src->nb[0] == sizeof(float) && src->nb[1] == cc->nb[1] &&
+                       (const uint8_t *) src->data == (const uint8_t *) cc->data + T * sizeof(float) &&
+                       n->type == GGML_TYPE_F32 && ggml_is_contiguous(n) && ggml_nelements(n) == K1 * C) {
+                m.cpy = j;
+            } else if (ggml_op_is_empty(n->op) && n->view_src == cc) {
+                // a view of the concat, its consumers are checked through view_src
+            } else {
+                return false;
+            }
+        }
+    }
+    if (m.conv < 0 || m.cpy < 0) return false;
+
+    const ggml_tensor * conv = graph->nodes[m.conv];
+    const ggml_tensor * w    = conv->src[1];
+    if (w->type != GGML_TYPE_F32 || w->ne[0] != K1 + 1 || w->ne[1] != C || w->nb[1] != w->ne[0] * sizeof(float)) return false;
+    if (conv->type != GGML_TYPE_F32 || conv->ne[0] != C || conv->ne[1] != T || conv->ne[2] != 1 || !ggml_is_contiguous(conv)) return false;
+
+    if (opt_conv_block_silu && m.conv + 1 < graph->n_nodes) {
+        const ggml_tensor * n = graph->nodes[m.conv + 1];
+        if (n->op == GGML_OP_UNARY && ggml_get_unary_op(n) == GGML_UNARY_OP_SILU && n->src[0] == conv &&
+            n->type == GGML_TYPE_F32 && ggml_is_contiguous(n) && ggml_are_same_shape(n, conv) &&
+            ggml_hexagon_tensor_used_only_by(graph, m.conv + 1, conv, m.conv + 1)) {
+            m.silu = m.conv + 1;
+        }
+    }
+
+    if (opt_conv_gate) {
+        ggml_hexagon_match_conv_gates(graph, i, m);
+    }
+
+    // everything runs at the position of the CONCAT: the outputs must not touch memory that nodes up to
+    // the last replaced node still use, and must not partially overlap the inputs (x may be reused in place)
+    const ggml_tensor * out  = graph->nodes[m.mul_c >= 0 ? m.mul_c : (m.silu >= 0 ? m.silu : m.conv)];
+    const ggml_tensor * nst  = m.cpy >= 0 ? graph->nodes[m.cpy] : nullptr;
+    const int           last = std::max({ m.conv, m.silu, m.cpy, m.mul_c });
+
+    if (ggml_hexagon_ranges_overlap(out, st) || ggml_hexagon_ranges_overlap(out, w)) return false;
+    if (m.mul_b >= 0) {
+        // x is read from b and x (the MUL output behind the transposed view is never built)
+        for (const ggml_tensor * g : { m.gb, m.gx }) {
+            if (ggml_hexagon_ranges_overlap(out, g) || (nst && ggml_hexagon_ranges_overlap(nst, g))) return false;
+        }
+    } else {
+        if (ggml_hexagon_ranges_overlap(out, x) && (out->data != x->data || x->nb[0] != out->nb[1])) return false;
+        if (nst && ggml_hexagon_ranges_overlap(nst, x)) return false;
+    }
+    if (m.gc && (ggml_hexagon_ranges_overlap(out, m.gc) || (nst && ggml_hexagon_ranges_overlap(nst, m.gc)))) return false;
+    if (nst && (ggml_hexagon_ranges_overlap(nst, out) || ggml_hexagon_ranges_overlap(nst, w))) return false;
+    if (nst && ggml_hexagon_ranges_overlap(nst, st) && nst->data != st->data) return false;
+
+    for (int j = i + 1; j <= last; j++) {
+        if (j == m.conv || j == m.silu || j == m.cpy || j == m.mul_c) continue;
+        const ggml_tensor * n = graph->nodes[j];
+        if (n == w || n == w->view_src) return false;
+        if (ggml_op_is_empty(n->op)) continue;
+        for (const ggml_tensor * o : { out, nst }) {
+            if (!o) continue;
+            if (ggml_hexagon_ranges_overlap(o, n)) return false;
+            for (int s = 0; s < GGML_MAX_SRC; s++) {
+                if (ggml_hexagon_ranges_overlap(o, n->src[s])) return false;
+            }
+        }
+    }
+    return true;
+}
+
+// GATED_DELTA_NET (HMX chunked kernel) with its Qwen3.5 neighbours:
+//   q = SCALE(RMS_NORM(q_raw)), k = SCALE(RMS_NORM(k_raw))            -> IN_NORM (normalized per chunk in VTCM)
+//   CPY(view(gdn, state tail), cache)                                  -> state written to the cache
+//   out = MUL(MUL(RMS_NORM(view(gdn, attn)), w), SILU(z))              -> OUT_NORM (gated norm before the output DMA)
+// All of it runs at the position of the GATED_DELTA_NET node.
+struct ggml_hexagon_gdn_fuse {
+    int   fuse = 0;          // HTP_GDN_FUSE_*
+    const ggml_tensor * q_raw = nullptr;
+    const ggml_tensor * k_raw = nullptr;
+    const ggml_tensor * w     = nullptr;
+    const ggml_tensor * z     = nullptr;
+    float in_eps = 0.f, in_scale = 0.f, out_eps = 0.f;
+    int   cpy = -1, rms = -1, mul_w = -1, silu = -1, mul_z = -1;
+    int   in_nodes[4] = { -1, -1, -1, -1 }; // q rms, q scale, k rms, k scale
+    bool  gb_overlap  = false;              // the gated-norm output reuses g / beta memory (needs HTP_GDN_PIPE_GB_VTCM)
+};
+
+static bool ggml_hexagon_used_only_by_nodes(const ggml_cgraph * graph, const ggml_tensor * t, std::initializer_list<const ggml_tensor *> users) {
+    if (t->flags & GGML_TENSOR_FLAG_OUTPUT) return false;
+    for (int j = 0; j < graph->n_nodes; j++) {
+        const ggml_tensor * n = graph->nodes[j];
+        if (ggml_op_is_empty(n->op)) continue;
+        for (int s = 0; s < GGML_MAX_SRC; s++) {
+            const ggml_tensor * src = n->src[s];
+            if (!src) continue;
+            if (src == t || src->view_src == t) {
+                bool ok = false;
+                for (const ggml_tensor * u : users) ok = ok || (u == n);
+                if (!ok) return false;
+            }
+        }
+    }
+    return true;
+}
+
+// q or k input of the GDN: SCALE(RMS_NORM(raw)) with raw rows contiguous
+static bool ggml_hexagon_match_gdn_l2(const ggml_cgraph * graph, const ggml_tensor * gdn, const ggml_tensor * sc,
+                                      const ggml_tensor *& raw, float & eps, float & scale) {
+    if (!sc || sc->op != GGML_OP_SCALE || sc->type != GGML_TYPE_F32) return false;
+    float bias = 0.f;
+    memcpy(&scale, (const float *) sc->op_params + 0, sizeof(float));
+    memcpy(&bias,  (const float *) sc->op_params + 1, sizeof(float));
+    if (bias != 0.f) return false;
+    const ggml_tensor * rn = sc->src[0];
+    if (!rn || rn->op != GGML_OP_RMS_NORM || rn->type != GGML_TYPE_F32) return false;
+    memcpy(&eps, rn->op_params, sizeof(float));
+    raw = rn->src[0];
+    if (!raw || raw->type != GGML_TYPE_F32 || !ggml_are_same_shape(raw, sc) || raw->nb[0] != sizeof(float)) return false;
+    if (!ggml_is_contiguous(rn) || !ggml_is_contiguous(sc)) return false;
+    return ggml_hexagon_used_only_by_nodes(graph, rn, { sc }) && ggml_hexagon_used_only_by_nodes(graph, sc, { gdn });
+}
+
+static void ggml_hexagon_gdn_dbg(const char * fmt, ...) {
+    static int n_msgs = 0;
+    if (!opt_gdn_fuse_dbg || n_msgs >= 64) return;
+    n_msgs++;
+    char buf[512];
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(buf, sizeof(buf), fmt, ap);
+    va_end(ap);
+    GGML_LOG_INFO("ggml-hex: gdn-fuse: %s\n", buf);
+}
+
+static bool ggml_hexagon_match_gdn_fuse(const ggml_cgraph * graph, int i, const std::unordered_map<const ggml_tensor *, int> & idx,
+                                        ggml_hexagon_gdn_fuse & m) {
+    const ggml_tensor * gdn = graph->nodes[i];
+    m = {};
+    if (opt_gdn_fuse <= 0 || gdn->op != GGML_OP_GATED_DELTA_NET || gdn->type != GGML_TYPE_F32) return false;
+    if (gdn->flags & GGML_TENSOR_FLAG_OUTPUT) return false;
+
+    const ggml_tensor * v = gdn->src[2];
+    const int64_t S_v = v->ne[0], H = v->ne[1], T = v->ne[2], n_seqs = v->ne[3];
+    const int64_t K   = ggml_get_op_params_i32(gdn, 0);
+    if (K != 1 || S_v % 32 != 0) return false;
+
+    auto index_of = [&](const ggml_tensor * t) { auto it = idx.find(t); return it == idx.end() ? -1 : it->second; };
+
+    // the state CPY (same rules as the GATED_DELTA_NET+CPY fusion) and the norm of the attention rows
+    const size_t tail_off = (size_t) S_v * H * T * n_seqs * sizeof(float);
+    const ggml_tensor * attn = nullptr; // view of the attention rows
+    for (int j = i + 1; j < graph->n_nodes; j++) {
+        const ggml_tensor * n = graph->nodes[j];
+        if (ggml_op_is_empty(n->op)) continue;
+        for (int s = 0; s < GGML_MAX_SRC; s++) {
+            const ggml_tensor * src = n->src[s];
+            if (!src || (src != gdn && src->view_src != gdn)) continue;
+            if (n->op == GGML_OP_CPY && s == 0 && m.cpy < 0 && src->op == GGML_OP_VIEW && src->view_offs == tail_off &&
+                ggml_is_contiguous(src) && n->type == GGML_TYPE_F32 && n->src[1] && n->src[1]->ne[0] == S_v * S_v * H &&
+                n->src[1]->ne[1] == n_seqs && n->src[1]->nb[0] == sizeof(float) &&
+                (n_seqs == 1 || n->src[1]->nb[1] == (size_t) S_v * S_v * H * sizeof(float)) && !(n->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+                m.cpy = j;
+            } else if (n->op == GGML_OP_RMS_NORM && s == 0 && m.rms < 0 && src->view_src == gdn && src->view_offs == 0 &&
+                       src->ne[0] == S_v && src->ne[1] == H && src->ne[2] == T && src->ne[3] == n_seqs && ggml_is_contiguous(src)) {
+                m.rms = j;
+                attn  = src;
+            } else {
+                return false;
+            }
+        }
+    }
+    if (m.cpy < 0) return false;
+
+    if ((opt_gdn_fuse & HTP_GDN_FUSE_OUT_NORM) && m.rms >= 0) {
+        const ggml_tensor * rn = graph->nodes[m.rms];
+        const ggml_tensor * mw = nullptr, * sl = nullptr, * mz = nullptr;
+        for (int j = m.rms + 1; j < graph->n_nodes && !mw; j++) {
+            const ggml_tensor * n = graph->nodes[j];
+            if (n->op == GGML_OP_MUL && (n->src[0] == rn || n->src[1] == rn)) mw = n;
+        }
+        if (mw) {
+            const ggml_tensor * w = mw->src[0] == rn ? mw->src[1] : mw->src[0];
+            for (int j = index_of(mw) + 1; j < graph->n_nodes && !mz; j++) {
+                const ggml_tensor * n = graph->nodes[j];
+                if (n->op == GGML_OP_MUL && (n->src[0] == mw || n->src[1] == mw)) mz = n;
+            }
+            if (mz) {
+                sl = mz->src[0] == mw ? mz->src[1] : mz->src[0];
+            }
+            const ggml_tensor * z = sl ? sl->src[0] : nullptr;
+            ggml_hexagon_gdn_dbg("%s: rms %d mul_w %d mul_z %d silu %d z %s w %s | sl_ok %d z_shape %d mz_shape %d mz_contig %d mw_shape %d idx_sl %d idx_mz %d used rn %d mw %d sl %d",
+                gdn->name, m.rms, index_of(mw), mz ? index_of(mz) : -1, sl ? index_of(sl) : -1, z ? z->name : "-", w ? w->name : "-",
+                sl && sl->op == GGML_OP_UNARY && ggml_get_unary_op(sl) == GGML_UNARY_OP_SILU,
+                z && ggml_are_same_shape(z, attn), mz && ggml_are_same_shape(mz, attn), mz && ggml_is_contiguous(mz),
+                ggml_are_same_shape(mw, attn), sl ? index_of(sl) : -1, mz ? index_of(mz) : -1,
+                ggml_hexagon_used_only_by_nodes(graph, rn, { mw }), mz ? ggml_hexagon_used_only_by_nodes(graph, mw, { mz }) : -1,
+                (sl && mz) ? ggml_hexagon_used_only_by_nodes(graph, sl, { mz }) : -1);
+            const bool ok =
+                w && w->type == GGML_TYPE_F32 && w->ne[0] == S_v && ggml_nelements(w) == S_v && ggml_is_contiguous(w) &&
+                sl && sl->op == GGML_OP_UNARY && ggml_get_unary_op(sl) == GGML_UNARY_OP_SILU && sl->type == GGML_TYPE_F32 &&
+                z && z->type == GGML_TYPE_F32 && ggml_are_same_shape(z, attn) && z->nb[0] == sizeof(float) &&
+                mz->type == GGML_TYPE_F32 && ggml_are_same_shape(mz, attn) && ggml_is_contiguous(mz) &&
+                rn->type == GGML_TYPE_F32 && mw->type == GGML_TYPE_F32 && ggml_are_same_shape(mw, attn) &&
+                !(mz->flags & GGML_TENSOR_FLAG_OUTPUT) &&
+                index_of(sl) > i && index_of(mz) > i &&
+                ggml_hexagon_used_only_by_nodes(graph, rn, { mw }) &&
+                ggml_hexagon_used_only_by_nodes(graph, mw, { mz }) &&
+                ggml_hexagon_used_only_by_nodes(graph, sl, { mz });
+            if (ok) {
+                m.mul_w = index_of(mw);
+                m.silu  = index_of(sl);
+                m.mul_z = index_of(mz);
+                m.w     = w;
+                m.z     = z;
+                memcpy(&m.out_eps, rn->op_params, sizeof(float));
+                m.fuse |= HTP_GDN_FUSE_OUT_NORM;
+            }
+        }
+    }
+
+    if (opt_gdn_fuse & HTP_GDN_FUSE_IN_NORM) {
+        const ggml_tensor * qr = nullptr, * kr = nullptr;
+        float qe = 0, qs = 0, ke = 0, ks = 0;
+        if (ggml_hexagon_match_gdn_l2(graph, gdn, gdn->src[0], qr, qe, qs) &&
+            ggml_hexagon_match_gdn_l2(graph, gdn, gdn->src[1], kr, ke, ks) && qe == ke && qs == ks &&
+            index_of(gdn->src[0]) >= 0 && index_of(gdn->src[1]) >= 0 &&
+            index_of(gdn->src[0]->src[0]) >= 0 && index_of(gdn->src[1]->src[0]) >= 0) {
+            m.q_raw       = qr;
+            m.k_raw       = kr;
+            m.in_eps      = qe;
+            m.in_scale    = qs;
+            m.in_nodes[0] = index_of(gdn->src[0]->src[0]);
+            m.in_nodes[1] = index_of(gdn->src[0]);
+            m.in_nodes[2] = index_of(gdn->src[1]->src[0]);
+            m.in_nodes[3] = index_of(gdn->src[1]);
+            m.fuse |= HTP_GDN_FUSE_IN_NORM;
+        }
+    }
+
+    // hazards: everything now runs at position i. The fused output must not overlap any input of the op or of
+    // the nodes between the first and last absorbed node; the raw q/k must not be written between their norm
+    // and i; z must not be written between i and the gated mul.
+    // g / beta (and the nodes producing them, whose only consumer is the GDN) may share memory with the
+    // gated-norm output when the kernel copies them to VTCM before writing anything (decided by the caller)
+    auto is_gb = [&](const ggml_tensor * t) {
+        if (!t) return false;
+        for (int s = 3; s <= 4; s++) {
+            const ggml_tensor * x = gdn->src[s];
+            if (t == x || (x->view_src && t == x->view_src)) {
+                const ggml_tensor * base = x->view_src ? x->view_src : x;
+                return t == x || ggml_hexagon_used_only_by_nodes(graph, base, { gdn });
+            }
+        }
+        return false;
+    };
+    auto hazards_ok = [&]() {
+        const ggml_tensor * out = (m.fuse & HTP_GDN_FUSE_OUT_NORM) ? graph->nodes[m.mul_z] : nullptr;
+        m.gb_overlap = false;
+        int first = i, last = m.cpy;
+        if (m.fuse & HTP_GDN_FUSE_IN_NORM) first = std::min({ m.in_nodes[0], m.in_nodes[2] });
+        if (out) last = std::max(last, m.mul_z);
+        auto absorbed = [&](int j) {
+            if (j == i || j == m.cpy) return true;
+            if (out && (j == m.rms || j == m.mul_w || j == m.silu || j == m.mul_z)) return true;
+            if (m.fuse & HTP_GDN_FUSE_IN_NORM) {
+                for (int k = 0; k < 4; k++) if (j == m.in_nodes[k]) return true;
+            }
+            return false;
+        };
+        if (out) {
+            const ggml_tensor * ins[] = { m.q_raw ? m.q_raw : gdn->src[0], m.k_raw ? m.k_raw : gdn->src[1], gdn->src[2],
+                                          gdn->src[3], gdn->src[4], gdn->src[5], graph->nodes[m.cpy]->src[1], m.w };
+            for (const ggml_tensor * t : ins) {
+                if (ggml_hexagon_ranges_overlap(out, t) && is_gb(t)) { m.gb_overlap = true; continue; }
+                if (ggml_hexagon_ranges_overlap(out, t)) { ggml_hexagon_gdn_dbg("%s: out %s overlaps input %s", gdn->name, out->name, t ? t->name : "-"); return false; }
+            }
+            // z may be updated in place (same rows), nothing else
+            if (ggml_hexagon_ranges_overlap(out, m.z) &&
+                (out->data != m.z->data || out->nb[1] != m.z->nb[1] || out->nb[2] != m.z->nb[2] || out->nb[3] != m.z->nb[3])) {
+                ggml_hexagon_gdn_dbg("%s: out %s partially overlaps z %s", gdn->name, out->name, m.z->name);
+                return false;
+            }
+        }
+        for (int j = first; j <= last; j++) {
+            if (absorbed(j)) continue;
+            const ggml_tensor * n = graph->nodes[j];
+            if (ggml_op_is_empty(n->op)) continue;
+            // nodes before i have run when the fused op writes out: their tensors can share memory with out
+            // only if they are dead by then (ggml-alloc never overlaps buffers that are alive at the same time,
+            // and out is alive from its original slot on); the fused op's own inputs are checked above
+            if (out && j > i) {
+                if (ggml_hexagon_ranges_overlap(out, n) && is_gb(n)) { m.gb_overlap = true; }
+                else if (ggml_hexagon_ranges_overlap(out, n)) { ggml_hexagon_gdn_dbg("%s: out %s overlaps node %d %s %s (range %d..%d)", gdn->name, out->name, j, ggml_op_desc(n), n->name, first, last); return false; }
+                for (int s = 0; s < GGML_MAX_SRC; s++) {
+                    if (ggml_hexagon_ranges_overlap(out, n->src[s]) && is_gb(n->src[s])) { m.gb_overlap = true; continue; }
+                    if (ggml_hexagon_ranges_overlap(out, n->src[s])) { ggml_hexagon_gdn_dbg("%s: out %s overlaps src of node %d %s %s", gdn->name, out->name, j, ggml_op_desc(n), n->name); return false; }
+                }
+                if (j > i && ggml_hexagon_ranges_overlap(n, m.z)) { ggml_hexagon_gdn_dbg("%s: node %d %s writes z", gdn->name, j, n->name); return false; }
+            }
+            if (j < i && (m.fuse & HTP_GDN_FUSE_IN_NORM)) {
+                if (ggml_hexagon_ranges_overlap(n, m.q_raw) || ggml_hexagon_ranges_overlap(n, m.k_raw)) return false;
+            }
+        }
+        return true;
+    };
+
+    // the gated output norm needs z before the GDN runs; in llama.cpp's Qwen3.5 graph the z projection is
+    // scheduled after the GDN, so that part usually fails here: keep the q/k norm absorption on its own
+    if ((m.fuse & HTP_GDN_FUSE_OUT_NORM) && !hazards_ok()) {
+        m.fuse &= ~HTP_GDN_FUSE_OUT_NORM;
+        m.rms = m.mul_w = m.silu = m.mul_z = -1;
+        m.w = m.z = nullptr;
+    }
+    if ((m.fuse & HTP_GDN_FUSE_IN_NORM) && !hazards_ok()) {
+        m.fuse &= ~HTP_GDN_FUSE_IN_NORM;
+    }
+    return m.fuse != 0;
+}
+
+static bool ggml_hexagon_precompute_ssm_conv_tc_params(const struct ggml_hexagon_session * sess, uint32_t d_conv,
+                                                      uint32_t d_inner, uint32_t n_t, bool silu, bool state_out,
+                                                      struct htp_ssm_conv_kernel_params * kparams, uint32_t mul = 0) {
+    memset(kparams, 0, sizeof(*kparams));
+
+    const uint32_t n_threads = (std::min)((uint32_t) sess->n_threads, d_inner / 32);
+    if (n_threads == 0) return false;
+
+    // channel block cb (DMA rows of cb floats) x time tiles of tt tokens: wide DMA rows matter more than
+    // long tiles (the K - 1 rows in front of a tile are copied from the previous one), so keep cb at 128
+    // and shorten the tile when the whole sequence does not fit
+    uint32_t cb = 0, tt = 0;
+    struct htp_ssm_conv_tc_layout L;
+    // gated blocks (LFM2, DMA bound: 3 input streams of [t][cb] rows) run best with the widest rows (512 channels: 2.3 vs
+    // 3.3 ms per 4096-token layer at 128); the plain block (Qwen3.5, compute bound by its SILU) keeps 128
+    const uint32_t cb_gate = (std::min)(512u, (std::max)(128u, ((d_inner + n_threads - 1) / n_threads + 31) / 32 * 32));
+    const uint32_t cb_req  = opt_conv_cb > 0 ? (uint32_t) opt_conv_cb : (mul ? cb_gate : 128u);
+    const uint32_t tt_req = opt_conv_tt > 0 ? (uint32_t) opt_conv_tt : n_t;
+    for (uint32_t c : { cb_req, 128u, 96u, 64u, 32u }) {
+        if (c % 32 != 0 || c > 512) continue;
+        for (uint32_t t = std::min(tt_req, n_t); t >= 16; t = (t + 1) / 2) {
+            htp_ssm_conv_tc_layout_build(&L, d_conv, t, c, mul);
+            if ((size_t) L.total * n_threads <= sess->vtcm_size) {
+                cb = c;
+                tt = t;
+                break;
+            }
+            if (t == 16) break;
+        }
+        if (cb) break;
+    }
+    if (cb == 0) return false;
+
+    kparams->n_threads    = n_threads;
+    kparams->d_conv       = d_conv;
+    kparams->d_inner      = d_inner;
+    kparams->n_t          = n_t;
