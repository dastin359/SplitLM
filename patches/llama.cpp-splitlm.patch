+    const HVX_Vector d_q = Q6_Vqf32_vadd_Vqf32Vsf(Q6_Vqf32_vsub_Vqf32Vqf32(v1, v2), a);
+    const HVX_Vector d   = Q6_Vsf_equals_Vqf32(d_q);
+
+    const HVX_Vector r0 = Q6_Vw_vsub_VwVw(c->rcp_seed, d);
+    const HVX_Vector e1 = Q6_Vsf_equals_Vqf32(Q6_Vqf32_vsub_Vqf32Vqf32(c->two, Q6_Vqf32_vmpy_VsfVsf(r0, d)));
