+// LFM2 short conv: bcx = in_proj output [3 C, T], y = c * SSM_CONV(CONCAT(state, (b * x)^T), w) + state update
+struct test_ssm_conv_gated : public test_case {
+    const int64_t d_conv;
+    const int64_t d_inner;
+    const int64_t n_t;
+
+    test_ssm_conv_gated(int64_t d_conv, int64_t d_inner, int64_t n_t)
+        : d_conv(d_conv), d_inner(d_inner), n_t(n_t) {}
+
+    std::string vars() override {
+        return VARS_TO_STR3(d_conv, d_inner, n_t);
+    }
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "SSM_CONV_GATED";
+    }
+
+    bool run_whole_graph() override { return true; }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * bcx   = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 3 * d_inner, n_t);
+        ggml_tensor * state = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, d_conv - 1, d_inner);
+        ggml_tensor * w     = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, d_conv, d_inner);
+        ggml_tensor * st    = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, (d_conv - 1) * d_inner);
+
+        const size_t es = ggml_element_size(bcx);
+        ggml_tensor * b = ggml_view_2d(ctx, bcx, d_inner, n_t, bcx->nb[1], 0 * d_inner * es);
+        ggml_tensor * c = ggml_view_2d(ctx, bcx, d_inner, n_t, bcx->nb[1], 1 * d_inner * es);
+        ggml_tensor * x = ggml_view_2d(ctx, bcx, d_inner, n_t, bcx->nb[1], 2 * d_inner * es);
+
+        ggml_tensor * bx      = ggml_transpose(ctx, ggml_mul(ctx, b, x));
+        ggml_tensor * conv_in = ggml_concat(ctx, state, bx, 0);
+
+        ggml_tensor * last = ggml_view_2d(ctx, conv_in, d_conv - 1, d_inner, conv_in->nb[1], n_t * ggml_element_size(conv_in));
+        ggml_tensor * upd  = ggml_reshape_1d(ctx, ggml_cpy(ctx, last, st), (d_conv - 1) * d_inner);
+
+        ggml_tensor * y = ggml_mul(ctx, c, ggml_ssm_conv(ctx, conv_in, w));
+        y = ggml_reshape_1d(ctx, y, d_inner * n_t);
+
+        ggml_tensor * out = ggml_concat(ctx, upd, y, 0);
+        ggml_set_name(out, "out");
+        return out;
+    }
+};
