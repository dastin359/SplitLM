+// --- Streamed expert kernel (single device) ---
+//
+// One flat item stream over the whole op: (expert, M-chunk, weight, N-chunk). Two raw weight buffers, two
+// fp16 weight buffers, two activation buffers and two output buffers, with async HMX:
+//   item j: wait DMA(j) -> pop HMX(j - 2) -> one HVX step [scatter(j - 2) | gather of a new expert / M-chunk |
+//           dequant(j)] -> DMA(j + 2) into the raw buffer just freed -> push HMX(j)
+// HMX always has the previous item queued while HVX runs the step, across expert boundaries.
+// Arithmetic is unchanged: every output tile is still one HMX job over the full k with the same dequant.
+
+// experts with rows, in order
+struct hmx_mmid_pos {
+    const uint32_t * row_counts;
+    uint32_t         n_as;
+    uint32_t         next_a;  // next expert to examine
+    bool             valid;
+    int              a;       // current expert
+    int              cne1;    // its rows
+    int              m_end;   // its rows padded to 32
+    int              mr;      // current M-chunk start
+    int              w;       // current weight
+    int              i;       // current N-chunk
+};
+
+static inline void hmx_mmid_pos_next_expert(struct hmx_mmid_pos * p) {
+    p->valid = false;
+    while (p->next_a < p->n_as) {
+        const uint32_t a = p->next_a++;
+        const uint32_t c = p->row_counts[a];
+        if (c > 0) {
+            p->valid = true;
+            p->a     = (int) a;
+            p->cne1  = (int) c;
+            p->m_end = hex_align_up((int) c, 32);
+            break;
+        }
+    }
+    p->mr = 0;
+    p->w  = 0;
+    p->i  = 0;
+}
 
