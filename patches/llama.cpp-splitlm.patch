+                const HVX_Vector x2 = hvx_vmem(src + 2 * S_v), x3 = hvx_vmem(src + 3 * S_v);
+                const HVX_Vector x4 = hvx_vmem(src + 4 * S_v), x5 = hvx_vmem(src + 5 * S_v);
+                const HVX_Vector x6 = hvx_vmem(src + 6 * S_v), x7 = hvx_vmem(src + 7 * S_v);
