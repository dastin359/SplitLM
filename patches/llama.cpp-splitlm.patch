+        if (args->want_lu) {
+            const uint32_t lr = fa_mask_row_unmasked_end(row, args->nek1, c, true);
+            lu = hex_smax(lu, lr);
+            if (args->lu_rows) {
+                args->lu_rows[r] = (uint16_t) hex_smin(lr, 0xffffu);
+            }
+        }
+    }
+    args->lu[i] = lu;
+}
