+// expert selection as build_moe_ffn does it: ggml_argsort_top_k of the router probabilities, then the weights of the
+// selected experts gathered with GET_ROWS. Backends may run the argsort as a top-k because only the first k columns
+// of the sort are read
+struct test_argsort_top_k_sel : public test_case {
+    const int64_t n_expert;
+    const int64_t n_expert_used;
+    const int64_t n_tokens;
+
+    test_argsort_top_k_sel(int64_t n_expert, int64_t n_expert_used, int64_t n_tokens) :
+        n_expert(n_expert), n_expert_used(n_expert_used), n_tokens(n_tokens) {}
+
+    std::string vars() override {
+        return VARS_TO_STR3(n_expert, n_expert_used, n_tokens);
+    }
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "ARGSORT_TOP_K_SEL";
+    }
+
+    bool run_whole_graph() override { return true; }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        // distinct values per row so the selection is unique
+        std::random_device rd;
+        std::default_random_engine rng(rd());
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != nullptr; t = ggml_get_next_tensor(ctx, t)) {
+            if (t->type != GGML_TYPE_F32) {
+                continue;
+            }
+            const int64_t nr = ggml_nrows(t);
+            std::vector<float> data(t->ne[0] * nr);
+            std::vector<int> perm(t->ne[0]);
+            for (int64_t r = 0; r < nr; r++) {
+                std::iota(perm.begin(), perm.end(), 0);
+                std::shuffle(perm.begin(), perm.end(), rng);
+                for (int64_t c = 0; c < t->ne[0]; c++) {
+                    data[r * t->ne[0] + c] = (float) perm[c] / (float) t->ne[0] - 0.5f;
+                }
+            }
+            ggml_backend_tensor_set(t, data.data(), 0, ggml_nbytes(t));
+        }
+    }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * probs = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_expert, n_tokens);
+        ggml_set_name(probs, "probs");
+        ggml_tensor * sel = ggml_argsort_top_k(ctx, probs, n_expert_used);
+        ggml_set_name(sel, "selected_experts");
+        ggml_tensor * w = ggml_get_rows(ctx, ggml_reshape_3d(ctx, probs, 1, n_expert, n_tokens), sel);
+        ggml_set_name(w, "weights");
+        return w;
+    }
+};
